# Umgebungsvariablen für die KU64-Website.
# In Railway unter Service → Variables setzen. Ohne die optionalen Schlüssel
# läuft die Seite vollständig – die betroffenen Funktionen zeigen dann einen
# klar gekennzeichneten Demo-Modus statt eines Fehlers.

# ── Pflicht ──────────────────────────────────────────────────────────────
# Geht in Canonical-URLs, Sitemap, llms.txt und die E-Mail-Links ein.
# Muss bereits zur BUILDZEIT gesetzt sein, nicht erst zur Laufzeit.
PUBLIC_SITE_URL=https://ku64-website-test.up.railway.app

# ── Digitaler Berater: Textchat ──────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional, Standard: claude-sonnet-5
CHAT_MODELL=

# ── Lächeln-Vorschau: Analyse und Bildgenerierung ────────────────────────
GEMINI_API_KEY=
# Optional, Standard: gemini-3-pro-image-preview (Nano Banana Pro)
NANO_BANANA_MODELL=
# Optional, Standard: gemini-3-flash
GEMINI_ANALYSE_MODELL=

# ── Versand der Lächeln-Vorschau ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_VON=KU64 <noreply@ku64.de>

# ── Sprachberater (ElevenLabs) ───────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional je Standort ein eigener Agent – überschreibt den allgemeinen:
ELEVENLABS_AGENT_ID_POTSDAM=
ELEVENLABS_AGENT_ID_BERLIN_CHARLOTTENBURG=
ELEVENLABS_AGENT_ID_BERLINMITTE=
ELEVENLABS_AGENT_ID_WILMERSDORF=

# ── Digitale Anamnese (Nelly Solutions) ──────────────────────────────────
# Je Standort die von Nelly bereitgestellte Formular-URL.
# Fehlt eine Variable, zeigt die Seite eine ehrliche Zwischenlösung mit
# Telefonnummer statt eines toten Links.
NELLY_URL_POTSDAM=
NELLY_URL_BERLIN_CHARLOTTENBURG=
NELLY_URL_BERLINMITTE=
NELLY_URL_WILMERSDORF=

# ── Laufzeit ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4321
