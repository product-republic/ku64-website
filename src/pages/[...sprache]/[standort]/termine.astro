---
/**
 * Terminbuchung über Doctolib – standortscharf.
 *
 * ── Warum hier kein Kalender eingebettet ist ────────────────────────────
 *
 * Weil es nicht geht. Doctolib sendet `X-Frame-Options: SAMEORIGIN`; jeder
 * Einbettungsversuch endet im Browser mit „www.doctolib.de hat die
 * Verbindung abgelehnt“ – eine graue Fläche an der Stelle, an der der
 * Terminkalender stehen sollte. Das ist keine Einstellungssache, sondern
 * eine Entscheidung von Doctolib, und sie gilt für jede fremde Seite.
 *
 * Vorher stand hier eine Einwilligungsschranke, hinter der genau dieser
 * graue Kasten wartete: Man stimmte der Datenübertragung zu und bekam
 * dafür einen Fehler. Schlechter geht es kaum.
 *
 * Stattdessen führt ein deutlicher Verweis direkt zum Kalender bei
 * Doctolib. Das ist obendrein datenschutzrechtlich der sauberere Weg:
 * Ohne Einbettung wird beim Aufruf dieser Seite überhaupt keine
 * Verbindung zu einem Dritten aufgebaut, und es braucht keine
 * Einwilligung nach § 25 TDDDG. Erst wer klickt, geht dorthin – bewusst
 * und sichtbar.
 *
 * Die zweite Ursache stand in den Daten: Die Adresse wurde ohne die Stadt
 * gebaut (`/zahnarztpraxis/<slug>` statt `/zahnarztpraxis/<stadt>/<slug>`).
 * Sie führte damit auch beim Klicken ins Leere. Gebaut wird sie jetzt an
 * genau einer Stelle – `doctolibAdresse()` in standorte.ts.
 */
import { inhalte } from '../../../i18n/daten';
import { texte } from '../../../i18n/katalog';
import { mitSprachen } from '../../../i18n/sprachen';
import Basis from '../../../layouts/Basis.astro';
import { STANDORTE, doctolibAdresse, zeitLesbar } from '../../../data/standorte';
import { schemaBrotkrumen, schemaFaq } from '../../../lib/seo';

export function getStaticPaths() {
  return mitSprachen(STANDORTE.map((s) => ({ params: { standort: s.slug } })));
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const standort = daten.standort(Astro.params.standort!)!;
const pfad = `/${standort.slug}/termine/`;

const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: `KU64 ${standort.name}`, pfad: `/${standort.slug}/` },
  { name: t('krume.termine'), pfad },
];

/*
 * Nur Fragen, die HIER anders beantwortet werden als anderswo.
 *
 * Vorher standen an dieser Stelle vier allgemeine Fragen – wie buche ich,
 * was bei Schmerzen, kann ich absagen, was mitbringen. Sie waren auf allen
 * vier Standortseiten wortgleich; gemessen waren 306 von 339 Wörtern
 * identisch, die Seiten damit untereinander zu 66 Prozent gleich.
 *
 * Allgemeine Fragen gehören auf eine allgemeine Seite. Sie stehen jetzt auf
 * /termine/ und werden von hier verlinkt. Was bleibt, ist das, was sich von
 * Standort zu Standort tatsächlich unterscheidet – und das kommt aus den
 * Standortdaten, nicht aus einer Vorlage.
 */
const wochentags = standort.oeffnungszeiten.filter((z) => z.von && !['Sa', 'So'].includes(z.tag));
const abweichend = wochentags.filter((z) => z.bis !== wochentags[0]?.bis);
const wochenende = standort.oeffnungszeiten.filter((z) => z.nachVereinbarung).map((z) => z.tag);

const faq = [
  /* Nur der Kurfürstendamm führt zwei getrennte Kalender. Wer das nicht
     weiß, bucht die Kieferorthopädie im Zahnmedizin-Kalender und bekommt
     einen Termin, der ihm nicht hilft. */
  ...(standort.doctolib.length > 1
    ? [
        {
          frage: `Warum gibt es bei KU64 ${standort.name} zwei Terminkalender?`,
          antwort: `Zahnmedizin und Kieferorthopädie werden hier von getrennten Teams behandelt und haben deshalb je einen eigenen Kalender: ${standort.doctolib
            .map((d) => d.label)
            .join(' und ')}. Wählen Sie den Kalender, der zu Ihrem Anliegen passt – bei Unsicherheit rufen Sie an, wir ordnen es zu.`,
        },
      ]
    : []),

  /* Sprechzeiten, die vom Üblichen abweichen – bei der KiezPraxis enden
     Dienstag und Donnerstag mittags. Das steht sonst nur in der Tabelle. */
  ...(abweichend.length > 0
    ? [
        {
          frage: `Bis wann kann ich in ${standort.ort} einen Termin bekommen?`,
          antwort: `${wochentags
            .map((z) => `${z.tag} bis ${z.bis} Uhr`)
            .join(', ')}. Die kürzeren Tage sind fest so gelegt – ein Abendtermin ist an ihnen nicht möglich, dafür an den übrigen.`,
        },
      ]
    : []),

  /* Wochenende nach Vereinbarung: Wer das als „geschlossen" liest, ruft
     nicht an – und wer es als feste Zeit liest, steht vor der Tür. */
  ...(wochenende.length > 0
    ? [
        {
          frage: `Kann ich bei KU64 ${standort.name} am Wochenende einen Termin bekommen?`,
          antwort: `${wochenende.join(' und ')} behandeln wir nach Vereinbarung. Das heißt: nicht ohne Termin, aber sehr wohl möglich – rufen Sie unter ${standort.telefon} an, dann klären wir es.`,
        },
      ]
    : []),

  {
    frage: `Wie komme ich zu KU64 ${standort.name}?`,
    antwort: `${standort.anfahrt.oepnv.join('. ')}. ${standort.anfahrt.parken} Die Adresse lautet ${standort.strasse}, ${standort.plz} ${standort.ort}.`,
  },
];
------

<Basis
  titel={`Termin in ${standort.ort}`}
  description={`Online-Termin bei KU64 ${standort.name}, ${standort.strasse}, ${standort.plz} ${standort.ort}. Oder telefonisch unter ${standort.telefon}.`}
  standort={standort}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen), schemaFaq(faq)]}
>
  <section class="kopf abschnitt-eng">
    <div class="huelle">
      <h1>{t('standort.terminBeiKu64', { name: standort.name })}</h1>
      <p class="unter">
        {t('standort.termineVorspann', {
          adresse: `${standort.strasse}, ${standort.plz} ${standort.ort}`,
        })}
      </p>
    </div>
  </section>

  <div class="huelle abschnitt wege">
    {/* Weg 1: Doctolib nach Einwilligung */}
    <section class="weg">
      <h2>{t('termine.onlineBuchen')}</h2>

      {
        standort.doctolib.length > 1 && (
          <p class="unter-klein">{t('termine.anDiesemStandortGibt')}</p>
        )
      }

      <div class="kalender">
        {
          standort.doctolib.map((d, i) => (
            <a
              href={doctolibAdresse(d)}
              class:list={['kalender-karte', 'karte', { erste: i === 0 }]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="k-bereich">{d.label}</span>
              <span class="k-titel">
                Termin bei KU64 {standort.name}
                {standort.doctolib.length > 1 && ` · ${d.label}`}
              </span>
              <span class="k-hinweis">{t('termine.oeffnetDenKalenderBei')}</span>
              <span class="k-pfeil" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18">
                  <path
                    d="M5 12h13M13 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      {/* Die Erklärung, warum der Kalender bei Doctolib liegt und was dabei
          übertragen wird, steht auf /termine/. Sie ist an allen vier
          Standorten dieselbe – viermal derselbe Absatz machte die Seiten zu
          45 Prozent textgleich. */}
      <p class="klein">
        Der Kalender liegt bei Doctolib, einem eigenständigen Dienst.
        <a href="/termine/#doctolib">Was dabei übertragen wird</a>
      </p>
    </section>

    {/* Weg 2: Ohne Drittanbieter */}
    <aside class="weg weg-schmal">
      <h2>{t('termine.lieberOhneOnlinePortal')}</h2>

      <div class="karte kontakt">
        <p class="k-titel">Anrufen</p>
        <a href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`} class="k-nummer">
          {standort.telefon}
        </a>
        <table class="zeiten">
          <caption class="nur-screenreader">{t('termine.wannSieUnsErreichen')}</caption>
          <tbody>
            {
              standort.oeffnungszeiten.map((z) => (
                <tr>
                  <th scope="row">{z.tag}</th>
                  <td>{zeitLesbar(z)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="karte kontakt">
        <p class="k-titel">Schreiben</p>
        <p class="k-text">{t('termine.schildernSieKurzIhr')}</p>
        <a href={`mailto:${standort.email}`} class="knopf knopf-sekundaer">{standort.email}</a>
      </div>

      <div class="karte kontakt akut">
        <p class="k-titel">{t('termine.akuteSchmerzen')}</p>
        <p class="k-text">{t('termine.bitteRufenSieAn')}</p>
        <a href="/notfall/" class="knopf knopf-sekundaer">{t('termine.wasTunImNotfall')}</a>
      </div>
    </aside>
  </div>

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>{t('termine.vorDemTerminAnamnese')}</h2>
      <p class="unter">{t('termine.denAnamnesebogenFuellenSie')}</p>
      <a href={`/${standort.slug}/anamnese/`} class="knopf knopf-primaer knopf-gross">{t('termine.zurDigitalenAnamnese')}</a>
    </div>
  </section>

  <div class="huelle">
    <section class="faq-bereich">
      <h2>Fragen zu diesem Standort</h2>
      {
        faq.map((f) => (
          <details>
            <summary>{f.frage}</summary>
            <p>{f.antwort}</p>
          </details>
        ))
      }
      <p class="klein">
        Allgemeine Fragen zur Terminbuchung – absagen, verschieben, was zum
        ersten Termin mitzubringen ist – beantworten wir gesammelt unter
        <a href="/termine/">Termin buchen</a>.
      </p>
    </section>
  </div>
</Basis>


<style>
  .kopf {
    background: linear-gradient(to bottom, color-mix(in oklab, var(--akzent) 8%, var(--flaeche)), var(--flaeche));
    border-bottom: 1px solid var(--linie);
  }

  .unter {
    max-width: var(--breite-text);
    margin-block-start: var(--raum-4);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
  }

  .wege {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--raum-7);
    align-items: start;
  }

  .weg h2 {
    font-size: var(--t-xl);
    margin-block-end: var(--raum-4);
  }

  .unter-klein {
    max-width: var(--breite-text);
    margin-block-end: var(--raum-4);
    color: var(--tinte-weich);
    font-size: var(--t-sm);
  }

  /**
   * Eine Karte je Kalender statt eines eingebetteten Fensters.
   *
   * Sie ist absichtlich groß und trägt das Ziel im Text: Wer klickt,
   * verlässt diese Website. Ein kleiner Verweis „hier buchen“ wäre kürzer
   * und würde verschweigen, was passiert.
   */
  .kalender {
    display: grid;
    gap: var(--raum-3);
    margin-block-end: var(--raum-4);
  }

  .kalender-karte {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--raum-2) var(--raum-4);
    padding: var(--raum-5);
    text-decoration: none;
    transition:
      transform var(--zeit) var(--kurve-feder),
      border-color var(--zeit) var(--kurve-weich);
  }

  .kalender-karte:hover,
  .kalender-karte:focus-visible {
    transform: translate3d(0, -2px, 0);
    border-color: color-mix(in oklab, var(--tinte) 28%, var(--scheibe-rand));
  }

  .k-bereich {
    grid-column: 1;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinte-leise);
  }

  .k-titel {
    grid-column: 1;
    font-family: var(--schrift-titel);
    font-size: var(--t-lg);
    font-weight: 700;
    line-height: var(--zeile-eng);
  }

  .k-hinweis {
    grid-column: 1;
    font-size: var(--t-sm);
    color: var(--tinte-weich);
  }

  /* Der Pfeil in der dunklen Scheibe – die Form aus den Entwürfen. Er sitzt
     über alle drei Textzeilen hinweg an der rechten Kante. */
  .k-pfeil {
    grid-column: 2;
    grid-row: 1 / -1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-voll);
    background: var(--knopf-flaeche);
    color: var(--knopf-schrift);
    transition: transform var(--zeit) var(--kurve-feder);
  }

  .kalender-karte:hover .k-pfeil {
    transform: translateX(3px);
  }

  .klein {
    margin-block-start: var(--raum-3);
    font-size: var(--t-xs);
    color: var(--tinte-weich);
    max-width: var(--breite-text);
  }

  .kontakt {
    margin-block-end: var(--raum-4);
  }

  .k-titel {
    font-family: var(--schrift-titel);
    font-size: var(--t-md);
    font-weight: 600;
    margin-block-end: var(--raum-2);
  }

  .k-nummer {
    display: block;
    font-size: var(--t-xl);
    font-weight: 700;
    color: var(--akzent-schrift);
    text-decoration: none;
  }

  .k-text {
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
    margin-block-end: var(--raum-4);
  }

  .zeiten {
    width: 100%;
    margin-block-start: var(--raum-4);
    border-collapse: collapse;
    font-size: var(--t-xs);
  }

  .zeiten th {
    text-align: start;
    font-weight: 500;
    padding-block: 2px;
    color: var(--tinte-weich);
  }

  .zeiten td {
    text-align: end;
    font-variant-numeric: tabular-nums;
    color: var(--tinte-leise);
  }

  .akut {
    border-color: color-mix(in oklab, var(--fehler) 30%, var(--linie));
    background: var(--fehler-flaeche);
  }

  .flaeche-warm {
    background: var(--flaeche-warm);
    border-block: 1px solid var(--linie);
  }

  .faq-bereich {
    padding-block: var(--raum-8);
  }

  .faq-bereich h2 {
    margin-block-end: var(--raum-5);
  }

  .faq-bereich details {
    border-bottom: 1px solid var(--linie);
  }

  .faq-bereich summary {
    padding-block: var(--raum-4);
    font-weight: 600;
    cursor: pointer;
  }

  .faq-bereich p {
    padding-block-end: var(--raum-4);
    max-width: var(--breite-text);
    color: var(--tinte-weich);
  }

  @media (max-width: 62rem) {
    .wege {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
