---
import { inhalte } from '../../../../i18n/daten';
import { texte } from '../../../../i18n/katalog';
import { mitSprachen } from '../../../../i18n/sprachen';
import Basis from '../../../../layouts/Basis.astro';
import TerminBand from '../../../../components/TerminBand.astro';
import Bild from '../../../../components/Bild.astro';
import { STANDORTE } from '../../../../data/standorte';
import { teamAn, gruppenAn, anzahlZahnaerzte, fachgebieteVon, GRUPPENNAMEN } from '../../../../data/team';
import { schemaBrotkrumen, kanonisch } from '../../../../lib/seo';
import profile from '../../../../data/profile.json';

export function getStaticPaths() {
  return mitSprachen(STANDORTE.map((s) => ({ params: { standort: s.slug } })));
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const standort = daten.standort(Astro.params.standort!)!;
const pfad = `/${standort.slug}/team/`;
const team = teamAn(standort.slug);

const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: `KU64 ${standort.name}`, pfad: `/${standort.slug}/` },
  { name: t('krume.team'), pfad },
];

/*
 * Filter: Bereich und Behandlungsart.
 *
 * Beides wird aus dem Team dieses Standorts errechnet, nicht fest verdrahtet.
 * Angeboten wird nur, was hier auch jemanden ergibt – ein Filter, der zu null
 * Treffern führt, ist ein Versprechen, das die Seite nicht hält.
 *
 * Die Behandlungsart kommt aus der Funktionsbezeichnung, die die Praxis
 * selbst führt („Fachzahnärztin für Kieferorthopädie"). Wer dort kein
 * Fachgebiet nennt – Assistenz, Empfang, Verwaltung – bekommt keines
 * zugeordnet und erscheint nur unter „Alle".
 */
const kategorieVonLeistung = (slug: string) => daten.leistung(slug)?.kategorie;

const mitFach = team.map((m) => ({
  mitglied: m,
  fach: fachgebieteVon(m, kategorieVonLeistung),
}));

const bereiche = [...new Set(team.map((m) => m.gruppe))].map((g) => ({
  wert: g,
  name: GRUPPENNAMEN[g],
  anzahl: team.filter((m) => m.gruppe === g).length,
}));

const fachgebiete = daten.kategorien
  .map((k) => ({
    wert: k.slug,
    name: k.name,
    anzahl: mitFach.filter((e) => e.fach.includes(k.slug)).length,
  }))
  .filter((k) => k.anzahl > 0)
  .sort((a, b) => b.anzahl - a.anzahl);

const schema: Record<string, unknown>[] = [schemaBrotkrumen(brotkrumen)];

if (team.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: team.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Physician',
        name: m.name,
        jobTitle: m.funktion,
        knowsLanguage: m.sprachen,
        worksFor: { '@id': kanonisch(`/${standort.slug}/`) + '#praxis' },
      },
    })),
  });
}
---

<Basis
  titel={`Team in ${standort.ort}`}
  description={`Die Behandelnden bei KU64 ${standort.name}, ${standort.strasse}, ${standort.plz} ${standort.ort}.`}
  standort={standort}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={schema}
  noindex={team.length === 0}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>Das Team in {standort.ort}</h1>

      {
        team.length > 0 ? (
          <>
            <p class="unter">
              {anzahlZahnaerzte(standort.slug)
                ? `${anzahlZahnaerzte(standort.slug)} Zahnärztinnen und Zahnärzte und insgesamt ${team.length} Menschen bei KU64 ${standort.name}.`
                : `Das Team bei KU64 ${standort.name}.`}
            </p>
            <div class="filter" role="group" aria-label="Team filtern" hidden>
              <div class="filter-zeile">
                <span class="filter-titel" id="f-bereich">Bereich</span>
                <div class="chips" data-feld="bereich" aria-labelledby="f-bereich">
                  <button type="button" class="chip" data-wert="" aria-pressed="true">{t('teamliste.alle')}<span class="chip-zahl">{team.length}</span>
                  </button>
                  {bereiche.map((b) => (
                    <button type="button" class="chip" data-wert={b.wert} aria-pressed="false">
                      {b.name} <span class="chip-zahl">{b.anzahl}</span>
                    </button>
                  ))}
                </div>
              </div>

              {fachgebiete.length > 1 && (
                <div class="filter-zeile">
                  <span class="filter-titel" id="f-fach">Behandlungsart</span>
                  <div class="chips" data-feld="fach" aria-labelledby="f-fach">
                    <button type="button" class="chip" data-wert="" aria-pressed="true">
                      Alle
                    </button>
                    {fachgebiete.map((k) => (
                      <button type="button" class="chip" data-wert={k.wert} aria-pressed="false">
                        {k.name} <span class="chip-zahl">{k.anzahl}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <p class="filter-stand" role="status" aria-live="polite" data-vorlage={`{n} von ${team.length}`}></p>
            </div>

            <p class="filter-leer" hidden>
              Mit dieser Auswahl steht niemand in {standort.ort}.
              <button type="button" class="filter-zuruecksetzen">{t('teamliste.auswahlAufheben')}</button>
            </p>

            <div class="raster" id="teamraster">
              {mitFach.map(({ mitglied: m, fach }) => {
                /* Verlinkt wird nur, wo es auch etwas zu lesen gibt. Eine
                   Kachel, die auf eine Seite mit dem eigenen Inhalt der
                   Kachel führt, ist ein enttäuschter Klick. */
                const hatProfil = m.slug in profile;
                return (
                <article
                  class:list={['karte', 'person', { 'person-klickbar': hatProfil }]}
                  data-bereich={m.gruppe}
                  data-fach={fach.join(' ')}
                >
                  {/* Über das Bildverzeichnis, nicht über einen Pfad aus den
                      Teamdaten: So gilt für Porträts dieselbe Nachweispflicht
                      wie für jedes andere Bild – Alternativtext, Herkunft,
                      Einwilligung. Fehlt der Nachweis, erscheint die Kachel
                      ohne Bild statt mit einem Platzhalter. */}
                  <Bild schluessel={`team-${m.slug}`} klasse="portraet" />
                  <h2>
                    {hatProfil ? (
                      <a href={`/${standort.slug}/team/${m.slug}/`} class="person-link">
                        {m.name}
                      </a>
                    ) : (
                      m.name
                    )}
                  </h2>
                  <p class="funktion">{m.funktion}</p>
                  {m.vorstellung && <p class="text">{m.vorstellung}</p>}
                  {m.sprachen && m.sprachen.length > 0 && (
                    <p class="sprachen">Spricht {m.sprachen.join(', ')}</p>
                  )}
                  {m.schwerpunkte && m.schwerpunkte.length > 0 && (
                    <ul class="schwerpunkte">
                      {m.schwerpunkte.map((s) => {
                        const l = daten.leistung(s);
                        return l ? (
                          <li>
                            <a href={`/${standort.slug}/leistungen/${l.slug}/`}>{l.name}</a>
                          </li>
                        ) : null;
                      })}
                    </ul>
                  )}
                  {hatProfil && (
                    <span class="person-mehr" aria-hidden="true">{t('teamliste.profilAnsehen')}<svg viewBox="0 0 24 24" width="15" height="15">
                        <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor"
                              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  )}
                </article>
                );
              })}
            </div>
          </>
        ) : (
          /* Ehrlicher Zwischenstand statt einer erfundenen Teamliste. */
          <div class="offen">
            <p class="unter">
              Die Vorstellung unseres Teams in {standort.ort} bereiten wir gerade auf –
              mit Fotos und Schwerpunkten der einzelnen Behandelnden.
            </p>
            <p class="text">
              {anzahlZahnaerzte(standort.slug)
                ? `Bei KU64 ${standort.name} behandeln ${anzahlZahnaerzte(standort.slug)} Zahnärztinnen und Zahnärzte.`
                : `Bei KU64 ${standort.name} behandelt Sie ein festes, eingespieltes Team.`}{' '}
              Wenn Sie zu einer bestimmten Person oder einem Fachgebiet Fragen haben, rufen
              Sie uns gern an – wir sagen Ihnen genau, wer für Ihr Anliegen zuständig ist.
            </p>
            <div class="offen-knoepfe">
              <a href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`} class="knopf knopf-primaer">
                {standort.telefon}
              </a>
              <a href={`/${standort.slug}/leistungen/`} class="knopf knopf-sekundaer">{t('teamliste.behandlungenAnsehen')}</a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <TerminBand standort={standort} />
</Basis>

<script>
  /*
   * Filtern im Browser, nicht auf dem Server.
   *
   * Alle Personen stehen im Quelltext – auch ohne JavaScript ist die Seite
   * vollständig, nur ohne Filterleiste. Deshalb wird die Leiste erst hier
   * sichtbar geschaltet: Ein Filter, der nicht filtert, ist schlimmer als
   * keiner.
   */
  const leiste = document.querySelector<HTMLElement>('.filter');
  const raster = document.getElementById('teamraster');

  if (leiste && raster) {
    leiste.hidden = false;

    const karten = [...raster.querySelectorAll<HTMLElement>('[data-bereich]')];
    const stand = leiste.querySelector<HTMLElement>('.filter-stand');
    const leer = document.querySelector<HTMLElement>('.filter-leer');
    const auswahl: Record<string, string> = { bereich: '', fach: '' };

    function anwenden() {
      let sichtbar = 0;
      for (const karte of karten) {
        const passtBereich = !auswahl.bereich || karte.dataset.bereich === auswahl.bereich;
        const passtFach =
          !auswahl.fach || (karte.dataset.fach ?? '').split(' ').includes(auswahl.fach);
        const zeigen = passtBereich && passtFach;
        karte.hidden = !zeigen;
        if (zeigen) sichtbar++;
      }

      if (stand?.dataset.vorlage) {
        stand.textContent =
          auswahl.bereich || auswahl.fach
            ? stand.dataset.vorlage.replace('{n}', String(sichtbar))
            : '';
      }
      if (leer) leer.hidden = sichtbar > 0;
    }

    for (const gruppe of leiste.querySelectorAll<HTMLElement>('.chips')) {
      const feld = gruppe.dataset.feld!;
      gruppe.addEventListener('click', (e) => {
        const knopf = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
        if (!knopf) return;
        /* Nochmals auf denselben Wert klicken hebt ihn auf – das erwartet
           man von einem Schalter, und es erspart den Weg über "Alle". */
        const wert = knopf.dataset.wert ?? '';
        auswahl[feld] = auswahl[feld] === wert && wert !== '' ? '' : wert;
        for (const k of gruppe.querySelectorAll<HTMLButtonElement>('.chip')) {
          k.setAttribute('aria-pressed', String((k.dataset.wert ?? '') === auswahl[feld]));
        }
        anwenden();
      });
    }

    document.querySelector('.filter-zuruecksetzen')?.addEventListener('click', () => {
      auswahl.bereich = '';
      auswahl.fach = '';
      for (const k of leiste.querySelectorAll<HTMLButtonElement>('.chip')) {
        k.setAttribute('aria-pressed', String((k.dataset.wert ?? '') === ''));
      }
      anwenden();
    });
  }
</script>

<style>
  /* Die Leiste erscheint erst, wenn das Skript sie einschaltet – ohne
     JavaScript steht das vollständige Team da, nur ohne Filter. */
  .filter[hidden] { display: none; }

  .filter {
    display: grid;
    gap: var(--raum-4);
    margin-block: var(--raum-6);
    padding-block-end: var(--raum-5);
    border-block-end: 1px solid var(--linie);
  }

  .filter-zeile {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--raum-3) var(--raum-4);
  }

  .filter-titel {
    flex-shrink: 0;
    min-width: 8rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinte-leise);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--linie);
    border-radius: var(--radius-voll);
    background: var(--flaeche);
    color: var(--tinte-weich);
    font-size: var(--t-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--zeit-schnell) var(--kurve),
      border-color var(--zeit-schnell) var(--kurve),
      color var(--zeit-schnell) var(--kurve);
  }

  .chip:hover { border-color: var(--tinte-leise); color: var(--tinte); }

  /* Der gewählte Zustand steht im aria-pressed und wird daraus gestaltet –
     so können Anzeige und Vorlesesoftware nicht auseinanderlaufen. */
  .chip[aria-pressed='true'] {
    background: var(--knopf-flaeche);
    border-color: var(--knopf-flaeche);
    color: var(--knopf-schrift);
  }

  .chip-zahl {
    font-variant-numeric: tabular-nums;
    font-size: 0.85em;
    opacity: 0.65;
  }

  .filter-stand {
    font-size: var(--t-sm);
    color: var(--tinte-leise);
    min-height: 1.2em;
  }

  .filter-leer {
    margin-block: var(--raum-6);
    color: var(--tinte-weich);
  }

  .filter-zuruecksetzen {
    margin-inline-start: var(--raum-2);
    color: var(--akzent-schrift);
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }

  .person[hidden] { display: none; }
  h1 { max-width: 16ch; }
  .unter {
    max-width: var(--breite-text);
    margin-block: var(--raum-4) var(--raum-6);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
  }
  .person :global(.portraet) { margin-block-end: var(--raum-4); border-radius: var(--radius-lg); }
  .person :global(.portraet img) { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .person h2 { font-size: var(--t-lg); }
  .person-klickbar {
    position: relative;
    transition:
      transform var(--zeit) var(--kurve-feder),
      border-color var(--zeit) var(--kurve-weich);
  }
  .person-klickbar:hover,
  .person-klickbar:focus-within {
    transform: translate3d(0, -3px, 0);
    border-color: color-mix(in oklab, var(--tinte) 25%, var(--scheibe-rand));
  }
  /* Die ganze Kachel klickbar, ohne verschachtelte Verweise. */
  .person-link { text-decoration: none; }
  .person-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .person-mehr {
    display: inline-flex; align-items: center; gap: var(--raum-2);
    margin-block-start: auto; padding-block-start: var(--raum-3);
    font-size: var(--t-sm); font-weight: 600;
  }
  .person-klickbar:hover .person-mehr svg { transform: translateX(3px); }
  .person-mehr svg { transition: transform var(--zeit) var(--kurve-feder); }
  .funktion { font-size: var(--t-sm); color: var(--akzent-schrift); font-weight: 600; margin-block: var(--raum-1) var(--raum-3); }
  .text { color: var(--tinte-weich); line-height: var(--zeile-weit); max-width: var(--breite-text); }
  .sprachen { margin-block-start: var(--raum-3); font-size: var(--t-xs); color: var(--tinte-leise); }
  .schwerpunkte { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--raum-2); margin-block-start: var(--raum-3); }
  .schwerpunkte a {
    display: inline-block; padding: 0.25rem 0.6rem; border-radius: var(--radius-voll);
    background: var(--flaeche-warm-2); font-size: var(--t-xs); text-decoration: none; color: var(--tinte-weich);
  }
  .offen { max-width: var(--breite-text); }
  .offen-knoepfe { display: flex; flex-wrap: wrap; gap: var(--raum-3); margin-block-start: var(--raum-5); }
</style>
