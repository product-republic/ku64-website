---
/**
 * Praxisvorstellung je Standort.
 *
 * Die Räume stehen als Bildstrecke in der Reihenfolge, in der man sie
 * durchläuft – Ankommen, Warten, Weg, Behandlung, Labor. Welche Aufnahmen das
 * je Standort sind, steht in `RAUMBILDER` (src/data/medien.ts); gibt es zu
 * einem Standort nur eine, steht dort auch nur eine.
 *
 * OFFEN: Ausstattungsdetails je Standort (Geräte, Sedierungsverfahren). Sie
 * gehören in `besonderheiten` in standorte.ts und brauchen keine Änderung an
 * dieser Seite.
 */
import { inhalte } from '../../../i18n/daten';
import { mitSprachen } from '../../../i18n/sprachen';
import Basis from '../../../layouts/Basis.astro';
import { anzahlZahnaerzte } from '../../../data/team';
import TerminBand from '../../../components/TerminBand.astro';
import LeistungKarte from '../../../components/LeistungKarte.astro';
import Bild from '../../../components/Bild.astro';
import { STANDORTE, behandlungstage } from '../../../data/standorte';
import { raumbilderFuer } from '../../../data/medien';
import { schemaBrotkrumen, schemaStandort } from '../../../lib/seo';
import { texte } from '../../../i18n/katalog';

export function getStaticPaths() {
  return mitSprachen(STANDORTE.map((s) => ({ params: { standort: s.slug } })));
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const standort = daten.standort(Astro.params.standort!)!;
const pfad = `/${standort.slug}/praxis/`;
const alleHier = daten.leistungenHier(standort.slug);
const gruppen = daten.gruppen(standort.slug);

const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: `KU64 ${standort.name}`, pfad: `/${standort.slug}/` },
  { name: 'Die Praxis', pfad },
];

const raeume = raumbilderFuer(standort.slug);

const eroeffnetJahr = standort.eroeffnet.slice(0, 4);
const jahre = new Date().getFullYear() - Number(eroeffnetJahr);
---

<Basis
  titel={`Die Praxis in ${standort.ort}`}
  description={`KU64 ${standort.name}: ${standort.claim} Seit ${eroeffnetJahr} in ${standort.ort}, ${alleHier.length} Behandlungen aus ${gruppen.length} Fachbereichen.`}
  standort={standort}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen), schemaStandort(standort, alleHier)]}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>KU64 {standort.name}</h1>
      <p class="claim">{standort.claim}</p>

      <dl class="zahlen">
        <div>
          <dt>Seit</dt>
          <dd>{eroeffnetJahr}</dd>
          <p>{jahre > 0 ? `${jahre} Jahre in ${standort.ort}` : `neu in ${standort.ort}`}</p>
        </div>
        {
          anzahlZahnaerzte(standort.slug) > 0 && (
            <div>
              <dt>Behandelnde</dt>
              <dd>{anzahlZahnaerzte(standort.slug)}</dd>
              <p>{t('standort.zahnaerzteLabel')}</p>
            </div>
          )
        }
        <div>
          <dt>Behandlungen</dt>
          <dd>{alleHier.length}</dd>
          <p>aus {gruppen.length} Fachbereichen</p>
        </div>
        <div>
          <dt>Geöffnet</dt>
          <dd>{behandlungstage(standort)}</dd>
          <p>{t('standort.tageWoche')}</p>
        </div>
      </dl>
    </div>
  </section>

  {
    raeume.length > 0 && (
      <section class="abschnitt">
        <div class="huelle">
          <h2>{t('praxis.dieRaeume')}</h2>
          <p class="abschnitt-text">
            {t('standort.galerieHinweis')}
          </p>
          <div class="raeume">
            {raeume.map((schluessel, i) => (
              <Bild
                schluessel={schluessel}
                klasse={i === 0 ? 'raum raum-gross' : 'raum'}
                vorrang={i === 0}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>{t('praxis.wasDiesenStandortAusmacht')}</h2>
      <ul class="merkmale">
        {
          standort.besonderheiten.map((b) => (
            <li class="einblenden">
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="abschnitt">
    <div class="huelle">
      <h2>Unsere Fachbereiche in {standort.ort}</h2>
      <p class="unter">
        {gruppen.length} Fachbereiche unter einem Dach – Sie müssen für die meisten
        Behandlungen nicht die Praxis wechseln.
      </p>
      <div class="raster">
        {
          gruppen.map((g) => (
            <a class="karte karte-klickbar bereich" href={`/${standort.slug}/leistungen/#${g.kategorie.slug}`}>
              <h3>{g.kategorie.name}</h3>
              <p>{g.kategorie.beschreibung}</p>
              <span class="anzahl">{g.leistungen.length} Behandlungen</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>Häufig gefragt in {standort.ort}</h2>
      <div class="raster">
        {
          alleHier.slice(0, 6).map((l) => (
            <LeistungKarte leistung={l} standortSlug={standort.slug} kompakt />
          ))
        }
      </div>
      <a href={`/${standort.slug}/leistungen/`} class="knopf knopf-sekundaer alle">
        Alle {alleHier.length} Behandlungen ansehen
      </a>
    </div>
  </section>

  <TerminBand standort={standort} />
</Basis>

<style>
  /**
   * Bildstrecke der Räume.
   *
   * Das erste Bild steht über die volle Breite, die übrigen zu zweit
   * daneben. Grund: Das erste ist der Empfang – die Ansicht, die die Frage
   * „wie sieht es da aus?“ tatsächlich beantwortet. Alle Bilder gleich groß
   * zu setzen, macht aus einer Antwort eine Kachelwand.
   */
  .raeume {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
    gap: var(--raum-4);
    margin-block-start: var(--raum-6);
  }

  .raeume :global(.raum-gross) {
    grid-column: 1 / -1;
  }

  .raeume :global(.raum img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .raeume :global(.raum-gross img) {
    aspect-ratio: 21 / 9;
  }

  @media (max-width: 40rem) {
    .raeume :global(.raum-gross img) {
      aspect-ratio: 3 / 2;
    }
  }

  h1 { max-width: 16ch; }
  .claim {
    max-width: var(--breite-text);
    margin-block: var(--raum-4) var(--raum-7);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
  }
  .zahlen {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--raum-5);
    padding-block-start: var(--raum-6);
    border-top: 1px solid var(--linie);
  }
  .zahlen dt {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--tinte-leise);
  }
  .zahlen dd {
    margin: var(--raum-1) 0 0;
    font-family: var(--schrift-titel);
    font-size: var(--t-2xl); font-weight: 600; color: var(--akzent-schrift);
  }
  .zahlen p { font-size: var(--t-xs); color: var(--tinte-weich); }
  .flaeche-warm { background: var(--flaeche-warm); border-block: 1px solid var(--linie); }
  .unter { max-width: var(--breite-text); margin-block: var(--raum-3) var(--raum-6); color: var(--tinte-weich); font-size: var(--t-lg); }
  .merkmale {
    list-style: none; padding: 0; margin-block-start: var(--raum-5);
    display: grid; gap: var(--raum-4);
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
  }
  .merkmale li { display: flex; align-items: flex-start; gap: var(--raum-3); line-height: var(--zeile-normal); }
  .merkmale svg { flex-shrink: 0; margin-block-start: 4px; color: var(--akzent-schrift); }
  .bereich { text-decoration: none; }
  .bereich h3 { font-size: var(--t-lg); margin-block-end: var(--raum-2); }
  .bereich p { font-size: var(--t-sm); color: var(--tinte-weich); line-height: var(--zeile-normal); margin-block-end: var(--raum-4); }
  .anzahl { margin-block-start: auto; font-size: var(--t-xs); font-weight: 600; color: var(--akzent-schrift); }
  .alle { margin-block-start: var(--raum-6); }
</style>
