---
/**
 * Eine Leistung an einem konkreten Standort.
 *
 * Das ist die Seite, die die Struktur der alten Website repariert: Dort lagen
 * Leistungen standortübergreifend unter /leistungen/, sodass jemand mit
 * Standort Potsdam beim Klick auf eine Leistung unbemerkt Inhalte einer
 * anderen Praxis las. Hier gehört jede Leistungsseite eindeutig zu einem Ort
 * – mit dessen Adresse, Telefonnummer, Sprechzeiten und Terminbuchung.
 */
import { inhalte } from '../../../../i18n/daten';
import { texte } from '../../../../i18n/katalog';
import { mitSprachen } from '../../../../i18n/sprachen';
import Basis from '../../../../layouts/Basis.astro';
import Bild from '../../../../components/Bild.astro';
import { veroeffentlichbar } from '../../../../data/team';
import FaqBlock from '../../../../components/FaqBlock.astro';
import LeistungsListe from '../../../../components/LeistungsListe.astro';
import TerminBand from '../../../../components/TerminBand.astro';
import Langtext from '../../../../components/Langtext.astro';
import { langtext, unterthemen, anriss } from '../../../../lib/langtexte';
import { alleKombinationen } from '../../../../data/leistungen';
import { fassungIstEigenstaendig } from '../../../../data/standortfassungen';
import { bereichsbild } from '../../../../data/bildbedarf';
import {
  schemaLeistung,
  schemaFaq,
  schemaBrotkrumen,
  descriptionKuerzen,
} from '../../../../lib/seo';

export function getStaticPaths() {
  return mitSprachen(alleKombinationen().map(({ standort, leistung }) => ({
    params: { standort, leistung: leistung.slug },
    props: { leistungSlug: leistung.slug },
  })));
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const { standort: standortSlug, leistung: leistungSlug } = Astro.params;

const standort = daten.standort(standortSlug!)!;
const leistung = daten.leistungen.find((l) => l.slug === leistungSlug)!;
const kategorie = daten.kategorie(leistung.kategorie)!;

/*
 * Wer diese Leistung HIER durchführt.
 *
 * Gefiltert auf den Standort: Clara-Constanze Meinberg macht Dentosophie am
 * Kurfürstendamm, Dr. Elisabeth Futterlieb in Potsdam. Auf der Potsdamer
 * Seite beide zu nennen hieße, jemanden anzukündigen, den man dort nicht
 * antrifft – und genau das ist der Fehler, den diese Website nicht machen
 * soll.
 */
const behandelnde = (leistung.behandler ?? [])
  .map((slug) => veroeffentlichbar().find((m) => m.slug === slug))
  .filter((m) => m !== undefined && m.standorte.includes(standort.slug));

const pfad = `/${standort.slug}/leistungen/${leistung.slug}/`;

/*
 * Der wiederhergestellte Originaltext und die Unterthemen.
 *
 * Beides ist über den Slug angebunden, nicht über den Standort: Der
 * Fachtext zu Zahnimplantaten ist an allen fünf Standorten derselbe – was
 * sich unterscheidet, sind Adresse, Team, Sprechzeiten und Termin, und die
 * stehen ohnehin auf jeder Fassung eigens.
 *
 * Dass der Text noch nicht ortsbezogen ist, ist die verbliebene
 * Redaktionsaufgabe (Kapitel 6 des Berichts). Sie wird nicht dadurch
 * gelöst, dass hier fünf Kopien desselben Absatzes entstehen.
 */
const eigenerText = langtext(leistung.slug);
const themen = unterthemen(leistung.slug);
const ortsname = standort.ortsname;

/* Titel und Description tragen den Ortsbezug – das ist der Unterschied
   zwischen einem generischen Treffer und einem lokalen. */
const titel = `${leistung.name} in ${standort.ort}`;
const description = descriptionKuerzen(
  `${leistung.teaser} Bei KU64 ${standort.name}, ${standort.strasse}, ${standort.plz} ${standort.ort}.`,
);

const verwandte = daten.verwandte(leistung, standort.slug);
const verwandteHier = verwandte.filter((v) => v.amStandort);
const verwandteWoanders = verwandte.filter((v) => !v.amStandort);

/* An welchen anderen Standorten gibt es diese Leistung auch? Wichtig für
   Menschen, denen ein anderer Standort besser passt – und für Suchmaschinen,
   die so das vollständige Bild bekommen. */
const auchAn = daten.standorte.filter(
  (s) => s.slug !== standort.slug && leistung.verfuegbar.includes(s.slug),
);

const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: `KU64 ${standort.name}`, pfad: `/${standort.slug}/` },
  { name: t('krume.leistungen'), pfad: `/${standort.slug}/leistungen/` },
  { name: leistung.name, pfad },
];

const schema = [
  schemaLeistung(leistung, standort),
  schemaFaq(leistung.faq),
  schemaBrotkrumen(brotkrumen),
];
---

<Basis
  titel={titel}
  description={description}
  standort={standort}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={schema}
  ogLeistung={leistung.slug}
  kanonischStatt={
    /* Solange diese Fassung nichts erzählt, was nur an diesem Standort gilt,
       ist sie dieselbe Aussage wie die Hauptseite – und zeigt dorthin.
       Bedingung und Begründung: src/data/standortfassungen.ts */
    fassungIstEigenstaendig(standort.slug, leistung.slug)
      ? undefined
      : `/leistungen/${leistung.slug}/`
  }
>
  <article>
    <header class="kopfbereich abschnitt-eng">
      <div class="huelle">
        <a href={`/${standort.slug}/leistungen/#${kategorie.slug}`} class="marke marke-akzent">
          {kategorie.name}
        </a>

        <h1>{leistung.name} <span class="ort">{t('leistung.inOrt', { ort: ortsname })}</span></h1>

        <p class="teaser">{leistung.teaser}</p>

        {/* Die vier Fragen, die Patientinnen und Patienten zuerst stellen –
            direkt sichtbar, ohne Scrollen und ohne Klick. */}
        {/* Bereichsmotiv – siehe src/data/bildbedarf.ts. */}
        <Bild schluessel={bereichsbild(kategorie.slug)} klasse="kopfbild" vorrang />

        <dl class="eckdaten">
          {
            leistung.dauer && (
              <div>
                <dt>{t('leistung.dauer')}</dt>
                <dd>{leistung.dauer}</dd>
              </div>
            )
          }
          {
            leistung.kosten && (
              <div>
                <dt>{t('leistung.kosten')}</dt>
                <dd>{leistung.kosten}</dd>
              </div>
            )
          }
          <div>
            <dt>Wo</dt>
            <dd>
              KU64 {standort.name}, {standort.strasse}
            </dd>
          </div>
          <div>
            <dt>{t('leistung.termin')}</dt>
            <dd>
              <a href={`/${standort.slug}/termine/`}>{t('leistung.onlineBuchen')}</a>{' '}
              {t('leistung.oder')}{' '}
              <a href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`}>{standort.telefon}</a>
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="huelle inhalt">
      <div class="haupt">
        {/* Die Kassenfrage bekommt einen eigenen, sofort auffindbaren Block –
            sie ist der häufigste Grund, warum jemand eine Praxis anruft. */}
        {
          leistung.kasse && (
            <section class="kasse" aria-labelledby="kasse-titel">
              <h2 id="kasse-titel">{t('leistung.kasse')}</h2>
              <p>{leistung.kasse}</p>
            </section>
          )
        }

        {
          leistung.ablauf && leistung.ablauf.length > 0 && (
            <section class="ablauf" aria-labelledby="ablauf-titel">
              <h2 id="ablauf-titel">{t('leistung.ablauf')}</h2>
              <ol class="schritte">
                {leistung.ablauf.map((schritt, i) => (
                  <li class="einblenden">
                    <div class="schritt-nr" aria-hidden="true">
                      {i + 1}
                    </div>
                    <div class="schritt-text">
                      <h3>
                        {schritt.titel}
                        {schritt.dauer && <span class="schritt-dauer">{schritt.dauer}</span>}
                      </h3>
                      <p>{schritt.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {/*
          Der Originaltext der Praxis.

          Steht VOR den häufigen Fragen und nach Ablauf und Kosten: Wer die
          Seite überfliegt, will zuerst wissen, was es ist, was es kostet und
          wie es abläuft. Wer bleibt, liest weiter. Die FAQ bilden den
          Abschluss, weil sie Einzelfragen aufgreifen – auch solche, die der
          Langtext schon behandelt.
        */}
        {
          eigenerText && (
            <section class="abschnitt-eng" aria-labelledby="ausfuehrlich-titel">
              <h2 id="ausfuehrlich-titel">{t('leistung.ausfuehrlich', { name: leistung.name })}</h2>
              <Langtext langtext={eigenerText} />
            </section>
          )
        }

        {/*
          Die Unterthemen, die eine eigene Seite haben.

          Prominent und nicht als Fußnote: Das sind die Fragen, mit denen
          Menschen mit Behandlungsabsicht suchen – Kosten, Haltbarkeit,
          Alternativen. Auf der alten Website hatten sie eigene Seiten, im
          ersten Neubau waren sie verschwunden. Wer hier landet und „was
          kostet das" wissen will, soll den Weg dorthin sehen, ohne zu
          scrollen.
        */}
        {
          themen.length > 0 && (
            <section class="unterthemen" aria-labelledby="unterthemen-titel">
              <h2 id="unterthemen-titel">{t('leistung.imEinzelnen', { name: leistung.name })}</h2>
              <ul class="unterthemen-liste">
                {themen.map((u) => (
                  <li>
                    <a href={`${pfad}${u.slug}/`} class="unterthema">
                      <span class="unterthema-name">{u.titel ?? u.slug}</span>
                      <span class="unterthema-anriss">{anriss(u, 120)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <FaqBlock
          titel={t('leistung.haeufigeFragen', { name: leistung.name })}
          eintraege={leistung.faq}
        />

        {/* Andere Standorte: nur als Angebot, nie als Umleitung. */}
        {
          auchAn.length > 0 && (
            <section class="auch-an" aria-labelledby="auch-titel">
              <h2 id="auch-titel">{t('leistung.anAnderenStandorten', { name: leistung.name })}</h2>
              <p class="auch-text">
                {t('leistung.sieSehenAngaben', { ort: standort.name })}
              </p>
              <ul class="auch-liste">
                {auchAn.map((s) => (
                  <li>
                    <a href={`/${s.slug}/leistungen/${leistung.slug}/`}>
                      <span class="auch-punkt" style={`background:${s.akzent}`} aria-hidden="true" />
                      <span>
                        <strong>KU64 {s.name}</strong>
                        <small>
                          {s.strasse}, {s.plz} {s.ort}
                        </small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      {/* Seitenspalte: Kontakt bleibt beim Scrollen sichtbar. */}
      <aside class="spalte">
        <div class="spalte-haft">
          <div class="kontaktkarte">
            <p class="kk-titel">KU64 {standort.name}</p>
            <address>
              {standort.strasse}<br />
              {standort.plz} {standort.ort}
            </address>
            <a
              href={`/${standort.slug}/termine/`}
              class="knopf knopf-primaer knopf-gross kk-knopf"
            >
              {t('leistung.terminFuer', { name: leistung.name })}
            </a>
            <a
              href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`}
              class="knopf knopf-sekundaer kk-knopf"
            >
              {standort.telefon}
            </a>
            <p class="kk-hinweis">
              {t('leistung.beraterHinweisVor')}{' '}
              <button class="chat-oeffner" type="button">{t('leistung.beraterHinweisLink')}</button>{' '}
              {t('leistung.beraterHinweisNach', { name: leistung.name })}
            </p>
          </div>

          {
            verwandteHier.length > 0 && (
              <nav class="verwandt" aria-labelledby="verwandt-titel">
                {/* Aus dem Katalog, nicht fest verdrahtet: Der Schlüssel ist
                    da und übersetzt, die globale Fassung dieser Seite nutzt
                    ihn längst – hier stand „Passt dazu" auf Englisch und
                    Französisch mit. */}
                <p class="kk-titel" id="verwandt-titel">{t('leistung.passtDazu')}</p>
                <ul>
                  {verwandteHier.map((v) => (
                    <li>
                      <a href={`/${standort.slug}/leistungen/${v.leistung.slug}/`}>
                        {v.leistung.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </aside>
    </div>

    {/* Verwandte Leistungen, die es hier nicht gibt – transparent ausgewiesen. */}
    {
      verwandteWoanders.length > 0 && (
        <section class="abschnitt weiter">
          <div class="huelle">
            <h2>{t('leistung.ergaenzend')}</h2>
            <p class="weiter-text">
              {t('leistung.ergaenzendText', { name: leistung.name, ort: standort.name })}
            </p>
            {/* Namen statt Teaser – siehe Kommentar auf der globalen Fassung. */}
            <LeistungsListe
              leistungen={verwandteWoanders.map((v) => v.leistung)}
              standortSlug={standort.slug}
              nichtHier
            />
          </div>
        </section>
      )
    }

    {
      behandelnde.length > 0 && (
        <section class="abschnitt flaeche-warm">
          <div class="huelle">
            <h2 class="bh-titel">
              {behandelnde.length === 1
                ? `Ihre Ansprechperson in ${standort.ort}`
                : `Ihre Ansprechpersonen in ${standort.ort}`}
            </h2>
            <div class="bh-liste">
              {behandelnde.map((m) => (
                <a href={`/${standort.slug}/team/${m!.slug}/`} class="bh-karte">
                  <span class="bh-name">{m!.name}</span>
                  {m!.funktion && <span class="bh-funktion">{m!.funktion}</span>}
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <TerminBand slot="abschluss" standort={standort} anlass={leistung.name} />
  </article>
</Basis>

<style>
  .kopfbereich {
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--akzent) 7%, var(--flaeche)),
      var(--flaeche)
    );
    border-bottom: 1px solid var(--linie);
  }

  h1 {
    margin-block: var(--raum-4) var(--raum-4);
    max-width: 20ch;
  }

  .ort {
    display: block;
    font-size: 0.55em;
    font-weight: 500;
    color: var(--tinte-leise);
    letter-spacing: -0.01em;
  }

  .teaser {
    max-width: var(--breite-text);
    font-size: var(--t-lg);
    line-height: var(--zeile-weit);
    color: var(--tinte-weich);
  }

  .kopfbild {
    margin-block: var(--raum-6) 0;
    max-width: 46rem;
  }

  .bh-titel {
    font-size: var(--t-xl);
    margin-block-end: var(--raum-5);
  }

  .bh-liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--raum-4);
    max-width: 52rem;
  }

  .bh-karte {
    display: grid;
    gap: var(--raum-1);
    padding: var(--raum-5);
    border-radius: var(--radius-l);
    border: 1px solid var(--linie);
    background: var(--flaeche);
    text-decoration: none;
    color: inherit;
  }

  .bh-karte:hover {
    border-color: var(--akzent);
  }

  .bh-name {
    font-weight: 600;
  }

  .bh-funktion {
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
  }

  .eckdaten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--raum-4);
    margin-block-start: var(--raum-6);
    padding-block-start: var(--raum-5);
    border-top: 1px solid var(--linie);
  }

  .eckdaten dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinte-leise);
    margin-block-end: 2px;
  }

  .eckdaten dd {
    margin: 0;
    font-size: var(--t-sm);
    line-height: var(--zeile-normal);
    color: var(--tinte);
  }

  .inhalt {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--raum-8);
    padding-block: var(--raum-8);
    align-items: start;
  }

  .haupt > section + section {
    margin-block-start: var(--raum-8);
  }

  /* ── Kassenblock ── */

  .kasse {
    padding: var(--raum-5) var(--raum-6);
    background: var(--info-flaeche);
    border-radius: var(--radius-lg);
  }

  .kasse h2 {
    font-size: var(--t-lg);
    margin-block-end: var(--raum-2);
  }

  .kasse p {
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
    max-width: var(--breite-text);
  }

  /* ── Ablauf ── */

  .schritte {
    list-style: none;
    padding: 0;
    counter-reset: schritt;
    margin-block-start: var(--raum-5);
  }

  .schritte li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--raum-4);
    padding-block: var(--raum-4);
    position: relative;
  }

  /* Verbindungslinie zwischen den Schritten. */
  .schritte li:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-inline-start: 1.125rem;
    top: 3.25rem;
    bottom: -0.25rem;
    width: 1px;
    background: var(--linie-stark);
  }

  .schritt-nr {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--knopf-flaeche);
    color: var(--knopf-schrift);
    font-weight: 700;
    font-size: var(--t-sm);
    flex-shrink: 0;
  }

  .schritt-text h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--raum-3);
    font-size: var(--t-lg);
    margin-block-end: var(--raum-2);
  }

  .schritt-dauer {
    font-family: var(--schrift-text);
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--tinte-leise);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-voll);
    background: var(--flaeche-warm-2);
  }

  .schritt-text p {
    color: var(--tinte-weich);
    max-width: var(--breite-text);
  }

  /* ── Andere Standorte ── */

  .auch-an {
    padding: var(--raum-6);
    background: var(--flaeche-warm);
    border-radius: var(--radius-lg);
  }

  .auch-an h2 {
    font-size: var(--t-xl);
  }

  .auch-text {
    margin-block: var(--raum-3) var(--raum-4);
    color: var(--tinte-weich);
    max-width: var(--breite-text);
  }

  .auch-liste {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--raum-2);
  }

  .auch-liste a {
    display: flex;
    align-items: center;
    gap: var(--raum-3);
    padding: var(--raum-3) var(--raum-4);
    background: var(--flaeche);
    border: 1px solid var(--linie);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--zeit-schnell) var(--kurve);
  }

  .auch-liste a:hover {
    border-color: var(--akzent-schrift);
  }

  .auch-punkt {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .auch-liste strong {
    display: block;
    font-size: var(--t-sm);
  }

  .auch-liste small {
    color: var(--tinte-leise);
  }

  /* ── Seitenspalte ── */

  .spalte-haft {
    position: sticky;
    top: 7.5rem;
    display: grid;
    gap: var(--raum-5);
  }

  .kontaktkarte {
    padding: var(--raum-5);
    border: 1px solid var(--linie);
    border-radius: var(--radius-lg);
    background: var(--flaeche);
    box-shadow: var(--schatten-sm);
  }

  .kk-titel {
    font-family: var(--schrift-titel);
    font-size: var(--t-md);
    font-weight: 600;
    margin-block-end: var(--raum-2);
  }

  .kontaktkarte address {
    font-style: normal;
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
    margin-block-end: var(--raum-4);
  }

  .kk-knopf {
    display: flex;
    width: 100%;
    text-align: center;
  }

  .kk-knopf + .kk-knopf {
    margin-block-start: var(--raum-2);
  }

  .kk-hinweis {
    margin-block-start: var(--raum-4);
    padding-block-start: var(--raum-4);
    border-top: 1px solid var(--linie);
    font-size: var(--t-xs);
    line-height: var(--zeile-normal);
    color: var(--tinte-leise);
  }

  .chat-oeffner {
    color: var(--akzent-schrift);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    padding: 0;
  }

  .verwandt ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--raum-2);
  }

  .verwandt a {
    display: block;
    padding: var(--raum-2) var(--raum-3);
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    text-decoration: none;
