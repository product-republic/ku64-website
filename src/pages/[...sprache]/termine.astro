---
/**
 * Terminbuchung – die allgemeine Seite.
 *
 * Sie war bis eben eine reine Standortabfrage mit 79 Wörtern. Dieselben vier
 * allgemeinen Fragen – wie buche ich, was bei Schmerzen, kann ich absagen,
 * was mitbringen – standen dafür wortgleich auf allen vier Standortseiten.
 * Gemessen waren dort 306 von 339 Wörtern identisch.
 *
 * Jetzt umgekehrt: Was überall gleich gilt, steht hier. Was sich je Standort
 * unterscheidet – Kalender, Sprechzeiten, Telefonnummer, Anfahrt –, steht auf
 * der Standortseite. Beide Seiten gewinnen dadurch: diese bekommt Substanz,
 * jene verliert die Wiederholung.
 */
import { sprachpfade } from '../../i18n/sprachen';
import { spracheAusParameter } from '../../i18n/sprachen';
import { texte } from '../../i18n/katalog';
import Basis from '../../layouts/Basis.astro';
import Standortwahl from '../../components/Standortwahl.astro';
import { STANDORTE } from '../../data/standorte';
import { schemaBrotkrumen, schemaFaq } from '../../lib/seo';

const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

export function getStaticPaths() {
  return sprachpfade();
}

const pfad = '/termine/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.termine'), pfad },
];

/* Die Fragen, die an jedem Standort dieselbe Antwort haben. Standortabhängige
   Fragen stehen bewusst NICHT hier, sondern dort, wo sie gelten. */
const faq = [
  {
    frage: 'Wie buche ich einen Termin bei KU64?',
    antwort:
      'Online über den Terminkalender Ihres Standorts oder telefonisch. Beides führt zum selben Kalender – es gibt keine getrennten Kontingente. Für die Online-Buchung brauchen Sie nur wenige Angaben; den Anamnesebogen füllen Sie danach digital aus.',
  },
  {
    frage: 'Kann ich einen Termin wieder absagen oder verschieben?',
    antwort:
      'Ja. Bitte sagen Sie spätestens 24 Stunden vorher ab – telefonisch oder über den Link in Ihrer Bestätigungsmail. So kann jemand anderes den Termin bekommen, und das ist bei einer ausgebuchten Praxis der eigentliche Grund für die Frist.',
  },
  {
    frage: 'Was muss ich zum ersten Termin mitbringen?',
    antwort:
      'Ihre Versichertenkarte, gegebenenfalls Bonusheft und Allergiepass sowie eine Liste Ihrer Medikamente. Wichtig sind vor allem Blutverdünner, Bisphosphonate, ein Herzklappenersatz, Diabetes, eine Schwangerschaft und Allergien gegen Betäubungsmittel – diese Angaben ändern die Behandlung.',
  },
  {
    frage: 'Was mache ich bei starken Schmerzen?',
    antwort:
      'Rufen Sie den Standort an, statt online zu buchen. Wir halten an jedem Standort Zeiten für Schmerzpatientinnen und -patienten frei und können am Telefon einschätzen, wie dringend es ist. Außerhalb der Sprechzeiten hilft die Notfallseite weiter.',
  },
  {
    id: 'doctolib',
    frage: 'Warum werde ich zu Doctolib weitergeleitet?',
    antwort:
      'Der Kalender liegt bei Doctolib, einem eigenständigen Dienst. Wir betten ihn bewusst nicht in diese Seite ein – so werden beim bloßen Lesen keine Daten an Dritte übertragen. Erst wenn Sie den Kalender öffnen, werden Ihre IP-Adresse übermittelt und Cookies gesetzt.',
  },
  {
    frage: 'Kann ich auch ohne Online-Portal einen Termin bekommen?',
    antwort:
      'Ja, jederzeit telefonisch oder per E-Mail. Die Online-Buchung ist ein Angebot, keine Voraussetzung – die Nummer Ihres Standorts steht auf dessen Terminseite.',
  },
];
---

<Basis
  titel={t('terminez.terminBuchen')}
  description={t('terminez.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen), schemaFaq(faq)]}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>{t('terminez.terminBuchen')}</h1>
      <Standortwahl ziel="termine" titel={t('terminez.anWelchemStandort')} />
    </div>
  </section>

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>Warum zuerst der Standort</h2>
      <p class="abschnitt-text">
        Sprechzeiten, Telefonnummern und das Angebot unterscheiden sich je
        Praxis. Am Kurfürstendamm gibt es zwei getrennte Kalender – einen für
        Zahnmedizin, einen für Kieferorthopädie –, in Potsdam wird am
        Wochenende nach Vereinbarung behandelt, in der KiezPraxis enden
        Dienstag und Donnerstag mittags. Ein gemeinsamer Kalender für alle vier
        Häuser würde diese Unterschiede verdecken und Termine erzeugen, die
        niemandem helfen.
      </p>

      <ul class="liste-schlicht">
        {
          STANDORTE.map((s) => (
            <li>
              <a href={`/${s.slug}/termine/`}>
                Termin bei KU64 {s.name}
              </a>{' '}
              <span class="klein">
                {s.strasse}, {s.plz} {s.ort} · {s.telefon}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="huelle">
    <section class="faq-bereich">
      <h2>Fragen zur Terminbuchung</h2>
      {
        faq.map((f) => (
          <details id={f.id}>
            <summary>{f.frage}</summary>
            <p>{f.antwort}</p>
          </details>
        ))
      }
    </section>
  </div>
</Basis>

<style>
  .liste-schlicht {
    list-style: none;
    margin: var(--raum-m) 0 0;
    padding: 0;
    display: grid;
    gap: var(--raum-xs);
  }

  .liste-schlicht li {
    border-top: 1px solid color-mix(in oklab, var(--tinte) 12%, transparent);
    padding-top: var(--raum-xs);
  }
</style>
