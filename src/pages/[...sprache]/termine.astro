---
import { sprachpfade } from '../../i18n/sprachen';
import { spracheAusParameter } from '../../i18n/sprachen';
import { texte } from '../../i18n/katalog';
import Basis from '../../layouts/Basis.astro';
import Standortwahl from '../../components/Standortwahl.astro';
import { schemaBrotkrumen } from '../../lib/seo';

const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

export function getStaticPaths() {
  return sprachpfade();
}

const pfad = '/termine/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: 'Termine', pfad },
];
---

<Basis
  titel="Termin buchen"
  description="Online-Termin bei KU64 – wählen Sie Ihren Standort in Berlin oder Potsdam."
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>Termin buchen</h1>
      <Standortwahl ziel="termine" titel="An welchem Standort möchten Sie einen Termin?" />
    </div>
  </section>
</Basis>
