---
/**
 * Terminbuchung – die allgemeine Seite.
 *
 * Sie war bis eben eine reine Standortabfrage mit 79 Wörtern. Dieselben vier
 * allgemeinen Fragen – wie buche ich, was bei Schmerzen, kann ich absagen,
 * was mitbringen – standen dafür wortgleich auf allen vier Standortseiten.
 * Gemessen waren dort 306 von 339 Wörtern identisch.
 *
 * Jetzt umgekehrt: Was überall gleich gilt, steht hier. Was sich je Standort
 * unterscheidet – Kalender, Sprechzeiten, Telefonnummer, Anfahrt –, steht auf
 * der Standortseite. Beide Seiten gewinnen dadurch: diese bekommt Substanz,
 * jene verliert die Wiederholung.
 */
import { sprachpfade } from '../../i18n/sprachen';
import { spracheAusParameter } from '../../i18n/sprachen';
import { texte } from '../../i18n/katalog';
import Basis from '../../layouts/Basis.astro';
import Standortwahl from '../../components/Standortwahl.astro';
import { STANDORTE } from '../../data/standorte';
import { schemaBrotkrumen, schemaFaq } from '../../lib/seo';

const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

export function getStaticPaths() {
  return sprachpfade();
}

const pfad = '/termine/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.termine'), pfad },
];

/* Die Fragen, die an jedem Standort dieselbe Antwort haben. Standortabhängige
   Fragen stehen bewusst NICHT hier, sondern dort, wo sie gelten. */
/*
 * Häufige Fragen zur Terminbuchung – Text aus dem Katalog.
 *
 * Die `id` bleibt eine Kennung und keine Anzeige: Auf sie zeigt ein
 * Sprunganker von der Doctolib-Schaltfläche, und Anker sind in jeder Sprache
 * dieselben.
 */
const faq = [
  { frage: t('faq.termine.buchen.frage'), antwort: t('faq.termine.buchen.antwort') },
  { frage: t('faq.termine.absagen.frage'), antwort: t('faq.termine.absagen.antwort') },
  { frage: t('faq.termine.mitbringen.frage'), antwort: t('faq.termine.mitbringen.antwort') },
  {
    frage: t('faq.termine.starkeSchmerzen.frage'),
    antwort: t('faq.termine.starkeSchmerzen.antwort'),
  },
  {
    id: 'doctolib',
    frage: t('faq.termine.doctolib.frage'),
    antwort: t('faq.termine.doctolib.antwort'),
  },
  { frage: t('faq.termine.ohnePortal.frage'), antwort: t('faq.termine.ohnePortal.antwort') },
];
---

<Basis
  titel={t('terminez.terminBuchen')}
  description={t('terminez.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen), schemaFaq(faq)]}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>{t('terminez.terminBuchen')}</h1>
      <Standortwahl ziel="termine" titel={t('terminez.anWelchemStandort')} />
    </div>
  </section>

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>Warum zuerst der Standort</h2>
      <p class="abschnitt-text">
        Sprechzeiten, Telefonnummern und das Angebot unterscheiden sich je
        Praxis. Am Kurfürstendamm gibt es zwei getrennte Kalender – einen für
        Zahnmedizin, einen für Kieferorthopädie –, in Potsdam wird am
        Wochenende nach Vereinbarung behandelt, in der KiezPraxis enden
        Dienstag und Donnerstag mittags. Ein gemeinsamer Kalender für alle vier
        Häuser würde diese Unterschiede verdecken und Termine erzeugen, die
        niemandem helfen.
      </p>

      <ul class="liste-schlicht">
        {
          STANDORTE.map((s) => (
            <li>
              <a href={`/${s.slug}/termine/`}>
                Termin bei KU64 {s.name}
              </a>{' '}
              <span class="klein">
                {s.strasse}, {s.plz} {s.ort} · {s.telefon}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="huelle">
    <section class="faq-bereich">
      <h2>Fragen zur Terminbuchung</h2>
      {
        faq.map((f) => (
          <details id={f.id}>
            <summary>{f.frage}</summary>
            <p>{f.antwort}</p>
          </details>
        ))
      }
    </section>
  </div>
</Basis>

<style>
  .liste-schlicht {
    list-style: none;
    margin: var(--raum-m) 0 0;
    padding: 0;
    display: grid;
    gap: var(--raum-xs);
  }

  .liste-schlicht li {
    border-top: 1px solid color-mix(in oklab, var(--tinte) 12%, transparent);
    padding-top: var(--raum-xs);
  }
</style>
