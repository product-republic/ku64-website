---
import { sprachpfade } from '../../i18n/sprachen';
import { spracheAusParameter } from '../../i18n/sprachen';
import { texte } from '../../i18n/katalog';
import Basis from '../../layouts/Basis.astro';
import Standortwahl from '../../components/Standortwahl.astro';
import { schemaBrotkrumen } from '../../lib/seo';

const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

export function getStaticPaths() {
  return sprachpfade();
}

const pfad = '/termine/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.termine'), pfad },
];
---

<Basis
  titel={t('terminez.terminBuchen')}
  description={t('terminez.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>{t('terminez.terminBuchen')}</h1>
      <Standortwahl ziel="termine" titel={t('terminez.anWelchemStandort')} />
    </div>
  </section>
</Basis>
