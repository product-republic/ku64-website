---
/**
 * Standortübergreifende Leistungsseite.
 *
 * Diese Seite ist ein Wegweiser, KEIN Ersatz für die Standortseite: Sie
 * erklärt die Leistung allgemein und führt dann sofort zu dem Standort,
 * an dem man sie bekommt. Damit bleibt die alte URL-Struktur /leistungen/…
 * erhalten – es entstehen keine toten Links aus Suchergebnissen und Backlinks –
 * ohne den Fehler zu wiederholen, dass Leistungen ortlos beschrieben werden.
 */
import { inhalte } from '../../../i18n/daten';
import { texte } from '../../../i18n/katalog';
import { mitSprachen } from '../../../i18n/sprachen';
import Basis from '../../../layouts/Basis.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import Langtext from '../../../components/Langtext.astro';
import { langtext, unterthemen, anriss } from '../../../lib/langtexte';
import Bild from '../../../components/Bild.astro';
import LeistungsListe from '../../../components/LeistungsListe.astro';
import { LEISTUNGEN } from '../../../data/leistungen';
import { veroeffentlichbar } from '../../../data/team';
import { beschwerdenZuBehandlung } from '../../../data/beschwerden';
import { bereichsbild } from '../../../data/bildbedarf';
import { schemaFaq, schemaBrotkrumen, descriptionKuerzen, kanonisch } from '../../../lib/seo';

export function getStaticPaths() {
  return mitSprachen(LEISTUNGEN.map((l) => ({ params: { leistung: l.slug } })));
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const leistung = daten.leistung(Astro.params.leistung!)!;
const kategorie = daten.kategorie(leistung.kategorie)!;
const pfad = `/leistungen/${leistung.slug}/`;

const wo = daten.standorte.filter((s) => leistung.verfuegbar.includes(s.slug));
const nicht = daten.standorte.filter((s) => !leistung.verfuegbar.includes(s.slug));

const beschwerden = beschwerdenZuBehandlung(leistung.slug);

/*
 * Der Originaltext gehört auf DIESE Seite, nicht nur auf die Standortfassungen.
 *
 * Sie ist die kanonische: Die fünf Standortfassungen zeigen mit ihrem
 * Canonical hierher, also ist das die Seite, die Google bewertet. Ein erster
 * Versuch hatte den Langtext nur an die Standortfassungen gehängt – gemessen
 * standen dann auf /leistungen/zahnimplantate/ 513 Wörter, während 3.169 an
 * fünf Adressen lagen, die alle hierher verweisen. Genau der Fehler, den die
 * Wiederherstellung beheben soll, nur eine Ebene höher.
 */
const eigenerText = langtext(leistung.slug, daten.sprache);
const themen = unterthemen(leistung.slug, daten.sprache);

/*
 * Wer die Behandlung durchführt.
 *
 * Nur wenige Leistungen führen das Feld – siehe Kommentar in
 * leistungen.ts. Wo es steht, ist es die Antwort auf die Frage, die auf
 * dieser Seite sonst offen bliebe: „Wer macht das bei euch?"
 */
const behandelnde = (leistung.behandler ?? [])
  .map((slug) => veroeffentlichbar().find((m) => m.slug === slug))
  .filter((m) => m !== undefined);

const verwandte = leistung.related
  .map((s) => daten.leistung(s))
  .filter((l): l is NonNullable<typeof l> => Boolean(l));

const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.leistungen'), pfad: '/leistungen/' },
  { name: leistung.name, pfad },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalProcedure',
    name: leistung.name,
    alternateName: leistung.synonyme,
    description: leistung.teaser,
    url: kanonisch(pfad),
    // Der Ortsbezug hängt an den einzelnen Standorten, nicht an dieser Seite.
    availableAtOrFrom: wo.map((s) => ({ '@id': kanonisch(`/${s.slug}/`) + '#praxis' })),
  },
  schemaFaq(leistung.faq),
  schemaBrotkrumen(brotkrumen),
];
---

<Basis
  titel={leistung.name}
  description={descriptionKuerzen(
    `${leistung.teaser} ${t('leistung.verfuegbarAn')}: ${t('leistung.vonStandorten', { wo: wo.length, gesamt: daten.standorte.length })}.`,
  )}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={schema}
  ogLeistung={leistung.slug}
>
  <section class="kopf abschnitt-eng">
    <div class="huelle">
      <a href={`/leistungen/#${kategorie.slug}`} class="marke marke-akzent">{kategorie.name}</a>
      <h1>{leistung.name}</h1>
      <p class="teaser">{leistung.teaser}</p>

      {/*
        Ein Bild je Bereich, nicht je Leistung.

        35 Leistungen einzeln zu bebildern hieße 35 Fototermine, und im
        Bild unterscheidet sich eine professionelle Zahnreinigung nicht von
        einer Prophylaxe 4.0. Solange das Foto fehlt, steht hier ein
        benannter Platzhalter statt einer leeren Stelle – siehe
        src/data/bildbedarf.ts.
      */}
      <Bild schluessel={bereichsbild(kategorie.slug)} klasse="kopfbild" vorrang />

      <dl class="eckdaten">
        {leistung.dauer && <div><dt>{t('leistung.dauer')}</dt><dd>{leistung.dauer}</dd></div>}
        {leistung.kosten && <div><dt>{t('leistung.kosten')}</dt><dd>{leistung.kosten}</dd></div>}
        <div>
          <dt>{t('leistung.verfuegbarAn')}</dt>
          <dd>{t('leistung.vonStandorten', { wo: wo.length, gesamt: daten.standorte.length })}</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* Die eigentliche Aufgabe dieser Seite: zum richtigen Standort führen. */}
  <section class="abschnitt wahl">
    <div class="huelle">
      <h2>{t('leistung.woLassen', { name: leistung.name.toLowerCase() })}</h2>
      <p class="unter">
        {t('leistung.standortWaehlen')}
      </p>

      <div class="raster">
        {
          wo.map((s) => (
            <a class="karte karte-klickbar ort" href={`/${s.slug}/leistungen/${leistung.slug}/`}
               style={`--akzent:${s.akzent}`}>
              <h3>KU64 {s.name}</h3>
              <address>{s.strasse}, {s.plz} {s.ort}</address>
              <p class="tel">{s.telefon}</p>
              <span class="mehr">
                {t('leistung.hierAnsehen', { name: leistung.name })}
                <svg viewBox="0 0 16 12" width="15" height="11" aria-hidden="true">
                  <path d="M1 6h13M9.5 1.5 14 6l-4.5 4.5" fill="none" stroke="currentColor"
                        stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      {
        nicht.length > 0 && (
          <p class="nicht-hinweis">
            <strong>{t('leistung.nichtAngebotenAn')}</strong>{' '}
            {nicht.map((s) => `KU64 ${s.name}`).join(', ')}.{' '}
            {t('leistung.nichtAngebotenHinweis')}
          </p>
        )
      }
    </div>
  </section>

  <div class="huelle abschnitt">
    <div class="fliesstext">
      {leistung.kasse && (
        <>
          <h2>{t('leistung.kasse')}</h2>
          <p>{leistung.kasse}</p>
        </>
      )}

      {
        leistung.ablauf && leistung.ablauf.length > 0 && (
          <>
            <h2>{t('leistung.ablauf')}</h2>
            <ol>
              {leistung.ablauf.map((a) => (
                <li>
                  <strong>{a.titel}</strong> – {a.text}
                  {a.dauer && <> ({a.dauer})</>}
                </li>
              ))}
            </ol>
          </>
        )
      }

      <h2>{t('leistung.synonyme')}</h2>
      <p>{leistung.synonyme.join(' · ')}</p>
    </div>

    {
      eigenerText && (
        <section class="ausfuehrlich" aria-labelledby="ausfuehrlich-titel">
          <h2 id="ausfuehrlich-titel">{t('leistung.ausfuehrlich', { name: leistung.name })}</h2>
          <Langtext langtext={eigenerText} sprache={daten.sprache} />
        </section>
      )
    }

    {
      themen.length > 0 && (
        <section class="unterthemen" aria-labelledby="unterthemen-titel">
          <h2 id="unterthemen-titel">{t('leistung.imEinzelnen', { name: leistung.name })}</h2>
          <ul class="unterthemen-liste">
            {themen.map((u) => (
              <li>
                <a href={`/leistungen/${leistung.slug}/${u.slug}/`}>
                  <span class="unterthema-name">{u.titel ?? u.slug}</span>
                  <span class="unterthema-anriss">{anriss(u, 120)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <FaqBlock titel={t('leistung.haeufigeFragen', { name: leistung.name })} eintraege={leistung.faq} />
  </div>

  {
    verwandte.length > 0 && (
      <section class="abschnitt flaeche-warm">
        <div class="huelle">
          <h2>{t('leistung.passtDazu')}</h2>
          {/*
            Namen statt Teaser – aus demselben Grund wie auf der Standortseite.

            Die Karte gab den Teaser der verwandten Leistung aus. Damit stand
            auf der Seite zum 3D-Röntgen der Einleitungstext des Knochenaufbaus,
            auf der zum Bleaching der von Veneers, und so weiter. Gemessen
            lagen dadurch Seiten zu VÖLLIG VERSCHIEDENEN Themen bei 36 Prozent
            Textgleichheit – ohne dass sie inhaltlich etwas gemeinsam hätten.

            Ein Verweis braucht den Namen und das Ziel. Was die verwandte
            Leistung ist, steht auf ihrer eigenen Seite.
          */}
          <LeistungsListe leistungen={verwandte} standortSlug={null} />
        </div>
      </section>
    )
  }

  {
    behandelnde.length > 0 && (
      <section class="abschnitt flaeche-warm">
        <div class="huelle">
          <h2 class="bh-titel">
            {behandelnde.length === 1 ? t('leistung.ansprechperson') : t('leistung.ansprechpersonen')}
          </h2>
          <div class="bh-liste">
            {behandelnde.map((m) => {
              /* Der Standort im Verweis ist der, an dem die Person arbeitet –
                 sonst führt der Klick auf eine Seite, die es nicht gibt. */
              const wo = m!.standorte[0]!;
              const ort = daten.standorte.find((s) => s.slug === wo);
              return (
                <a href={`/${wo}/team/${m!.slug}/`} class="bh-karte">
                  <span class="bh-name">{m!.name}</span>
                  {m!.funktion && <span class="bh-funktion">{m!.funktion}</span>}
                  {ort && <span class="bh-ort">KU64 {ort.name}</span>}
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  {
    beschwerden.length > 0 && (
      /*
       * Der Rückweg. Die Beschwerdeseiten verweisen hierher, weil jemand mit
       * einem Symptom sucht – hier steht die Gegenrichtung, für alle, die
       * über den Fachbegriff gekommen sind und wissen wollen, ob das ihr
       * Problem überhaupt ist. Beide Richtungen zusammen machen aus zwei
       * Listen ein Netz.
       */
      <section class="abschnitt-eng">
        <div class="huelle">
          <h2 class="fuehrt-titel">{t('leistung.beschwerdenHierher')}</h2>
          <ul class="fuehrt">
            {beschwerden.map((b) => (
              <li>
                <a href={`/zahnbeschwerden/${b.slug}/`}>{b.titel}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Basis>

<style>
  .bh-titel {
    font-size: var(--t-xl);
    margin-block-end: var(--raum-5);
  }

  .bh-liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--raum-4);
    max-width: 52rem;
  }

  .bh-karte {
    display: grid;
    gap: var(--raum-1);
    padding: var(--raum-5);
    border-radius: var(--radius-l);
    border: 1px solid var(--linie);
    background: var(--flaeche);
    text-decoration: none;
    color: inherit;
  }

  .bh-karte:hover {
    border-color: var(--akzent);
  }

  .bh-name {
    font-weight: 600;
  }

  .bh-funktion {
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
  }

  .bh-ort {
    font-size: var(--t-xs);
    color: var(--tinte-leise);
    margin-block-start: var(--raum-2);
  }

  .fuehrt-titel {
    font-size: var(--t-lg);
    margin-block-end: var(--raum-4);
  }

  .fuehrt {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--raum-2) var(--raum-3);
  }

  .fuehrt a {
    display: inline-block;
    padding: var(--raum-2) var(--raum-4);
    border-radius: var(--radius-l);
    border: 1px solid var(--linie);
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    text-decoration: none;
  }

  .fuehrt a:hover {
    border-color: var(--akzent);
    color: var(--tinte);
  }

  .kopfbild {
    margin-block: var(--raum-6) 0;
    max-width: 46rem;
  }

  .kopf {
    background: linear-gradient(to bottom, color-mix(in oklab, var(--akzent) 7%, var(--flaeche)), var(--flaeche));
    border-bottom: 1px solid var(--linie);
  }
  h1 { margin-block: var(--raum-4); max-width: 18ch; }
  .teaser { max-width: var(--breite-text); font-size: var(--t-lg); color: var(--tinte-weich); line-height: var(--zeile-weit); }
  .eckdaten {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr)); gap: var(--raum-4);
    margin-block-start: var(--raum-6); padding-block-start: var(--raum-5); border-top: 1px solid var(--linie);
  }
  .eckdaten dt { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tinte-leise); }
  .eckdaten dd { margin: 2px 0 0; font-size: var(--t-sm); }
  .wahl { background: transparent; }
  .unter { max-width: var(--breite-text); margin-block: var(--raum-3) var(--raum-6); color: var(--tinte-weich); }
  .ort { text-decoration: none; overflow: hidden; padding-block-start: calc(var(--raum-5) + 4px); }
  /* Das gelbe Band über der Karte ist entfallen – siehe Standortwahl.astro:
     Eine Auszeichnung auf jeder Karte zeichnet keine aus. */
  .ort h3 { font-size: var(--t-lg); }
  .ort address { font-style: normal; margin-block: var(--raum-2); font-size: var(--t-sm); color: var(--tinte-leise); }
  .tel { font-size: var(--t-sm); font-weight: 600; margin-block-end: var(--raum-4); }
  .mehr { display: inline-flex; align-items: center; gap: var(--raum-2); margin-block-start: auto; font-size: var(--t-sm); font-weight: 600; color: var(--akzent-schrift); }
  .ort:hover .mehr svg { transform: translateX(3px); }
  .mehr svg { transition: transform var(--zeit) var(--kurve); }
  .nicht-hinweis {
    margin-block-start: var(--raum-6); padding: var(--raum-4);
    border-radius: var(--radius); background: var(--flaeche-warm);
    font-size: var(--t-sm); color: var(--tinte-weich); max-width: var(--breite-text);
  }
  .flaeche-warm { background: var(--flaeche-warm); border-block: 1px solid var(--linie); }

  .ausfuehrlich,
  .unterthemen {
    margin-block-start: var(--raum-8, 2.5rem);
  }

  .unterthemen-liste {
    list-style: none;
    margin: var(--raum-4, 1rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .unterthemen-liste a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--linie);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
  }

  .unterthemen-liste a:hover,
  .unterthemen-liste a:focus-visible {
    border-color: var(--akzent);
  }

  .unterthema-name {
    font-weight: 650;
    line-height: 1.3;
    /* Unterstrichen, damit der Verweis nicht nur an der Farbe hängt. */
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .unterthema-anriss {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--tinte-weich);
  }
</style>
