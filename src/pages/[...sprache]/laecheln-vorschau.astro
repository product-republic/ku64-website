---
/**
 * Lächeln-Vorschau. Bewusst mit sehr klarer Aufklärung vor dem Upload –
 * ein Gesichtsfoto ist ein sensibles Datum, und die Einwilligung muss
 * informiert sein, nicht weggeklickt.
 */
import { inhalte } from '../../i18n/daten';
import { texte } from '../../i18n/katalog';
import { sprachpfade } from '../../i18n/sprachen';
import Basis from '../../layouts/Basis.astro';
import { schemaBrotkrumen, schemaFaq } from '../../lib/seo';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const pfad = '/laecheln-vorschau/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.laechelnVorschau'), pfad },
];

/* Häufige Fragen zur Lächeln-Vorschau – Text aus dem Katalog. */
const faq = [
  {
    frage: t('faq.laecheln.fotoGespeichert.frage'),
    antwort: t('faq.laecheln.fotoGespeichert.antwort'),
  },
  { frage: t('faq.laecheln.versprechen.frage'), antwort: t('faq.laecheln.versprechen.antwort') },
  { frage: t('faq.laecheln.welchesFoto.frage'), antwort: t('faq.laecheln.welchesFoto.antwort') },
  { frage: t('faq.laecheln.werSiehtEs.frage'), antwort: t('faq.laecheln.werSiehtEs.antwort') },
  { frage: t('faq.laecheln.fuerKind.frage'), antwort: t('faq.laecheln.fuerKind.antwort') },
];
---

<Basis
  titel="Lächeln-Vorschau"
  description={t('laecheln.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen), schemaFaq(faq)]}
>
  <section class="kopf abschnitt-eng">
    <div class="huelle">
      <span class="marke marke-akzent">{t('laecheln.unverbindlicheVisualisierung')}</span>
      <h1>{t('laecheln.sehenSieIhrLaecheln')}</h1>
      <p class="unter">{t('laecheln.ladenSieEinPortraetfoto')}</p>

      <div class="hinweis hinweis-warnung wichtig">
        <strong>{t('laecheln.dasIstKeinBehandlungsergebnis')}</strong>{t('laecheln.dieDarstellungIstEine')}</div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="huelle spalten">
      <form id="formular" class="formular">
        {/* Schritt 1 */}
        <fieldset class="schritt">
          <legend><span class="nr">1</span>{t('laecheln.fotoAuswaehlen')}</legend>

          <div class="ablage" id="ablage" tabindex="0" role="button"
               aria-label={t('laecheln.fotoWaehlen')}>
            <input type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp" required hidden />
            <div class="ablage-leer" id="ablageLeer">
              <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
                <path d="M4 22V8a2 2 0 0 1 2-2h20a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"
                      fill="none" stroke="currentColor" stroke-width="1.6" />
                <circle cx="11" cy="13" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="m4 20 7-6 6 5 4-3 7 6" fill="none" stroke="currentColor" stroke-width="1.6"
                      stroke-linejoin="round" />
              </svg>
              <p><strong>{t('laecheln.fotoHierherZiehen')}</strong>{t('laecheln.oderKlickenZumAuswaehlen')}</p>
              <p class="klein">{t('laecheln.jpegPngOderWebp')}</p>
            </div>
            <img id="vorschau" alt="Ihr hochgeladenes Foto" hidden />
            <button type="button" class="ablage-weg" id="ablageWeg" hidden aria-label="Foto entfernen">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </button>
          </div>

          <details class="tipps">
            <summary>{t('laecheln.wasMachtEinGutes')}</summary>
            <ul>
              <li>{t('laecheln.frontalInDieKamera')}</li>
              <li>{t('laecheln.deutlichLaechelnSodassDie')}</li>
              <li>{t('laecheln.gleichmaessigesLichtKeinHartes')}</li>
              <li>{t('laecheln.keineFilterKeineBeauty')}</li>
              <li>{t('laecheln.nichtsVorDemMund')}</li>
            </ul>
          </details>
        </fieldset>

        {/* Schritt 2 */}
        <fieldset class="schritt">
          <legend><span class="nr">2</span>{t('laecheln.wohinDuerfenWirDas')}</legend>

          <label class="feld">
            <span>E-Mail-Adresse</span>
            <input type="email" name="email" id="email" required autocomplete="email"
                   placeholder={t('laecheln.adressePlatzhalter')} />
          </label>

          <label class="feld">
            <span>{t('laecheln.ihrWunschstandort')}<em>(freiwillig)</em></span>
            <select name="standort" id="standort">
              <option value="">{t('laecheln.nochNichtEntschieden')}</option>
              {daten.standorte.map((s) => <option value={s.slug}>KU64 {s.name} – {s.ort}</option>)}
            </select>
          </label>

          {/*
            Der Standort aus der Adresse übernehmen.

            Wer über das Band auf einer Standortseite hierher kommt, hat den
            Ort schon gewählt – ihn erneut zu fragen wäre eine Frage, deren
            Antwort man kennt. Die Auswahl bleibt frei: Es ist eine
            Vorbelegung, keine Festlegung, und das Feld ist ohnehin
            freiwillig.

            Als eingebettetes Skript und nicht als Modul, weil es beim Aufbau
            laufen muss – ein nachgeladenes Modul setzte das Feld erst, wenn
            jemand vielleicht schon etwas anderes gewählt hat.

            ACHTUNG: `is:inline` gibt den Inhalt WÖRTLICH aus. Die
            Astro-Schreibweise mit geschweifter Klammer und Backtick landet
            als Text im HTML und ergibt gültiges JavaScript, das nichts tut –
            lautlos. `skripte-pruefen.mjs` sucht danach.
          */}
          <script is:inline data-astro-rerun>
            (() => {
              const feld = document.getElementById('standort');
              if (!feld) return;
              const wunsch = new URLSearchParams(location.search).get('standort');
              if (!wunsch) return;
              /* Nur setzen, wenn es die Auswahl wirklich gibt – ein
                 erfundener Wert würde das Feld auf leer zurückfallen lassen
                 und sähe wie ein Fehler der Seite aus. */
              const gibtEs = [...feld.options].some((o) => o.value === wunsch);
              if (gibtEs) feld.value = wunsch;
            })();
          </script>

          {/* Honeypot gegen Bots – für Menschen unsichtbar. */}
          <div class="honig" aria-hidden="true">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          {/* Eintrittskarte, vom Skript beim Seitenaufbau geholt – siehe
              src/lib/eintrittskarte.ts. Hier ohne `<noscript>`-Ersatz: Diese
              Seite braucht ohnehin JavaScript für Foto-Auswahl, Fortschritt
              und Vorher-Nachher-Regler. */}
          <input type="hidden" name="karte" value="" />
        </fieldset>

        {/* Schritt 3 */}
        <fieldset class="schritt">
          <legend><span class="nr">3</span> Einwilligung</legend>

          <label class="haken">
            <input type="checkbox" name="einwilligung" value="ja" required />
            <span>{t('laecheln.ichWilligeAusdruecklichEin')}<a href="/datenschutz/#laecheln">Datenschutzerklärung</a>.
            </span>
          </label>

          <label class="haken">
            <input type="checkbox" name="volljaehrig" value="ja" required />
            <span>{t('laecheln.ichBinVolljaehrigUnd')}</span>
          </label>

          <button type="submit" class="knopf knopf-primaer knopf-gross absenden" id="absenden">{t('laecheln.vorschauErstellen')}</button>

          <p class="dauer-hinweis">{t('laecheln.dieBerechnungDauertEtwa')}</p>
        </fieldset>
      </form>

      {/* Ergebnisspalte */}
      <div class="ergebnis" id="ergebnis" aria-live="polite">
        <div class="platzhalter" id="platzhalter">
          <p>{t('laecheln.ihreVorschauErscheintHier')}</p>
        </div>

        <div class="laeuft" id="laeuft" hidden>
          <div class="spinner" aria-hidden="true"></div>
          <p id="laeuftText">{t('laecheln.fotoWirdAnalysiert')}</p>
        </div>

        <div class="fertig" id="fertig" hidden>
          {/* Vorher-Nachher-Schieberegler */}
          <div class="vergleich" id="vergleich">
            <img id="bildVorher" alt="Ihr Ausgangsfoto" />
            <div class="nachher-huelle" id="nachherHuelle">
              <img id="bildNachher" alt="Visualisierung Ihres Lächelns" />
            </div>
            <input type="range" id="regler" min="0" max="100" value="50"
                   aria-label={t('laecheln.vergleich')} />
            <span class="griff" id="griff" aria-hidden="true"></span>
            <span class="etikett etikett-links">{t('laecheln.ihrFoto')}</span>
            <span class="etikett etikett-rechts">Visualisierung</span>
          </div>

          <div class="analyse" id="analyse"></div>

          <p class="rechtshinweis">{t('laecheln.unverbindlicheIllustrationKeinBehandlungsergebnis')}</p>

          <p class="versand" id="versand"></p>

          <div class="ergebnis-knoepfe">
            <a href="/standorte/" class="knopf knopf-primaer" id="terminKnopf">{t('laecheln.beratungsterminVereinbaren')}</a>
            <button type="button" class="knopf knopf-sekundaer" id="nochmal">{t('laecheln.anderesFotoProbieren')}</button>
          </div>
        </div>

        <div class="fehlerbox" id="fehlerbox" hidden role="alert"></div>
      </div>
    </div>
  </section>

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>{t('laecheln.wasDanachMoeglichIst')}</h2>
      <p class="unter">{t('laecheln.einVeraendertesLaechelnEntsteht')}</p>
      <div class="raster">
        <a class="karte karte-klickbar weg" href="/berlin-charlottenburg/leistungen/veneers/">
          <h3>Veneers</h3>
          <p>{t('laecheln.keramikschalenFuerFormUnd')}</p>
        </a>
        <a class="karte karte-klickbar weg" href="/berlin-charlottenburg/leistungen/zahnaufhellung/">
          <h3>Zahnaufhellung</h3>
          <p>{t('laecheln.mehrereNuancenHellerOhne')}</p>
        </a>
        <a class="karte karte-klickbar weg" href="/berlin-charlottenburg/leistungen/aligner/">
          <h3>{t('laecheln.unsichtbareSchienen')}</h3>
          <p>{t('laecheln.zahnstellungKorrigierenOhneFeste')}</p>
        </a>
        <a class="karte karte-klickbar weg" href="/berlin-charlottenburg/leistungen/smile-design/">
          <h3>{t('laecheln.digitalesSmileDesign')}</h3>
          <p>{t('laecheln.dieVerbindlichePlanungMit')}</p>
        </a>
      </div>
    </div>
  </section>

  <div class="huelle">
    <section class="faq-bereich">
      <h2>{t('laecheln.fragenZurLaechelnVorschau')}</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.frage}</summary>
          <p>{f.antwort}</p>
        </details>
      ))}
    </section>
  </div>
</Basis>

<script>
  import { beimSeitenaufbau } from '../../lib/seitenaufbau';
  import { karteHolen } from '../../lib/karte-holen';

  /*
   * Nach jedem Seitenaufbau neu binden.
   *
   * Beim Seitenwechsel tauscht die Website den Körper aus, führt Module aber
   * nicht erneut aus. Wer die Lächeln-Vorschau als zweite Seite ansteuerte,
   * bekam ein Formular, das kein Foto annahm – und ein Formular, das nichts
   * tut, ist schlimmer als keines.
   */
  beimSeitenaufbau(() => {
    const form = document.getElementById('formular') as HTMLFormElement | null;
    /* Das Modul bleibt geladen, auch wenn man die Seite verlässt. */
    if (!form) return;

    /* Eintrittskarte gleich beim Aufbau holen. Sie braucht drei Sekunden
       Reifezeit; bis ein Foto ausgewählt und zwei Haken gesetzt sind, ist sie
       längst gültig. */
    karteHolen(form);

    const fotoFeld = document.getElementById('foto') as HTMLInputElement;
    const ablage = document.getElementById('ablage')!;
    const ablageLeer = document.getElementById('ablageLeer')!;
    const vorschau = document.getElementById('vorschau') as HTMLImageElement;
    const ablageWeg = document.getElementById('ablageWeg') as HTMLButtonElement;
    const absenden = document.getElementById('absenden') as HTMLButtonElement;

    const platzhalter = document.getElementById('platzhalter')!;
    const laeuft = document.getElementById('laeuft')!;
    const laeuftText = document.getElementById('laeuftText')!;
    const fertig = document.getElementById('fertig')!;
    const fehlerbox = document.getElementById('fehlerbox')!;

    const bildVorher = document.getElementById('bildVorher') as HTMLImageElement;
    const bildNachher = document.getElementById('bildNachher') as HTMLImageElement;
    const nachherHuelle = document.getElementById('nachherHuelle')!;
    const regler = document.getElementById('regler') as HTMLInputElement;
    const griff = document.getElementById('griff')!;
    const analyseEl = document.getElementById('analyse')!;
    const versandEl = document.getElementById('versand')!;
    const terminKnopf = document.getElementById('terminKnopf') as HTMLAnchorElement;
    const nochmal = document.getElementById('nochmal') as HTMLButtonElement;

    let objektUrl: string | null = null;

    /* ── Foto auswählen ── */

    function fotoUebernehmen(datei: File | undefined) {
      if (!datei) return;

      if (datei.size > 8 * 1024 * 1024) {
        zeigeFehler('Das Bild ist größer als 8 MB. Bitte wählen Sie ein kleineres Foto.');
        return;
      }

      if (objektUrl) URL.revokeObjectURL(objektUrl);
      objektUrl = URL.createObjectURL(datei);

      vorschau.src = objektUrl;
      vorschau.hidden = false;
      ablageLeer.hidden = true;
      ablageWeg.hidden = false;
      fehlerbox.hidden = true;
    }

    ablage.addEventListener('click', (e) => {
      if (e.target !== ablageWeg && !ablageWeg.contains(e.target as Node)) fotoFeld.click();
    });

    ablage.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        fotoFeld.click();
      }
    });

    fotoFeld.addEventListener('change', () => fotoUebernehmen(fotoFeld.files?.[0]));

    ['dragenter', 'dragover'].forEach((typ) =>
      ablage.addEventListener(typ, (e) => {
        e.preventDefault();
        ablage.classList.add('drueber');
      }),
    );

    ['dragleave', 'drop'].forEach((typ) =>
      ablage.addEventListener(typ, (e) => {
        e.preventDefault();
        ablage.classList.remove('drueber');
      }),
    );

    ablage.addEventListener('drop', (e) => {
      const datei = (e as DragEvent).dataTransfer?.files?.[0];
      if (datei) {
        // DataTransfer in das Input übernehmen, damit FormData es mitsendet.
        const dt = new DataTransfer();
        dt.items.add(datei);
        fotoFeld.files = dt.files;
        fotoUebernehmen(datei);
      }
    });

    ablageWeg.addEventListener('click', (e) => {
      e.stopPropagation();
      fotoFeld.value = '';
      vorschau.hidden = true;
      ablageWeg.hidden = true;
      ablageLeer.hidden = false;
      if (objektUrl) {
        URL.revokeObjectURL(objektUrl);
        objektUrl = null;
      }
    });

    /* ── Absenden ── */

    function zeigeFehler(text: string) {
      laeuft.hidden = true;
      fertig.hidden = true;
      platzhalter.hidden = true;
      fehlerbox.hidden = false;
      fehlerbox.textContent = text;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!fotoFeld.files?.[0]) {
        zeigeFehler('Bitte wählen Sie zuerst ein Foto aus.');
        return;
      }

      absenden.disabled = true;
      platzhalter.hidden = true;
      fehlerbox.hidden = true;
      fertig.hidden = true;
      laeuft.hidden = false;

      // Der Ablauf dauert spürbar – die Anzeige erklärt, was gerade passiert.
      const stufen = [
        'Foto wird analysiert…',
        'Zahnform und Lachlinie werden ausgewertet…',
        'Visualisierung wird erstellt…',
        'Fast fertig…',
      ];
      let stufe = 0;
      const takt = setInterval(() => {
        stufe = Math.min(stufe + 1, stufen.length - 1);
        laeuftText.textContent = stufen[stufe];
      }, 7000);

      try {
        const res = await fetch('/api/laecheln/', { method: 'POST', body: new FormData(form) });
        const daten = await res.json();

        if (!res.ok) throw new Error(daten.fehler || 'Die Vorschau konnte nicht erstellt werden.');

        if (daten.demo) {
          zeigeFehler(daten.analyse);
          return;
        }

        bildVorher.src = objektUrl!;
        bildNachher.src = daten.bild;
        analyseEl.innerHTML = `<h3>Was uns aufgefallen ist</h3><p></p>`;
        analyseEl.querySelector('p')!.textContent = daten.analyse;

        versandEl.textContent = daten.versandOk
          ? 'Wir haben Ihnen das Ergebnis zusätzlich per E-Mail geschickt.'
          : 'Der E-Mail-Versand ist in dieser Testumgebung noch nicht eingerichtet – Sie sehen das Ergebnis hier.';

        const standort = (document.getElementById('standort') as HTMLSelectElement).value;
        if (standort) terminKnopf.href = `/${standort}/termine/`;

        laeuft.hidden = true;
        fertig.hidden = false;
        reglerAnwenden();
      } catch (err) {
        zeigeFehler(err instanceof Error ? err.message : 'Es ist ein Fehler aufgetreten.');
      } finally {
        clearInterval(takt);
        absenden.disabled = false;
      }
    });

    /* ── Vorher-Nachher-Regler ── */

    function reglerAnwenden() {
      const wert = Number(regler.value);
      nachherHuelle.style.clipPath = `inset(0 0 0 ${wert}%)`;
      griff.style.insetInlineStart = `${wert}%`;
    }

    regler.addEventListener('input', reglerAnwenden);

    nochmal.addEventListener('click', () => {
      fertig.hidden = true;
      platzhalter.hidden = false;
      ablageWeg.click();
      /* Neue Karte: Die alte ist mit dem ersten Durchlauf verbraucht. Ohne
         diese Zeile scheitert genau der zweite Versuch – also der, den dieser
         Knopf anbietet. */
      karteHolen(form);
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<style>
  .kopf {
    background: linear-gradient(160deg, color-mix(in oklab, var(--akzent) 9%, var(--flaeche)), var(--flaeche) 70%);
    border-bottom: 1px solid var(--linie);
  }

  h1 {
    margin-block: var(--raum-4);
    max-width: 18ch;
  }

  .unter {
    max-width: var(--breite-text);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
  }

  .wichtig {
    max-width: var(--breite-text);
    margin-block-start: var(--raum-5);
  }

  .spalten {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--raum-6);
    /* `stretch` statt `start`: Beide Spalten sind gleich hoch. Vorher trug nur
       das Ergebnis einen Rahmen, das Formular stand nackt daneben und endete
       auf einer anderen Höhe – zwei Elemente, die dasselbe Gewicht haben,
       sahen aus wie Inhalt und Beiwerk. */
    align-items: stretch;
  }

  /* Eine Karte, zweimal. Die Unterscheidung macht die Fläche, nicht die Form:
     Das Formular steht auf der Grundfläche, das Ergebnis auf der warmen. */
  .formular,
  .ergebnis {
    display: flex;
    flex-direction: column;
    padding: var(--raum-6);
    border: 1px solid var(--linie);
    border-radius: var(--radius-xl);
  }

  .formular {
    background: var(--flaeche);
  }

  /* ── Formular ── */

  .schritt {
    border: none;
    padding: 0;
    margin: 0;
  }

  /* Die drei Schritte sind jetzt sichtbar getrennt. Vorher lagen sie nur mit
     Abstand untereinander – die Nummern behaupteten eine Gliederung, die das
     Auge nicht bestätigt bekam.

     Die Linie ist ein Pseudoelement und NICHT `border-block-start`: Ein
     `<legend>` sitzt im `<fieldset>` von Haus aus auf der Rahmenlinie und
     schneidet eine Lücke hinein. Als Rahmen gezeichnet lief die Trennung
     deshalb rechts neben „Einwilligung" ins Leere statt über die Karte. */
  .schritt + .schritt {
    position: relative;
    margin-block-start: var(--raum-6);
    padding-block-start: var(--raum-6);
  }

  .schritt + .schritt::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
    background: var(--linie);
  }

  /* Der letzte Schritt trägt den Absendeknopf und wird nach unten gedrückt,
     damit die Karte auch dann sauber abschließt, wenn das Ergebnis daneben
     höher ist. */
  .schritt:last-of-type {
    margin-block-start: auto;
  }

  legend {
    display: flex;
    align-items: center;
    gap: var(--raum-3);
    font-family: var(--schrift-titel);
    font-size: var(--t-lg);
    font-weight: 600;
    margin-block-end: var(--raum-4);
  }

  .nr {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--knopf-flaeche);
    color: var(--knopf-schrift);
    font-family: var(--schrift-text);
    font-size: var(--t-sm);
  }

  .ablage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 15rem;
    padding: var(--raum-5);
    border: 2px dashed var(--linie-stark);
    border-radius: var(--radius-lg);
    background: var(--flaeche-warm);
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--zeit) var(--kurve), background-color var(--zeit) var(--kurve);
  }

  .ablage:hover,
  .ablage.drueber {
    border-color: var(--akzent-schrift);
    background: color-mix(in oklab, var(--akzent) 5%, var(--flaeche-warm));
  }

  .ablage-leer {
