---
import { inhalte } from '../../i18n/daten';
import { oeffnungstageTeile } from '../../data/standorte';
import { sprachpfade } from '../../i18n/sprachen';
import Basis from '../../layouts/Basis.astro';
import Bild from '../../components/Bild.astro';
import { standortbildFuer } from '../../data/medien';
import { schemaBrotkrumen, schemaOrganisation, kanonisch } from '../../lib/seo';
import { texte } from '../../i18n/katalog';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const pfad = '/standorte/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.standorte'), pfad },
];

/* Vergleichstabelle: Welche Leistung gibt es wo? Genau die Information, die
   auf der alten Seite fehlte und die Menschen an den falschen Ort führte. */
const vergleich = daten.leistungen.map((l) => ({
  leistung: l,
  wo: daten.standorte.map((s) => l.verfuegbar.includes(s.slug)),
}));

const schema = [
  schemaOrganisation(),
  schemaBrotkrumen(brotkrumen),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: daten.standorte.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: kanonisch(`/${s.slug}/`),
      name: s.nameLang,
    })),
  },
];
---

<Basis
  titel={t('orte.seitentitel')}
  description={t('orte.beschreibung', { anzahl: daten.standorte.length })}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={schema}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>{t('orte.anzahlStandorte', { anzahl: daten.standorte.length })}</h1>
      <p class="unter">
        {t('standorte.vorspann')}
      </p>

      <div class="raster ortraster">
        {
          daten.standorte.map((s) => {
            const anzahl = daten.leistungenHier(s.slug).length;
            const tage = oeffnungstageTeile(s, t);
            return (
              <article class="karte karte-klickbar ort" style={`--akzent:${s.akzent}`}>
                {/* Derselbe Raum wie auf der Startseite: der Empfang, bei
                    Wilmersdorf die Außenansicht. Vier Textblöcke
                    nebeneinander unterscheidet man an der Adresse, vier
                    Räume in einer halben Sekunde. */}
                <Bild schluessel={standortbildFuer(s.slug) ?? ''} klasse="ort-bild" />
                <h2>
                  <a href={`/${s.slug}/`} class="karte-link">KU64 {s.name}</a>
                </h2>
                <address>
                  {s.strasse}<br />{s.plz} {s.ort}
                </address>
                <p class="claim">{s.claim}</p>
                <ul class="merkmale">
                  {s.besonderheiten.slice(0, 3).map((b) => <li>{b}</li>)}
                </ul>
                <dl class="fakten">
                  <div><dt>{t('orte.behandlungen')}</dt><dd>{anzahl}</dd></div>
                  <div>
                    <dt>Geöffnet</dt>
                    {/* Je Sinneinheit ein Stück, das nicht umbrochen wird –
                        Begründung bei `oeffnungstageTeile` in standorte.ts. */}
                    <dd class="zeiten">
                      {tage.map((teil) => <span>{teil}</span>)}
                    </dd>
                  </div>
                  <div><dt>Seit</dt><dd>{s.eroeffnet.slice(0, 4)}</dd></div>
                </dl>
                <p class="tel">{s.telefon}</p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>{t('standorte.matrixTitel')}</h2>
      <p class="unter">
        {t('standorte.matrixVorspann')}
      </p>

      <div class="tabelle-huelle">
        <table class="vergleich">
          <caption class="nur-screenreader">
            {t('standorte.matrixBeschriftung')}
          </caption>
          <thead>
            <tr>
              <th scope="col">{t('standorte.behandlung')}</th>
              {daten.standorte.map((s) => <th scope="col">{s.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              vergleich.map(({ leistung, wo }) => (
                <tr>
                  <th scope="row">
                    <a href={`/leistungen/${leistung.slug}/`}>{leistung.name}</a>
                  </th>
                  {wo.map((da, i) => (
                    <td class:list={{ ja: da, nein: !da }}>
                      {da ? (
                        <a
                          href={`/${daten.standorte[i].slug}/leistungen/${leistung.slug}/`}
                          aria-label={`${leistung.name} bei KU64 ${daten.standorte[i].name}`}
                        >
                          <span aria-hidden="true">✓</span>
                        </a>
                      ) : (
                        <span aria-label={t('orte.nichtVerfuegbar')}>–</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Basis>

<style>
  h1 { max-width: 18ch; }
  .unter {
    max-width: var(--breite-text);
    margin-block: var(--raum-4) var(--raum-7);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
  }
  /*
   * Vier Standorte, vier Spalten – nicht drei und einer darunter.
   *
   * `.raster` verteilt mit `auto-fit` und `minmax(18rem, 1fr)`. Bei 72 rem
   * Satzspiegel passen davon rechnerisch drei, also stand der vierte allein
   * in der zweiten Reihe. Für eine Übersicht, deren ganze Aussage „das sind
   * unsere vier Standorte" lautet, ist das die falsche Anordnung: Drei und
   * einer liest sich wie drei wichtige und ein nachgereichter.
   *
   * Ab 64 rem deshalb ausdrücklich vier gleiche Spalten. Darunter greift
   * weiter die automatische Verteilung – zwei nebeneinander auf dem Tablet,
   * einer auf dem Telefon.
   */
  @media (min-width: 64rem) {
    .ortraster {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ort {
    overflow: hidden;
    /* Das Bild sitzt in der Kartenkante – der Innenabstand oben entfällt und
       wandert unter das Bild. */
    padding-block-start: 0;
  }

  .ort :global(.ort-bild) {
    margin: 0 calc(var(--raum-5) * -1) var(--raum-5);
    border-radius: 0;
  }

  .ort :global(.ort-bild img) {
    width: 100%;
    /* Breites Format: Es geht um den Raumeindruck, nicht um Einzelheiten. */
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  /* Das gelbe Band über der Karte ist entfallen – siehe Standortwahl.astro:
     Eine Auszeichnung auf jeder Karte zeichnet keine aus. */
  /*
   * Kleiner als eine normale Kartenüberschrift – wegen eines Wortes.
   *
   * „KU64 Kurfürstendamm" braucht bei `--t-xl` rund 208 px, die Karte in
   * vier Spalten bietet 204. Die Überschrift brach daraufhin mitten im Wort:
   * „Kurfürstenda / mm". `hyphens: auto` steht global und hätte sauber
   * getrennt – nur liegt im Prüf-Chromium kein Trennwörterbuch, und was
   * dort nicht trennt, trennt auch bei manchen Besuchern nicht.
   *
   * Eine Schriftgröße, die passt, ist verlässlicher als eine Trennung, die
   * vielleicht greift.
   */
  .ort h2 { font-size: var(--t-lg); }
  .ort h2 a { text-decoration: none; }
  address { font-style: normal; margin-block: var(--raum-2) var(--raum-3); font-size: var(--t-sm); color: var(--tinte-leise); line-height: var(--zeile-normal); }
  .claim { font-size: var(--t-sm); color: var(--tinte-weich); line-height: var(--zeile-normal); }
  .merkmale { margin-block-start: var(--raum-4); padding-inline-start: var(--raum-5); font-size: var(--t-xs); color: var(--tinte-weich); }
  .merkmale li + li { margin-block-start: var(--raum-1); }
  /*
   * Die Faktenreihe bricht in vier Spalten um.
   *
   * Drei feste Spalten in einer Karte von rund 250 px hießen 80 px je
   * Angabe – „7 Tage/Woche Sa + So nach Vereinbarung" braucht mehr. `auto-fit`
   * legt sie bei Bedarf untereinander, statt sie zu quetschen.
   */
  .fakten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(6.5rem, 100%), 1fr));
    gap: var(--raum-3);
    margin-block: var(--raum-5) var(--raum-3);
    padding-block-start: var(--raum-4); border-top: 1px solid var(--linie);
  }
  .fakten dt { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tinte-leise); }
  .fakten dd { margin: 0; font-size: var(--t-sm); font-weight: 600; }
  .tel { margin-block-start: auto; font-size: var(--t-sm); font-weight: 600; color: var(--akzent-schrift); }
  .flaeche-warm { background: var(--flaeche-warm); border-block: 1px solid var(--linie); }

  .tabelle-huelle { overflow-x: auto; border: 1px solid var(--scheibe-rand); border-radius: var(--radius-lg); background: var(--scheibe-flaeche); box-shadow: inset 0 1px 0 var(--glas-glanz); }
  .vergleich { width: 100%; border-collapse: collapse; font-size: var(--t-sm); }
  .vergleich th, .vergleich td { padding: var(--raum-3); text-align: center; border-bottom: 1px solid var(--linie); }
  .vergleich thead th {
    position: sticky; top: 0; background: var(--flaeche);
    font-size: var(--t-xs); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--tinte-leise); white-space: nowrap;
  }
  .vergleich tbody th { text-align: start; font-weight: 500; white-space: nowrap; }
  .vergleich tbody th a { text-decoration: none; }
  .vergleich tbody th a:hover { color: var(--akzent-schrift); }
  .vergleich tbody tr:hover { background: var(--flaeche-warm); }
  .ja a { display: block; color: var(--erfolg); font-weight: 700; text-decoration: none; font-size: var(--t-md); }
  .ja a:hover { transform: scale(1.25); }
  .nein { color: var(--linie-stark); }

  /* Die Öffnungsangabe bricht nur zwischen den Sinneinheiten, nie in einer.
     `inline` und nicht `flex`, damit „7 Tage/Woche" ohne Zusatz weiterhin in
     der Zeile der Beschriftung steht und keine eigene Zeile beansprucht. */
  .zeiten span {
    white-space: nowrap;
  }

  .zeiten span + span::before {
    /* Ein normales Leerzeichen als Trennstelle – hier DARF gebrochen werden. */
    content: ' ';
    white-space: normal;
  }
</style>
