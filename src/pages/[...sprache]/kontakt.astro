---
import { inhalte } from '../../i18n/daten';
import { texte } from '../../i18n/katalog';
import { zeitLesbar } from '../../data/standorte';
import { sprachpfade } from '../../i18n/sprachen';
import Basis from '../../layouts/Basis.astro';
import { schemaBrotkrumen, schemaOrganisation } from '../../lib/seo';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const pfad = '/kontakt/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.kontakt'), pfad },
];
---

<Basis
  titel="Kontakt"
  description={t('kontaktz.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen), schemaOrganisation()]}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>Kontakt</h1>
      <p class="unter">{t('kontaktz.jederStandortHatEigene')}</p>

      <div class="raster">
        {daten.standorte.map((s) => (
          <article class="karte ort" style={`--akzent:${s.akzent}`}>
            <h2><a href={`/${s.slug}/kontakt/`}>KU64 {s.name}</a></h2>
            <address>{s.strasse}<br />{s.plz} {s.ort}</address>
            <a href={`tel:${s.telefonRaw.replace(/\s/g, '')}`} class="tel">{s.telefon}</a>
            <a href={`mailto:${s.email}`} class="mail">{s.email}</a>
            <table class="zeiten">
              <caption class="nur-screenreader">{t('fuss.oeffnungszeitenVon', { name: s.name })}</caption>
              <tbody>
                {s.oeffnungszeiten.map((z) => (
                  <tr>
                    <th scope="row">{z.tag}</th>
                    <td>{zeitLesbar(z)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <a href={`/${s.slug}/termine/`} class="knopf knopf-primaer">{t('kontaktz.terminBuchen')}</a>
          </article>
        ))}
      </div>

      <div class="hinweis notfall">
        <strong>{t('kontaktz.akuteBeschwerden')}</strong>{t('kontaktz.bitteRufenSieAn')}<a href="/notfall/">Notfall</a>.
      </div>
    </div>
  </section>

  {/*
    Das Formular, das zwei andere Seiten versprechen.

    Die Barrierefreiheitserklärung nennt diesen Weg, um eine Barriere zu
    melden, die KI-Transparenzseite als schriftliche Alternative zum Berater.
    Beide verwiesen hierher, wo bis eben nur Adressen standen – wer das
    Telefon nicht benutzen kann, fand ausgerechnet den Weg nicht, der ihm
    zusteht.

    Es funktioniert ohne JavaScript: Ohne Skript ist es ein gewöhnlicher
    Formularversand mit eigener Antwortseite. Das Skript darüber ersetzt nur
    den Seitenwechsel durch eine Rückmeldung an Ort und Stelle.
  */}
  {/*
    Welcher Weg wofür – einmal, für alle Standorte.

    Stand bis eben auf allen vier Standort-Kontaktseiten wortgleich und machte
    sie damit zu 41 Prozent textgleich. Die Zuordnung „welches Anliegen gehört
    auf welchen Kanal" ist an jedem Standort dieselbe; nur die Nummer und die
    Adresse unterscheiden sich, und die stehen dort.
  */}
  <section class="abschnitt">
    <div class="huelle eng">
      <h2>Welcher Weg wofür</h2>
      <dl class="wege">
        <dt>Termin, Absage, Verschiebung</dt>
        <dd>Online buchen oder anrufen – beides führt in denselben Kalender.</dd>
        <dt>Starke Schmerzen, Schwellung, Unfall</dt>
        <dd>
          Bitte anrufen, nicht schreiben. An jedem Standort sind Zeiten für
          Schmerzfälle frei. <a href="/notfall/">Was im Notfall zu tun ist</a>
        </dd>
        <dt>Rezept, Bescheinigung, Unterlagen</dt>
        <dd>
          Schriftlich an die Adresse Ihres Standorts – mit Namen und Geburtsdatum,
          sonst dürfen wir nichts herausgeben.
        </dd>
        <dt>Frage zu einer Leistung oder zu Kosten</dt>
        <dd>
          Der <button type="button" class="chat-oeffner text-knopf">digitale Berater</button>{' '}
          antwortet rund um die Uhr und kennt das Angebot jedes Standorts.
        </dd>
        <dt>Alles andere</dt>
        <dd>Das Formular unten. Wir antworten in der Regel am selben oder nächsten Werktag.</dd>
      </dl>
    </div>
  </section>

  <section class="abschnitt flaeche-warm" id="schreiben">
    <div class="huelle eng">
      <h2>Schreiben Sie uns</h2>
      <p class="unter">
        Für alles, was keinen Termin braucht: Rückfragen, Unterlagen, Lob,
        Beschwerden – und um eine Barriere auf dieser Website zu melden.
      </p>

      <form id="kontaktformular" method="post" action="/api/kontakt/" novalidate>
        <p class="feld">
          <label for="k-standort">An welchen Standort?</label>
          <select id="k-standort" name="standort">
            {daten.standorte.map((s) => (
              <option value={s.slug}>KU64 {s.name} – {s.ort}</option>
            ))}
          </select>
        </p>

        <p class="feld">
          <label for="k-name">Ihr Name</label>
          <input id="k-name" name="name" type="text" autocomplete="name" required />
        </p>

        <p class="feld">
          <label for="k-email">E-Mail-Adresse</label>
          <input id="k-email" name="email" type="email" autocomplete="email" required />
          <span class="hilfe">Damit wir Ihnen antworten können.</span>
        </p>

        <p class="feld">
          <label for="k-nachricht">Ihr Anliegen</label>
          <textarea id="k-nachricht" name="nachricht" rows="6" required></textarea>
          <span class="hilfe">
            Bitte keine Befunde oder Beschwerden – eine E-Mail ist dafür nicht
            sicher genug. Rufen Sie in dem Fall an, dann klären wir es direkt.
          </span>
        </p>

        {/* Für Menschen unsichtbar. Wer es ausfüllt, arbeitet Formulare
            automatisch ab – siehe src/pages/api/kontakt.ts. */}
        <p class="honigtopf" aria-hidden="true">
          <label for="k-website">Website</label>
          <input id="k-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </p>

        {/* Die Eintrittskarte holt das Skript beim Seitenaufbau – siehe
            src/lib/eintrittskarte.ts. Sie kann nicht beim Bauen hier stehen:
            Diese Seite ist statisch, eine eingebaute Karte trüge das Datum des
            Deploys und wäre für alle Besucher dieselbe. */}
        <input type="hidden" name="karte" value="" />

        <noscript>
          <p class="hinweis hinweis-warnung">
            Dieses Formular braucht JavaScript, weil es vor dem Versand eine
            Prüfung gegen automatisierte Nachrichten durchläuft. Ohne
            JavaScript schreiben Sie uns bitte direkt an die E-Mail-Adresse
            Ihres Standorts – die Adressen stehen oben auf dieser Seite. Eine
            Barriere können Sie an jede davon melden.
          </p>
        </noscript>

        <button type="submit" class="knopf knopf-primaer knopf-gross">Nachricht senden</button>

        {/* `aria-live`: Die Rückmeldung erscheint ohne Seitenwechsel und muss
            deshalb angesagt werden, sonst bemerkt sie niemand, der nicht
            hinsieht. */}
        <p class="rueckmeldung" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Basis>

<script>
  import { karteHolen } from '../../lib/karte-holen';

  /*
    Fortschrittliche Verbesserung: Mit diesem Skript bleibt man beim Absenden
    auf der Seite.

    Eine Einschränkung, die mit der Eintrittskarte dazugekommen ist: Ohne
    JavaScript kommt das Formular nicht mehr durch, weil die Karte per fetch
    geholt wird. Für diesen Fall steht ein `<noscript>` im Formular, das auf
    die E-Mail-Adressen der Standorte weiter oben verweist – die stehen auf
    dieser Seite ohnehin und sind der direktere Weg. Das ist bewusst so
    entschieden und nicht übersehen: Diese Seite ist der schriftliche Weg für
    Menschen, die nicht telefonieren können, und der darf nicht wortlos
    verschwinden.
  */
  function formularVerdrahten() {
    const formular = document.querySelector<HTMLFormElement>('#kontaktformular');
    if (!formular || formular.dataset.verdrahtet) return;
    formular.dataset.verdrahtet = 'ja';

    /* Sofort holen, nicht erst beim Absenden: Die Karte muss drei Sekunden alt
       sein, und die soll der Besucher nicht am Knopf abwarten. */
    karteHolen(formular);

    const rueckmeldung = formular.querySelector<HTMLElement>('.rueckmeldung');
    const knopf = formular.querySelector<HTMLButtonElement>('button[type=submit]');

    formular.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!rueckmeldung || !knopf) return;

      knopf.disabled = true;
      rueckmeldung.textContent = 'Wird gesendet …';
      rueckmeldung.className = 'rueckmeldung';

      try {
        const antwort = await fetch(formular.action, {
          method: 'POST',
          body: new FormData(formular),
        });
        const daten = await antwort.json();

        if (antwort.ok && daten.mailto) {
          /* Kein Postausgang eingerichtet: Die Nachricht ist fertig und wird
             im E-Mail-Programm geöffnet, statt verloren zu gehen. */
          rueckmeldung.textContent = daten.hinweis + ' ';
          const knopf2 = document.createElement('a');
          knopf2.href = daten.mailto;
          knopf2.className = 'knopf knopf-primaer';
          knopf2.textContent = 'Nachricht im E-Mail-Programm öffnen';
          rueckmeldung.appendChild(knopf2);
          rueckmeldung.className = 'rueckmeldung gut';
        } else if (antwort.ok) {
          rueckmeldung.textContent = daten.hinweis ?? 'Ihre Nachricht ist eingegangen.';
          rueckmeldung.className = 'rueckmeldung gut';
          formular.reset();
        } else {
          rueckmeldung.textContent = daten.fehler ?? 'Das hat nicht geklappt.';
          rueckmeldung.className = 'rueckmeldung schlecht';
        }
      } catch {
        rueckmeldung.textContent =
          'Die Verbindung kam nicht zustande. Bitte rufen Sie uns an – die Nummern stehen oben.';
        rueckmeldung.className = 'rueckmeldung schlecht';
      } finally {
        knopf.disabled = false;
        /* Jede Karte gilt einmal. Wer eine zweite Nachricht schreibt – oder
           gerade eine abgelehnte korrigiert –, braucht eine neue; sonst
           scheitert der zweite Versuch an einer Prüfung, die den ersten
           gemeint hat. `formular.reset()` oben leert das Feld ohnehin. */
        karteHolen(formular);
      }
    });
  }

  formularVerdrahten();
  document.addEventListener('astro:page-load', formularVerdrahten);
</script>

<style>
  .wege { margin: 0; max-width: var(--breite-text); }
  .wege dt { font-weight: 600; margin-block-start: var(--raum-4); }
  .wege dt:first-child { margin-block-start: 0; }
  .wege dd { margin: var(--raum-2) 0 0; color: var(--tinte-weich); line-height: var(--zeile-normal); }
  .text-knopf {
    background: none; border: 0; padding: 0; font: inherit;
    color: var(--akzent-schrift); text-decoration: underline;
    text-underline-offset: 0.2em; cursor: pointer;
  }

  .eng { max-width: 44rem; }
  .feld { display: grid; gap: var(--raum-2); margin-block-end: var(--raum-5); }
  .feld label { font-weight: 600; }
  .feld input, .feld textarea, .feld select {
    font: inherit;
    padding: var(--raum-3);
    border: 1px solid var(--linie);
    border-radius: var(--radius-s, 6px);
    background: var(--flaeche, #fff);
    color: inherit;
    width: 100%;
  }
  .feld input:focus-visible, .feld textarea:focus-visible, .feld select:focus-visible {
    outline: 2px solid var(--akzent);
    outline-offset: 2px;
  }
  .hilfe { font-size: var(--t-sm); color: var(--tinte-weich); }
  /* Nicht `display: none`: Ein Feld, das der Browser gar nicht rendert, füllt
     auch kein Skript aus – und genau darauf zielt der Honigtopf. */
  .honigtopf {
    position: absolute;
    inset-inline-start: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .rueckmeldung { margin-block-start: var(--raum-4); font-weight: 600; }
  .rueckmeldung.gut { color: var(--gut, #2C6B4C); }
  .rueckmeldung.schlecht { color: var(--fehler, #B02A1B); }

  .unter { max-width: var(--breite-text); margin-block: var(--raum-4) var(--raum-7); font-size: var(--t-lg); color: var(--tinte-weich); }
  .ort { overflow: hidden; padding-block-start: calc(var(--raum-5) + 4px); }
  /* Das gelbe Band über der Karte ist entfallen – siehe Standortwahl.astro:
     Eine Auszeichnung auf jeder Karte zeichnet keine aus. */
  .ort h2 { font-size: var(--t-lg); }
  .ort h2 a { text-decoration: none; }
  address { font-style: normal; margin-block: var(--raum-2) var(--raum-3); font-size: var(--t-sm); color: var(--tinte-leise); line-height: var(--zeile-normal); }
  .tel { display: block; font-size: var(--t-lg); font-weight: 700; color: var(--akzent-schrift); text-decoration: none; }
  .mail { display: block; font-size: var(--t-sm); color: var(--tinte-weich); margin-block-start: var(--raum-1); word-break: break-all; }
  .zeiten { width: 100%; margin-block: var(--raum-4); border-collapse: collapse; font-size: var(--t-xs); }
  .zeiten th { text-align: start; font-weight: 500; padding-block: 2px; color: var(--tinte-weich); }
  .zeiten td { text-align: end; font-variant-numeric: tabular-nums; color: var(--tinte-leise); }
  .ort .knopf { margin-block-start: auto; align-self: flex-start; }
  .notfall { margin-block-start: var(--raum-7); border-color: var(--fehler); background: var(--fehler-flaeche); max-width: var(--breite-text); }
</style>
