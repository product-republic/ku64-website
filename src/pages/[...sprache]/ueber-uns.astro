---
/**
 * Über KU64 – die Übersicht.
 *
 * ── Warum diese Seite nicht mehr 862 Wörter hat ─────────────────────────
 *
 * Sie hatte auf ku64.de 2.211 eigene Wörter, und der erste Neubau hatte
 * davon keines übernommen: Er beschrieb die Praxis neu, kürzer und in
 * eigenen Worten. Das war der Fehler, um den es in diesem Projekt geht –
 * neu geschrieben ist nicht dasselbe wie übernommen, und was die Praxis
 * über sich sagt, sagt niemand besser als die Praxis.
 *
 * Der Originaltext steht deshalb hier, unter „Die Praxis in eigenen
 * Worten". Vier unausgefüllte Platzhalter („Auf … Quadratmetern") und zwei
 * falsche Jahreszahlen sind dabei korrigiert; jede Korrektur steht mit Grund
 * in `scripts/langtexte-bauen.mjs`.
 *
 * ── Und warum sie trotzdem nicht nur Fließtext ist ──────────────────────
 *
 * Die Zahlen oben kommen aus `team.ts` und `standorte.ts` und nicht aus dem
 * Text. Eine Zahl im Fließtext veraltet, sobald jemand eingestellt wird;
 * eine Zahl aus den Daten nicht.
 */
import { inhalte } from '../../i18n/daten';
import { texte } from '../../i18n/katalog';
import { sprachpfade } from '../../i18n/sprachen';
import type { TextSchluessel } from '../../i18n/texte';
import Basis from '../../layouts/Basis.astro';
import Langtext from '../../components/Langtext.astro';
import Video from '../../components/Video.astro';
import { videosZuThema } from '../../data/videos';
import { anzahlGesamt, anzahlZahnaerzte } from '../../data/team';
import { GRUPPENFOLGE, THEMEN_MIT_SEITE, THEMA_UEBERSICHT } from '../../data/themen';
import { ueberThema } from '../../lib/langtexte';
import { schemaBrotkrumen, schemaOrganisation } from '../../lib/seo';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const pfad = '/ueber-uns/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.ueberKu64'), pfad },
];

const aeltester = [...daten.standorte].sort((a, b) => a.eroeffnet.localeCompare(b.eroeffnet))[0];
const seit = Number(aeltester.eroeffnet.slice(0, 4));
const jahre = new Date().getFullYear() - seit;

const eigeneWorte = THEMA_UEBERSICHT ? ueberThema(THEMA_UEBERSICHT.slug, daten.sprache) : undefined;
const videos = THEMA_UEBERSICHT ? videosZuThema(THEMA_UEBERSICHT.slug) : [];

/* Nach Gruppen, in der Reihenfolge aus `themen.ts` – und innerhalb einer
   Gruppe in der Reihenfolge, in der sie dort stehen. Alphabetisch wäre eine
   Aussage über das Alphabet. */
const themenGruppen = GRUPPENFOLGE.map((gruppe) => ({
  gruppe,
  themen: THEMEN_MIT_SEITE.filter((x) => x.gruppe === gruppe),
})).filter((g) => g.themen.length > 0);
---

<Basis
  titel="Über KU64"
  description={`KU64 – Die Zahnspezialisten: seit ${seit} in Berlin, heute an ${daten.standorte.length} Standorten in Berlin und Potsdam mit ${daten.leistungen.length} Leistungen.`}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen), schemaOrganisation()]}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>{t('ueber.ueberKu64')}</h1>
      <p class="unter">
        {t('ueber.seit', { jahr: seit, anzahl: daten.standorte.length })}
      </p>

      <dl class="zahlen">
        <div><dt>{t('ueber.jahre')}</dt><dd>{jahre}</dd><p>{t('ueber.seitGruendung', { jahr: seit })}</p></div>
        <div><dt>{t('ueber.standorte')}</dt><dd>{daten.standorte.length}</dd><p>{t('ueber.inBerlinUndPotsdam')}</p></div>
        <div><dt>{t('praxis.behandlungen')}</dt><dd>{daten.leistungen.length}</dd><p>{t('praxis.ausFachbereichen', { anzahl: daten.kategorien.length })}</p></div>
        {/* Zwei Zahlen statt einer. Vorher stand hier "100+ Zahnärztinnen und
            Zahnärzte" – die 100 stimmte, aber sie ist die gesamte
            Belegschaft. Zahnärztinnen und Zahnärzte sind 38 davon. */}
        <div>
          <dt>{t('ueber.zahnaerztinnenUndZahnaerzte')}</dt>
          <dd>{anzahlZahnaerzte()}</dd>
          <p>{t('ueber.anVierStandorten')}</p>
        </div>
        <div>
          <dt>{t('ueber.imTeam')}</dt>
          <dd>{anzahlGesamt()}</dd>
          <p>{t('ueber.mitProphylaxeAssistenzEmpfang')}</p>
        </div>
      </dl>
    </div>
  </section>

  {
    eigeneWorte && (
      <section class="abschnitt">
        <div class="huelle">
          <Langtext
            langtext={eigeneWorte}
            sprache={daten.sprache}
            titel={t('ueber.inEigenenWorten')}
            basisStufe={3}
          />
        </div>
      </section>
    )
  }

  {
    videos.length > 0 && (
      <section class="abschnitt" aria-labelledby="videos-titel">
        <div class="huelle">
          <h2 id="videos-titel">{t('video.ueberschrift')}</h2>
          <div class="videos">
            {videos.map((v) => (
              <Video video={v} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="abschnitt flaeche-warm" aria-labelledby="themen-titel">
    <div class="huelle">
      <h2 id="themen-titel">{t('ueber.themenTitel')}</h2>
      <p class="themen-vorspann">{t('ueber.themenVorspann')}</p>
      {
        themenGruppen.map((g) => (
          <div class="themen-gruppe">
            <h3>{t(`ueber.gruppe.${g.gruppe}` as TextSchluessel)}</h3>
            <div class="raster">
              {g.themen.map((x) => (
                <a class="karte karte-klickbar thema" href={`/ueber-uns/${x.slug}/`}>
                  <h4>{t(`thema.${x.slug}.titel` as TextSchluessel)}</h4>
                  <p>{t(`thema.${x.slug}.kurz` as TextSchluessel)}</p>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="abschnitt">
    <div class="huelle">
      <h2>{t('ueber.wofuerWirStehen')}</h2>
      <div class="raster">
        <div class="karte wert">
          <h3>{t('ueber.ehrlichStattWerbend')}</h3>
          <p>{t('ueber.wirSagenOffenWas')}</p>
        </div>
        <div class="karte wert">
          <h3>{t('ueber.angstErnstNehmen')}</h3>
          <p>{t('ueber.sehrVieleMenschenSchieben')}</p>
        </div>
        <div class="karte wert">
          <h3>{t('ueber.spezialisierungUnterEinemDach')}</h3>
          <p>{t('ueber.vonProphylaxeUeberKieferorthopaedie')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>{t('ueber.unsereStandorte')}</h2>
      <div class="raster ortraster">
        {daten.standorte.map((s) => (
          <a class="karte karte-klickbar ort" href={`/${s.slug}/`} style={`--akzent:${s.akzent}`}>
            <h3>KU64 {s.name}</h3>
            <p class="claim">{s.claim}</p>
            <span class="seit">seit {s.eroeffnet.slice(0, 4)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Basis>

<style>
  .unter { max-width: var(--breite-text); margin-block: var(--raum-4) var(--raum-7); font-size: var(--t-lg); color: var(--tinte-weich); line-height: var(--zeile-weit); }
  .zahlen { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr)); gap: var(--raum-5); padding-block-start: var(--raum-6); border-top: 1px solid var(--linie); }
  .zahlen dt { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tinte-leise); }
  .zahlen dd { margin: var(--raum-1) 0 0; font-family: var(--schrift-titel); font-size: var(--t-2xl); font-weight: 600; color: var(--akzent-schrift); }
  .zahlen p { font-size: var(--t-xs); color: var(--tinte-weich); }
  .flaeche-warm { background: var(--flaeche-warm); border-block: 1px solid var(--linie); }
  h2 { margin-block-end: var(--raum-6); }
  .themen-vorspann { max-width: var(--breite-text); margin-block: calc(var(--raum-6) * -1) var(--raum-6); font-size: var(--t-sm); color: var(--tinte-weich); line-height: var(--zeile-weit); }
  .themen-gruppe + .themen-gruppe { margin-block-start: var(--raum-7); }
  .themen-gruppe h3 { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tinte-leise); margin-block-end: var(--raum-4); }
  .videos { max-width: 44rem; display: flex; flex-direction: column; gap: var(--raum-5); }
  .thema { text-decoration: none; }
  .thema h4 { font-size: var(--t-md); margin-block-end: var(--raum-2); }
  .thema p { font-size: var(--t-sm); color: var(--tinte-weich); line-height: var(--zeile-normal); }
  .wert h3 { font-size: var(--t-lg); margin-block-end: var(--raum-3); }
  .wert p { font-size: var(--t-sm); color: var(--tinte-weich); line-height: var(--zeile-weit); }
  /* Vier Standorte, vier Spalten – dieselbe Begründung wie auf /standorte/:
     Drei und einer liest sich wie drei wichtige und ein nachgereichter. */
  @media (min-width: 64rem) {
    .ortraster { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .ort { text-decoration: none; overflow: hidden; padding-block-start: calc(var(--raum-5) + 4px); }
  /* Das gelbe Band über der Karte ist entfallen – siehe Standortwahl.astro:
     Eine Auszeichnung auf jeder Karte zeichnet keine aus. */
  .ort h3 { font-size: var(--t-lg); margin-block-end: var(--raum-2); }
  .claim { font-size: var(--t-sm); color: var(--tinte-weich); line-height: var(--zeile-normal); }
  .seit { margin-block-start: auto; padding-block-start: var(--raum-4); font-size: var(--t-xs); font-weight: 600; color: var(--akzent-schrift); }
</style>
