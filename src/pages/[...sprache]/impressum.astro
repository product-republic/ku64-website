---
/**
 * ⚠️ ENTWURF. Ein Impressum enthält ausschließlich Tatsachenangaben über die
 * Praxis – erfundene Inhalte wären hier rechtlich riskant. Alle Felder sind
 * als Platzhalter angelegt und von der Praxis zu befüllen.
 *
 * Pflichtangaben für Zahnarztpraxen: § 5 DDG (ehem. TMG), § 18 MStV sowie die
 * berufsrechtlichen Angaben nach der Berufsordnung der Zahnärztekammer.
 */
import { sprachpfade } from '../../i18n/sprachen';
import { spracheAusParameter } from '../../i18n/sprachen';
import { texte } from '../../i18n/katalog';
import { TRAEGER, angabe } from '../../data/traeger';
import Basis from '../../layouts/Basis.astro';
import Vorrangklausel from '../../components/Vorrangklausel.astro';
import { schemaBrotkrumen } from '../../lib/seo';

const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

export function getStaticPaths() {
  return sprachpfade();
}

const pfad = '/impressum/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.impressum'), pfad },
];
---

<Basis
  titel={t('imp.seitentitel')}
  description={t('imp.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
  noindex={true}
>
  <div class="huelle abschnitt">
    <h1>{t('imp.seitentitel')}</h1>
    <Vorrangklausel />

    {/* `set:html` wie in der Datenschutzerklärung: Die Felder, die die Praxis
        noch befüllt, stehen als <code> mitten im Satz. Warum das hier die
        richtige Ausnahme ist, steht bei den Rechtstexten in texte.ts. */}
    <p class="hinweis hinweis-warnung entwurf" set:html={t('imp.entwurf')} />

    <div class="fliesstext">
      <h2>{t('imp.angabenNach5Ddg')}</h2>
      <p
        set:html={t('imp.anschrift', {
          name: angabe(TRAEGER.name),
          rechtsform: angabe(TRAEGER.rechtsform),
          strasse: angabe(TRAEGER.strasse),
          plzOrt: angabe(TRAEGER.plzOrt),
        })}
      />
      <p
        set:html={t('imp.kontakt', {
          telefon: angabe(TRAEGER.telefon),
          fax: angabe(TRAEGER.fax),
          epost: angabe(TRAEGER.epost),
        })}
      />

      <h2>{t('imp.vertretung')}</h2>
      <p set:html={t('imp.vertretungAngabe', { vertretung: angabe(TRAEGER.vertretung) })} />

      <h2>{t('imp.register')}</h2>
      <p
        set:html={t('imp.registerAngabe', {
          registergericht: angabe(TRAEGER.registergericht),
          registernummer: angabe(TRAEGER.registernummer),
        })}
      />

      <h2>{t('imp.ustId')}</h2>
      <p set:html={t('imp.ustIdAngabe', { ustId: angabe(TRAEGER.ustId) })} />

      <h2>{t('imp.berufsrechtlicheAngaben')}</h2>
      <p
        set:html={t('imp.berufsAngaben', {
          berufsbezeichnung: angabe(TRAEGER.berufsbezeichnung),
          verleihstaat: angabe(TRAEGER.verleihstaat),
          kammer: angabe(TRAEGER.kammer),
          kzv: angabe(TRAEGER.kassenzahnaerztlicheVereinigung),
          aufsicht: angabe(TRAEGER.aufsicht),
        })}
      />
      <p set:html={t('imp.berufsRegeln', { fundstelle: angabe(TRAEGER.berufsordnungFundstelle) })} />

      <h2>{t('imp.haftpflicht')}</h2>
      <p
        set:html={t('imp.haftpflichtAngabe', {
          versicherer: angabe(TRAEGER.versicherer),
          geltungsbereich: angabe(TRAEGER.versicherungGeltungsbereich),
        })}
      />

      <h2>{t('imp.verantwortlichFuerDenInhalt')}</h2>
      <p set:html={t('imp.verantwortlichAngabe', { verantwortlich: angabe(TRAEGER.inhaltlichVerantwortlich) })} />

      <h2>{t('imp.streitbeilegung')}</h2>
      <p set:html={t('imp.streitbeilegungText', { bereit: angabe(TRAEGER.streitbeilegungBereit) })} />
      <p set:html={t('imp.schlichtungsstelle', { stelle: angabe(TRAEGER.schlichtungsstelle) })} />

      <h2>{t('imp.bildnachweise')}</h2>
      <p set:html={t('imp.bildnachweiseAngabe', { nachweise: angabe(TRAEGER.bildnachweise) })} />
    </div>
  </div>
</Basis>

<style>
  h1 { margin-block-end: var(--raum-5); }
  .entwurf { max-width: var(--breite-text); margin-block-end: var(--raum-7); }
  code {
    padding: 0.1em 0.4em; border-radius: var(--radius-sm);
    background: var(--warnung-flaeche); color: var(--warnung); font-size: 0.9em;
  }
</style>
