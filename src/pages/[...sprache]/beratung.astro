---
/**
 * Sprachberater. Wer nicht tippen mag oder sehr viele Fragen hat, spricht hier
 * einfach – die Alternative zum Chat, nicht dessen Ersatz.
 *
 * Das Mikrofon wird erst nach ausdrücklichem Klick angefordert. Es läuft nichts
 * im Hintergrund mit, und es wird kein Gespräch aufgezeichnet.
 *
 * ── Warum die Offenlegung hier größer ausfällt als im Chat ───────────────
 *
 * Beim Chat sieht man Text auf einem Bildschirm; dass dahinter keine Person
 * in Echtzeit tippt, ahnt man. Eine natürlich klingende Stimme, die antwortet,
 * ohne zu zögern, ist etwas anderes – Artikel 50 Absatz 1 nennt genau das als
 * Grund, warum die Ausnahme „ist ohnehin offensichtlich" hier nicht trägt.
 *
 * Der Hinweis steht deshalb VOR dem Startknopf und nicht darunter: Wer das
 * Gespräch beginnt, hat ihn gelesen, weil er im Weg stand.
 */
import { inhalte } from '../../i18n/daten';
import { texte } from '../../i18n/katalog';
import { sprachpfade } from '../../i18n/sprachen';
import Basis from '../../layouts/Basis.astro';
import { kiSystem, WEG_ZUM_MENSCHEN } from '../../data/ki-systeme';
import { schemaBrotkrumen, schemaFaq } from '../../lib/seo';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const pfad = '/beratung/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.digitaleBeratung'), pfad },
];

const system = kiSystem('sprachberater')!;

const faq = [
  {
    frage: 'Spreche ich mit einem Menschen?',
    antwort:
      'Nein. Sie sprechen mit einem KI-System, und die Stimme ist synthetisch erzeugt. Einen Menschen erreichen Sie unter der Telefonnummer Ihres Standorts.',
  },
  {
    frage: 'Wird das Gespräch aufgezeichnet?',
    antwort:
      'Für die Dauer des Gesprächs wird Ihre Stimme verarbeitet, um die Antwort zu erzeugen. Eine dauerhafte Aufzeichnung findet nicht statt, und wir ordnen das Gespräch keiner Person zu. Sie können jederzeit auflegen.',
  },
  {
    frage: 'Ersetzt das eine Beratung in der Praxis?',
    antwort:
      'Nein. Der Sprachberater erklärt Leistungen, Abläufe und Kostenrahmen. Er stellt keine Diagnose und beurteilt keine Beschwerden. Alles, was Ihren konkreten Fall betrifft, gehört in eine persönliche Untersuchung.',
  },
  {
    frage: 'Was, wenn ich lieber schreibe?',
    antwort:
      'Dann nutzen Sie den Chat unten rechts – inhaltlich beantwortet er dieselben Fragen. Manche Menschen tippen lieber, andere sprechen lieber; beides ist gleichwertig.',
  },
  {
    frage: 'Kann ich darüber einen Termin buchen?',
    antwort:
      'Nein, der Berater nimmt keine Termine entgegen und erfasst keine persönlichen Daten. Er verweist Sie auf die Terminseite Ihres Standorts oder auf unsere Telefonnummer.',
  },
];
---

<Basis
  titel="Digitale Beratung"
  description={t('beratungz.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen), schemaFaq(faq)]}
>
  <section class="kopf abschnitt-eng">
    <div class="huelle">
      <span class="marke marke-akzent">{t('beratung.rundUmDieUhr')}</span>
      <h1>{t('beratung.sprechenSieMitUnserem')}</h1>
      <p class="unter">{t('beratung.fragenZuEinerBehandlung')}</p>
    </div>
  </section>

  <div class="huelle abschnitt spalten">
    <section class="gespraech">
      <label class="feld">
        <span>{t('beratung.zuWelchemStandortHaben')}</span>
        <select id="standortWahl">
          <option value="">{t('beratung.allgemeinNochUnentschieden')}</option>
          {daten.standorte.map((s) => <option value={s.slug}>KU64 {s.name} – {s.ort}</option>)}
        </select>
      </label>

      <p class="offenlegung">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.6" />
          <path d="M10 9v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          <circle cx="10" cy="6.2" r="1" fill="currentColor" />
        </svg>
        <span>
          <strong>{system.offenlegung}</strong> {WEG_ZUM_MENSCHEN}{' '}
          <a href="/ki-transparenz/">{t('beratung.welchesSystemHierArbeitet')}</a>
        </span>
      </p>

      <div class="buehne" id="buehne" data-zustand="bereit">
        {/* Visualisierung des Gesprächszustands */}
        <div class="welle" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>

        <p class="zustand" id="zustand" role="status" aria-live="polite">{t('beratung.bereitKlickenSieUm')}</p>

        <button type="button" class="knopf knopf-primaer knopf-gross mikro" id="mikro">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <rect x="7" y="2" width="6" height="10" rx="3" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M4 9a6 6 0 0 0 12 0M10 15v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span id="mikroText">{t('beratung.gespraechStarten')}</span>
        </button>

        <p class="mikro-hinweis">{t('beratung.ihrBrowserFragtDanach')}</p>
      </div>

      <div class="protokoll" id="protokoll" aria-live="polite"></div>

      <div class="fehlerbox" id="fehlerbox" hidden role="alert"></div>
    </section>

    <aside class="seite">
      <div class="karte">
        <h2>{t('beratung.lieberSchreiben')}</h2>
        <p>{t('beratung.derChatUntenRechts')}</p>
        <button type="button" class="knopf knopf-sekundaer chat-oeffner">{t('beratung.chatOeffnen')}</button>
      </div>

      <div class="karte">
        <h2>{t('beratung.lieberMitEinemMenschen')}</h2>
        <p>{t('beratung.selbstverstaendlichRufenSieDen')}</p>
        <ul class="nummern">
          {
            daten.standorte.map((s) => (
              <li>
                <strong>{s.name}</strong>
                <a href={`tel:${s.telefonRaw.replace(/\s/g, '')}`}>{s.telefon}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="karte grenze">
        <h2>{t('beratung.wasDerBeraterNicht')}</h2>
        <ul class="liste">
          <li>{t('beratung.keineDiagnoseUndKeine')}</li>
          <li>{t('beratung.keineTerminbuchungUndKeine')}</li>
          <li>{t('beratung.keineZusagenZuBehandlungsergebnissen')}</li>
        </ul>
        <p class="notfall">{t('beratung.beiStarkenSchmerzenSchwellung')}</p>
      </div>
    </aside>
  </div>

  <div class="huelle">
    <section class="faq-bereich">
      <h2>{t('beratung.fragenZurDigitalenBeratung')}</h2>
      {
        faq.map((f) => (
          <details>
            <summary>{f.frage}</summary>
            <p>{f.antwort}</p>
          </details>
        ))
      }
    </section>
  </div>
</Basis>

<script>
  import { beimSeitenaufbau } from '../../lib/seitenaufbau';

  /*
   * Das ElevenLabs-SDK wird NICHT hier oben geladen.
   *
   * Es wiegt 450 KB – mehr als der gesamte Rest der Website zusammen. Fest
   * eingebunden lud es jeder, der diese Seite öffnet, auch wer nur die
   * Fragen darunter liest oder lieber tippt. Geholt wird es deshalb erst in
   * dem Moment, in dem jemand wirklich sprechen will (siehe `starten`).
   *
   * Diese Typen sind reine Typangaben und verschwinden beim Übersetzen –
   * sie ziehen nichts in das Bündel.
   */
  type SDK = typeof import('@elevenlabs/client');
  type Gespraech = Awaited<ReturnType<SDK['Conversation']['startSession']>>;

  /*
   * Nach jedem Seitenaufbau neu binden.
   *
   * Beim Seitenwechsel tauscht die Website den Körper aus, führt Module aber
   * nicht erneut aus – der Mikrofonknopf hörte danach auf niemanden mehr.
   * Ein laufendes Gespräch wird beim Verlassen der Seite beendet: Es geht um
   * Sprachminuten, die sonst weiterlaufen, während niemand mehr zuhört.
   */
  beimSeitenaufbau(() => {
    /* Das Modul bleibt geladen, auch wenn man die Beratungsseite verlässt –
       ab hier ist also zu prüfen, ob wir überhaupt noch auf ihr sind. */
    const gefunden = document.getElementById('mikro') as HTMLButtonElement | null;
    if (!gefunden) return;
    /* Eigene Bindung, damit die Prüfung oben auch in den Funktionen weiter
       unten gilt – Funktionsdeklarationen werden vorgezogen, die Verengung
       einer geprüften Variablen nicht. */
    const mikro: HTMLButtonElement = gefunden;
    const mikroText = document.getElementById('mikroText')!;
    const zustand = document.getElementById('zustand')!;
    const buehne = document.getElementById('buehne')!;
    const protokoll = document.getElementById('protokoll')!;
    const fehlerbox = document.getElementById('fehlerbox')!;
    const standortWahl = document.getElementById('standortWahl') as HTMLSelectElement;

    let gespraech: Gespraech | null = null;

    // Auf einer Standortseite gelandet? Dann diesen Standort vorauswählen.
    try {
      const gemerkt = localStorage.getItem('ku64:standort');
      if (gemerkt) standortWahl.value = gemerkt;
    } catch {
      /* kein Speicher */
    }

    function setzeZustand(text: string, name: string) {
      zustand.textContent = text;
      buehne.dataset.zustand = name;
    }

    function zeigeFehler(text: string) {
      fehlerbox.hidden = false;
      fehlerbox.textContent = text;
    }

    function protokollZeile(wer: 'Sie' | 'Berater', text: string) {
      const p = document.createElement('p');
      p.className = wer === 'Sie' ? 'zeile zeile-ich' : 'zeile zeile-bot';
      p.innerHTML = `<span class="wer"></span><span class="was"></span>`;
      p.querySelector('.wer')!.textContent = wer;
      p.querySelector('.was')!.textContent = text;
      protokoll.append(p);
      protokoll.scrollTop = protokoll.scrollHeight;
    }

    async function starten() {
      fehlerbox.hidden = true;
      mikro.disabled = true;
      setzeZustand('Verbindung wird aufgebaut…', 'verbindet');

      try {
        /* Jetzt erst die 450 KB holen – und zwar parallel zur
           Mikrofonabfrage, die ohnehin auf eine Entscheidung wartet. Bis
           jemand „Zulassen" geklickt hat, ist das SDK meistens schon da. */
        const sdk = import('@elevenlabs/client');
        /* Die Ablehnung wird unten beim `await` behandelt. Dieser leere
           Fänger sorgt nur dafür, dass ein früher Ausstieg (Demo-Betrieb)
           keine unbehandelte Ablehnung hinterlässt. */
        sdk.catch(() => {});

        // Mikrofon-Erlaubnis, bevor irgendetwas an ElevenLabs geht.
        await navigator.mediaDevices.getUserMedia({ audio: true });

        const slug = standortWahl.value;
        const res = await fetch(`/api/voice-token/${slug ? `?standort=${slug}` : ''}`);
        const daten = await res.json();

        if (daten.demo) {
          setzeZustand('Noch nicht verbunden', 'bereit');
          zeigeFehler(daten.hinweis);
          return;
        }

        if (!res.ok || !daten.signedUrl) {
          throw new Error(daten.fehler || 'Verbindung fehlgeschlagen.');
        }

        const { Conversation } = await sdk;

        gespraech = await Conversation.startSession({
          signedUrl: daten.signedUrl,
          onConnect: () => {
            setzeZustand('Verbunden – sprechen Sie einfach los.', 'verbunden');
            mikroText.textContent = 'Gespräch beenden';
            mikro.disabled = false;
          },
          onDisconnect: () => {
            setzeZustand('Gespräch beendet. Sie können jederzeit neu starten.', 'bereit');
            mikroText.textContent = 'Gespräch starten';
            mikro.disabled = false;
            gespraech = null;
          },
          onModeChange: (modus: { mode: string }) => {
            setzeZustand(
              modus.mode === 'speaking' ? 'Der Berater spricht…' : 'Ich höre zu…',
              modus.mode === 'speaking' ? 'spricht' : 'hoert',
            );
          },
          onMessage: (n: { message: string; source: string }) => {
            if (n?.message) protokollZeile(n.source === 'user' ? 'Sie' : 'Berater', n.message);
          },
          onError: (e: unknown) => {
            console.error('[voice]', e);
            zeigeFehler(
              'Die Verbindung wurde unterbrochen. Bitte versuchen Sie es erneut oder nutzen Sie den Chat.',
            );
          },
        });
      } catch (e) {
        setzeZustand('Bereit. Klicken Sie, um das Gespräch zu starten.', 'bereit');
        mikro.disabled = false;

        const meldung =
          e instanceof DOMException && e.name === 'NotAllowedError'
            ? 'Ohne Mikrofon-Erlaubnis können wir kein Gespräch führen. Sie können stattdessen den Chat nutzen.'
            : e instanceof Error
              ? e.message
              : 'Es ist ein Fehler aufgetreten.';

        zeigeFehler(meldung);
      }
    }

    async function beenden() {
      mikro.disabled = true;
      await gespraech?.endSession();
      gespraech = null;
      mikro.disabled = false;
    }

    mikro?.addEventListener('click', () => (gespraech ? beenden() : starten()));

    /*
     * Verfügbarkeit beim Laden prüfen, nicht erst beim Klick.
     *
     * Solange der Sprachdienst nicht angeschlossen ist, antwortet der
     * Endpunkt mit `demo: true`. Das erfuhr bisher nur, wer auf „Gespräch
     * starten" geklickt hatte – also alle, die es benutzen wollten. Ein
     * Knopf, der aussieht wie ein Angebot und keines ist, ist schlechter als
     * ein Hinweis an derselben Stelle.
     *
     * Die Abfrage ist billig: eine Zeile JSON, kein SDK, keine 450 KB.
     */
    async function verfuegbarkeitPruefen() {
      if (!mikro) return;
      try {
        const res = await fetch('/api/voice-token/');
        const daten = await res.json();
        if (!daten.demo) return;

        mikro.disabled = true;
        mikro.setAttribute('aria-disabled', 'true');
        const text = document.getElementById('mikroText');
        if (text) text.textContent = 'Noch nicht verfügbar';
        setzeZustand(
          'Der Sprachberater wird gerade eingerichtet. Bis dahin beantwortet der Chatberater dieselben Fragen – schriftlich, sofort und ebenfalls rund um die Uhr.',
          'bereit',
        );
      } catch {
        /* Netzfehler: Knopf aktiv lassen. Ein Versuch, der eine Fehlermeldung
           bringt, ist besser als ein Knopf, den wir grundlos sperren. */
      }
    }

    verfuegbarkeitPruefen();

    const steuerung = new AbortController();

    // Beim Verlassen der Seite sauber auflegen – sonst laufen Sprachminuten weiter.
    window.addEventListener(
      'pagehide',
      () => {
        gespraech?.endSession();
      },
      { signal: steuerung.signal },
    );

    /* Auch der Wechsel auf eine andere Seite ist ein Verlassen – nur ohne
       `pagehide`, weil das Dokument dabei bestehen bleibt. */
    return () => {
      gespraech?.endSession();
      steuerung.abort();
    };
  });
</script>

<style>
  .kopf {
    background: linear-gradient(160deg, color-mix(in oklab, var(--akzent) 9%, var(--flaeche)), var(--flaeche) 70%);
    border-bottom: 1px solid var(--linie);
  }

  h1 {
    margin-block: var(--raum-4);
    max-width: 20ch;
  }

  .unter {
    max-width: var(--breite-text);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
  }

  .spalten {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--raum-8);
    align-items: start;
  }

  /* Im Weg, mit Absicht: zwischen Standortwahl und Startknopf. Wer das
     Gespräch beginnt, ist daran vorbeigekommen. */
  .offenlegung {
    display: flex;
    gap: var(--raum-3);
    align-items: flex-start;
    margin-block: var(--raum-5) 0;
    padding: var(--raum-4);
    border: 1px solid var(--linie);
    border-radius: var(--radius-lg);
    background: var(--flaeche-warm);
    font-size: var(--t-sm);
    line-height: var(--zeile-normal);
    color: var(--tinte-weich);
  }
  .offenlegung svg {
    flex-shrink: 0;
    margin-block-start: 2px;
    color: var(--akzent-schrift);
  }
  .offenlegung strong { color: var(--tinte); }

  .feld {
    display: block;
    margin-block-end: var(--raum-5);
    max-width: 26rem;
  }

  .feld span {
    display: block;
    font-size: var(--t-sm);
    font-weight: 600;
    margin-block-end: var(--raum-2);
  }

  .feld select {
    width: 100%;
    padding: 0.75rem var(--raum-3);
    border: 1px solid var(--linie-stark);
    border-radius: var(--radius);
    background: var(--flaeche);
    font-size: var(--t-sm);
  }

  .buehne {
    display: grid;
    place-items: center;
    padding: var(--raum-8) var(--raum-5);
    border: 1px solid var(--linie);
    border-radius: var(--radius-xl);
    background: var(--flaeche-warm);
    text-align: center;
  }

  .welle {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 3.5rem;
    margin-block-end: var(--raum-5);
  }

  .welle span {
    width: 5px;
    height: 12px;
    border-radius: var(--radius-voll);
    background: var(--linie-stark);
    transition: background-color var(--zeit) var(--kurve);
  }

  /* Der Balkenverlauf zeigt, wer gerade dran ist – ohne Text lesen zu müssen. */
  [data-zustand='hoert'] .welle span,
  [data-zustand='spricht'] .welle span {
    background: var(--tinte);
    animation: pulsieren 1s ease-in-out infinite;
  }

  [data-zustand='spricht'] .welle span {
    animation-duration: 0.6s;
  }

  .welle span:nth-child(2) { animation-delay: 0.1s; }
  .welle span:nth-child(3) { animation-delay: 0.2s; }
  .welle span:nth-child(4) { animation-delay: 0.3s; }
  .welle span:nth-child(5) { animation-delay: 0.4s; }

  [data-zustand='verbindet'] .welle span {
    animation: pulsieren 1.4s ease-in-out infinite;
  }

  @keyframes pulsieren {
    0%, 100% { height: 12px; }
    50% { height: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .welle span { animation: none !important; }
  }

  .zustand {
    margin-block-end: var(--raum-5);
    font-size: var(--t-md);
    color: var(--tinte-weich);
  }

  .mikro-hinweis {
    margin-block-start: var(--raum-4);
    font-size: var(--t-xs);
    color: var(--tinte-leise);
    max-width: 32ch;
  }

  .protokoll {
    max-height: 22rem;
    overflow-y: auto;
    margin-block-start: var(--raum-5);
  }

  .protokoll:empty {
    display: none;
  }

  .zeile {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--raum-3);
    padding-block: var(--raum-3);
    border-bottom: 1px solid var(--linie);
    font-size: var(--t-sm);
    line-height: var(--zeile-normal);
  }

  .zeile :global(.wer) {
    font-weight: 700;
    font-size: var(--t-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tinte-leise);
    padding-block-start: 2px;
  }

  .zeile-bot :global(.wer) {
    color: var(--akzent-schrift);
  }

  .fehlerbox {
    margin-block-start: var(--raum-4);
    padding: var(--raum-4);
    border-radius: var(--radius);
    background: var(--fehler-flaeche);
    color: var(--fehler);
    font-size: var(--t-sm);
    line-height: var(--zeile-normal);
  }

  .seite {
    display: grid;
    gap: var(--raum-4);
  }

  .seite h2 {
    font-size: var(--t-md);
    margin-block-end: var(--raum-3);
  }

  .seite p {
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
    margin-block-end: var(--raum-3);
  }

  .nummern {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--raum-3);
  }

  .nummern li {
    display: flex;
    justify-content: space-between;
    gap: var(--raum-3);
    font-size: var(--t-sm);
  }

  .nummern a {
    color: var(--akzent-schrift);
    font-weight: 600;
    white-space: nowrap;
  }

  .liste {
    padding-inline-start: var(--raum-5);
    font-size: var(--t-sm);
    color: var(--tinte-weich);
  }

  .liste li + li {
    margin-block-start: var(--raum-2);
  }

  .grenze {
    background: var(--flaeche-warm);
  }

  .notfall {
    margin-block-start: var(--raum-4);
    padding: var(--raum-3);
    border-radius: var(--radius);
    background: var(--fehler-flaeche);
    color: var(--fehler);
    font-size: var(--t-xs);
    font-weight: 600;
    margin-block-end: 0;
  }

  .faq-bereich {
    padding-block: var(--raum-8);
  }

  .faq-bereich h2 {
    margin-block-end: var(--raum-5);
  }

  .faq-bereich details {
    border-bottom: 1px solid var(--linie);
  }

  .faq-bereich summary {
    padding-block: var(--raum-4);
    font-weight: 600;
    cursor: pointer;
  }

  .faq-bereich p {
    padding-block-end: var(--raum-4);
    max-width: var(--breite-text);
    color: var(--tinte-weich);
  }

  @media (max-width: 62rem) {
    .spalten {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
