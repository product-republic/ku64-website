---
/**
 * Datenschutzerklärung.
 *
 * ⚠️ ENTWURF – muss vor Live-Gang juristisch geprüft werden.
 *
 * Der technische Teil ist belastbar: Er beschreibt exakt, was diese Website
 * tatsächlich tut – geprüft am Code, nicht aus einem Generator übernommen.
 * Was fehlt und nur die Praxis liefern kann, ist als Platzhalter markiert:
 * Verantwortlicher, Datenschutzbeauftragter, Aufbewahrungsfristen der
 * Patientenakte, Auftragsverarbeiter-Verträge.
 */
import { sprachpfade } from '../../i18n/sprachen';
import { spracheAusParameter } from '../../i18n/sprachen';
import { texte } from '../../i18n/katalog';
import Basis from '../../layouts/Basis.astro';
import Vorrangklausel from '../../components/Vorrangklausel.astro';
import { schemaBrotkrumen } from '../../lib/seo';
import Diensteverzeichnis from '../../components/Diensteverzeichnis.astro';

const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

export function getStaticPaths() {
  return sprachpfade();
}

const pfad = '/datenschutz/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.datenschutz'), pfad },
];
---

<Basis
  titel={t('ds.seitentitel')}
  description={t('ds.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
  noindex={true}
>
  <div class="huelle abschnitt">
    <h1>{t('ds.seitentitel')}</h1>
    <Vorrangklausel />

    {/* `set:html`: Die Texte tragen Auszeichnung – fetter Einstieg, <code>
        für das, was die Praxis noch befüllen muss. Warum das hier die
        richtige Ausnahme ist, steht bei den Rechtstexten in texte.ts. */}
    <p class="hinweis hinweis-warnung entwurf" set:html={t('ds.entwurf')} />

    <div class="fliesstext">
      <h2>{t('ds.1Verantwortlicher')}</h2>
      <p set:html={t('ds.verantwortlicherAngaben')} />
      <p set:html={t('ds.datenschutzbeauftragter')} />

      <h2>{t('ds.2WasBeimAufruf')}</h2>
      <p set:html={t('ds.serverdaten')} />
      <p set:html={t('ds.keineAnalyse')} />
      <p set:html={t('ds.schriften')} />

      <h2>{t('ds.3LokaleSpeicherungIm')}</h2>
      <p>{t('ds.lokalEinleitung')}</p>
      <ul>
        <li set:html={t('ds.lokalStandort')} />
        <li set:html={t('ds.lokalTermin')} />
      </ul>
      <p>{t('ds.beidesKoennenSieJederzeit')}</p>

      <h2 id="doctolib">{t('ds.4Doctolib')}</h2>
      <p set:html={t('ds.doctolibEins')} />
      <p set:html={t('ds.doctolibZwei')} />

      <h2 id="anamnese">{t('ds.5Anamnese')}</h2>
      <p set:html={t('ds.anamneseEins')} />
      <p set:html={t('ds.anamneseZwei')} />

      <h2 id="berater">{t('ds.6Berater')}</h2>
      <p set:html={t('ds.beraterText')} />
      <p set:html={t('ds.beraterSprache')} />
      <p set:html={t('ds.beraterHinweis')} />

      <h2 id="laecheln">{t('ds.7Laecheln')}</h2>
      <p set:html={t('ds.laechelnEins')} />
      <p>{t('ds.laechelnAblauf')}</p>
      <ul>
        <li set:html={t('ds.laechelnSpeicher')} />
        <li>{t('ds.laechelnGoogle')}</li>
        <li>{t('ds.dasErgebnisWirdIhnen')}</li>
        <li>{t('ds.nachAbschlussDerAnfrage')}</li>
      </ul>
      <p set:html={t('ds.laechelnSchluss')} />

      {/*
        Das vollständige Verzeichnis, erzeugt aus src/data/dienste.ts.

        Die Abschnitte darüber erklären die vier Verarbeitungen, die eigene
        Erläuterung brauchen – Doctolib, Anamnese, Berater, Lächeln-Vorschau.
        Was fehlte, war die Vollständigkeit: Google Analytics, Google Maps und
        Matterport sind hinzugekommen, und eine handgeschriebene Erklärung
        hinkt so einer Änderung immer nach.

        Deshalb steht hier dieselbe Tabelle wie auf /cookies/. Doppelt ist sie
        nicht: Es ist eine Quelle, an zwei Stellen gesetzt. Wer einen Dienst
        einbaut, kann diesen Abschnitt nicht vergessen – dienste-pruefen.mjs
        bricht den Bau ab, wenn ein fremder Host ohne Eintrag auftaucht.
      */}
      <h2 id="verzeichnis">Verzeichnis aller Dienste und Empfänger</h2>
      <p>
        Diese Übersicht entsteht aus dem Verzeichnis, das die Website selbst führt – sie
        kann deshalb nicht veralten, während die Website sich ändert. Sie nennt zu jedem
        Dienst Zweck, Anbieter, Empfängerland, Rechtsgrundlage, übertragene Daten und
        Speicherdauer. Auch Dienste, die <strong>bewusst nicht</strong> eingebaut wurden,
        stehen mit ihrer Begründung dabei.
      </p>
      <p>
        Ihre Auswahl ändern oder widerrufen können Sie jederzeit auf{' '}
        <a href="/cookies/">Cookie-Einstellungen</a>.
      </p>

      <Diensteverzeichnis stufe={3} />

      <h2>{t('ds.8Kontaktaufnahme')}</h2>
      <p>{t('ds.kontaktText')}</p>

      <h2>{t('ds.9IhreRechte')}</h2>
      <p>{t('ds.rechteText')}</p>
      <p set:html={t('ds.beschwerdeText')} />

      <h2>{t('ds.10Aenderungen')}</h2>
      <p set:html={t('ds.aenderungenText')} />
    </div>
  </div>
</Basis>

<style>
  h1 { margin-block-end: var(--raum-5); }
  .entwurf { max-width: var(--breite-text); margin-block-end: var(--raum-7); }
  code {
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    background: var(--warnung-flaeche);
    color: var(--warnung);
    font-size: 0.9em;
  }
</style>
