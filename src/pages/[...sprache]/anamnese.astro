---
import { sprachpfade } from '../../i18n/sprachen';
import { spracheAusParameter } from '../../i18n/sprachen';
import { texte } from '../../i18n/katalog';
import Basis from '../../layouts/Basis.astro';
import Standortwahl from '../../components/Standortwahl.astro';
import { schemaBrotkrumen } from '../../lib/seo';

const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

export function getStaticPaths() {
  return sprachpfade();
}

const pfad = '/anamnese/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.digitaleAnamnese'), pfad },
];
---

<Basis
  titel="Digitale Anamnese"
  description={t('anamnesez.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
>
  <section class="abschnitt">
    <div class="huelle">
      <h1>{t('anamnesez.digitaleAnamnese')}</h1>
      <p class="unter">{t('anamnesez.fuenfMinutenZuHause')}</p>
      <Standortwahl ziel="anamnese" titel={t('anamnesez.woTermin')} />
    </div>
  </section>
</Basis>

<style>
  .unter {
    max-width: var(--breite-text);
    margin-block: var(--raum-4) var(--raum-5);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
  }
</style>
