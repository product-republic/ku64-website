---
import { inhalte } from '../../i18n/daten';
import { texte } from '../../i18n/katalog';
import { sprachpfade } from '../../i18n/sprachen';
import Basis from '../../layouts/Basis.astro';
import Vorrangklausel from '../../components/Vorrangklausel.astro';
import { schemaBrotkrumen } from '../../lib/seo';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const pfad = '/barrierefreiheit/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.barrierefreiheit'), pfad },
];
---

<Basis
  titel="Barrierefreiheit"
  description={t('bf.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
>
  <div class="huelle abschnitt">
    <h1>Barrierefreiheit</h1>
      <Vorrangklausel />

    <div class="fliesstext">
      <p>{t('bf.dieseWebsiteSollFuer')}</p>

      <h2>{t('bf.wasUmgesetztIst')}</h2>
      <ul>
        <li>{t('bf.alleFunktionenSindMit')}</li>
        <li>{t('bf.einSprunglinkFuehrtDirekt')}</li>
        <li>Semantisches HTML: Überschriftenhierarchie, Landmarken, beschriftete Formulare</li>
        <li>{t('bf.aufklappbareInhalteFunktionierenAuch')}</li>
        <li>{t('bf.bewegteEffekteWerdenBei')}</li>
        <li>{t('bf.einDunklesFarbschemaWird')}</li>
        <li>{t('bf.schriftgroessenSkalierenMitIhren')}</li>
        <li>{t('bf.bedienelementeSindMindestens44')}</li>
        <li>{t('bf.statusmeldungenWerdenScreenreadernAngekuendigt')}</li>
      </ul>

      <h2>{t('bf.wasNochOffenIst')}</h2>
      <ul>
        <li>{t('bf.screenreaderTest')}</li>
        <li>{t('bf.alternativtexteFuerBildmaterialWerden')}</li>
        <li>{t('bf.dieTerminbuchungVonDoctolib')}</li>
        <li>{t('bf.leichteSpracheUndGebaerdensprachvideos')}</li>
      </ul>

      <h2>{t('bf.zugaenglichkeitUnsererPraxen')}</h2>
      <ul>
        {daten.standorte.map((s) => (
          <li>
            <strong>KU64 {s.name}</strong> ({s.ort}):{' '}
            {s.anfahrt.barrierefrei
              ? 'barrierefrei zugänglich'
              : (s.anfahrt.barrierefreiHinweis ?? 'bitte vorab anfragen')}
          </li>
        ))}
      </ul>

      <h2>{t('bf.etwasGefunden')}</h2>
      <p>{t('bf.bitteSagenSieUns')}</p>
      <p><a href="/kontakt/" class="knopf knopf-primaer">{t('bf.barriereMelden')}</a></p>
    </div>
  </div>
</Basis>

<style>
  h1 { margin-block-end: var(--raum-5); }
</style>
