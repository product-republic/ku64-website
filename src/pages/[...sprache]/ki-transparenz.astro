---
/**
 * Transparenzseite zu den KI-Systemen dieser Website.
 *
 * Artikel 50 der Verordnung (EU) 2024/1689 verlangt die Offenlegung dort, wo
 * die Interaktion stattfindet – im Chatfenster, vor dem Gespräch, unter dem
 * erzeugten Bild. Diese Seite ersetzt das nicht und soll es nicht: Eine
 * Unterseite, die niemand aufruft, erfüllt Absatz 1 nicht.
 *
 * Sie beantwortet die Fragen, für die im Hinweisfeld kein Platz ist: Welcher
 * Anbieter, welches Modell, welche Daten, was passiert nicht, und wie man
 * einen Menschen erreicht. Wer das wissen will, will es vollständig wissen und
 * nicht in drei Sätzen.
 *
 * Der Inhalt kommt aus `src/data/ki-systeme.ts` – derselben Datei, aus der die
 * Hinweisfelder ihren Wortlaut ziehen. Ein System, das dort fehlt, fehlt
 * überall; ein System, das dort steht, kann hier nicht vergessen werden.
 */
import { inhalte } from '../../i18n/daten';
import { texte } from '../../i18n/katalog';
import { sprachpfade } from '../../i18n/sprachen';
import Basis from '../../layouts/Basis.astro';
import { schemaBrotkrumen } from '../../lib/seo';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);
const t = texte(daten.sprache);

const pfad = '/ki-transparenz/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.kiTransparenz'), pfad },
];
---

<Basis
  titel={t('krume.kiTransparenz')}
  description={t('ki.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
>
  <section class="kopf abschnitt-eng">
    <div class="huelle">
      <span class="marke marke-akzent">{t('kitrans.marke')}</span>
      <h1>{t('kitrans.woAufDieserWebsite')}</h1>
      <p class="unter">{t('kitrans.dreiSystemeUndWir')}</p>
    </div>
  </section>

  <div class="huelle abschnitt">
    <section class="mensch karte">
      <h2>{t('kitrans.wennSieMitEinem')}</h2>
      <p>{t('kitrans.dasIstKeineAusweichloesung')}</p>
      <ul class="nummern">
        {
          daten.standorte.map((s) => (
            <li>
              <strong>KU64 {s.name}</strong>
              <a href={`tel:${s.telefonRaw.replace(/\s/g, '')}`}>{s.telefon}</a>
            </li>
          ))
        }
      </ul>
      <p class="klein">{t('kitrans.oderSchriftlichUeberDas')}<a href="/kontakt/">{t('kitrans.kontaktformular')}</a>{t('kitrans.beidesBeantwortetEinMensch')}</p>
    </section>

    {
      daten.kiSysteme.map((s) => (
        <section class="system" id={s.slug}>
          <h2>{s.name}</h2>
          <p class="zweck">{s.zweck}</p>

          <p class="hinweis">{s.offenlegung}</p>

          <dl class="angaben">
            <div>
              <dt>{t('kitrans.woSieIhmBegegnen')}</dt>
              <dd>{s.wo}</dd>
            </div>
            <div>
              <dt>{t('kitrans.anbieter')}</dt>
              <dd>{s.anbieter}</dd>
            </div>
            <div>
              <dt>{t('kitrans.modell')}</dt>
              <dd>{s.modell}</dd>
            </div>
            <div>
              <dt>{t('kitrans.wasUebertragenWird')}</dt>
              <dd>{s.daten}</dd>
            </div>
            <div>
              <dt>{t('kitrans.wasNichtPassiert')}</dt>
              <dd>{s.nichtDaten}</dd>
            </div>
            <div>
              <dt>{t('kitrans.grenzen')}</dt>
              <dd>{s.grenzen}</dd>
            </div>
          </dl>
        </section>
      ))
    }

    <section class="rechtlich">
      <h2>{t('kitrans.rechtlicherRahmen')}</h2>
      <p>{t('kitrans.dieseAngabenSetzenArtikel')}</p>
      <p>{t('kitrans.fuerDieLaechelnVorschau')}<code>trainedAlgorithmicMedia</code>{t('kitrans.erBleibtDamitAuch')}</p>
      <p>{t('kitrans.wieIhreDatenVerarbeitet')}<a href="/datenschutz/">{t('kitrans.datenschutzerklaerung')}</a>{t('kitrans.welcheDiensteBeimAufruf')}<a href="/cookies/">{t('krume.cookieEinstellungen')}</a>.
      </p>
    </section>
  </div>
</Basis>

<style>
  .unter {
    max-width: var(--breite-text);
    margin-block-start: var(--raum-4);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
  }

  .mensch {
    max-width: var(--breite-text);
    margin-block-end: var(--raum-8);
  }
  .mensch h2 { font-size: var(--t-xl); }
  .mensch p { margin-block-start: var(--raum-3); color: var(--tinte-weich); line-height: var(--zeile-normal); }
  .nummern {
    list-style: none;
    padding: 0;
    margin-block-start: var(--raum-4);
    display: grid;
    gap: var(--raum-2);
  }
  .nummern li {
    display: flex;
    justify-content: space-between;
    gap: var(--raum-4);
    padding-block: var(--raum-2);
    border-block-end: 1px solid var(--linie);
  }
  .nummern strong { font-weight: 600; }
  .klein { font-size: var(--t-sm); }

  .system {
    max-width: var(--breite-text);
    padding-block: var(--raum-7);
    border-block-start: 1px solid var(--linie);
  }
  .system h2 { font-size: var(--t-xl); }
  .zweck {
    margin-block-start: var(--raum-3);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
  }

  /* Die Offenlegung trägt hier dieselbe Aussage wie im Hinweisfeld am System
     selbst – wortgleich, weil zwei Formulierungen für denselben Sachverhalt
     die Frage aufwerfen, welche gilt. */
  .hinweis {
    margin-block-start: var(--raum-4);
    padding: var(--raum-3) var(--raum-4);
    border-inline-start: 3px solid var(--akzent-schrift);
    background: var(--flaeche-warm);
    font-weight: 600;
    line-height: var(--zeile-normal);
  }

  .angaben {
    margin-block-start: var(--raum-5);
    display: grid;
    gap: var(--raum-4);
  }
  .angaben dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinte-leise);
  }
  .angaben dd {
    margin: var(--raum-1) 0 0;
    line-height: var(--zeile-normal);
  }

  .rechtlich {
    max-width: var(--breite-text);
    padding-block-start: var(--raum-7);
    border-block-start: 1px solid var(--linie);
  }
  .rechtlich h2 { font-size: var(--t-xl); }
  .rechtlich p {
    margin-block-start: var(--raum-4);
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
  }
  .rechtlich code {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    background: var(--flaeche-warm);
  }
</style>
