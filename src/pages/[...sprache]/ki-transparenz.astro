---
/**
 * Transparenzseite zu den KI-Systemen dieser Website.
 *
 * Artikel 50 der Verordnung (EU) 2024/1689 verlangt die Offenlegung dort, wo
 * die Interaktion stattfindet – im Chatfenster, vor dem Gespräch, unter dem
 * erzeugten Bild. Diese Seite ersetzt das nicht und soll es nicht: Eine
 * Unterseite, die niemand aufruft, erfüllt Absatz 1 nicht.
 *
 * Sie beantwortet die Fragen, für die im Hinweisfeld kein Platz ist: Welcher
 * Anbieter, welches Modell, welche Daten, was passiert nicht, und wie man
 * einen Menschen erreicht. Wer das wissen will, will es vollständig wissen und
 * nicht in drei Sätzen.
 *
 * Der Inhalt kommt aus `src/data/ki-systeme.ts` – derselben Datei, aus der die
 * Hinweisfelder ihren Wortlaut ziehen. Ein System, das dort fehlt, fehlt
 * überall; ein System, das dort steht, kann hier nicht vergessen werden.
 */
import { inhalte } from '../../i18n/daten';
import { sprachpfade } from '../../i18n/sprachen';
import Basis from '../../layouts/Basis.astro';
import { KI_SYSTEME } from '../../data/ki-systeme';
import { schemaBrotkrumen } from '../../lib/seo';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);

const pfad = '/ki-transparenz/';
const brotkrumen = [
  { name: 'Start', pfad: '/' },
  { name: 'KI-Transparenz', pfad },
];
---

<Basis
  titel="KI-Transparenz"
  description="Welche KI-Systeme auf dieser Website arbeiten, wofür, mit welchen Daten – und wie Sie stattdessen einen Menschen erreichen."
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
>
  <section class="kopf abschnitt-eng">
    <div class="huelle">
      <span class="marke marke-akzent">Transparenz</span>
      <h1>Wo auf dieser Website KI arbeitet</h1>
      <p class="unter">
        Drei Systeme, und wir sagen bei jedem, was es tut, wer es betreibt und was mit
        Ihren Eingaben geschieht. Sie müssen keines davon benutzen: Alles, was sie
        beantworten, beantwortet Ihnen auch jemand am Telefon.
      </p>
    </div>
  </section>

  <div class="huelle abschnitt">
    <section class="mensch karte">
      <h2>Wenn Sie mit einem Menschen sprechen möchten</h2>
      <p>
        Das ist keine Ausweichlösung, sondern der normale Weg. Rufen Sie den Standort an,
        der Ihnen am nächsten liegt:
      </p>
      <ul class="nummern">
        {
          daten.standorte.map((s) => (
            <li>
              <strong>KU64 {s.name}</strong>
              <a href={`tel:${s.telefonRaw.replace(/\s/g, '')}`}>{s.telefon}</a>
            </li>
          ))
        }
      </ul>
      <p class="klein">
        Oder schriftlich über das <a href="/kontakt/">Kontaktformular</a>. Beides
        beantwortet ein Mensch.
      </p>
    </section>

    {
      KI_SYSTEME.map((s) => (
        <section class="system" id={s.slug}>
          <h2>{s.name}</h2>
          <p class="zweck">{s.zweck}</p>

          <p class="hinweis">{s.offenlegung}</p>

          <dl class="angaben">
            <div>
              <dt>Wo Sie ihm begegnen</dt>
              <dd>{s.wo}</dd>
            </div>
            <div>
              <dt>Anbieter</dt>
              <dd>{s.anbieter}</dd>
            </div>
            <div>
              <dt>Modell</dt>
              <dd>{s.modell}</dd>
            </div>
            <div>
              <dt>Was übertragen wird</dt>
              <dd>{s.daten}</dd>
            </div>
            <div>
              <dt>Was nicht passiert</dt>
              <dd>{s.nichtDaten}</dd>
            </div>
            <div>
              <dt>Grenzen</dt>
              <dd>{s.grenzen}</dd>
            </div>
          </dl>
        </section>
      ))
    }

    <section class="rechtlich">
      <h2>Rechtlicher Rahmen</h2>
      <p>
        Diese Angaben setzen Artikel 50 der Verordnung (EU) 2024/1689 über künstliche
        Intelligenz um. Der Artikel verlangt dreierlei: Wer mit einem KI-System
        interagiert, muss das spätestens bei der ersten Interaktion erfahren. Erzeugte
        Inhalte müssen maschinenlesbar als solche gekennzeichnet sein. Und veränderte
        Bilder von Menschen müssen auch sichtbar gekennzeichnet sein.
      </p>
      <p>
        Für die Lächeln-Vorschau heißt das konkret: Der Hinweis steht in einem Streifen
        am Bild und zusätzlich in der Bilddatei selbst, als IPTC-Angabe
        <code>trainedAlgorithmicMedia</code>. Er bleibt damit auch dann erhalten, wenn
        das Bild diese Website verlässt – per E-Mail, weitergeleitet, gespeichert.
      </p>
      <p>
        Wie Ihre Daten verarbeitet werden, steht in der
        <a href="/datenschutz/">Datenschutzerklärung</a>. Welche Dienste beim Aufruf
        geladen werden, in den <a href="/cookies/">Cookie-Einstellungen</a>.
      </p>
    </section>
  </div>
</Basis>

<style>
  .unter {
    max-width: var(--breite-text);
    margin-block-start: var(--raum-4);
    font-size: var(--t-lg);
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
  }

  .mensch {
    max-width: var(--breite-text);
    margin-block-end: var(--raum-8);
  }
  .mensch h2 { font-size: var(--t-xl); }
  .mensch p { margin-block-start: var(--raum-3); color: var(--tinte-weich); line-height: var(--zeile-normal); }
  .nummern {
    list-style: none;
    padding: 0;
    margin-block-start: var(--raum-4);
    display: grid;
    gap: var(--raum-2);
  }
  .nummern li {
    display: flex;
    justify-content: space-between;
    gap: var(--raum-4);
    padding-block: var(--raum-2);
    border-block-end: 1px solid var(--linie);
  }
  .nummern strong { font-weight: 600; }
  .klein { font-size: var(--t-sm); }

  .system {
    max-width: var(--breite-text);
    padding-block: var(--raum-7);
    border-block-start: 1px solid var(--linie);
  }
  .system h2 { font-size: var(--t-xl); }
  .zweck {
    margin-block-start: var(--raum-3);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
  }

  /* Die Offenlegung trägt hier dieselbe Aussage wie im Hinweisfeld am System
     selbst – wortgleich, weil zwei Formulierungen für denselben Sachverhalt
     die Frage aufwerfen, welche gilt. */
  .hinweis {
    margin-block-start: var(--raum-4);
    padding: var(--raum-3) var(--raum-4);
    border-inline-start: 3px solid var(--akzent-schrift);
    background: var(--flaeche-warm);
    font-weight: 600;
    line-height: var(--zeile-normal);
  }

  .angaben {
    margin-block-start: var(--raum-5);
    display: grid;
    gap: var(--raum-4);
  }
  .angaben dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinte-leise);
  }
  .angaben dd {
    margin: var(--raum-1) 0 0;
    line-height: var(--zeile-normal);
  }

  .rechtlich {
    max-width: var(--breite-text);
    padding-block-start: var(--raum-7);
    border-block-start: 1px solid var(--linie);
  }
  .rechtlich h2 { font-size: var(--t-xl); }
  .rechtlich p {
    margin-block-start: var(--raum-4);
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
  }
  .rechtlich code {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    background: var(--flaeche-warm);
  }
</style>
