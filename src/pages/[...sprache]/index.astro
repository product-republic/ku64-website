---
/**
 * Startseite. Ihre einzige Aufgabe: die Person schnell und bewusst zum
 * richtigen Standort bringen.
 *
 * Es findet KEINE automatische Weiterleitung statt – weder per Geolocation
 * noch per gespeichertem Standort. Wer einmal Potsdam gewählt hat, bekommt
 * Potsdam angeboten, aber die Entscheidung bleibt sichtbar und umkehrbar.
 */
import { inhalte } from '../../i18n/daten';
import { sprachpfade } from '../../i18n/sprachen';
import Basis from '../../layouts/Basis.astro';
import Video from '../../components/Video.astro';
import { videosStart } from '../../data/videos';
import Bild from '../../components/Bild.astro';
import Kopfmedium from '../../components/Kopfmedium.astro';
import { standortbildFuer } from '../../data/medien';
import { oeffnungstageTeile } from '../../data/standorte';
import { schemaOrganisation, schemaFaq } from '../../lib/seo';
import { texte } from '../../i18n/katalog';

export function getStaticPaths() {
  return sprachpfade();
}

const daten = inhalte(Astro);

const gesamtLeistungen = daten.leistungen.length;
const t = texte(daten.sprache);

/*
 * Häufige Fragen – Text aus dem Katalog, Zahlen und Adressen als Platzhalter.
 *
 * Diese vier Sätze standen bis eben hier als deutsche Zeichenkette. Sie
 * erscheinen sichtbar auf der Seite UND über `schemaFaq()` im JSON-LD; auf
 * /en/ und /fr/ waren damit beide deutsch. Die Standortliste bleibt eine
 * Aufzählung aus Eigennamen und Adressen und wird nicht übersetzt.
 */
const faq = [
  {
    frage: t('faq.start.wieVieleStandorte.frage'),
    antwort: t('faq.start.wieVieleStandorte.antwort', {
      anzahl: daten.standorte.length,
      standorte: daten.standorte
        .map((s) => `${s.name} (${s.strasse}, ${s.plz} ${s.ort})`)
        .join(', '),
    }),
  },
  {
    frage: t('faq.start.alleLeistungen.frage'),
    antwort: t('faq.start.alleLeistungen.antwort'),
  },
  {
    frage: t('faq.start.terminBuchen.frage'),
    antwort: t('faq.start.terminBuchen.antwort'),
  },
  {
    frage: t('faq.start.akuteSchmerzen.frage'),
    antwort: t('faq.start.akuteSchmerzen.antwort'),
  },
];

/* Die Länge des Satzes bestimmt seine Schriftgröße im Kopf – siehe die
   Erklärung bei `h1` weiter unten. Sie kommt aus dem Text selbst, damit sie
   in jeder Sprache stimmt, ohne dass jemand daran denken muss. */
const ueberschrift = t('start.ueberschrift');

const startVideos = videosStart();
---

<Basis
  titel={t('start.seitentitel')}
  description={`KU64 – Die Zahnspezialisten an ${daten.standorte.length} Standorten in Berlin und Potsdam. Wählen Sie Ihren Standort und sehen Sie genau die Leistungen, die dort angeboten werden.`}
  pfad="/"
  schema={[schemaOrganisation(), schemaFaq(faq)]}
>
  <section class="held held-medium auf-medium">
    {/*
      Das Kopfmedium der Startseite ist der Kurfürstendamm.

      Das ist eine bewusste Ausnahme von der Regel, dass diese Seite keinen
      Standort vorwegnimmt: Sie zeigt ihn als BILD, nicht als Auswahl. Die
      gelbe Höhle am Ku'damm ist seit zwanzig Jahren das, woran man KU64
      erkennt – sie steht hier für die Marke, nicht für eine Adresse.
      Verlinkt wird von hier aus nichts; die Wahl trifft man weiter unten
      an vier gleichrangigen Karten.
    */}
    <Kopfmedium standortSlug="berlin-charlottenburg" />
    {/* Der weite Rahmen, nicht der normale: Die Überschrift soll über die
        ganze Seite laufen. Der Fließtext darunter bleibt schmal – eine Zeile
        über 1300 Pixel liest niemand gern. */}
    <div class="huelle-weit">
      <p class="held-marke">{t('start.ku64DieZahnspezialisten')}</p>
      <h1 style={`--zeichen:${ueberschrift.length}`}>{ueberschrift}</h1>
      <p class="held-text">{t('start.vorspann', { anzahl: daten.standorte.length })}</p>

      {/* Zuletzt gewählter Standort – ein Angebot, keine Umleitung. */}
      <div class="zuletzt" id="zuletzt" hidden>
        <p data-vorlage={t('start.zuletztWaren', { standort: '{standort}' })}>
          <strong id="zuletzt-name"></strong>
        </p>
        <a href="#" id="zuletzt-link" class="knopf knopf-primaer">{t('start.zuletztZurueck')}</a>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="huelle-weit">
      <div class="standort-raster">
        {
          daten.standorte.map((s) => {
            const anzahl = daten.leistungenHier(s.slug).length;
            return (
              <article
                class="s-karte karte karte-klickbar einblenden"
                style={`--akzent:${s.akzent}`}
              >
                {/* Der Raum, den man betritt – statt eines gelben Balkens. */}
                <Bild schluessel={standortbildFuer(s.slug) ?? ''} klasse="s-bild" />
                <h2>
                  <a href={`/${s.slug}/`} class="karte-link">
                    KU64 {s.name}
                  </a>
                </h2>
                <address>
                  {s.strasse}
                  <br />
                  {s.plz} {s.ort}
                </address>
                <p class="s-claim">{s.claim}</p>
                <dl class="s-fakten">
                  <div>
                    <dt>{t('karte.behandlungen')}</dt>
                    <dd>{anzahl}</dd>
                  </div>
                  <div>
                    <dt>{t('karte.geoeffnet')}</dt>
                    {/* Je Sinneinheit ein Stück, das nicht umbrochen wird –
                        sonst steht „Sa" allein hinter „7 Tage/Woche" und der
                        Vorbehalt erst eine Zeile tiefer. Siehe
                        `oeffnungstageTeile` in standorte.ts. */}
                    <dd class="zeiten">
                      {oeffnungstageTeile(s, t).map((teil) => <span>{teil}</span>)}
                    </dd>
                  </div>
                  <div>
                    <dt>{t('karte.telefon')}</dt>
                    <dd>{s.telefon}</dd>
                  </div>
                </dl>
                <span class="s-mehr">
                  {t('karte.standortAnsehen')}
                  <svg viewBox="0 0 16 12" width="15" height="11" aria-hidden="true">
                    <path
                      d="M1 6h13M9.5 1.5 14 6l-4.5 4.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="abschnitt flaeche-warm">
    <div class="huelle">
      <h2>{t('start.warumTitel')}</h2>
      <div class="raster-zwei erklaer">
        <p>{t('start.warumEins')}</p>
        <p>{t('start.warumZwei', { anzahl: gesamtLeistungen })}</p>
      </div>
    </div>
  </section>

  {
    startVideos.length > 0 && (
      <section class="abschnitt" aria-labelledby="start-videos-titel">
        <div class="huelle">
          <h2 id="start-videos-titel">{t('video.ueberschrift')}</h2>
          <div class="start-videos">
            {startVideos.map((v) => (
              <Video video={v} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="abschnitt">
    <div class="huelle">
      <h2>{t('start.digitalTitel')}</h2>
      <div class="raster">
        <a href="/laecheln-vorschau/" class="karte karte-klickbar dienst">
          <h3>Lächeln-Vorschau</h3>
          <p>{t('start.laechelnText')}</p>
          <span class="dienst-mehr">{t('start.laechelnKnopf')}</span>
        </a>
        <a href="/anamnese/" class="karte karte-klickbar dienst">
          <h3>{t('start.digitaleAnamnese')}</h3>
          <p>{t('start.anamneseText')}</p>
          <span class="dienst-mehr">{t('start.anamneseKnopf')}</span>
        </a>
        <a href="/beratung/" class="karte karte-klickbar dienst">
          <h3>{t('start.digitalerBerater')}</h3>
          <p>{t('start.beraterText')}</p>
          <span class="dienst-mehr">{t('start.beraterKnopf')}</span>
        </a>
      </div>
    </div>
  </section>
</Basis>

<script>
  import { beimSeitenaufbau } from '../../lib/seitenaufbau';

  /*
   * Zuletzt gewählten Standort anbieten. Bewusst als Vorschlag mit Namen und
   * Klick – keine automatische Weiterleitung, weil die sonst genau das
   * Problem erzeugt, das diese Seite lösen soll.
   */
  const STANDORT_NAMEN: Record<string, string> = {
    'berlin-charlottenburg': 'KU64 Kurfürstendamm',
    berlinmitte: 'KU64 Berlin-Mitte',
    wilmersdorf: 'KU64 Wilmersdorf',
    potsdam: 'KU64 Potsdam',
  };

  /* Nach jedem Seitenaufbau – wer von einer Standortseite zurück auf die
     Startseite wechselt, soll den Vorschlag sehen, und genau dann ist das
     Modul längst ausgeführt. */
  beimSeitenaufbau(() => {
    try {
      const slug = localStorage.getItem('ku64:standort');
      if (slug && STANDORT_NAMEN[slug]) {
        const box = document.getElementById('zuletzt');
        const name = document.getElementById('zuletzt-name');
        const link = document.getElementById('zuletzt-link') as HTMLAnchorElement | null;
        if (box && name && link) {
          name.textContent = STANDORT_NAMEN[slug];
          link.href = `/${slug}/`;
          box.hidden = false;
        }
      }
    } catch {
      /* Kein localStorage verfügbar – dann eben ohne Vorschlag. */
    }
  });
</script>

<style>
  .start-videos { max-width: 44rem; display: flex; flex-direction: column; gap: var(--raum-5); }

  /*
   * Der Kopf der Startseite steht auf einem Medium, nicht auf einem Verlauf.
   *
   * Vorher lag hier ein heller Gelbverlauf: sauber, aber er zeigte nichts.
   * Wer zum ersten Mal kommt, will vor allem eines wissen – wie sieht es da
   * aus? Der Rundgang durch die Praxis beantwortet das in zwei Sekunden und
   * besser als jeder Satz darüber.
   */
  .held {
    position: relative;
    padding-block: clamp(var(--raum-9), 15vw, 13rem) clamp(var(--raum-7), 8vw, var(--raum-9));
    border-end-start-radius: var(--radius-xl);
    border-end-end-radius: var(--radius-xl);
    overflow: hidden;
  }

  .held-medium .held-marke {
    color: var(--auf-medium-schrift-leise);
  }

  .held-medium .held-text {
    color: var(--auf-medium-schrift);
  }

  .held-marke {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--akzent-schrift);
  }

  /*
   * Auf dem Telefon bricht die Überschrift nach vierzehn Zeichen um – sonst
   * stünden dort drei Wörter je Zeile und die Zeile wäre schmaler als der
   * Daumen.
   *
   * `text-wrap: balance` verteilt den Rest gleichmäßig – etwa auf
   * Französisch, wo derselbe Satz länger ist.
   */
  h1 {
    font-size: var(--t-4xl);
    margin-block: var(--raum-4);
    max-width: 14ch;
    text-wrap: balance;
  }

  /*
   * Auf dem Schreibtisch läuft die Überschrift in EINER Zeile über die
   * ganze Breite.
   *
   * ── Warum nicht einfach eine große Schrift ──────────────────────────
   *
   * Weil „groß" und „über die ganze Breite" nicht dasselbe sind. Mit einer
   * festen Größe passiert je nach Sprache eines von beidem Falschen: Der
   * deutsche Satz („Wo dürfen wir Sie behandeln?") bricht nach „Sie" um und
   * die zweite Zeile besteht aus einem Wort; der englische („Where may we
   * treat you?") ist fünf Zeichen kürzer und hört weit vor dem rechten Rand
   * auf. Eine Größe, die für alle drei Sprachen stimmt, gibt es nicht.
   *
   * ── Wie es hier gelöst ist ──────────────────────────────────────────
   *
   * Die Größe wird aus der Breite geteilt durch die Zeichenzahl bestimmt,
   * statt geraten. `--zeichen` steht im Markup und ist die Länge des Satzes
   * in der Sprache, die gerade gilt – ohne Zutun, weil sie aus dem Text
   * selbst kommt.
   *
   * Der Faktor 0,53 ist die mittlere Zeichenbreite dieser Schrift, gemessen
   * bei 100 px: deutsch 50,3 px, englisch und französisch je 51,9 px. 0,53
   * liegt knapp darüber und lässt damit den Rest Luft, den Zeichenzahl als
   * Näherung braucht.
   *
   * `100cqi` ist die INNENbreite der Hülle, nicht die des Fensters. Damit
   * stimmt die Rechnung auch dort, wo beides auseinanderläuft: ab 1600 px
   * wächst das Fenster weiter, die Hülle nicht mehr.
   *
   * Die 7,5 rem sind die Obergrenze – nicht die gewünschte Größe, sondern
   * die Stelle, an der eine Überschrift aufhört, eine zu sein. Erreicht wird
   * sie nur vom kürzesten der drei Sätze auf sehr breiten Schirmen.
   *
   * Ergebnis, gemessen von 960 bis 2560 px in allen drei Sprachen: überall
   * eine Zeile, überall 95 bis 98 Prozent der Breite gefüllt.
   */
  @media (min-width: 60rem) {
    .huelle-weit {
      container-type: inline-size;
    }

    h1 {
      max-width: none;
      font-size: min(7.5rem, 100cqi / (var(--zeichen, 28) * 0.53));
      /*
       * KEIN eigenes `line-height` mehr – es galt hier 1,02.
       *
       * Bei 73 px Schriftgrad sind das 74,8 px Zeilenbox für einen
       * Schriftkegel von 1,21 em, also 88 px. Die Unterlänge des „ü" in
       * „dürfen" ragte 14,2 px darunter hinaus und lag unter dem nächsten
       * Kasten. Auf dem Schirm sah es aus, als sei der Text unten
       * angeschnitten – gemeldet von `npm run abschnitt:pruefen`.
       *
       * Eine große Überschrift verträgt die 1,22 aus `--zeile-eng` ohne
       * Weiteres: Sie steht hier in EINER Zeile, die Zeilenhöhe wirkt
       * deshalb nicht als Durchschuss, sondern nur als Kastenhöhe – und
       * genau die fehlte darunter.
       *
       * Die optische Enge trägt die Laufweite, nicht die Zeile.
       */
      letter-spacing: -0.02em;
      /*
       * Hier KEIN `balance`: Es verteilt gleichmäßig auf zwei Zeilen, auch
       * wenn eine gereicht hätte. Genau das war der Fehler – die
       * Überschrift stand groß da und trotzdem nur über der halben Seite.
       */
      text-wrap: initial;
    }
  }

  .held-text {
    max-width: 52ch;
    font-size: var(--t-lg);
    line-height: var(--zeile-weit);
    color: var(--tinte-weich);
  }

  .zuletzt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--raum-4);
    margin-block-start: var(--raum-6);
    padding: var(--raum-4) var(--raum-5);
    background: var(--flaeche);
    border: 1px solid var(--linie);
    border-radius: var(--radius-lg);
    box-shadow: var(--schatten-sm);
    width: fit-content;
  }

  .zuletzt p {
    font-size: var(--t-sm);
    color: var(--tinte-weich);
  }

  /*
   * Vier Standorte, eine Reihe.
   *
   * `auto-fit` mit 20 rem Mindestbreite ergab bei üblichen Fensterbreiten drei
   * Karten und eine allein darunter. Das liest sich wie eine Rangfolge, die es
   * nicht gibt: drei richtige Praxen und ein Nachzügler.
   *
   * Deshalb fest vier Spalten, sobald der Platz reicht, und darunter in zwei
   * klaren Stufen: zwei mal zwei, dann untereinander. Kein Zustand, in dem
   * eine Karte allein steht.
   */
  .standort-raster {
    display: grid;
    gap: var(--raum-5);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 78rem) {
    .standort-raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .standort-raster {
      grid-template-columns: 1fr;
    }
  }

  .s-karte {
    overflow: hidden;
    /* Das Bild sitzt in der Kartenkante, nicht im Innenabstand – deshalb
       liegt der Abstand hier nicht oben, sondern das Bild zieht sich mit
       negativem Rand über die Polsterung hinaus. */
    padding-block-start: 0;
  }

  .s-karte :global(.s-bild) {
    margin: calc(var(--raum-5) * -1) calc(var(--raum-5) * -1) var(--raum-5);
    border-radius: 0;
  }

  .s-karte :global(.s-bild img) {
    width: 100%;
    /* Breites Format: Es geht um den Raumeindruck, nicht um Einzelheiten. */
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .s-karte h2 {
    /* Dieselbe Größe wie auf der Standortübersicht, aus demselben Grund:
       „KU64 Kurfürstendamm" passt bei `--t-xl` nicht in eine Spalte von
       vieren und bricht mitten im Wort. Begründung dort ausführlich. */
    font-size: var(--t-lg);
  }

  .s-karte h2 a {
    text-decoration: none;
  }

  .s-karte address {
    margin-block: var(--raum-2) var(--raum-3);
    font-style: normal;
    font-size: var(--t-sm);
    color: var(--tinte-leise);
    line-height: var(--zeile-normal);
  }

  .s-claim {
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
  }

  /*
   * Drei Angaben nebeneinander, solange sie hineinpassen.
   *
   * Feste drei Spalten schnitten die Telefonnummer ab, sobald die Karte
   * schmal wurde. `auto-fit` mit Mindestbreite bricht stattdessen um – eine
   * Telefonnummer in zwei Zeilen ist lesbar, eine abgeschnittene nicht.
   */
  .s-fakten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(6.5rem, 100%), 1fr));
    gap: var(--raum-3);
    margin-block: var(--raum-5) var(--raum-4);
    padding-block-start: var(--raum-4);
    border-top: 1px solid var(--linie);
  }

  .s-fakten dt {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinte-leise);
  }

  .s-fakten dd {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: 600;
  }

  .s-mehr {
    display: inline-flex;
    align-items: center;
    gap: var(--raum-2);
    margin-block-start: auto;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--akzent-schrift);
  }

  .s-mehr svg {
    transition: transform var(--zeit) var(--kurve);
  }

  .s-karte:hover .s-mehr svg {
    transform: translateX(3px);
  }

  .flaeche-warm {
    background: var(--flaeche-warm);
    border-block: 1px solid var(--linie);
  }

  .erklaer {
    margin-block-start: var(--raum-5);
    font-size: var(--t-md);
    line-height: var(--zeile-weit);
    color: var(--tinte-weich);
  }

  .dienst {
    text-decoration: none;
  }

  .dienst h3 {
    font-size: var(--t-lg);
    margin-block-end: var(--raum-2);
  }

  .dienst p {
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
    margin-block-end: var(--raum-4);
  }

  .dienst-mehr {
    margin-block-start: auto;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--akzent-schrift);
  }

  .zeiten span {
    white-space: nowrap;
  }

  .zeiten span + span::before {
    content: ' ';
    white-space: normal;
  }
</style>
