---
import { sprachpfade } from '../../i18n/sprachen';
import { spracheAusParameter } from '../../i18n/sprachen';
import { texte } from '../../i18n/katalog';
import Basis from '../../layouts/Basis.astro';
import Vorrangklausel from '../../components/Vorrangklausel.astro';
import { schemaBrotkrumen } from '../../lib/seo';

const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

export function getStaticPaths() {
  return sprachpfade();
}

const pfad = '/cookies/';
const brotkrumen = [
  { name: t('krume.start'), pfad: '/' },
  { name: t('krume.cookieEinstellungen'), pfad },
];
---

<Basis
  titel="Cookie-Einstellungen"
  description={t('ck.beschreibung')}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={[schemaBrotkrumen(brotkrumen)]}
>
  <div class="huelle abschnitt">
    <h1>{t('ck.seitentitel')}</h1>
      <Vorrangklausel />

    <div class="fliesstext">
      <p set:html={t('ck.einleitung')} />

      <h2>{t('ck.wasTatsaechlichGespeichertWird')}</h2>
      <p>{t('ck.zweiAngaben')}</p>
      <ul>
        <li>
          <strong>ku64:standort</strong>{t('ck.ihrZuletztGewaehlterStandort')}</li>
        <li>
          <strong>ku64:einwilligung</strong>{t('ck.nurVorhandenWennSie')}</li>
      </ul>

      <h2>{t('ck.wannDochDrittanbieterIns')}</h2>
      <p
        set:html={t('ck.drittanbieterText', {
          verweis: `<a href="/datenschutz/">${t('ck.datenschutzerklaerung')}</a>`,
        })}
      />

      <h2>{t('ck.loeschen')}</h2>
      <p>{t('ck.einKlickGenuegtDanach')}</p>
      <p>
        <button type="button" class="knopf knopf-primaer" id="loeschen">{t('ck.gespeicherteAngabenLoeschen')}</button>
      </p>
      <p class="ergebnis" id="ergebnis" role="status" aria-live="polite"></p>
    </div>
  </div>
</Basis>

<script>
  import { beimSeitenaufbau } from '../../lib/seitenaufbau';

  /* Nach jedem Seitenaufbau neu binden – der Knopf ist beim Seitenwechsel
     ein anderes Element, das Modul läuft aber nicht noch einmal. */
  beimSeitenaufbau(() => {
    document.getElementById('loeschen')?.addEventListener('click', () => {
      const ergebnis = document.getElementById('ergebnis');
      try {
        localStorage.removeItem('ku64:standort');
        localStorage.removeItem('ku64:einwilligung');
        /* Der alte Schlüssel aus der Zeit, als der Terminkalender eingebettet
           werden sollte. Wer ihn noch hat, soll ihn hier loswerden können. */
        localStorage.removeItem('ku64:doctolib-ok');
        if (ergebnis) ergebnis.textContent = 'Erledigt – alle lokal gespeicherten Angaben wurden gelöscht.';
      } catch {
        if (ergebnis) ergebnis.textContent = 'Ihr Browser erlaubt keinen Zugriff auf den lokalen Speicher – es ist ohnehin nichts gespeichert.';
      }
    });
  });
</script>

<style>
  h1 { margin-block-end: var(--raum-5); }
  .ergebnis:not(:empty) {
    padding: var(--raum-3) var(--raum-4);
    border-radius: var(--radius);
    background: var(--erfolg-flaeche);
    color: var(--erfolg);
    font-size: var(--t-sm);
    font-weight: 600;
  }
</style>
