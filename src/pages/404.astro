---
/**
 * 404-Seite.
 *
 * Der Anspruch war, dass es möglichst keine Sackgassen gibt. Wo eine Adresse
 * trotzdem ins Leere läuft, soll sie nicht mit einer Entschuldigung enden,
 * sondern mit einem Weg: Suche über alle Behandlungen plus Standortwahl.
 */
import { inhalte } from '../i18n/daten';
import Basis from '../layouts/Basis.astro';
import { texte } from '../i18n/katalog';

const daten = inhalte(Astro);
const t = texte(daten.sprache);


const suchindex = daten.leistungen.map((l) => ({
  slug: l.slug,
  name: l.name,
  begriffe: [l.name, l.kurz, ...l.synonyme].join(' ').toLowerCase(),
}));

/*
 * Der wichtigste 404-Fall überhaupt: jemand ruft eine Behandlung an einem
 * Standort auf, der sie nicht anbietet – über einen alten Link, ein
 * Suchergebnis oder geratene Adresse. Statt einer allgemeinen Fehlerseite
 * bekommt diese Person eine präzise Antwort: Hier nicht, dort schon.
 *
 * Die Auflösung passiert im Browser, weil eine statische Seite den
 * aufgerufenen Pfad zur Buildzeit nicht kennen kann. Der HTTP-Status bleibt
 * korrekt 404 – die Seite existiert ja tatsächlich nicht.
 */
/*
 * Die Sätze für das Skript.
 *
 * Sie stehen im Katalog wie jeder andere Text und werden dem Skript
 * mitgegeben. Sie dort direkt hinzuschreiben wäre der Fehler, den der
 * Sprachwächter nicht sehen kann: In einem Skript findet er nichts.
 */
const skripttexte = {
  gibtEsNichtIn: t('fehler.gibtEsNichtIn'),
  stattdessenDort: t('fehler.stattdessenDort'),
  nirgends: t('fehler.nirgends'),
  beiStandort: t('fehler.beiStandort'),
  alleBehandlungenIn: t('fehler.alleBehandlungenIn'),
  und: t('fehler.und'),
};

const kombinationen = {
  standorte: Object.fromEntries(
    daten.standorte.map((s) => [s.slug, { name: s.name, ort: s.ort }]),
  ),
  leistungen: Object.fromEntries(
    daten.leistungen.map((l) => [
      l.slug,
      {
        name: l.name,
        verfuegbar: l.verfuegbar,
      },
    ]),
  ),
};
---

<Basis
  titel={t('fehler.seitentitel')}
  description={t('fehler.beschreibung')}
  pfad="/404/"
  {/* Es gibt keine Route /404/ – die Seite wird als 404.html gebaut und für
      jede unbekannte Adresse ausgeliefert. Der Sprachwähler zeigt deshalb
      auf die Startseite der jeweiligen Sprache statt auf eine zweite Seite,
      die es nicht gibt. */}
  sprachwahlPfad="/"
  noindex={true}
>
  <section class="abschnitt">
    <div class="huelle">
      <p class="code">404</p>

      {/*
        Eine H1, nicht zwei.

        Vorher stand hier eine zweite, leere H1 im Kasten für die präzise
        Antwort – ausgeblendet, aber im Markup. Zwei erste Ebenen auf einer
        Seite heißen: Es gibt zwei Anfänge, und die Gliederung stimmt nicht.
        Dass immer nur eine sichtbar ist, weiß der Quelltext nicht.

        Jetzt gibt es eine, und das Skript schreibt ihren Text um, wenn die
        Adresse eine Behandlung an einem Standort meint, der sie nicht
        anbietet.
      */}
      <h1 id="titel">{t('fehler.titel')}</h1>

      {/* Präzise Antwort. Wird per Skript eingeblendet. */}
      <div class="treffer-box" id="treffer" hidden>
        <p class="treffer-text" id="treffer-text"></p>
        <div class="treffer-knoepfe" id="treffer-knoepfe"></div>
      </div>

      <div id="allgemein">
      <p class="unter">{t('fehler.text')}</p>

      <div class="suche">
        <label for="q" class="nur-screenreader">{t('fehler.suchen')}</label>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="9" cy="9" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7" />
          <path d="M13.8 13.8 18 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        <input type="search" id="q" autocomplete="off" placeholder={t('fehler.platzhalter')} />
      </div>

      <ul class="ergebnisse" id="ergebnisse"></ul>

      <h2>{t('fehler.oderStandort')}</h2>
      <div class="raster">
        {daten.standorte.map((s) => (
          <a class="karte karte-klickbar ort" href={`/${s.slug}/`} style={`--akzent:${s.akzent}`}>
            <h3>KU64 {s.name}</h3>
            <address>{s.strasse}, {s.plz} {s.ort}</address>
          </a>
        ))}
      </div>

      {/* `{' '}` nach jedem Trennpunkt: Ohne ihn klebt der nächste Verweis
          am Punkt, weil der Zeilenumbruch im Markup dort keinen Abstand
          hinterlässt. */}
      <p class="weiter">
        {t('fehler.nichtsDabei')} <a href="/leistungen/">{t('fehler.alleBehandlungen')}</a> ·{' '}
        <a href="/standorte/">{t('fehler.alleStandorte')}</a> ·{' '}
        <a href="/notfall/">{t('fehler.notfall')}</a> ·{' '}
        <button type="button" class="chat-oeffner leise">{t('fehler.beraterFragen')}</button>
      </p>
      </div>
    </div>
  </section>
</Basis>

<script is:inline define:vars={{ suchindex, kombinationen, skripttexte }} data-astro-rerun>
  /* ── Fall 1: Behandlung an einem Standort, der sie nicht anbietet ── */

  const teile = location.pathname.split('/').filter(Boolean);

  if (teile.length === 3 && teile[1] === 'leistungen') {
    const standort = kombinationen.standorte[teile[0]];
    const leistung = kombinationen.leistungen[teile[2]];

    if (standort && leistung) {
      const box = document.getElementById('treffer');
      const titel = document.getElementById('titel');
      const text = document.getElementById('treffer-text');
      const knoepfe = document.getElementById('treffer-knoepfe');
      const allgemein = document.getElementById('allgemein');

      const woNamen = leistung.verfuegbar.map((s) => `KU64 ${kombinationen.standorte[s].name}`);

      const fuellen = (vorlage, werte) =>
        Object.entries(werte).reduce((t, [k, v]) => t.replaceAll(`{${k}}`, v), vorlage);

      titel.textContent = fuellen(skripttexte.gibtEsNichtIn, {
        name: leistung.name,
        ort: standort.ort,
      });

      text.textContent = woNamen.length
        ? fuellen(skripttexte.stattdessenDort, {
            wo: woNamen.join(` ${skripttexte.und} `),
          })
        : skripttexte.nirgends;

      // Zuerst die Standorte, an denen es die Behandlung gibt …
      for (const slug of leistung.verfuegbar) {
        const a = document.createElement('a');
        a.href = `/${slug}/leistungen/${teile[2]}/`;
        a.className = 'knopf knopf-primaer';
        a.textContent = fuellen(skripttexte.beiStandort, {
          name: leistung.name,
          ort: kombinationen.standorte[slug].name,
        });
        knoepfe.append(a);
      }

      // … danach der Weg zurück in den ursprünglich gewählten Standort.
      const zurueck = document.createElement('a');
      zurueck.href = `/${teile[0]}/leistungen/`;
      zurueck.className = 'knopf knopf-sekundaer';
      zurueck.textContent = fuellen(skripttexte.alleBehandlungenIn, { ort: standort.ort });
      knoepfe.append(zurueck);

      box.hidden = false;
      allgemein.hidden = true;
      document.title = `${leistung.name} in ${standort.ort} • KU64`;
    }
  }

  /* ── Fall 2: alles Übrige – Suche über alle Behandlungen ── */

  const feld = document.getElementById('q');
  const liste = document.getElementById('ergebnisse');

  const norm = (s) =>
    s.toLowerCase().replace(/ä/g, 'a').replace(/ö/g, 'o').replace(/ü/g, 'u').replace(/ß/g, 'ss');

  const daten = suchindex.map((e) => ({ ...e, norm: norm(e.begriffe) }));

  // Startwert aus der aufgerufenen Adresse ableiten: Wer /leistungen/implantate/
  // aufgerufen hat, bekommt sofort passende Treffer statt eines leeren Felds.
  const ausPfad = decodeURIComponent(location.pathname).replace(/[-/]+/g, ' ').trim();

  function suchen(frage) {
    liste.innerHTML = '';
    const q = norm(frage.trim());
    if (!q) return;

    const treffer = daten
      .filter((e) => q.split(/\s+/).some((wort) => wort.length > 2 && e.norm.includes(wort)))
      .slice(0, 8);

    for (const t of treffer) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/leistungen/${t.slug}/`;
      a.textContent = t.name;
      li.append(a);
      liste.append(li);
    }
  }

  feld?.addEventListener('input', () => suchen(feld.value));

  if (ausPfad) suchen(ausPfad);
</script>

<style>
  .code { font-family: var(--schrift-titel); font-size: var(--t-2xl); font-weight: 700; color: var(--akzent-schrift); }
  .treffer-box { max-width: var(--breite-text); }
  .treffer-box h1 { margin-block: var(--raum-3) var(--raum-4); }
  .treffer-text { font-size: var(--t-lg); color: var(--tinte-weich); line-height: var(--zeile-weit); }
  .treffer-knoepfe { display: flex; flex-wrap: wrap; gap: var(--raum-3); margin-block-start: var(--raum-6); }
  h1 { margin-block: var(--raum-3) var(--raum-4); }
  h2 { font-size: var(--t-lg); margin-block: var(--raum-7) var(--raum-4); }
  .unter { max-width: var(--breite-text); font-size: var(--t-lg); color: var(--tinte-weich); }
  .suche {
    display: flex; align-items: center; gap: var(--raum-3); max-width: 34rem;
    margin-block-start: var(--raum-6); padding: 0 var(--raum-4);
    background: var(--scheibe-flaeche); box-shadow: inset 0 1px 0 var(--glas-glanz); border: 1px solid var(--scheibe-rand); border-radius: var(--radius-voll);
  }
  .suche:focus-within { border-color: var(--akzent-schrift); }
  .suche svg { flex-shrink: 0; color: var(--tinte-leise); }
  .suche input { flex: 1; min-width: 0; padding-block: 0.85rem; border: none; background: none; outline: none; font-size: var(--t-sm); }
  .ergebnisse { list-style: none; padding: 0; margin-block-start: var(--raum-4); max-width: 34rem; }
  .ergebnisse:empty { display: none; }
  .ergebnisse li { border-bottom: 1px solid var(--linie); }
  .ergebnisse a { display: block; padding: var(--raum-3); text-decoration: none; font-weight: 500; }
  .ergebnisse a:hover { color: var(--akzent-schrift); background: var(--flaeche-warm); }
  .ort { text-decoration: none; overflow: hidden; padding-block-start: calc(var(--raum-5) + 4px); }
  /* Das gelbe Band über der Karte ist entfallen – siehe Standortwahl.astro:
     Eine Auszeichnung auf jeder Karte zeichnet keine aus. */
  .ort h3 { font-size: var(--t-md); }
  address { font-style: normal; margin-block-start: var(--raum-2); font-size: var(--t-sm); color: var(--tinte-leise); }
  .weiter { margin-block-start: var(--raum-7); font-size: var(--t-sm); color: var(--tinte-weich); }
  .leise { color: var(--akzent-schrift); font-weight: 600; text-decoration: underline; text-underline-offset: 0.18em; }
</style>
