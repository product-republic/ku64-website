---
/**
 * Eine Behandlung an einem konkreten Standort.
 *
 * Das ist die Seite, die die Struktur der alten Website repariert: Dort lagen
 * Leistungen standortübergreifend unter /leistungen/, sodass jemand mit
 * Standort Potsdam beim Klick auf eine Behandlung unbemerkt Inhalte einer
 * anderen Praxis las. Hier gehört jede Behandlungsseite eindeutig zu einem Ort
 * – mit dessen Adresse, Telefonnummer, Sprechzeiten und Terminbuchung.
 */
import Basis from '../../../layouts/Basis.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import LeistungKarte from '../../../components/LeistungKarte.astro';
import TerminBand from '../../../components/TerminBand.astro';
import {
  LEISTUNGEN,
  getKategorie,
  verwandteLeistungen,
  alleKombinationen,
} from '../../../data/leistungen';
import { getStandort, STANDORTE } from '../../../data/standorte';
import {
  schemaLeistung,
  schemaFaq,
  schemaBrotkrumen,
  descriptionKuerzen,
} from '../../../lib/seo';

export function getStaticPaths() {
  return alleKombinationen().map(({ standort, leistung }) => ({
    params: { standort, leistung: leistung.slug },
    props: { leistungSlug: leistung.slug },
  }));
}

const { standort: standortSlug, leistung: leistungSlug } = Astro.params;

const standort = getStandort(standortSlug!)!;
const leistung = LEISTUNGEN.find((l) => l.slug === leistungSlug)!;
const kategorie = getKategorie(leistung.kategorie)!;

const pfad = `/${standort.slug}/leistungen/${leistung.slug}/`;
const ortsname = standort.bezirk ? `${standort.ort}-${standort.bezirk}` : standort.ort;

/* Titel und Description tragen den Ortsbezug – das ist der Unterschied
   zwischen einem generischen Treffer und einem lokalen. */
const titel = `${leistung.name} in ${standort.ort}`;
const description = descriptionKuerzen(
  `${leistung.teaser} Bei KU64 ${standort.name}, ${standort.strasse}, ${standort.plz} ${standort.ort}.`,
);

const verwandte = verwandteLeistungen(leistung, standort.slug);
const verwandteHier = verwandte.filter((v) => v.amStandort);
const verwandteWoanders = verwandte.filter((v) => !v.amStandort);

/* An welchen anderen Standorten gibt es diese Behandlung auch? Wichtig für
   Menschen, denen ein anderer Standort besser passt – und für Suchmaschinen,
   die so das vollständige Bild bekommen. */
const auchAn = STANDORTE.filter(
  (s) => s.slug !== standort.slug && leistung.verfuegbar.includes(s.slug),
);

const brotkrumen = [
  { name: 'Start', pfad: '/' },
  { name: `KU64 ${standort.name}`, pfad: `/${standort.slug}/` },
  { name: 'Leistungen', pfad: `/${standort.slug}/leistungen/` },
  { name: leistung.name, pfad },
];

const schema = [
  schemaLeistung(leistung, standort),
  schemaFaq(leistung.faq),
  schemaBrotkrumen(brotkrumen),
];
---

<Basis
  titel={titel}
  description={description}
  standort={standort}
  pfad={pfad}
  brotkrumen={brotkrumen}
  schema={schema}
>
  <article>
    <header class="kopfbereich abschnitt-eng">
      <div class="huelle">
        <a href={`/${standort.slug}/leistungen/#${kategorie.slug}`} class="marke marke-akzent">
          {kategorie.name}
        </a>

        <h1>{leistung.name} <span class="ort">in {ortsname}</span></h1>

        <p class="teaser">{leistung.teaser}</p>

        {/* Die vier Fragen, die Patientinnen und Patienten zuerst stellen –
            direkt sichtbar, ohne Scrollen und ohne Klick. */}
        <dl class="eckdaten">
          {
            leistung.dauer && (
              <div>
                <dt>Dauer</dt>
                <dd>{leistung.dauer}</dd>
              </div>
            )
          }
          {
            leistung.kosten && (
              <div>
                <dt>Kosten</dt>
                <dd>{leistung.kosten}</dd>
              </div>
            )
          }
          <div>
            <dt>Wo</dt>
            <dd>
              KU64 {standort.name}, {standort.strasse}
            </dd>
          </div>
          <div>
            <dt>Termin</dt>
            <dd>
              <a href={`/${standort.slug}/termine/`}>Online buchen</a> oder{' '}
              <a href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`}>{standort.telefon}</a>
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="huelle inhalt">
      <div class="haupt">
        {/* Die Kassenfrage bekommt einen eigenen, sofort auffindbaren Block –
            sie ist der häufigste Grund, warum jemand eine Praxis anruft. */}
        {
          leistung.kasse && (
            <section class="kasse" aria-labelledby="kasse-titel">
              <h2 id="kasse-titel">Zahlt die Krankenkasse?</h2>
              <p>{leistung.kasse}</p>
            </section>
          )
        }

        {
          leistung.ablauf && leistung.ablauf.length > 0 && (
            <section class="ablauf" aria-labelledby="ablauf-titel">
              <h2 id="ablauf-titel">So läuft die Behandlung ab</h2>
              <ol class="schritte">
                {leistung.ablauf.map((schritt, i) => (
                  <li class="einblenden">
                    <div class="schritt-nr" aria-hidden="true">
                      {i + 1}
                    </div>
                    <div class="schritt-text">
                      <h3>
                        {schritt.titel}
                        {schritt.dauer && <span class="schritt-dauer">{schritt.dauer}</span>}
                      </h3>
                      <p>{schritt.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <FaqBlock
          titel={`${leistung.name}: häufige Fragen`}
          eintraege={leistung.faq}
        />

        {/* Andere Standorte: nur als Angebot, nie als Umleitung. */}
        {
          auchAn.length > 0 && (
            <section class="auch-an" aria-labelledby="auch-titel">
              <h2 id="auch-titel">{leistung.name} an anderen KU64-Standorten</h2>
              <p class="auch-text">
                Sie sehen gerade die Angaben für <strong>KU64 {standort.name}</strong>. Diese
                Behandlung bieten wir auch hier an – falls Ihnen ein anderer Standort besser
                passt:
              </p>
              <ul class="auch-liste">
                {auchAn.map((s) => (
                  <li>
                    <a href={`/${s.slug}/leistungen/${leistung.slug}/`}>
                      <span class="auch-punkt" style={`background:${s.akzent}`} aria-hidden="true" />
                      <span>
                        <strong>KU64 {s.name}</strong>
                        <small>
                          {s.strasse}, {s.plz} {s.ort}
                        </small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      {/* Seitenspalte: Kontakt bleibt beim Scrollen sichtbar. */}
      <aside class="spalte">
        <div class="spalte-haft">
          <div class="kontaktkarte">
            <p class="kk-titel">KU64 {standort.name}</p>
            <address>
              {standort.strasse}<br />
              {standort.plz} {standort.ort}
            </address>
            <a
              href={`/${standort.slug}/termine/`}
              class="knopf knopf-primaer knopf-gross kk-knopf"
            >
              Termin für {leistung.name}
            </a>
            <a
              href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`}
              class="knopf knopf-sekundaer kk-knopf"
            >
              {standort.telefon}
            </a>
            <p class="kk-hinweis">
              Fragen vorab? Unser <button class="chat-oeffner" type="button">digitaler Berater</button>{' '}
              antwortet rund um die Uhr – auch zu {leistung.name}.
            </p>
          </div>

          {
            verwandteHier.length > 0 && (
              <nav class="verwandt" aria-labelledby="verwandt-titel">
                <p class="kk-titel" id="verwandt-titel">
                  Passt dazu
                </p>
                <ul>
                  {verwandteHier.map((v) => (
                    <li>
                      <a href={`/${standort.slug}/leistungen/${v.leistung.slug}/`}>
                        {v.leistung.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </aside>
    </div>

    {/* Verwandte Leistungen, die es hier nicht gibt – transparent ausgewiesen. */}
    {
      verwandteWoanders.length > 0 && (
        <section class="abschnitt weiter">
          <div class="huelle">
            <h2>Ergänzend – an anderen Standorten</h2>
            <p class="weiter-text">
              Diese Behandlungen hängen mit {leistung.name} zusammen, werden bei KU64{' '}
              {standort.name} aber nicht angeboten. Wir sagen Ihnen offen, wo Sie sie
              bekommen.
            </p>
            <div class="raster">
              {verwandteWoanders.map((v) => (
                <LeistungKarte leistung={v.leistung} standortSlug={standort.slug} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <TerminBand standort={standort} anlass={leistung.name} />
  </article>
</Basis>

<style>
  .kopfbereich {
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--akzent) 7%, var(--flaeche)),
      var(--flaeche)
    );
    border-bottom: 1px solid var(--linie);
  }

  h1 {
    margin-block: var(--raum-4) var(--raum-4);
    max-width: 20ch;
  }

  .ort {
    display: block;
    font-size: 0.55em;
    font-weight: 500;
    color: var(--tinte-leise);
    letter-spacing: -0.01em;
  }

  .teaser {
    max-width: var(--breite-text);
    font-size: var(--t-lg);
    line-height: var(--zeile-weit);
    color: var(--tinte-weich);
  }

  .eckdaten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--raum-4);
    margin-block-start: var(--raum-6);
    padding-block-start: var(--raum-5);
    border-top: 1px solid var(--linie);
  }

  .eckdaten dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinte-leise);
    margin-block-end: 2px;
  }

  .eckdaten dd {
    margin: 0;
    font-size: var(--t-sm);
    line-height: var(--zeile-normal);
    color: var(--tinte);
  }

  .inhalt {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--raum-8);
    padding-block: var(--raum-8);
    align-items: start;
  }

  .haupt > section + section {
    margin-block-start: var(--raum-8);
  }

  /* ── Kassenblock ── */

  .kasse {
    padding: var(--raum-5) var(--raum-6);
    background: var(--info-flaeche);
    border-radius: var(--radius-lg);
  }

  .kasse h2 {
    font-size: var(--t-lg);
    margin-block-end: var(--raum-2);
  }

  .kasse p {
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
    max-width: var(--breite-text);
  }

  /* ── Ablauf ── */

  .schritte {
    list-style: none;
    padding: 0;
    counter-reset: schritt;
    margin-block-start: var(--raum-5);
  }

  .schritte li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--raum-4);
    padding-block: var(--raum-4);
    position: relative;
  }

  /* Verbindungslinie zwischen den Schritten. */
  .schritte li:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-inline-start: 1.125rem;
    top: 3.25rem;
    bottom: -0.25rem;
    width: 1px;
    background: var(--linie-stark);
  }

  .schritt-nr {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--akzent);
    color: var(--akzent-kontrast);
    font-weight: 700;
    font-size: var(--t-sm);
    flex-shrink: 0;
  }

  .schritt-text h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--raum-3);
    font-size: var(--t-lg);
    margin-block-end: var(--raum-2);
  }

  .schritt-dauer {
    font-family: var(--schrift-text);
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--tinte-leise);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-voll);
    background: var(--flaeche-warm-2);
  }

  .schritt-text p {
    color: var(--tinte-weich);
    max-width: var(--breite-text);
  }

  /* ── Andere Standorte ── */

  .auch-an {
    padding: var(--raum-6);
    background: var(--flaeche-warm);
    border-radius: var(--radius-lg);
  }

  .auch-an h2 {
    font-size: var(--t-xl);
  }

  .auch-text {
    margin-block: var(--raum-3) var(--raum-4);
    color: var(--tinte-weich);
    max-width: var(--breite-text);
  }

  .auch-liste {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--raum-2);
  }

  .auch-liste a {
    display: flex;
    align-items: center;
    gap: var(--raum-3);
    padding: var(--raum-3) var(--raum-4);
    background: var(--flaeche);
    border: 1px solid var(--linie);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--zeit-schnell) var(--kurve);
  }

  .auch-liste a:hover {
    border-color: var(--akzent);
  }

  .auch-punkt {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .auch-liste strong {
    display: block;
    font-size: var(--t-sm);
  }

  .auch-liste small {
    color: var(--tinte-leise);
  }

  /* ── Seitenspalte ── */

  .spalte-haft {
    position: sticky;
    top: 7.5rem;
    display: grid;
    gap: var(--raum-5);
  }

  .kontaktkarte {
    padding: var(--raum-5);
    border: 1px solid var(--linie);
    border-radius: var(--radius-lg);
    background: var(--flaeche);
    box-shadow: var(--schatten-sm);
  }

  .kk-titel {
    font-family: var(--schrift-titel);
    font-size: var(--t-md);
    font-weight: 600;
    margin-block-end: var(--raum-2);
  }

  .kontaktkarte address {
    font-style: normal;
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    line-height: var(--zeile-normal);
    margin-block-end: var(--raum-4);
  }

  .kk-knopf {
    display: flex;
    width: 100%;
    text-align: center;
  }

  .kk-knopf + .kk-knopf {
    margin-block-start: var(--raum-2);
  }

  .kk-hinweis {
    margin-block-start: var(--raum-4);
    padding-block-start: var(--raum-4);
    border-top: 1px solid var(--linie);
    font-size: var(--t-xs);
    line-height: var(--zeile-normal);
    color: var(--tinte-leise);
  }

  .chat-oeffner {
    color: var(--akzent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    padding: 0;
  }

  .verwandt ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--raum-2);
  }

  .verwandt a {
    display: block;
    padding: var(--raum-2) var(--raum-3);
    font-size: var(--t-sm);
    color: var(--tinte-weich);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color var(--zeit-schnell) var(--kurve);
  }

  .verwandt a:hover {
    background: var(--flaeche-warm);
    color: var(--akzent);
  }

  /* ── Weiterführend ── */

  .weiter {
    background: var(--flaeche-warm);
    border-block: 1px solid var(--linie);
  }

  .weiter-text {
    margin-block: var(--raum-3) var(--raum-6);
    max-width: var(--breite-text);
    color: var(--tinte-weich);
  }

  @media (max-width: 62rem) {
    .inhalt {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--raum-7);
    }
    .spalte-haft {
      position: static;
    }
  }
</style>
