---
interface Props {
  punkte: { name: string; pfad: string }[];
}
const { punkte } = Astro.props;
---

<nav class="brotkrumen" aria-label="Sie befinden sich hier">
  <div class="huelle">
    <ol>
      {
        punkte.map((p, i) => (
          <li>
            {i < punkte.length - 1 ? (
              <a href={p.pfad}>{p.name}</a>
            ) : (
              <span aria-current="page">{p.name}</span>
            )}
            {i < punkte.length - 1 && (
              <svg viewBox="0 0 6 10" width="5" height="8" aria-hidden="true">
                <path d="M1 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .brotkrumen {
    padding-block: var(--raum-4);
    font-size: var(--t-xs);
    color: var(--tinte-leise);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--raum-2);
    list-style: none;
    padding: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--raum-2);
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--akzent-schrift);
  }

  span[aria-current] {
    color: var(--tinte);
    font-weight: 500;
  }

  svg {
    opacity: 0.45;
  }
</style>
