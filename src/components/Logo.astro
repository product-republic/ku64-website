M259.8,83.1v-6.8l6.2,6.8h.8v-9.7h-1.5v6.8l-6.2-6.8h-.8v9.7h1.5"
  ></path>

  {/* KU */}
  <path
    class="logo-ku"
    d="M16.8,59.5v-31.7l19.9,31.6h19.4l-22.3-33.2L54.4.1h-18.4l-19.2,25.9V.1H.1v59.3h16.7s0,0,0,.1ZM60.2,36.1c0,8,2.3,14.1,6.8,18.2s11.3,6.1,20.3,6.1,16.5-2,21.5-6c4.9-4,7.4-9.9,7.4-17.5V.1h-16v35.3c0,4.2-1,7.4-3.1,9.7s-5,3.4-8.8,3.4-6.7-1.1-8.6-3.3-2.9-5.5-2.9-9.8V.1h-16.6v36"
