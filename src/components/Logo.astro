<style>
  /**
   * Die Farben stehen in der Originaldatei und werden hier nicht neu
   * erfunden – sie sind nur benannt, damit man sie beim Lesen wiedererkennt.
   */
  .logo-marke {
    display: block;
    width: auto;
  }

  .logo-ku {
    fill: #fc0;
  }

  .logo-64 {
    fill: #b71e3f;
  }

  .logo-wort {
    fill: #000;
  }

  /**
   * Auf dunklem Grund – dunkle Fläche, Foto, Video, dunkler Modus.
   *
   * Das Gelb bleibt: Auf Dunkel ist es das kontraststärkste der drei und
   * genau der Teil, an dem man die Marke erkennt. Das Hausrot dagegen
   * erreicht auf Schwarz nur 2,3:1 und weicht deshalb auf die hellere
   * Hausfassung aus. Der schwarze Zusatz wird weiß – schwarz auf schwarz
   * wäre keine Zurückhaltung, sondern Abwesenheit.
   */
  :global(.auf-medium) .logo-64,
  :global(.dunkel) .logo-64 {
    fill: var(--ku-rot-hell);
  }

  :global(.auf-medium) .logo-wort,
  :global(.dunkel) .logo-wort {
    fill: rgb(255 255 255 / 0.88);
  }

  @media (prefers-color-scheme: dark) {
    .logo-64 {
      fill: var(--ku-rot-hell);
    }
    .logo-wort {
      fill: rgb(255 255 255 / 0.88);
    }
  }

  /* Im Kontrastmodus bestimmt das System die Farben – eine Marke, die dort
     auf eigenen Werten beharrt, verschwindet. */
  @media (forced-colors: active) {
    .logo-ku,
    .logo-64,
    .logo-wort {
      fill: CanvasText;
    }
  }
</style>
