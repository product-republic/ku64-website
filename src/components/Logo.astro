---
/**
 * Wort-Bild-Marke KU64 – Die Zahnspezialisten.
 *
 * Die Pfade stammen unverändert aus der Originaldatei der Praxis
 * (ku64-die-zahnspezialisten-berlin.svg). Nachgezeichnet wurde nichts: Eine
 * Marke, die man nachbaut, ist irgendwann nicht mehr dieselbe.
 *
 * Geändert wurde ausschließlich die Farbe – aus dem fest eingetragenen Weiß
 * der Originaldatei wird `currentColor`. Dadurch nimmt das Logo die Schrift-
 * farbe seiner Umgebung an und funktioniert auf hellem wie auf dunklem Grund,
 * im Kontrastmodus und im Druck, ohne dass es drei Dateien braucht.
 *
 * Als Inline-SVG statt als `<img>`: kein zusätzlicher Netzwerkabruf vor dem
 * ersten Bild, keine Layoutverschiebung und eben die Farbvererbung. Die Datei
 * ist rund 4 kB, das trägt das HTML.
 */
interface Props {
  /** Höhe in der Textmaßeinheit, damit das Logo mit der Schrift skaliert. */
  hoehe?: string;
  /** Auf dekorativen Wiederholungen ausblenden, damit Screenreader nicht doppeln. */
  dekorativ?: boolean;
  titel?: string;
}

const { hoehe = '1.9rem', dekorativ = false, titel = 'KU64 – Die Zahnspezialisten' } =
  Astro.props;
