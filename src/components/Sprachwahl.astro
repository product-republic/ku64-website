---
/**
 * Die drei Sprachknöpfe. Nur sie – der Hinweis nach einer automatischen
 * Umstellung und die Erkennung selbst stehen in `Sprachhinweis.astro`.
 *
 * Der Grund für die Trennung: Diesen Wähler gibt es zweimal auf jeder Seite,
 * in der Kopfleiste und im mobilen Menü. Alles, was er mitbringt, gibt es
 * damit ebenfalls zweimal – und ein `id` zweimal ist keins.
 *
 * Benannt sind die Sprachen mit ihrer Eigenbezeichnung, nicht mit Flaggen.
 * Flaggen stehen für Länder, nicht für Sprachen: Französisch spricht man auch
 * in Belgien und Kanada, und für Englisch gäbe es keine richtige Wahl.
 *
 * ── Was hier zuletzt falsch war ─────────────────────────────────────────
 *
 * Drei Dinge, alle drei sichtbar:
 *
 * 1. DIE GEWÄHLTE SPRACHE WAR EINE DUNKLE PILLE UND BLIEB STEHEN. Beim
 *    Überfahren erschien daneben eine zweite, helle Fläche – zwei
 *    Markierungen gleichzeitig, und die aktive klebte am Anfang. Jetzt gibt
 *    es genau EINE Fläche. Sie ruht auf der gewählten Sprache, gleitet zu
 *    der, über der der Zeiger steht, und kehrt zurück, wenn er die Gruppe
 *    verlässt. Dieselbe Mechanik wie im Hauptmenü, aus demselben Grund.
 *
 * 2. „EN" STAND IN `--tinte-leise` AUF GRAUEM GLAS. Gemessen gegen den
 *    Untergrund der Kopfleiste über einem Foto sind das 2,4:1; gefordert
 *    sind 4,5:1. Alle drei Kürzel stehen jetzt in voller Tinte.
 *
 *    Damit entfällt die farbliche Kennzeichnung „im Aufbau". Das ist kein
 *    Verlust: Sie war die Ursache des schlechten Kontrasts, und die
 *    Information steht im `title` und im Sprachhinweis – dort mit Worten
 *    statt mit einem Grauton, den niemand deuten kann.
 *
 * 3. EIN KAPUTTER KOMMENTAR HAT EINE REGEL GEFRESSEN. Im Stilteil endete ein
 *    Blockkommentar zu früh, danach lief Fließtext weiter und ein zweites
 *    Kommentarende schloss ihn noch einmal. Der CSS-Parser fing sich erst an
 *    der übernächsten Regel – `[data-freigegeben='nein']` fehlte im gebauten
 *    Stylesheet vollständig. Nachweisbar: eine Suche nach
 *    `data-freigegeben` über `dist/` fand null Treffer.
 *
 *    Aufgefallen ist es nur, weil die verschluckte Regel dieselbe Farbe
 *    setzte wie die Grundregel. Hätte sie etwas anderes getan, wäre es
 *    monatelang unbemerkt geblieben.
 */
import { pfadInSprache, SPRACHEN, spracheAusParameter } from '../i18n/sprachen';
import { texte } from '../i18n/katalog';

interface Props {
  /** Sprachneutraler Pfad der aktuellen Seite. */
  pfad: string;
}

const { pfad } = Astro.props;
const aktuell = spracheAusParameter(Astro.params.sprache as string | undefined);
const t = texte(aktuell);

const fassungen = SPRACHEN.map((s) => ({
  ...s,
  ziel: pfadInSprache(pfad, s.code),
  aktiv: s.code === aktuell,
}));
---

<div class="sprachwahl" role="group" aria-label={t('sprache.waehlen')}>
  {/* Die gleitende Fläche. Liegt hinter den Kürzeln und wird im Browser
      gesetzt; ohne JavaScript bleibt sie unsichtbar, und die gewählte
      Sprache ist an ihrer Schriftstärke zu erkennen. */}
  <span class="sprach-laeufer" aria-hidden="true"></span>
  {
    fassungen.map((f) => (
      <a
        href={f.ziel}
        hreflang={f.bcp47}
        lang={f.bcp47}
        aria-current={f.aktiv ? 'true' : undefined}
        data-sprache={f.code}
        data-freigegeben={f.freigegeben ? 'ja' : 'nein'}
        title={f.freigegeben ? f.aria : `${f.aria} – im Aufbau`}
      >
        <span class="kurz" aria-hidden="true">
          {f.code.toUpperCase()}
        </span>
        <span class="voll">{f.eigenname}</span>
      </a>
    ))
  }
</div>

<style>
  .sprachwahl {
    position: relative;
    /*
     * `inline-flex`, nicht `flex`.
     *
     * Als Block füllte der Regler die Breite seines Elternteils. In der
     * Kopfleiste fiel das nicht auf – dort steht er in einer Flex-Zeile und
     * wird ohnehin nach Inhalt bemessen. Im Mobilmenü steht er in einem
     * Block, und dort lief der Rahmen über die ganze Bildschirmbreite,
     * während die drei Kürzel links in der Ecke klebten.
     *
     * Ein Segmentregler umschließt seine Segmente. Alles andere sieht aus
     * wie ein Eingabefeld, in dem oben links drei Wörter stehen.
     */
    display: inline-flex;
    gap: 0.125rem;
    padding: 0.15rem;
    border: 1px solid var(--linie);
    border-radius: var(--radius-voll);
  }

  .sprachwahl a {
    /* Über der gleitenden Fläche, nicht darunter. */
    position: relative;
    z-index: 1;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-voll);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    /*
     * Volle Tinte für alle drei – siehe Punkt 2 im Kopfkommentar.
     *
     * Nebenbei repariert: Hier stand `transition: background var(--kurve)`.
     * `--kurve` ist eine Zeitfunktion und keine Dauer; der Kurzform fehlte
     * der erste Wert, und der Übergang lief nie. Jetzt braucht es keinen
     * mehr: Es wechselt keine Farbe, es gleitet eine Fläche.
     */
    color: var(--tinte);
    text-decoration: none;
  }

  /* Die gewählte Sprache bleibt erkennbar, auch wenn die Fläche gerade
     woanders steht: schwerer gesetzt, nicht anders gefärbt. */
  .sprachwahl a[aria-current='true'] {
    font-weight: 700;
  }

  /*
   * Die eine Fläche.
   *
   * Weißliches Glas mit dunkler Schrift darüber – dieselbe Sprache wie das
   * wandernde Feld im Hauptmenü. Kein Weichzeichner: Die Fläche ist rund
   * dreißig Pixel breit, ein `backdrop-filter` darauf kostet eine eigene
   * Ebene und bringt auf dieser Größe nichts.
   */
  .sprach-laeufer {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 0;
    inline-size: var(--b, 0);
    block-size: var(--h, 0);
    border-radius: var(--radius-voll);
    background: var(--scheibe-flaeche);
    border: 1px solid var(--scheibe-rand);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(var(--x, 0), var(--y, 0), 0);
    transition:
      transform var(--zeit-lang) var(--kurve-feder),
      inline-size var(--zeit-lang) var(--kurve-feder),
      opacity var(--zeit) var(--kurve-weich);
  }

  .sprach-laeufer[data-sichtbar] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .sprach-laeufer {
      transition: opacity var(--zeit) var(--kurve-weich);
    }
  }

  /* Der ausgeschriebene Name steht Screenreadern immer zur Verfügung –
     sichtbar ist in der schmalen Leiste nur das Kürzel. */
  .voll {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { beimSeitenaufbau } from '../lib/seitenaufbau';

  /*
   * Nach jedem Seitenaufbau neu binden – der ClientRouter tauscht den Körper
   * aus, ohne Module erneut auszuwerten. Genau dieser Fehler hat in diesem
   * Projekt schon einmal den Sprachumschalter gekostet.
   *
   * Und je Wähler, nicht einmal: Es gibt zwei auf jeder Seite.
   */
  beimSeitenaufbau(() => {
    for (const gruppe of document.querySelectorAll<HTMLElement>('.sprachwahl')) {
      const laeufer = gruppe.querySelector<HTMLElement>('.sprach-laeufer');
      const links = [...gruppe.querySelectorAll<HTMLAnchorElement>('a')];
      if (!laeufer || links.length === 0) continue;

      const aktiv = () => links.find((l) => l.getAttribute('aria-current') === 'true') ?? null;

      const stellen = (ziel: HTMLElement) => {
        const z = ziel.getBoundingClientRect();
        const bezug = gruppe.getBoundingClientRect();
        laeufer.style.setProperty('--x', `${z.left - bezug.left}px`);
        laeufer.style.setProperty('--y', `${z.top - bezug.top}px`);
        laeufer.style.setProperty('--b', `${z.width}px`);
        laeufer.style.setProperty('--h', `${z.height}px`);
      };

      /* Ohne Übergang setzen – sonst gleitet die Fläche bei jedem
         Seitenaufbau sichtbar von der linken Kante zur gewählten Sprache. */
      const ohneUebergang = (ziel: HTMLElement) => {
        const vorher = laeufer.style.transition;
        laeufer.style.transition = 'none';
        stellen(ziel);
        void laeufer.offsetWidth;
        laeufer.style.transition = vorher;
      };

      const ruhe = aktiv();
      if (ruhe) {
        ohneUebergang(ruhe);
        laeufer.dataset.sichtbar = '';
      }

      for (const link of links) {
        const hin = () => {
          stellen(link);
          laeufer.dataset.sichtbar = '';
        };
        link.addEventListener('pointerenter', hin);
        link.addEventListener('focus', hin);
      }

      const zurueck = () => {
        const a = aktiv();
        if (a) stellen(a);
        else delete laeufer.dataset.sichtbar;
      };

      gruppe.addEventListener('pointerleave', zurueck);
      gruppe.addEventListener('focusout', (e) => {
        if (!gruppe.contains(e.relatedTarget as Node)) zurueck();
      });

      /* Die Kürzel sind in jeder Sprache gleich breit, die Umgebung nicht:
         Beim Andocken der Kopfleiste wandert der Wähler. Ohne Beobachter
         säße die Fläche danach neben ihrem Kürzel. */
      if ('ResizeObserver' in window) {
        const beobachter = new ResizeObserver(() => {
          const a = aktiv();
          if (a) ohneUebergang(a);
        });
        beobachter.observe(gruppe);
      }
    }
  });
</script>
