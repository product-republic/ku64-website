---
/**
 * Die drei Sprachknöpfe. Nur sie – der Hinweis nach einer automatischen
 * Umstellung und die Erkennung selbst stehen in `Sprachhinweis.astro`.
 *
 * Der Grund für die Trennung: Diesen Wähler gibt es zweimal auf jeder Seite,
 * in der Kopfleiste und im mobilen Menü. Alles, was er mitbringt, gibt es
 * damit ebenfalls zweimal – und ein `id` zweimal ist keins.
 *
 * Der Umschalter steht in der Standortleiste, direkt neben dem
 * Standortwähler. Das ist kein Zufall: Beides beantwortet dieselbe Frage –
 * in welchem Kontext sehe ich diese Seite gerade? – und beides ist an
 * derselben Stelle umkehrbar.
 *
 * Benannt sind die Sprachen mit ihrer Eigenbezeichnung, nicht mit Flaggen.
 * Flaggen stehen für Länder, nicht für Sprachen: Französisch spricht man auch
 * in Belgien und Kanada, und für Englisch gäbe es keine richtige Wahl.
 */
import { pfadInSprache, SPRACHEN, spracheAusParameter } from '../i18n/sprachen';
import { texte } from '../i18n/katalog';

interface Props {
  /** Sprachneutraler Pfad der aktuellen Seite. */
  pfad: string;
}

const { pfad } = Astro.props;
const aktuell = spracheAusParameter(Astro.params.sprache as string | undefined);
const t = texte(aktuell);

const fassungen = SPRACHEN.map((s) => ({
  ...s,
  ziel: pfadInSprache(pfad, s.code),
  aktiv: s.code === aktuell,
}));

---

<div class="sprachwahl" role="group" aria-label={t('sprache.waehlen')}>
  {
    fassungen.map((f) => (
      <a
        href={f.ziel}
        hreflang={f.bcp47}
        lang={f.bcp47}
        aria-current={f.aktiv ? 'true' : undefined}
        data-sprache={f.code}
        data-freigegeben={f.freigegeben ? 'ja' : 'nein'}
        title={f.freigegeben ? f.aria : `${f.aria} – im Aufbau`}
      >
        <span class="kurz" aria-hidden="true">
          {f.code.toUpperCase()}
        </span>
        <span class="voll">{f.eigenname}</span>
      </a>
    ))
  }
</div>


<style>
  .sprachwahl {
    display: flex;
    gap: 0.125rem;
    padding: 0.15rem;
    border: 1px solid var(--linie);
    border-radius: var(--radius-voll);
  }

  .sprachwahl a {
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-voll);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--tinte-leise);
    text-decoration: none;
    transition: background var(--kurve), color var(--kurve);
  }

  .sprachwahl a:hover,
  .sprachwahl a:focus-visible {
    background: var(--scheibe-flaeche);
    color: var(--tinte);
  }

  /* Die gewählte Sprache dunkel statt gelb: Sie zeigt einen Zustand an und
     fordert zu nichts auf – ein gelbes Feld daneben sah aus wie ein Knopf. */
  .sprachwahl a[aria-current='true'] {
    background: var(--knopf-flaeche);
    color: var(--knopf-schrift);
  }

  /*
   * Sprachen im Aufbau treten zurück – über die Farbe, nicht über die
   * Deckkraft.
   *
   * Hier stand `opacity: 0.5`. Das blendet nicht nur ab, es rechnet den
   * Kontrast herunter: aus dem leisen Ton wurden 1,92:1, also weit unter
   * den 4,5:1 für normalen Text. Zurücktreten heißt leiser, nicht
   * unleserlich – gerade bei einem Bedienelement, das man treffen soll.
   *
   * Der leise Ton allein reicht als Unterschied: Die gewählte Sprache steht
   * auf dunklem Grund, die freigegebenen in voller Tinte, die im Aufbau
   * leise. Drei Stufen, alle lesbar.
   */
   * `:not([aria-current])` ist nicht kosmetisch: Auf /en/ ist Englisch
   * zugleich die gewählte Sprache UND eine im Aufbau. Ohne die Einschränkung
   * gewinnt die leise Farbe gegen die helle Schrift des dunklen Feldes –
   * dunkel auf dunkel, 1,82:1. Die erste Fassung dieser Korrektur hatte
   * genau das gebaut.
   */
  .sprachwahl a[data-freigegeben='nein']:not([aria-current='true']) {
    color: var(--tinte-leise);
  }

  /* Der ausgeschriebene Name steht Screenreadern immer zur Verfügung –
     sichtbar ist in der schmalen Leiste nur das Kürzel. */
  .voll {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

</style>
