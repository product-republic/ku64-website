---
/**
 * Aufklappbare Fragen und Antworten.
 *
 * Bewusst mit <details>/<summary> statt einer JavaScript-Lösung: funktioniert
 * ohne JS, ist von Haus aus zugänglich, durchsuchbar (Strg+F findet auch
 * geschlossene Inhalte in modernen Browsern) und wird von Suchmaschinen und
 * KI-Systemen vollständig gelesen.
 */
interface Props {
  titel?: string;
  eintraege: { frage: string; antwort: string }[];
  /** Erste Frage geöffnet anzeigen. */
  ersteOffen?: boolean;
}

const { titel = 'Häufige Fragen', eintraege, ersteOffen = true } = Astro.props;
---

{
  eintraege.length > 0 && (
    <section class="faq" aria-labelledby="faq-titel">
      <h2 id="faq-titel">{titel}</h2>
      <div class="faq-liste">
        {eintraege.map((e, i) => (
          <details open={ersteOffen && i === 0} name="faq">
            <summary>
              <span>{e.frage}</span>
              <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
                <path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </summary>
            <div class="antwort">
              <p>{e.antwort}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq {
    margin-block-start: var(--raum-8);
  }

  h2 {
    margin-block-end: var(--raum-5);
  }

  .faq-liste {
    border-radius: var(--radius-lg);
    background: var(--scheibe-flaeche);
    border: 1px solid var(--scheibe-rand);
    box-shadow: inset 0 1px 0 var(--glas-glanz), 0 10px 30px -14px rgb(20 16 14 / 0.14);
    padding-inline: var(--raum-5);
  }

  details {
    border-bottom: 1px solid var(--glas-rand-unten);
  }

  details:last-child {
    border-bottom: none;
  }

  summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--raum-4);
    padding-block: var(--raum-4);
    font-family: var(--schrift-titel);
    font-size: var(--t-lg);
    font-weight: 600;
    line-height: var(--zeile-normal);
    cursor: pointer;
    list-style: none;
    transition: color var(--zeit-schnell) var(--kurve);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--akzent);
  }

  summary svg {
    flex-shrink: 0;
    margin-block-start: 0.4em;
    color: var(--akzent);
    transition: transform var(--zeit) var(--kurve);
  }

  details[open] summary svg {
    transform: rotate(45deg);
  }

  .antwort {
    padding-block-end: var(--raum-5);
    max-width: var(--breite-text);
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
  }

  /* Sanftes Ausklappen, wo der Browser es unterstützt. */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      details::details-content {
        block-size: 0;
        overflow: hidden;
        transition:
          block-size var(--zeit) var(--kurve),
          content-visibility var(--zeit) allow-discrete;
      }
      details[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
