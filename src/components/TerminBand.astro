---
/**
 * Wiederkehrender Abschluss-Aufruf mit Terminbuchung.
 *
 * Doctolib wird bewusst NICHT als iframe eingebunden, sondern erst nach
 * ausdrücklicher Zustimmung geladen (siehe /[standort]/termine/). Hier steht
 * nur der Link – so entsteht auf normalen Inhaltsseiten kein Drittanbieter-
 * Kontakt ohne Einwilligung und kein Ladeballast.
 */
import type { Standort } from '../data/standorte';
import { inhalte } from '../i18n/daten';
import { texte } from '../i18n/katalog';

interface Props {
  standort: Standort;
  /** Behandlungsname, damit der Aufruf konkret statt generisch ist. */
  anlass?: string;
}

const { standort, anlass } = Astro.props;
const t = texte(inhalte(Astro).sprache);
---

<section class="band" aria-labelledby="band-titel">
  <div class="huelle band-inner">
    <div>
      <h2 id="band-titel">
        {
          anlass
            ? t('termin.anlassBei', { anlass, name: standort.name })
            : t('termin.terminBei', { name: standort.name })
        }
      </h2>
      <p>{t('termin.vorspann')}</p>
      <p class="feindaten">
        {standort.strasse}, {standort.plz} {standort.ort}
        {standort.anfahrt.barrierefrei && <> · {t('termin.barrierefreierZugang')}</>}
      </p>
    </div>

    <div class="band-knoepfe">
      <a href={`/${standort.slug}/termine/`} class="knopf knopf-primaer knopf-gross">
        {t('termin.onlineWaehlen')}
      </a>
      <a
        href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`}
        class="knopf knopf-sekundaer knopf-gross"
      >
        {standort.telefon}
      </a>
      <a href={`/${standort.slug}/anamnese/`} class="knopf knopf-leise">
        Anamnese vorab ausfüllen
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    padding-block: var(--raum-8);
    /*
     * Warmer, heller Grund statt fast Schwarz.
     *
     * Vorher stand hier `--flaeche-dunkel` (#14100e) – ein Band, das quer
     * durch eine ansonsten helle, gläserne Seite schnitt und dabei härter
     * wirkte als alles andere darauf. Die Entwürfe kennen dunkle Flächen nur
     * als kleine Elemente, nicht als ganze Bänder.
     *
     * Jetzt ist es eine ruhige Sandfläche mit feiner Kante: Der Abschnitt
     * hebt sich weiterhin ab, aber er bricht die Seite nicht mehr auf.
     */
    background: linear-gradient(
      160deg,
      color-mix(in oklab, var(--ku-gelb) 7%, #f7f4ee),
      #f2eee7 70%
    );
    color: var(--tinte);
    border-block: 1px solid var(--linie);
  }

  .band-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--raum-6);
    align-items: center;
  }

  h2 {
    font-size: var(--t-2xl);
    margin-block-end: var(--raum-3);
  }

  p {
    max-width: 42ch;
    color: var(--tinte-weich);
    line-height: var(--zeile-weit);
  }

  .feindaten {
    margin-block-start: var(--raum-3);
    font-size: var(--t-sm);
    color: var(--tinte-leise);
  }

  .band-knoepfe {
    display: grid;
    gap: var(--raum-3);
    justify-items: stretch;
  }

  .band-knoepfe .knopf-sekundaer {
    background: var(--scheibe-flaeche);
    color: var(--tinte);
    border-color: var(--scheibe-rand);
  }

  .band-knoepfe .knopf-sekundaer:hover {
    border-color: var(--akzent-schrift);
    color: var(--akzent-schrift);
  }

  .band-knoepfe .knopf-leise {
    color: var(--tinte-leise);
    font-size: var(--t-xs);
  }

  @media (max-width: 54rem) {
    .band-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
