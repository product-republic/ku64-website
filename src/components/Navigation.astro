---
/**
 * Hauptnavigation.
 *
 * Kernregel: Steht ein Standort fest, zeigen ALLE Navigationslinks auf
 * Unterseiten genau dieses Standorts. Ein Standortwechsel ist nur über den
 * ausdrücklichen Wähler möglich und wird dort klar benannt.
 */
import { inhalte } from '../i18n/daten';
import { type Standort, istGeoeffnet } from '../data/standorte';
import Sprachwahl from './Sprachwahl.astro';
import Standortliste from './Standortliste.astro';
import Logo from './Logo.astro';
import { texte } from '../i18n/katalog';
import { sprachdefinition } from '../i18n/sprachen';

const daten = inhalte(Astro);


interface Props {
  standort: Standort | null;
  pfad: string;
}

const { standort, pfad } = Astro.props;
const t = texte(daten.sprache);

/** Basis für alle Links: innerhalb des Standorts bleiben. */
const basis = standort ? `/${standort.slug}` : '';

/*
 * Die Suche liegt standortübergreifend unter `/suche/`, nicht unter
 * `/potsdam/suche/`.
 *
 * Sie braucht keine eigene Fassung je Standort: Welcher Standort gewählt
 * ist, liest sie aus dem Seitenkopf und richtet ihre Treffer danach. Vier
 * gleiche Seiten dafür zu bauen, hieße vier Seiten um dieselbe Suchanfrage
 * konkurrieren zu lassen.
 *
 * Der Sprachpräfix gehört dagegen davor – `/en/suche/` ist eine andere
 * Seite als `/suche/`.
 */
const sprachbasis = sprachdefinition(daten.sprache).praefix
  ? `/${sprachdefinition(daten.sprache).praefix}`
  : '';

/*
 * Den Standort reicht der Verweis mit.
 *
 * Ohne ihn verliert man beim Klick auf die Lupe, wo man war: Wer von
 * `/potsdam/` kommt, soll Treffer für Potsdam bekommen und nicht die
 * allgemeine Fassung. Die Suchseite selbst bleibt dabei eine – der Standort
 * steht in der Adresse, nicht im Pfad, und wird deshalb weder gebaut noch
 * indexiert.
 */
const suchpfad = `${sprachbasis}/suche/${standort ? `?ort=${standort.slug}` : ''}`;

const punkte = standort
  ? [
      { name: t('nav.behandlungen'), pfad: `${basis}/leistungen/`, mega: true },
      { name: t('nav.praxis'), pfad: `${basis}/praxis/` },
      { name: t('nav.team'), pfad: `${basis}/team/` },
      { name: t('nav.anfahrt'), pfad: `${basis}/anfahrt/` },
      { name: t('nav.kontakt'), pfad: `${basis}/kontakt/` },
    ]
  : [
      { name: t('nav.standorte'), pfad: '/standorte/' },
      { name: t('nav.behandlungen'), pfad: '/leistungen/', mega: true },
      { name: t('nav.ueberKu64'), pfad: '/ueber-uns/' },
      { name: 'Blog', pfad: '/blog/' },
      { name: t('nav.kontakt'), pfad: '/kontakt/' },
    ];

const aktiv = (ziel: string) => pfad === ziel || (ziel !== '/' && pfad.startsWith(ziel));

/*
 * Alle Behandlungen, nach Bereich gruppiert – für das große Menü.
 *
 * ── Warum die ganze Liste und nicht nur die Bereiche ────────────────────
 *
 * Vorher standen im Menü elf Bereichsnamen mit einer Zahl dahinter. Wer
 * „Zahnimplantate" sucht, muss daraus erst raten, dass sie unter
 * „Implantologie" stehen, dann klicken, dann suchen. Die Bereiche sind
 * unsere Ordnung, nicht die Frage der Besucherin.
 *
 * Dreiundvierzig Behandlungen in elf Bereichen sind übersichtlich, wenn sie
 * gruppiert und gesetzt sind – das ist der ganze Sinn eines großen Menüs.
 * Auf dem Telefon klappt jeder Bereich einzeln auf, damit die Liste nicht
 * zur Bildschirmwanderung wird.
 *
 * ── Nur, was es hier wirklich gibt ──────────────────────────────────────
 *
 * Steht ein Standort fest, zeigt das Menü ausschließlich dessen
 * Behandlungen. Ein Menüpunkt, der auf eine Seite führt, die es an diesem
 * Ort nicht gibt, ist schlimmer als ein fehlender.
 */
const leistungenImMenue = standort ? daten.leistungenHier(standort.slug) : daten.leistungen;

const kategorienHier = daten.kategorien
  .map((k) => ({
    ...k,
    leistungen: leistungenImMenue
      .filter((l) => l.kategorie === k.slug)
      .sort((a, b) => a.name.localeCompare(b.name, 'de')),
  }))
  .filter((k) => k.leistungen.length > 0)
  .sort((a, b) => a.rang - b.rang);

/* Die Adresse einer Behandlung – mit Standort davor, wenn einer feststeht.
   Den Sprachpräfix setzt die Middleware, siehe src/middleware.ts. */
const leistungspfad = (leistungsSlug: string) => `${basis}/leistungen/${leistungsSlug}/`;

/* Der Öffnungsstatus wird beim Build berechnet und im Browser aktualisiert –
   sonst zeigt eine statische Seite dauerhaft den Stand des Build-Zeitpunkts. */
const offenJetzt = standort ? istGeoeffnet(standort, new Date()) : false;
---

{/* Ein Pixel über dem Kopf. Verlässt er das Sichtfeld, ist der Kopf
    angedockt – das erkennt ein IntersectionObserver, ohne bei jedem
    Scrollschritt zu rechnen. */}
<div class="kopf-marke" aria-hidden="true"></div>

<header class="kopf">
  <div class="kopf-glas">
    {/* Die Glasfläche ist eine eigene Ebene und nicht der Hintergrund der
        Pille. Grund steht bei `.kopf-glasflaeche` im Stilteil. */}
    <div class="kopf-glasflaeche" aria-hidden="true"></div>
    <div class="kopf-inner">
    <a
      href={standort ? `${basis}/` : '/'}
      class="logo"
      aria-label={
        standort ? t('nav.zurStartseiteOrt', { ort: standort.name }) : t('nav.zurStartseite')
      }
    >
      <Logo hoehe="1.75rem" dekorativ />
      {/* Erscheint erst beim Scrollen, wenn die Standortleiste einklappt –
          bis dahin steht der Ort ausgeschrieben in der Leiste darunter. */}
      {standort && <span class="logo-ort">{standort.name}</span>}
    </a>

    <nav class="haupt" aria-label={t('geruest.hauptnavigation')}>
      <ul class="haupt-liste">
        {/*
          Ein einziges Feld, das wandert – nicht eines je Punkt, das ein- und
          ausblendet. Genau das ist der Unterschied zwischen „springt" und
          „fließt": Beim Ein-/Ausblenden gibt es einen Moment, in dem beide
          Felder halb da sind; beim Wandern gibt es immer genau eines.

          Es liegt hinter den Beschriftungen und wird von JavaScript
          positioniert. Ohne JavaScript bleibt es unsichtbar, und die alten
          Flächen je Punkt übernehmen – siehe Stil unten.
        */}
        <span class="haupt-laeufer" aria-hidden="true"></span>
        {
          punkte.map((p) =>
            p.mega ? (
              /*
                Ein `<details>` und kein Knopf mit `hidden`-Feld.
                Ohne JavaScript klappt es trotzdem auf, und die Tastatur
                bedient es ohne eine Zeile von uns. Der Weg auf die
                Übersichtsseite geht nicht verloren – er steht als erste
                Zeile im Feld, ausgeschrieben und mit Anzahl.
              */
              <li class="hat-mega">
                <details class="mega">
                  <summary class:list={['haupt-link', { 'ist-aktiv': aktiv(p.pfad) }]}>
                    {p.name}
                    <svg class="mega-pfeil" viewBox="0 0 12 8" width="9" height="6" aria-hidden="true">
                      <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                    </svg>
                  </summary>
                  <div class="mega-feld">
                    <a href={p.pfad} class="mega-alle">
                      {t('standort.alleBehandlungenAnsehen', { anzahl: leistungenImMenue.length })}
                      <span aria-hidden="true">→</span>
                    </a>
                    <div class="mega-spalten">
                      {kategorienHier.map((k) => (
                        <div class="mega-block" style={`--kat:${k.farbe}`}>
                          <p class="mega-titel">
                            <a href={`${p.pfad}#${k.slug}`}>{k.name}</a>
                          </p>
                          <ul>
                            {k.leistungen.map((l) => (
                              <li>
                                <a href={leistungspfad(l.slug)}>{l.name}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={p.pfad}
                  class:list={['haupt-link', { 'ist-aktiv': aktiv(p.pfad) }]}
                  aria-current={aktiv(p.pfad) ? 'page' : undefined}
                >
                  {p.name}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="kopf-aktionen">
      {/*
        Standort und Sprache – aber erst, wenn die Leiste darunter weg ist.

        Beides steht ganz oben auf der Seite in der Standortleiste, wo es
        Platz hat und ausgeschrieben ist. Sobald gescrollt wird, klappt die
        Leiste ein, und beides wandert hierher: der Standort auf ein Symbol
        mit Namen, die Sprache unverändert.

        Warum hier ein zweites Bedienelement steht und nicht dasselbe
        umgezogen ist: Ein Element kann nicht in zwei Kästen liegen, und ein
        Umhängen im Browser (`appendChild`) verliert bei jedem Seitenwechsel
        seinen Zustand und muss nach jedem `ClientRouter`-Wechsel neu
        gemacht werden. Zwei Auszeichnungen, von denen CSS immer genau eine
        zeigt, sind billiger und überstehen den Seitenwechsel ohne Zutun.

        Die Liste darin ist trotzdem nur einmal geschrieben – siehe
        `Standortliste.astro`.
      */}
      <details class="ort-kompakt">
        <summary>
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <path
              d="M8 1.6c-2.4 0-4.3 1.9-4.3 4.3 0 3.1 4.3 8.5 4.3 8.5s4.3-5.4 4.3-8.5c0-2.4-1.9-4.3-4.3-4.3Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"></path>
            <circle cx="8" cy="5.9" r="1.6" fill="currentColor"></circle>
          </svg>
          {/* Der Name steht als Text da, nicht als `aria-label`: Ein
              `aria-label` am `summary` ersetzt dessen Inhalt für die
              Vorlesehilfe, und dann verschwindet der Hinweis darauf, dass
              sich hier etwas aufklappt. Auf schmalen Geräten wird der Text
              für die Augen weggeblendet, nicht entfernt. */}
          <span class="ort-kompakt-name">
            {standort ? standort.name : t('nav.standortWaehlenKurz')}
          </span>
          <svg class="ort-kompakt-pfeil" viewBox="0 0 12 8" width="9" height="6" aria-hidden="true">
            <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.8"></path>
          </svg>
        </summary>
        <Standortliste aktiv={standort?.slug ?? null} />
      </details>

      <div class="kopf-sprache">
        <Sprachwahl pfad={pfad} />
      </div>

      {/*
        Die Lupe steht als Verweis, nicht als Feld.

        Ein Suchfeld im Kopf kostet auf jeder Seite Platz, den es an
        neunundneunzig von hundert Stellen nicht braucht – und auf dem
        Telefon nimmt es die halbe Zeile. Ein Verweis auf die Suchseite
        kostet einen Klick und ist dafür überall gleich groß.
      */}
      <a href={suchpfad} class="lupe-link" aria-label={t('nav.suchen')}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M12.8 12.8 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </a>

      {
        standort && (
          <a
            href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`}
            class="telefon"
            data-oeffnungszeiten={JSON.stringify(standort.oeffnungszeiten)}
          >
            <span class:list={['punkt', { offen: offenJetzt }]} aria-hidden="true" />
            <span class="telefon-nr">{standort.telefon}</span>
          </a>
        )
      }

      <a href={standort ? `${basis}/termine/` : '/termine/'} class="knopf knopf-primaer">
        {t('nav.terminBuchen')}
      </a>

      <button
        class="menue-knopf"
        aria-expanded="false"
        aria-controls="mobilmenue"
        aria-label={t('geruest.menueOeffnen')}
        data-label-oeffnen={t('geruest.menueOeffnen')}
        data-label-schliessen={t('geruest.menueSchliessen')}
      >
        <span aria-hidden="true"></span>
      </button>
      </div>
    </div>

    {/* Zweite Zeile derselben Fläche: wo bin ich, und wie komme ich
        woandershin. Der äußere Kasten trägt nur die Einklapp-Bewegung – die
        Begründung für die zwei Ebenen steht bei `.standortleiste` im
        Stilteil. */}
    <div class="standortleiste">
    <div class="standortleiste-inner">
      {
        standort ? (
          <p class="wo-bin-ich">
            {t('nav.sieSehen')} <strong>KU64 {standort.name}</strong> · {standort.strasse},{' '}
            {standort.plz} {standort.ort}
          </p>
        ) : (
          <p class="wo-bin-ich">{t('nav.standortWaehlen')}</p>
        )
      }

      <details class="waehler">
        <summary>
          {standort ? t('nav.andererStandort') : t('nav.standortWaehlenKurz')}
          <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
            <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          </svg>
        </summary>
        <Standortliste aktiv={standort?.slug ?? null} />
      </details>

      <Sprachwahl pfad={pfad} />
    </div>
    </div>
  </div>

  {/* Mobiles Menü */}
  <div class="mobilmenue" id="mobilmenue" hidden>
    <nav class="huelle" aria-label={t('geruest.mobileNavigation')}>
      <ul class="mobil-liste">
        {/*
          Die Suche steht hier als FELD, nicht als Verweis.

          Vorher war es ein Link: antippen, Seite wechseln, warten, dann erst
          tippen. Drei Schritte für eine Frage, die man schon im Kopf hat.
          Jetzt steht der Cursor eine Berührung entfernt.

          Es bleibt ein `<form method="get">`: Ohne JavaScript sendet es an
          `/suche/?q=…` und die Ergebnisseite antwortet – dieselbe Adresse,
          die auch ein Lesezeichen oder ein geteilter Link trägt. Die Suche
          ist der Weg, auf dem jemand findet, was er sucht; sie darf nicht an
          einem nicht geladenen Skript hängen.

          `type="search"` statt `text`: Das Telefon zeigt dann eine Tastatur
          mit Lupe statt mit Absatzmarke, und iOS blendet ein Kreuz zum Leeren
          ein. Die Schriftgröße kommt aus `global.css` – auf Fingergeräten
          mindestens 16 px, sonst zoomt iOS beim Fokus die ganze Seite heran.

          Der Standort steht als verstecktes Feld da und nicht in der Adresse
          des Formulars. Das ist kein Geschmack, sondern Notwendigkeit: Ein
          `GET`-Formular WIRFT die Abfrage seiner `action` weg und schreibt
          seine eigenen Felder hin. Mit `action="/suche/?ort=…"` wäre nach dem
          Absenden `/suche/?q=implantat` herausgekommen – gemessen – und die
          Suche hätte vergessen, aus welcher Praxis man kam. Als Feld reist er
          mit: `/suche/?q=implantat&ort=berlin-charlottenburg`.

          `size="1"`: Ein Eingabefeld ist ohne diese Angabe zwanzig Zeichen
          breit, und diese zwanzig Zeichen sind seine Mindestbreite – auch als
          Flex-Kind mit `min-width: 0`. Gemessen hat das die Spalte des Menüs
          auf 322 px aufgezogen, 42 px mehr, als das Menü bei 320 px Gerät
          hergibt; das Feld hing rechts aus dem Bild. Ein Zeichen als
          Mindestbreite, den Rest holt sich `flex: 1`.
        */}
        <li class="mobil-suche-punkt">
          <form class="mobil-suche" role="search" method="get" action={`${sprachbasis}/suche/`}>
            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <path d="M12.8 12.8 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <input
              type="search"
              name="q"
              size="1"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              placeholder={t('nav.suchen')}
              aria-label={t('nav.suchen')}
            />
            {standort && <input type="hidden" name="ort" value={standort.slug} />}
          </form>
        </li>
        {/*
          Die Rufnummer steht hier, weil sie oben nicht mehr steht.

          In der Kopfleiste blieb auf dem Telefon von ihr nur ein 8 px großer
          Punkt übrig: `.telefon-nr` ist unter 46 rem ausgeblendet, und der
          Punkt selbst trägt `aria-hidden`. Übrig war damit ein Verweis ohne
          Namen und ohne Fläche – für eine Zahnarztpraxis ausgerechnet der
          Weg, den ein Mensch mit Schmerzen zuerst sucht.

          Hier hat sie beides: einen Namen links, die Nummer rechts, den
          Ampelpunkt davor und die volle Zeilenhöhe des Menüs als Ziel.
        */}
        {
          standort && (
            <li>
              <a href={`tel:${standort.telefonRaw.replace(/\s/g, '')}`} class="mobil-telefon">
                {t('karte.telefon')}
                <span class="mobil-telefon-nr">
                  <span class:list={['punkt', { offen: offenJetzt }]} aria-hidden="true" />
                  {standort.telefon}
                </span>
              </a>
            </li>
          )
        }
        {
          punkte.map((p) => (
            <li>
              <a href={p.pfad}>{p.name}</a>
            </li>
          ))
        }
      </ul>
      {
        kategorienHier.length > 0 && (
          <>
            {/*
              Auf dem Telefon dasselbe Angebot, nur anders gefaltet.

              Alle dreiundvierzig Behandlungen untereinander wären eine
              Bildschirmwanderung; elf Bereichsnamen mit einer Zahl dahinter
              waren das Gegenteil und zwangen zu einem Klick ins Ungewisse.
              Ein `<details>` je Bereich zeigt beides: die Ordnung sofort,
              die Behandlungen auf einen Tipp – ohne Seitenwechsel.
            */}
            <p class="mobil-titel">{t('nav.behandlungen')}</p>
            <a href={`${basis}/leistungen/`} class="mobil-alle">
              {t('standort.alleBehandlungenAnsehen', { anzahl: leistungenImMenue.length })}
            </a>
            <div class="mobil-bereiche">
              {kategorienHier.map((k) => (
                <details class="mobil-bereich">
                  <summary>
                    {k.name} <span class="anzahl">{k.leistungen.length}</span>
                    <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
                      <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                    </svg>
                  </summary>
                  <ul class="mobil-liste mobil-liste-klein">
                    {k.leistungen.map((l) => (
                      <li>
                        <a href={leistungspfad(l.slug)}>{l.name}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </div>
          </>
        )
      }
      {/*
        Der Standortwähler gehört ins Menü, nicht nur in die Leiste.

        Bisher stand er ausschließlich in der Standortleiste unter dem Kopf.
        Die klappt beim Scrollen ein – und dann blieb als einziger Zugang der
        kompakte Wähler oben, der sich mit Termin- und Menüknopf um den Platz
        stritt und dessen Ausklappliste auf die Leiste gerechnet ist, nicht
        auf ihn.

        Hier ist er immer erreichbar, in voller Breite, mit Adresse je
        Standort. Damit kann der kompakte Wähler auf dem Telefon aus dem
        angedockten Kopf verschwinden, ohne dass etwas verloren geht.
      */}
      <div class="mobil-standort">
        <p class="mobil-titel">{t('nav.standortWaehlenKurz')}</p>
        <Standortliste aktiv={standort?.slug ?? null} />
      </div>

      {/* Auf schmalen Bildschirmen steht die Sprachwahl hier statt in der
          Leiste: Dort drängte sie sich als dritte Zeile unter Ort und
          Wähler und machte den Kopf höher als den Inhalt darüber. */}
      <div class="mobil-sprache">
        <p class="mobil-titel">{t('sprache.waehlen')}</p>
        <Sprachwahl pfad={pfad} />
      </div>
    </nav>
  </div>
</header>

<style>
  /*
   * Die Navigation ist eine der wenigen Stellen mit echtem backdrop-filter:
   * Sie liegt fest, der Inhalt scrollt darunter durch – genau dafür ist der
   * Effekt gemacht.
   */
  .kopf {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
  }

  /*
   * Eine Glasfläche, zwei Zeilen.
   *
   * Vorher waren es zwei getrennte Elemente: die schwebende Pille und
   * darunter die Standortleiste. Die untere wirkte dadurch angehängt – drei
   * Angaben, weit auseinandergezogen, ohne erkennbare Zugehörigkeit. Jetzt
   * ist es ein Bauteil mit einer Trennlinie darin: oben die Navigation,
   * unten der Ort, in dem man sich befindet.
   *
   * Breiter als der Textbereich: Die Leiste trägt Marke, fünf
   * Navigationspunkte, Telefonnummer und Schaltfläche. Auf 72 rem gedrängt
   * standen die Punkte auf Tuchfühlung.
   */
  .kopf-glas {
    position: relative;
    /* Hält die Glasfläche mit `z-index: -1` innerhalb der Pille, statt sie
       hinter die Seite fallen zu lassen. */
    isolation: isolate;
    max-width: min(100rem, calc(100vw - 2 * var(--rand)));
    margin-inline: auto;
    margin-block-start: var(--raum-3);
    border-radius: var(--radius-xl);
    border: 1px solid var(--glas-rand);
    box-shadow:
      inset 0 1px 0 var(--glas-glanz),
      inset 0 -1px 0 var(--glas-rand-unten),
      var(--schatten);
    /*
     * KEIN `overflow: hidden` hier.
     *
     * Es stand hier, um die Standortleiste in die runden Ecken der Pille zu
     * zwingen – und schnitt dabei den Standortwähler ab. Der klappt nach
     * unten aus der Pille heraus; geklippt sah es aus, als reagiere der
     * Klick überhaupt nicht. Ein `<details>`, das sich öffnet und nichts
     * zeigt, ist von einem kaputten Knopf nicht zu unterscheiden.
     *
     * Die Ecken macht jetzt die Leiste selbst rund.
     */
  }

  /*
   * ── Offen ist die Pille kein eigener Körper mehr ──────────────────────
   *
   * Solange der kompakte Wähler aufgeklappt ist, sind Pille und Liste EIN
   * Glaskörper. Drei Dinge machten daraus vorher zwei:
   *
   *   1. Die Pille blieb unten mit 28 px gerundet, die Liste setzte dort
   *      eckig an – die Stufe an den beiden unteren Ecken.
   *   2. `inset 0 -1px 0 var(--glas-rand-unten)` zeichnete quer durch die
   *      Naht eine Innenkante, also genau dort, wo keine Kante ist.
   *   3. `var(--schatten)` fiel von der Pille auf die Liste und schrieb die
   *      Fuge nach, die 1. und 2. gezogen hatten.
   *
   * Übrig bleibt die Lichtkante oben – die gehört zur Oberkante des
   * gemeinsamen Körpers. Untere Kante und Schatten trägt jetzt die Liste,
   * denn dort endet der Körper (siehe `Standortliste.astro`).
   *
   * Der Wähler in der Leiste ist ein anderer Fall: Seine Liste ist bis
   * 24 rem breit und rechtsbündig, deckt die Pille also nicht in ganzer
   * Breite. Dort geht nur die Ecke eckig, an der beide sich treffen –
   * Schatten und untere Kante bleiben, weil die Pille links daneben
   * weiterhin ihre eigene Unterkante ist.
   */
  .kopf-glas:has(.ort-kompakt[open]) {
    border-end-start-radius: 0;
    border-end-end-radius: 0;
    box-shadow: inset 0 1px 0 var(--glas-glanz);
  }

  .kopf-glas:has(.waehler[open]) {
    border-end-end-radius: 0;
  }

  /*
   * Warum das Glas eine eigene Ebene ist und nicht der Hintergrund der Pille
   *
   * Ein Element mit `backdrop-filter` wird zur „Backdrop Root": Alles, was
   * darin liegt und selbst `backdrop-filter` trägt, sieht als Hintergrund nur
   * noch den Inhalt dieser Wurzel – nicht mehr die Seite dahinter.
   *
   * Genau das ist beim Standortwähler passiert. Er lag in der Pille, hatte
   * seinen eigenen Weichzeichner und filterte damit nichts als die Pille.
   * Sichtbar war eine halbdurchsichtige Fläche, durch die die Überschrift
   * scharf hindurchstand. Das ist kein Glas, sondern Milchfolie: Glas
   * erkennt man daran, dass der Hintergrund verschwimmt, nicht daran, dass er
   * blasser wird.
   *
   * Die Fläche liegt deshalb als eigene Ebene IN der Pille, nicht ALS Pille.
   * Damit hat der Wähler keinen gefilterten Vorfahren mehr und sein eigener
   * Weichzeichner greift auf die Seite zu.
   */
  .kopf-glasflaeche {
    position: absolute;
    inset: 0;
    /*
     * Hinter den Inhalt, nicht davor.
     *
     * Vorher lag sie auf `z-index: 0`, und beide Zeilen darüber brauchten
     * deshalb `position: relative; z-index: 1`. Das hatte eine Nebenwirkung,
     * die erst beim großen Menü auffiel: Ein aufklappendes Feld richtet
     * sich am nächsten POSITIONIERTEN Vorfahren aus – und das war damit
     * `.kopf-inner`, dessen Unterkante mitten in der Pille liegt. Der
     * Abstand zur Pillenunterkante musste als Zahl geschätzt werden, einmal
     * je Zustand, und war auf Englisch und Französisch prompt falsch: Dort
     * ist die Standortleiste höher.
     *
     * Mit `z-index: -1` und dem Isolieren der Pille braucht keine der beiden
     * Zeilen mehr eine eigene Ebene. Bezug für alles, was aufklappt, ist
     * dann die Pille selbst, und `top: 100%` heißt schlicht „unter dem
     * Kopf" – in jedem Zustand und in jeder Sprache, ohne eine einzige Zahl.
     */
    z-index: -1;
    border-radius: inherit;
    background: var(--glas-kopf-flaeche);
    -webkit-backdrop-filter: blur(var(--glas-kopf-unschaerfe)) saturate(var(--glas-saettigung));
    backdrop-filter: blur(var(--glas-kopf-unschaerfe)) saturate(var(--glas-saettigung));
    pointer-events: none;
  }

  /*
   * Ohne Weichzeichner deckend – und zwar hier genauso wie in der Liste.
   *
   * `Standortliste.astro` hat diesen Zweig längst: Fällt der Weichzeichner
   * aus, bliebe von „durchscheinend plus unscharf" nur „durchscheinend", und
   * die Überschrift der Seite stünde scharf durch das Menü.
   *
   * Solange nur die Liste deckend wurde, war das Ergebnis im Fallback genau
   * das Bild, das dieser Umbau abschafft: eine weiße Karte unter einem
   * durchsichtigen Streifen. Beide Körper müssen denselben Rückfall nehmen,
   * sonst reißt die Naht dort wieder auf.
   */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .kopf-glasflaeche {
      background: var(--flaeche);
    }
  }

  /*
   * KEINE eigene Ebene für die beiden Zeilen.
   *
   * Sie liegen ohnehin über der Glasfläche, seit die auf `z-index: -1`
   * steht. Und weil sie nicht mehr positioniert sind, ist der Bezug für
   * alles, was aus dem Kopf herausklappt, die Pille – siehe Begründung bei
   * `.kopf-glasflaeche`.
   */

  .logo {
    display: flex;
    align-items: baseline;
    gap: var(--raum-2);
    text-decoration: none;
    flex-shrink: 0;
  }

  /* Die erste Zeile: Marke, Navigation, Aktionen. */
  .kopf-inner {
    display: flex;
    align-items: center;
    gap: var(--raum-5);
    min-height: 4.25rem;
    padding-inline: var(--raum-5);
  }

  .logo {
    color: var(--tinte);
  }

  .kopf-marke {
    height: 1px;
  }

  /*
   * Zwei Zustände: oben ausführlich, gescrollt knapp.
   *
   * Ganz oben steht in der Leiste ausgeschrieben, wo man ist – „Sie sehen
   * KU64 Berlin-Mitte, Hausvogteiplatz 14". Das ist die wichtigste Angabe
   * beim Ankommen und darf Platz brauchen.
   *
   * Sobald gescrollt wird, ist die Frage beantwortet und der Kopf soll aus
   * dem Weg. Die Leiste klappt ein, und der Ort rutscht unter das Logo –
   * klein, aber dauerhaft sichtbar. Die Angabe verschwindet also nie, sie
   * wechselt nur den Platz.
   *
   * Vorher stand der Ort doppelt da: neben dem Logo UND in der Leiste.
   */
  .logo {
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  /*
   * Der Ortsname sitzt unter der Marke.
   *
   * ── Was hier schiefging, und warum zweimal ────────────────────────────
   *
   * Erst stand die Breite auf 5,6rem, gerechnet aus der Logohöhe: 1,75rem
   * bei 267:83,4. Die Rechnung war richtig und die Annahme falsch – gemessen
   * braucht „KURFÜRSTENDAMM" 92 Pixel, der Kasten war 90 breit. Zwei Pixel,
   * und die trafen ausgerechnet das letzte M.
   *
   * Das ist derselbe Fehler wie bei der Zeilenhöhe darunter, nur waagerecht:
   * eine Maßzahl aus einer Rechnung statt aus einer Messung, kombiniert mit
   * `overflow: hidden`, das den Beweis versteckt.
   *
   * Deshalb jetzt keine Breitenschranke mehr. Der Name ist so breit, wie er
   * ist; `white-space: nowrap` verhindert, dass er stattdessen umbricht.
   * Platz ist da – gemessen endet der Block auch bei 390 Pixeln
   * Fensterbreite bei 143 Pixeln, die Navigation beginnt weit rechts davon.
   * `kopf-pruefen.mjs` misst es jetzt bei jedem Lauf.
   *
   * ── Und der Kontrast ──────────────────────────────────────────────────
   *
   * `--tinte-leise` (#6F6F67) ergibt gegen den gemessenen Untergrund der
   * Kopfleiste über einem Foto – rgb(148,166,149) – 2,4:1. Für Text dieser
   * Größe sind 4,5:1 gefordert. Volle Tinte kommt auf 6,5:1. Dieselbe
   * Entscheidung wie bei den Menüpunkten, aus demselben Grund: Dunklere
   * Schrift statt dichteres Glas.
   */
  .logo-ort {
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--tinte);
    white-space: nowrap;
    /*
     * Die Zeilenhöhe steht hier ausdrücklich, weil `max-height` sie sonst
     * beschneidet.
     *
     * Geerbt waren 1,6 – bei 0,54 rem also 13,8 px Inhalt in einem Kasten
     * von `max-height: 1.4em` = 12,1 px. Mit `overflow: hidden` fehlten
     * 3 px, und weil der Text in Versalien steht, sah man es nicht sofort:
     * abgeschnitten wurde die Unterkante von „M" und „N", nicht eine
     * Unterlänge. `npm run abschnitt:pruefen` hat es auf sechs Ansichten
     * gefunden.
     */
    line-height: 1.4;
    /* Nimmt keinen Platz, solange die Leiste die Angabe trägt. */
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height var(--zeit) var(--kurve),
      margin-block-start var(--zeit) var(--kurve),
      opacity var(--zeit) var(--kurve);
  }

  /* `:global()` um die Zustandsklasse: Sie wird erst im Browser gesetzt und
     steht nirgends im Markup. Ohne diesen Hinweis versucht Astro, sie zu
     einem Bauteil zuzuordnen, und die Regel greift nie. */
  .kopf:global(.ist-angedockt) .logo-ort {
    max-height: 1.4em;
    /* Der Abstand gehört in den ausgeklappten Zustand, nicht in die
       Grundregel: Ein Außenabstand verschwindet nicht mit `max-height: 0`
       und ließe im eingeklappten Zustand eine Lücke stehen. */
    margin-block-start: 0.3rem;
    opacity: 1;
  }

  /*
   * ── Beim Scrollen klappt die untere Zeile GANZ ein ────────────────────
   *
   * Zwei Anläufe davor sind an derselben Stelle gescheitert, und beide
   * Kommentare standen hier noch:
   *
   *   1. Die Leiste zusammenklappen – der Standortwähler war danach
   *      unerreichbar. Ein Bedienelement, das nur ganz oben auf der Seite
   *      funktioniert, ist kaputt, nur nicht immer.
   *   2. Deshalb nur die Adresse einklappen und die Leiste flacher machen.
   *      Erreichbar, aber der Kopf blieb zweizeilig – und zwei Zeilen, von
   *      denen die untere nur noch zwei kleine Bedienelemente trägt, sind
   *      eine Zeile zu viel.
   *
   * Der Grund für Fall 1 war nie das Einklappen, sondern dass es danach
   * keinen Wähler mehr gab. Den gibt es jetzt: `.ort-kompakt` und
   * `.kopf-sprache` stehen in der oberen Zeile und erscheinen genau dann,
   * wenn die untere geht. Nichts wird unerreichbar, es wechselt nur den
   * Platz – dieselbe Regel wie beim Ortsnamen unter dem Logo.
   *
   * Eingeklappt wird über `grid-template-rows`, nicht über `max-height`:
   * `max-height` braucht eine geratene Obergrenze, und wer die Leiste einmal
   * um eine Zeile erweitert, bekommt eine Bewegung, die zu früh stehen
   * bleibt. `0fr → 1fr` misst der Browser selbst.
   */
  .standortleiste {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--zeit) var(--kurve);
  }

  .kopf:global(.ist-angedockt) .standortleiste {
    grid-template-rows: 0fr;
  }

  /*
   * Ohne `min-height: 0` wächst ein Rasterkind nicht unter seine
   * Inhaltshöhe – die Zeile steht auf 0fr und der Kasten trotzdem 40 px
   * hoch. Genau das hat `kopf-pruefen.mjs` im ersten Lauf gemeldet, auf
   * allen neun Aufrufen.
   *
   * Die Regel muss den angedockten Zustand nennen: `.standortleiste-inner`
   * setzt weiter unten `min-height: 2.5rem` als Ruhehöhe, und bei gleicher
   * Spezifität gewinnt die spätere Regel. Der erste Versuch stand ohne
   * `.ist-angedockt` davor und wurde stillschweigend überschrieben.
   */
  .kopf:global(.ist-angedockt) .standortleiste-inner {
    min-height: 0;
    /*
     * Polsterung und Trennlinie müssen mit.
     *
     * Eine Rasterzeile auf `0fr` ist trotzdem so hoch wie das kleinste, was
     * ihr Kind einnehmen kann – und das ist bei `min-height: 0` immer noch
     * Polsterung plus Rahmen. Gemessen: 17 px, die stehen blieben, obwohl
     * die Zeile auf null stand. Zweimal hintereinander hat `kopf-pruefen`
     * denselben Wert gemeldet, einmal am inneren und einmal am äußeren
     * Kasten – erst da war klar, dass es nicht am Messen liegt.
     */
    padding-block: 0;
    border-block-start-width: 0;
  }

  /*
   * Geklippt wird die Leiste, nicht der Wähler.
   *
   * Während des Einklappens ist die Rasterzeile schon flacher als ihr
   * Inhalt; ohne Klippen stünde die Adresse für die Dauer der Bewegung über
   * dem Text darunter.
   *
   * Der Standortwähler hängt aber aus dieser Leiste nach unten heraus.
   * Geklippt öffnet er sich und zeigt nichts – ein `<details>`, das
   * aufklappt und nichts zeigt, ist von einem kaputten Knopf nicht zu
   * unterscheiden. Genau dieser Fehler steckte schon zweimal in diesem
   * Kopf, einmal in `.kopf-glas` und einmal in der Leiste selbst.
   *
   * `:has()` löst beides in einer Regel: geklippt, solange die Liste zu ist.
   * Ist sie offen, ist die Leiste ohnehin ausgeklappt – im angedockten
   * Zustand kommt man an den Wähler gar nicht heran, er steht dann oben.
   */
  .standortleiste {
    overflow: hidden;
  }

  .standortleiste:has(.waehler[open]) {
    overflow: visible;
  }

  /*
   * Eingeklappt ist die Leiste nicht nur unsichtbar, sondern auch nicht
   * anklickbar.
   *
   * `overflow: hidden` allein nimmt einem 0 px hohen Kasten nicht den
   * Tastaturfokus: Wer durch die Seite tabbt, landet sonst in einer Liste,
   * die niemand sieht, und der Bildlauf springt an eine Stelle ohne Inhalt.
   */
  .kopf:global(.ist-angedockt) .standortleiste-inner {
    visibility: hidden;
  }

  /*
   * Die Zeitfunktion für `visibility` kommt aus dem ZIELzustand.
   *
   * Das ist die Falle: Wer die Regeln nach Gefühl setzt, vertauscht sie.
   * Beim Einklappen ist das Ziel die angedockte Regel – dort muss
   * `step-end` stehen, damit der Inhalt während der Bewegung sichtbar
   * bleibt und erst am Ende verschwindet. Beim Ausklappen ist das Ziel die
   * Grundregel, und dort gehört `step-start` hin, damit er sofort da ist
   * und nicht 240 ms später aufpoppt.
   *
   * Vertauscht war es genau einmal, und `durchgang.mjs` hat es gefunden –
   * als ein einzelner Befund auf /fr/potsdam/team/, weil die Prüfung dort
   * 400 ms wartete und das Aufpoppen knapp danach lag. Ein Fehler, der
   * einmal von vierzig Aufrufen auftritt, ist kein Zufall, sondern ein
   * Rennen.
   */
  .standortleiste-inner {
    transition:
      padding-block var(--zeit) var(--kurve),
      visibility var(--zeit) step-start;
  }

  .kopf:global(.ist-angedockt) .standortleiste-inner {
    transition:
      padding-block var(--zeit) var(--kurve),
      visibility var(--zeit) step-end;
  }

  /*
   * ── Standort und Sprache in der oberen Zeile ──────────────────────────
   *
   * Beide sind da, solange die Seite ganz oben steht – nur unsichtbar und
   * ohne Platzbedarf. `display: none` wäre einfacher und wäre falsch: Der
   * Wechsel soll fließen wie alles andere im Kopf, und aus `none` heraus
   * gibt es keine Bewegung.
   */
  .ort-kompakt,
  .kopf-sprache {
    /*
     * Zusammengeschoben statt ausgeblendet: `scale` und `opacity` laufen
     * beide auf dem Compositor, `width` nicht. Die Breite gibt trotzdem
     * `max-width` frei, sonst bliebe eine Lücke im Kopf stehen.
     */
    max-width: 0;
    opacity: 0;
    transform: scale(0.9);
    transform-origin: right center;
    pointer-events: none;
    overflow: hidden;
    visibility: hidden;
    transition:
      max-width var(--zeit) var(--kurve),
      opacity var(--zeit) var(--kurve),
      transform var(--zeit) var(--kurve),
      visibility var(--zeit) step-end;
  }

  .kopf:global(.ist-angedockt) .ort-kompakt,
  .kopf:global(.ist-angedockt) .kopf-sprache {
    /*
     * Reichlich bemessen, nicht knapp: `max-width` ist hier nur die
     * Freigabe der Breite, die das Element ohnehin braucht – zu knapp
     * bemessen schneidet sie ab, statt zu begrenzen.
     */
    max-width: 12rem;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    visibility: visible;
    /* Beim Aufklappen darf nicht geklippt werden – sonst schneidet der
       Kasten die aufgeklappte Standortliste ab. Derselbe Fehler steckte
       schon zweimal in diesem Kopf, einmal in `.kopf-glas` und einmal in
       der Leiste. */
    overflow: visible;
    transition:
      max-width var(--zeit) var(--kurve),
      opacity var(--zeit) var(--kurve),
      transform var(--zeit) var(--kurve),
      visibility var(--zeit) step-start;
  }

  /*
   * Beide Bedienelemente schrumpfen nicht mit.
   *
   * `.kopf-aktionen` trägt auf schmalen Geräten `min-width: 0`, damit der
   * Terminknopf nachgeben kann statt hinauszuschieben. Ohne `flex: none`
   * gilt das auch hier – gemessen hat `kopf-pruefen.mjs` einen Wähler von
   * 10 px Höhe, also ein zusammengedrücktes Symbol ohne Trefferfläche.
   */
  .ort-kompakt,
  .kopf-sprache {
    flex: none;
  }

  /*
   * Der Wähler oben trägt nur das Symbol – der Ortsname steht daneben unter
   * der Wortmarke.
   *
   * Beides anzuzeigen hieße, denselben Namen zweimal in dieselbe Zeile zu
   * setzen. Genau dagegen ist der Name überhaupt erst unter die Marke
   * gewandert. Auf Englisch kam der Kopf damit zusätzlich 34 px über den
   * Rand – gemeldet, nicht vermutet.
   *
   * Für die Vorlesehilfe bleibt der Name stehen: weggeblendet, nicht
   * entfernt. `display: none` nähme ihn beiden, und dann hieße das
   * Bedienelement nur noch „Schaltfläche" – derselbe Fehler wie damals im
   * Berater-Knopf, und der Grund, warum es `namen-pruefen.mjs` gibt.
   */
  .ort-kompakt-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ort-kompakt summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    /* Zielgröße nach WCAG 2.5.8, Stufe AA: mindestens 24 × 24 CSS-Pixel. */
    min-inline-size: 2.4rem;
    min-block-size: 2.4rem;
    padding-inline: 0.4rem;
    border-radius: var(--radius-voll);
    font-size: var(--t-xs);
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    color: var(--tinte-weich);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--zeit-schnell) var(--kurve),
      color var(--zeit-schnell) var(--kurve);
  }

  .ort-kompakt summary::-webkit-details-marker {
    display: none;
  }

  .ort-kompakt summary:hover,
  .ort-kompakt[open] summary {
    background: color-mix(in oklab, var(--tinte) 8%, transparent);
    color: var(--tinte);
  }

  .kopf-sprache {
    display: inline-flex;
  }

  .kopf-sprache :global(.sprachwahl a) {
    padding-block: 0.2rem;
  }

  .ort-kompakt-pfeil {
    transition: transform var(--zeit) var(--kurve);
  }

  .ort-kompakt[open] .ort-kompakt-pfeil {
    transform: rotate(180deg);
  }

  /*
   * Die aufgeklappte Liste setzt an der Unterkante der Glaspille an, nicht
   * unter dem kleinen Wähler.
   *
   * Sie ist `position: absolute` und richtet sich am nächsten positionierten
   * Vorfahren aus. `.ort-kompakt` bekommt deshalb ABSICHTLICH kein
   * `position: relative`: Ohne das ist der Bezug `.kopf-inner`, und dessen
   * Unterkante ist – eingeklappte Leiste – die Unterkante der Pille. Genau
   * dort soll die Liste ansetzen und deren Rundung fortsetzen.
   */


  .kopf:global(.ist-angedockt) .wo-bin-ich {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
  }

  .wo-bin-ich {
    max-height: 3em;
    transition:
      max-height var(--zeit) var(--kurve),
      opacity var(--zeit) var(--kurve);
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-ort,
    .standortleiste,
    .standortleiste-inner,
    .ort-kompakt,
    .kopf-sprache {
      transition: none;
    }
  }

  /*
   * Schmale Bildschirme: Der Ort steht unter dem Logo, die Leiste trägt nur
   * noch den Wechsel.
   *
   * Auf dem Telefon war der Kopf dreizeilig – Logo mit Schaltflächen, dann
   * „Sie sehen KU64 Potsdam, Berliner Straße 139, 14467 Potsdam" mit dem
   * Wähler daneben, dann noch die Sprachwahl. Zusammen höher als der erste
   * Inhaltsblock. Dieselbe Angabe passt unter das Logo in eine Zeile.
   */
  @media (max-width: 52rem) {
    .logo-ort {
      max-height: 1.4em;
      opacity: 1;
      /*
       * Der Abstand gehört hier dazu, nicht nur ins Angedockte.
       *
       * Auf dem Telefon steht die Ortszeile IMMER – die Regel darüber blendet
       * sie dauerhaft ein. Den Abstand von 0,3 rem setzte bisher allein
       * `.ist-angedockt`, weil er für den ausklappenden Fall gedacht war: Ein
       * Außenabstand verschwindet nicht mit `max-height: 0` und ließe sonst
       * eine Lücke stehen.
       *
       * Auf dem Telefon klappt hier aber nichts, und deshalb sprang der
       * Abstand beim Scrollen. Gemessen bei 402 px auf /berlin-charlottenburg/:
       *
       *     oben        margin-block-start 0 px      Luft zur Marke 0,0 px
       *     angedockt   margin-block-start 4,8 px    Luft zur Marke 4,8 px
       *
       * Sonst war alles gleich – Breite 91,6, Höhe 12,1, Schriftgrad 8,64.
       * Es war nie die Größe, es war immer nur diese Lücke.
       *
       * Jetzt steht der größere Wert in beiden Zuständen. Die Regel für den
       * angedockten Kopf setzt denselben Wert noch einmal; das ist kein
       * Widerspruch, sondern gilt weiterhin für breite Bildschirme, wo die
       * Zeile tatsächlich ein- und ausklappt.
       */
      margin-block-start: 0.3rem;
    }

    /* Die ausgeschriebene Fassung in der Leiste ist damit doppelt. */
    .wo-bin-ich {
      display: none;
    }

    /* Die Sprachwahl steht im Menü, nicht in der Leiste. */
    .standortleiste-inner > :global(.sprachwahl) {
      display: none;
    }

    /*
     * Und aus demselben Grund auch nicht oben in der Aktionszeile.
     *
     * Dort ist der Platz noch knapper als in der Leiste: Bei 390 px stehen
     * Marke, Ortsname, Standortwähler, Terminknopf und Menüknopf
     * nebeneinander. Die Sprachwahl steht im Mobilmenü, mit
     * ausgeschriebenen Namen statt Kürzeln.
     */
    .kopf-sprache {
      display: none;
    }

    .standortleiste-inner {
      justify-content: flex-start;
    }
  }

  /* ── Behandlungen im mobilen Menü ──────────────────────────────────── */

  .mobil-alle {
    display: block;
    margin-block-end: var(--raum-3);
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--akzent-schrift);
    text-decoration: none;
  }

  .mobil-bereiche {
    display: grid;
    gap: 2px;
  }

  .mobil-bereich > summary {
    display: flex;
    align-items: center;
    gap: var(--raum-2);
    /* Zielgröße nach WCAG 2.5.8 – auf dem Telefon ist das keine Formalie. */
    min-block-size: 2.75rem;
    padding-inline: var(--raum-2);
    border-radius: var(--radius);
    font-size: var(--t-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .mobil-bereich > summary::-webkit-details-marker {
    display: none;
  }

  .mobil-bereich > summary svg {
    margin-inline-start: auto;
    opacity: 0.6;
    transition: transform var(--zeit) var(--kurve);
  }

  .mobil-bereich[open] > summary svg {
    transform: rotate(180deg);
  }

  .mobil-bereich[open] > summary {
    background: var(--flaeche-warm-2);
  }

  .mobil-bereich > .mobil-liste {
    padding-inline-start: var(--raum-4);
    margin-block: var(--raum-1) var(--raum-3);
  }

  .mobil-standort {
    margin-block-start: var(--raum-6);
    padding-block-start: var(--raum-5);
    border-block-start: 1px solid var(--linie);
  }

  /*
   * Im Menü steht die Liste im Fluss, nicht als Ausklapp.
   *
   * `Standortliste` ist für den Ausklapp unter einem Wähler gebaut:
   * `position: absolute`, oben eckig, oben ohne Rahmen, damit sie an der
   * Leiste ansetzt. Im Menü gibt es nichts, woran sie ansetzen könnte – dort
   * ist sie der Inhalt selbst.
   *
   * Kein Glas, kein Schatten, keine Rundung: Sie schwebt hier über nichts.
   * Ein Weichzeichner über dem Menü, das selbst schon Glas ist, ergibt
   * milchige Fläche und kostet auf dem Telefon spürbar Rechenzeit.
   */
  /*
   * ── Der Ausklapp im Kopf füllt die Pille, statt darin zu schweben ─────
   *
   * `Standortliste` ist auf die Standortleiste gerechnet: `width: min(24rem,
   * 100vw - 2rem)`, rechtsbündig, oben eckig und ohne Rahmen, damit sie
   * nahtlos an der Leiste ansetzt.
   *
   * Unter dem kompakten Wähler im Kopf ergab das eine sichtbare Stufe.
   * Gemessen bei 402 px auf `/potsdam/`, angedockt und aufgeklappt:
   *
   *     Pille   x =  8 … 394
   *     Liste   x = 23 … 393
   *
   * Fünfzehn Pixel schmaler auf der linken Seite, dazu eckige obere Ecken
   * gegen eine runde Pille – die Kante, die im Bild auffällt. Das Glas war
   * nie das Problem; die Breite war es.
   *
   * `inset-inline: 0` statt fester Breite: Die Liste nimmt die Pillenbreite
   * und setzt deren Rundung unten fort. Oben bleibt sie eckig und rahmenlos
   * – dort ist keine Kante, dort ist die Naht.
   *
   * ── Warum −1 px und nicht 0 ───────────────────────────────────────────
   *
   * `inset-inline` und `top` lösen gegen die PADDING-Box von `.kopf-glas`
   * auf, also INNERHALB des Pillenrahmens. Mit 0 begann die Liste einen
   * Pixel weiter innen: Links und rechts standen zwei 1-px-Linien
   * nebeneinander – Pillenrahmen plus Listenrahmen –, und oben blieb die
   * Innenkante der Pille als Strich zwischen beiden Körpern stehen.
   *
   * Um einen Pixel nach außen und nach oben gerückt liegen die Rahmen
   * aufeinander statt nebeneinander, und die Liste deckt die untere
   * Kantenlinie der Pille ab.
   */
  .kopf-aktionen .ort-kompakt :global(.waehler-liste) {
    inset-inline: -1px;
    margin-block-start: -1px;
    width: auto;
  }

  .mobil-standort :global(.waehler-liste) {
    position: static;
    width: auto;
    padding: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .mobil-sprache {
    margin-block-start: var(--raum-5);
    padding-block-start: var(--raum-5);
    border-block-start: 1px solid var(--linie);
  }

  .mobil-sprache :global(.sprachwahl) {
    margin-block-start: var(--raum-3);
  }

  .haupt {
    margin-inline-end: auto;
  }

  .haupt-liste {
    /*
     * KEIN `position: relative`.
     *
     * Sonst wäre sie der Bezug für das große Menü, und das Feld begänne an
     * einem einzelnen Menüpunkt statt an der Pille. Das wandernde Feld
     * darunter braucht deshalb keinen positionierten Vorfahren mehr: Es
     * rechnet seine Lage gegen seinen tatsächlichen Bezugskasten aus, siehe
     * `stellen()` im Skriptteil.
     */
    display: flex;
    gap: var(--raum-1);
    list-style: none;
    padding: 0;
  }

  /*
   * Das wandernde Feld.
   *
   * Verschoben wird mit `translate3d` – das übernimmt die Grafikkarte. Die
   * BREITE dagegen wird echt gesetzt und nicht über `scaleX` erzeugt.
   *
   * Der erste Versuch tat genau das, und das Ergebnis war lehrreich: Ein
   * Rahmen von einem Pixel, um den Faktor 132 in die Breite gezogen, ist ein
   * 132 Pixel breiter Balken. Er lag über der Beschriftung „Leistungen",
   * und die war nicht mehr zu lesen. `scaleX` skaliert alles mit – Rahmen,
   * Rundung, Schatten.
   *
   * Eine Breitenänderung an einem absolut positionierten Element kostet nur
   * dieses eine Element ein neues Layout, nicht die Kopfleiste. Das ist der
   * Preis, und er ist bei einem Element pro Bild nicht messbar.
   */
  .haupt-laeufer {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    block-size: var(--h, 0);
    /* Hinter den Beschriftungen, nicht darüber. */
    z-index: 0;
    inline-size: var(--b, 0);
    border-radius: var(--radius-voll);
    /*
     * Weißliches Glas – und der Weg dorthin über zwei Fehlversuche.
     *
     * Erster Versuch: `--scheibe-flaeche`, also weiß. Ergebnis war Weiß auf
     * Weiß, die Mechanik lief und zu sehen war nichts.
     * Zweiter Versuch: getönt, `--tinte` zu 7 Prozent. Sichtbar ja, aber als
     * grauer Schatten unter der Beschriftung – „zu durchsichtig".
     *
     * Der Denkfehler in beiden: Eine Glasfläche hebt sich nicht durch ihre
     * FARBE ab, sondern durch ihre KANTE und ihren Schatten. Weiß mit einer
     * weißen Kante und einem weichen Schlagschatten liest sich auf der
     * hellen Kopfleiste als aufliegende Scheibe – dieselbe Sprache wie die
     * Schaltflächen, und genau das ist gewollt.
     *
     * Der Schatten liegt AUSSEN. Innen lagen vorher zwei Kanten übereinander
     * – der Rahmen und der `inset 0 1px 0`-Glanz –, und oben ergab das eine
     * doppelte Linie. Eine Kante genügt.
     */
    background: var(--scheibe-flaeche);
    border: 1px solid var(--scheibe-rand);
    -webkit-backdrop-filter: blur(16px) saturate(var(--glas-saettigung));
    backdrop-filter: blur(16px) saturate(var(--glas-saettigung));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 6px 16px rgb(0 0 0 / 0.06);
    opacity: 0;
    pointer-events: none;
    /*
     * Verborgen ist es kleiner, nicht nur durchsichtig.
     *
     * Vorher wurde nur die Deckkraft geschaltet: Das Feld blieb in voller
     * Größe stehen und verschwand. Zusammen mit der Federkurve auf der
     * Bewegung sah das aus, als bräche die Animation ab – „löst nicht
     * richtig auf". Ein Feld, das beim Gehen um sechs Prozent einfällt,
     * geht; eines, das nur blasser wird, wird ausgeknipst.
     */
    transform: translate3d(var(--x, 0), var(--y, 0), 0) scale(0.94);
    transition:
      transform var(--zeit-lang) var(--kurve-feder),
      inline-size var(--zeit-lang) var(--kurve-feder),
      opacity var(--zeit) var(--kurve-weich);
  }

  /* Die Beschriftungen gehören über das Feld. */
  .haupt-liste li {
    position: relative;
    z-index: 1;
  }

  /* ── Das große Behandlungsmenü ─────────────────────────────────────── */

  /*
   * Der Listenpunkt mit dem großen Menü ist ABSICHTLICH nicht positioniert.
   *
   * Das Feld darin ist `position: absolute` und richtet sich am nächsten
   * positionierten Vorfahren aus. Wäre das der `<li>`, begänne es an einem
   * einzelnen Menüpunkt und wäre höchstens so breit wie „Leistungen".
   * Ohne Positionierung ist der Bezug die Menüliste – das Feld beginnt an
   * ihrer linken Kante und darf sich über die ganze Leiste ziehen.
   *
   * Die Beschriftung braucht ihre Ebene trotzdem, sonst läuft das
   * wandernde Feld darüber statt darunter. Sie bekommt sie selbst.
   */
  .haupt-liste li.hat-mega {
    /*
     * Die Auswahl nennt die Liste mit – sonst gewinnt `.haupt-liste li`.
     *
     * `.hat-mega` allein hat eine Klasse, `.haupt-liste li` eine Klasse und
     * einen Typ; bei ungleicher Spezifität hilft die Reihenfolge nicht. Der
     * Listenpunkt blieb deshalb positioniert, das Feld hing weiter an ihm
     * statt an der Pille, und `kopf-pruefen` meldete es auf zwölf Wegen:
     * 69 px zu hoch im ausgeklappten, 15 px im angedockten Zustand.
     */
    position: static;
  }

  .hat-mega > .mega > summary {
    position: relative;
    z-index: 1;
  }

  .mega > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    list-style: none;
  }

  .mega > summary::-webkit-details-marker {
    display: none;
  }

  .mega-pfeil {
    transition: transform var(--zeit) var(--kurve);
    opacity: 0.7;
  }

  .mega[open] .mega-pfeil {
    transform: rotate(180deg);
  }

  /*
   * Das Feld hängt an der Menüliste, nicht am Punkt.
   *
   * `top: calc(100% + …)`: Die Liste sitzt mittig in einer 4,25 rem hohen
   * Zeile; ihre Unterkante liegt also über der Unterkante der Glaspille.
   * Der Zuschlag setzt das Feld unter die Pille statt mitten hinein.
   */
  .mega-feld {
    position: absolute;
    /*
     * Bündig unter der Pille, über ihre ganze Breite.
     *
     * Bezug ist `.kopf-glas` – keine Zahl, kein Zustandsunterschied, keine
     * Sprachabhängigkeit. Der erste Versuch hing am Menüpunkt und brauchte
     * zwei geschätzte Abstände; `kopf-pruefen` hat sie prompt auf Englisch
     * und Französisch widerlegt, wo die Standortleiste höher ist.
     */
    inset-inline: 0;
    top: 100%;
    /*
     * Ein Fingerbreit Luft – als Außenabstand, nicht im `top`.
     *
     * `top: 100%` trifft die Innenkante des Rahmens; gemessen sitzt das Feld
     * damit exakt 1 px über der Außenkante der Pille. Der Abstand gehört
     * trotzdem hierher und nicht in die Rechnung: Er ist ein Gestaltungswert
     * und hängt an nichts – nicht am Zustand, nicht an der Sprache. Genau
     * das unterscheidet ihn von den beiden geschätzten Abständen, die diese
     * Stelle vorher hatte.
     */
    margin-block-start: 0.5rem;
    z-index: var(--z-overlay);
    max-height: min(72vh, 38rem);
    overflow-y: auto;
    padding: var(--raum-5);
    background: var(--glas-flaeche-stark);
    -webkit-backdrop-filter: blur(28px) saturate(var(--glas-saettigung));
    backdrop-filter: blur(28px) saturate(var(--glas-saettigung));
    border: 1px solid var(--glas-rand);
    border-radius: var(--radius-xl);
    box-shadow:
      inset 0 1px 0 var(--glas-glanz),
      0 24px 48px -24px rgb(20 16 14 / 0.34),
      0 6px 16px -10px rgb(20 16 14 / 0.18);
  }

  /* Dieselbe Begründung wie beim Standortwähler: Ohne Weichzeichner bleibt
     von „durchscheinend plus unscharf" nur „durchscheinend" – und dann steht
     die Überschrift der Seite scharf durch das Menü. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .mega-feld {
      background: var(--flaeche);
    }
  }

  .mega-alle {
    display: inline-flex;
    align-items: center;
    gap: var(--raum-2);
    margin-block-end: var(--raum-5);
    padding-block-end: var(--raum-4);
    border-block-end: 1px solid var(--linie);
    width: 100%;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--akzent-schrift);
    text-decoration: none;
  }

  .mega-alle:hover {
    text-decoration: underline;
  }

  .mega-spalten {
    display: grid;
    /* Schmaler als eine Textspalte sein darf: Hier stehen Namen, keine
       Sätze. Elf Bereiche passen damit in zwei Reihen statt in drei – und
       zwei Reihen sieht man ohne zu rollen. */
    grid-template-columns: repeat(auto-fill, minmax(min(11.5rem, 100%), 1fr));
    gap: var(--raum-5) var(--raum-4);
  }

  .mega-block {
    min-width: 0;
  }

  /*
   * Bereichsnamen in Groß- und Kleinschreibung, nicht in Versalien.
   *
   * Versalien sind hier zweimal im Weg. Erstens brauchen sie Breite:
   * „KINDERZAHNHEILKUNDE" mit 0,08 em Sperrung passte in keine der sechs
   * Spalten und brach mitten im Wort um – „KINDERZAHNHEILKUND / E".
   * Zweitens liest man sie langsamer, und in einem Menü mit
   * dreiundvierzig Einträgen ist Überfliegen die einzige Bedienart, die
   * zählt.
   *
   * Die Abstufung zum Verweis darunter trägt jetzt das Gewicht und die
   * Farbe: Bereich in voller Tinte und fett, Behandlung in weicher Tinte
   * und normal.
   */
  /*
   * Die Kategoriefarbe – ein Strich, kein Icon.
   *
   * ── Warum keine Icons ─────────────────────────────────────────────────
   *
   * Elf Kategorien bräuchten elf Piktogramme, und in der Zahnmedizin sehen
   * die alle gleich aus: Für Vorsorge, Zahnerhalt, Zahnersatz und
   * Implantologie zeichnet jeder denselben Zahn. Dazu je ein Alternativtext
   * in drei Sprachen. Viel Pflege, wenig Orientierung.
   *
   * ── Was der Strich leistet ────────────────────────────────────────────
   *
   * Er gibt dem Menü einen Rhythmus, ohne den Text zu verändern: Elf
   * Überschriften in einer Reihe sind eine Wand, elf Überschriften mit einer
   * durchlaufenden Farbskala sind eine Ordnung. Die Farben laufen in der
   * Reihenfolge des `rang` von Markengelb zu Hausrot – kein Regenbogen,
   * sondern die zwei Farben der Marke und die Töne dazwischen.
   *
   * Dieselbe Farbe steht in `leistungen.ts` und lässt sich überall
   * verwenden, wo eine Kategorie auftaucht. Erst dann ist sie ein
   * Wiedererkennungszeichen und nicht Dekoration.
   *
   * ── Und was sie nicht tut ─────────────────────────────────────────────
   *
   * Sie trägt keine Bedeutung allein (WCAG 1.4.1) – der Name steht
   * ausgeschrieben daneben. Und sie färbt keinen Text: #FFCC00 auf Weiß
   * ergibt 1,7:1.
   */
  .mega-titel::before {
    content: '';
    display: block;
    inline-size: 1.6rem;
    block-size: 3px;
    margin-block-end: 0.45rem;
    border-radius: var(--radius-voll);
    background: var(--kat, var(--linie));
  }

  .mega-titel {
    margin: 0 0 var(--raum-2);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--tinte);
  }

  .mega-titel a {
    color: inherit;
    text-decoration: none;
  }

  .mega-titel a:hover {
    color: var(--akzent-schrift);
  }

  .mega-block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
  }

  .mega-block li {
    /* Die Grundregel `.haupt-liste li` setzt `position: relative; z-index: 1`
       – hier drin wäre das eine Ebene je Verweis, ohne Nutzen. */
    position: static;
  }

  .mega-block a {
    display: block;
    padding: 0.32rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: var(--radius);
    font-size: var(--t-sm);
    line-height: 1.35;
    color: var(--tinte-weich);
    text-decoration: none;
    transition: background-color var(--zeit-schnell) var(--kurve),
      color var(--zeit-schnell) var(--kurve);
  }

  .mega-block a:hover,
  .mega-block a:focus-visible {
    background: var(--flaeche-warm-2);
    color: var(--tinte);
  }

  .haupt-laeufer[data-sichtbar] {
    opacity: 1;
    transform: translate3d(var(--x, 0), var(--y, 0), 0) scale(1);
  }

  /*
   * Der aktive Punkt behält seine Fläche. Der Läufer ist nur für den Zeiger.
   *
   * Der erste Versuch nahm dem aktiven Punkt die Fläche weg, damit nie zwei
   * Markierungen gleichzeitig zu sehen sind. Das Ergebnis: „Leistungen"
   * war unlesbar. Seine Fläche ist dunkel und seine Schrift deshalb weiß –
   * ohne Fläche stand weiße Schrift auf weißem Grund.
   *
   * Beide dürfen also gleichzeitig da sein, und sie sagen auch
   * Verschiedenes: Die dunkle Pille heißt „hier bin ich", das Glasfeld heißt
   * „hier zeige ich gerade hin". Über dem aktiven Punkt erscheint der Läufer
   * gar nicht erst – dort wäre er eine Doppelung.
   */
  .haupt-link.ist-aktiv::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .haupt-laeufer {
      transition: opacity var(--zeit) var(--kurve-weich);
    }
  }

  /*
   * Navigationspunkte als Pillen, wie in den Entwürfen.
   *
   * Die Füllung liegt in einem Pseudoelement, das nur skaliert und ein- und
   * ausgeblendet wird. Damit bewegt sich beim Überfahren ausschließlich der
   * Compositor; würde stattdessen der Hintergrund des Links selbst wechseln,
   * müsste der Browser die Fläche bei jedem Bild neu zeichnen.
   */
  .lupe-link {
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border-radius: var(--radius-voll);
    color: var(--tinte-weich);
    text-decoration: none;
    transition: color var(--zeit-schnell) var(--kurve),
      background-color var(--zeit-schnell) var(--kurve);
  }

  .lupe-link:hover {
    color: var(--tinte);
    background: color-mix(in oklab, var(--tinte) 8%, transparent);
  }

  /*
   * Die Suche im Mobilmenü: ein Feld mit Kontur, kein siebter Menüpunkt.
   *
   * Ohne Rahmen stünde sie als Wort zwischen sechs anderen Wörtern in
   * derselben Spalte und wäre damit versteckt. Die Kontur sagt vor dem Lesen,
   * dass hier etwas eingegeben und nicht angetippt wird – dieselbe Form wie
   * das große Feld auf der Ergebnisseite, damit der Sprung dorthin nicht wie
   * ein Wechsel in eine andere Anwendung wirkt.
   *
   * `flex`, nicht `inline-flex`: Das Feld soll die Menübreite füllen. Als
   * Inline-Kasten wäre es genau so breit wie sein Platzhaltertext, und rechts
   * daneben bliebe eine tote Fläche, die aussieht, als gehörte sie dazu.
   */
  .mobil-suche {
    display: flex;
    align-items: center;
    gap: var(--raum-3);
    padding-inline: var(--raum-4);
    border: 1px solid var(--linie);
    border-radius: var(--radius-voll);
    background: var(--flaeche);
    transition: border-color var(--zeit-schnell) var(--kurve);
  }

  /* Etwas Luft zur ersten Zeile darunter: Die Liste setzt 2 px zwischen ihre
     Punkte, und ein Eingabefeld 2 px über einem Verweis liest sich, als wäre
     der Verweis eine Vorschlagszeile des Feldes. */
  .mobil-suche-punkt {
    margin-block-end: var(--raum-3);
  }

  .mobil-suche:focus-within {
    border-color: var(--akzent-schrift);
  }

  .mobil-suche svg {
    flex: none;
    color: var(--tinte-leise);
  }

  .mobil-suche input {
    flex: 1;
    min-width: 0;
    /* 2,75 rem sind 44 px – die kleinste Fläche, die eine Fingerspitze
       zuverlässig trifft. Die Höhe kommt vom Feld, nicht von der
       Schriftgröße, sonst hinge sie an der Sprache des Platzhalters. */
    min-block-size: 2.75rem;
    border: 0;
    padding: 0;
    background: none;
    font-family: inherit;
    font-weight: 500;
    /*
     * Ausdrücklich `--t-lg`, nicht geerbt.
     *
     * `global.css` hebt Eingabefelder auf Fingergeräten auf mindestens 16 px,
     * weil iOS sonst beim Fokus die ganze Seite heranzoomt. Diese Regel hier
     * ist über den Astro-Bereichsselektor spezifischer und würde sie schlagen
     * – dieselbe Falle, in die der Berater schon einmal gelaufen ist. `--t-lg`
     * beginnt bei 1,125 rem und liegt damit immer darüber; nebenbei steht die
     * Suche dann im selben Grad wie die Menüpunkte unter ihr.
     */
    font-size: var(--t-lg);
    color: inherit;
  }

  .mobil-suche input::placeholder {
    color: var(--tinte-leise);
  }

  /* Das Kreuzchen von Safari und Chrome sitzt in einem runden Feld schief und
     tut dasselbe wie die Rücktaste. */
  .mobil-suche input::-webkit-search-cancel-button {
    display: none;
  }

  /*
   * Der Fokusring gehört um die Kontur, nicht um das nackte Feld.
   *
   * `global.css` legt ihn mit 3 px Abstand um das fokussierte Element. Am
   * Eingabefeld läge er damit quer über der Pille. Um das Formular gelegt
   * umschließt er, was man auch sieht – gleiche Stärke, gleiche Farbe.
   *
   * Im `@supports`, weil die Unterdrückung am Feld sonst ohne Ersatz bliebe:
   * Kennt ein Browser `:has()` nicht, greift keine der beiden Regeln und der
   * Ring aus `global.css` bleibt stehen. Lieber an der falschen Stelle als
   * gar nicht.
   */
  @supports selector(:has(*)) {
    .mobil-suche:has(input:focus-visible) {
      outline: 3px solid var(--tinte);
      outline-offset: 3px;
      box-shadow: 0 0 0 6px rgb(255 255 255 / 0.85);
    }

    .mobil-suche input:focus-visible {
      outline: none;
      box-shadow: none;
    }
  }

  .haupt-link {
    position: relative;
    /* Eigener Stapelkontext, damit die Füllung mit z-index -1 hinter dem Text
       landet und nicht hinter der Glasleiste verschwindet. */
    isolation: isolate;
    display: block;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-voll);
    font-size: var(--t-sm);
    font-weight: 500;
    text-decoration: none;
    /*
     * Volle Tinte statt der weichen.
     *
     * Gemessen mit durchsichtig gestellter Schrift: Unter der Kopfleiste des
     * Blogbeitrags – dort liegt ein Foto darunter – kam der Untergrund auf
     * rgb(148,166,149). Gegen die weiche Tinte ergibt das 3,5:1 und liegt
     * damit unter den 4,5:1, die für Fließtext gelten.
     *
     * Der naheliegende Ausweg wäre gewesen, das Glas wieder dichter zu
     * machen. Das hätte genau die Sichtbarkeit zurückgenommen, um die es
     * hier geht. Dunklere Schrift löst dasselbe Problem, ohne etwas
     * aufzugeben: gegen dieselben rgb(148,166,149) sind es dann 7,1:1.
     */
    color: var(--tinte);
    transition: color var(--zeit) var(--kurve-weich);
  }

  .haupt-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--scheibe-flaeche);
    border: 1px solid var(--scheibe-rand);
    opacity: 0;
    transform: scale(0.86);
    transition:
      opacity var(--zeit) var(--kurve-weich),
      transform var(--zeit-lang) var(--kurve-feder);
  }

  .haupt-link:hover,
  .haupt-link.ist-aktiv {
    color: var(--tinte);
  }

  /*
   * NUR der aktive Punkt hat eine eigene Fläche.
   *
   * Vorher blendete beim Überfahren zusätzlich die Fläche des Punktes ein –
   * gleichzeitig mit dem wandernden Feld. Zu sehen waren damit zwei Pillen
   * übereinander: eine, die von 0,86 auf 1 aufpoppt, und eine, die
   * herübergleitet. Das war der Grund, warum die Bewegung „komisch" aussah;
   * sie war nicht komisch, sie war doppelt.
   *
   * Der Fokus braucht keine eigene Fläche mehr: Das wandernde Feld folgt
   * auch der Tastatur (`focus`-Zuhörer weiter unten), und `:focus-visible`
   * bekommt zusätzlich den globalen Fokusrahmen aus `global.css`. Der ist
   * sichtbar, wenn das Feld ausnahmsweise nicht erscheint – nämlich über dem
   * aktiven Punkt.
   */
  .haupt-link.ist-aktiv::after {
    opacity: 1;
    transform: scale(1);
  }

  /* Die aktive Seite trägt eine dunkle Pille – dieselbe Form wie die
     Hauptschaltfläche, nur ohne Aufforderung. Vorher war sie gelb: dieselbe
     Farbe wie der Terminknopf daneben, also zwei gleich laute Signale mit
     verschiedener Bedeutung. */
  .haupt-link.ist-aktiv {
    color: var(--knopf-schrift);
  }

  .haupt-link.ist-aktiv::after {
    background: var(--knopf-flaeche);
    border-color: transparent;
  }

  .kopf-aktionen {
    display: flex;
    align-items: center;
    gap: var(--raum-3);
  }

  .telefon {
    display: inline-flex;
    align-items: center;
    gap: var(--raum-2);
    font-size: var(--t-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  /*
   * Der Punkt vor der Rufnummer: geöffnet oder nicht.
   *
   * Er ist `aria-hidden` – die Öffnungszeiten stehen als Text in der
   * Standortleiste. Hier ist er ein Blickfang, kein Informationsträger, und
   * darf deshalb ausschließlich über Farbe und Bewegung sprechen.
   */
  .punkt {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tinte-leise);
    flex-shrink: 0;
  }

  /*
   * Geöffnet: kräftiges Grün, und ein Ring, der atmet.
   *
   * ── Warum der Ring pulsiert und nicht der Punkt ───────────────────────
   *
   * Ein Punkt, der selbst größer und kleiner wird, springt beim Lesen der
   * Rufnummer daneben – das Auge folgt der Größenänderung und verliert die
   * Ziffern. Ein Ring, der nach außen läuft und dabei verschwindet, macht
   * dasselbe Versprechen („hier ist gerade jemand") und lässt den Text in
   * Ruhe. Es ist die Bewegung eines Funksignals, nicht die eines Herzens.
   *
   * Der Ring liegt deshalb in einem Pseudoelement mit `transform: scale()` –
   * das läuft im Compositor. Eine Animation auf `box-shadow` müsste der
   * Browser bei jedem Bild neu zeichnen, und zwar unter der Kopfleiste, die
   * ohnehin einen Weichzeichner trägt.
   *
   * ── Und die Farbe ────────────────────────────────────────────────────
   *
   * `--erfolg` (#1F7A52) blieb auf der hellen Kopfleiste unauffällig. Der
   * Punkt bekommt jetzt zusätzlich einen satten Kern über einen zweiten,
   * stehenden Ring – zusammen liest er sich als leuchtender Punkt statt als
   * dunkelgrünes Pünktchen.
   */
  .punkt.offen {
    background: var(--erfolg);
    box-shadow: 0 0 0 2.5px color-mix(in oklab, var(--erfolg) 30%, transparent);
  }

  .punkt.offen::after {
    content: '';
    position: absolute;
    inset: -2.5px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in oklab, var(--erfolg) 70%, transparent);
    animation: punkt-welle 2.4s var(--kurve-weich) infinite;
  }

  @keyframes punkt-welle {
    0% {
      transform: scale(0.85);
      opacity: 0.75;
    }
    70% {
      transform: scale(2.1);
      opacity: 0;
    }
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  /* Wer Bewegung abbestellt hat, bekommt den Ring stehend – nicht gar
     keinen: Er trägt zur Auffälligkeit bei, um die es hier geht. */
  @media (prefers-reduced-motion: reduce) {
    .punkt.offen::after {
      animation: none;
      opacity: 0.6;
    }
  }

  /* ── Standortleiste ── */

  /*
   * Die Standortleiste trägt keine eigene Kante mehr.
   *
   * Unter einer frei schwebenden Pille wirkt eine durchgehende Linie wie ein
   * abgerissener Rest der alten Balkennavigation – sie schneidet genau dort
   * durch, wo die Leiste eigentlich schweben soll.
   */
  /*
   * Die zweite Zeile derselben Fläche.
   *
   * Getrennt durch eine Haarlinie statt durch Abstand: Das hält beides als
   * ein Bauteil zusammen und macht trotzdem klar, dass hier etwas anderes
   * steht als oben.
   */
  .standortleiste-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--raum-3);
    min-height: 2.5rem;
    flex-wrap: wrap;
    padding: var(--raum-2) var(--raum-5);
    border-block-start: 1px solid var(--linie);
    /*
     * Nur ein Hauch, kein zweiter Anstrich.
     *
     * Vorher 45 Prozent – zusammen mit den 58 der Glasfläche darunter ergab
     * das rund 78 Prozent Deckung, und durch 78 Prozent Weiß sieht man
     * nichts mehr. Die Leiste soll sich vom Menü darüber abheben, nicht das
     * Glas ersetzen.
     */
    background: color-mix(in oklab, var(--flaeche) 16%, transparent);
    /* Die untere Rundung der Glaspille – siehe Begründung bei `.kopf-glas`. */
    border-end-start-radius: var(--radius-xl);
    border-end-end-radius: var(--radius-xl);
  }

  /*
   * ── Der Wähler in der Leiste: dieselbe Naht, eine Ecke ────────────────
   *
   * Die Liste hängt auch hier an der Pille (`.waehler` ist bewusst
   * `position: static`), aber rechtsbündig und höchstens 24 rem breit. Sie
   * setzt also nur die rechte untere Ecke fort, nicht die ganze Unterkante.
   *
   * Drei Dinge müssen deshalb mit:
   *
   *   1. Der Rahmen: −1 px rückt die Liste über den Pillenrahmen statt
   *      daneben, und der Anschlag nach oben deckt die Kantenlinie ab –
   *      genau dort, wo die Liste steht, und nur dort.
   *   2. Die Rundung: Die Leiste rundet ihre untere Ecke selbst (sie macht
   *      die Ecken der Pille, siehe oben). Bliebe sie rund, stünde ein
   *      28-px-Bogen über der eckigen Oberkante der Liste.
   *   3. Die Aufhellung: `.standortleiste-inner` legt 16 % `--flaeche` über
   *      das Glas. Ohne dieselbe Lage in der Liste bliebe an der Naht eine
   *      zweite, schwächere Stufe stehen – dieselbe Ursache wie die große,
   *      nur leiser. Als `background-image` über die Grundfläche gelegt,
   *      damit die Fläche selbst aus `Standortliste.astro` kommt.
   */
  .standortleiste :global(.waehler-liste) {
    inset-inline-end: -1px;
    margin-block-start: -1px;
    background-image: linear-gradient(
      color-mix(in oklab, var(--flaeche) 16%, transparent),
      color-mix(in oklab, var(--flaeche) 16%, transparent)
    );
  }

  .standortleiste:has(.waehler[open]) .standortleiste-inner {
    border-end-end-radius: 0;
  }


  .wo-bin-ich {
    color: var(--tinte-leise);
    line-height: 1.4;
  }

  .wo-bin-ich strong {
    color: var(--tinte);
  }

  /*
   * KEIN `position: relative` – die Liste gehört an die Pille, nicht an den
   * Knopf.
   *
   * Hier stand es, und damit war der Wähler selbst der Bezugskasten seiner
   * aufklappenden Liste. Die ist bis 24 rem breit und richtet sich rechts
   * aus; auf dem Telefon steht der Knopf aber links in der Leiste. Gemessen
   * bei 390 px: Die Liste begann bei −187 px, bei 402 px sogar bei −199 –
   * die Hälfte der Standorte lag außerhalb des Bildschirms und war weder zu
   * sehen noch zu treffen.
   *
   * Ohne Positionierung ist der Bezug `.kopf-glas`, genau wie beim kompakten
   * Wähler oben: rechtsbündig zur Pille, bündig unter ihr, in jeder Breite
   * im Bild.
   */
  .waehler {
    position: static;
  }

  .waehler summary {
    display: inline-flex;
    align-items: center;
    gap: var(--raum-2);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-voll);
    font-weight: 600;
    color: var(--akzent-schrift);
    cursor: pointer;
    list-style: none;
  }

  .waehler summary::-webkit-details-marker {
    display: none;
  }

  .waehler summary svg {
    transition: transform var(--zeit) var(--kurve);
  }

  .waehler[open] summary svg {
    transform: rotate(180deg);
  }

  /*
   * Die Liste selbst steht in Standortliste.astro, nicht hier.
   *
   * Sie hängt an zwei Wählern – dem in der Leiste und dem kompakten oben –
   * und Astro grenzt Stile auf das Bauteil ein, in dem sie stehen. Blieben
   * die Regeln hier, griffen sie am kompakten Wähler nicht; stünden sie
   * zweimal da, liefen sie irgendwann auseinander.
   */

  /* ── Mobil ── */

  .menue-knopf {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 1px solid var(--scheibe-rand);
    background: var(--scheibe-flaeche);
    box-shadow: inset 0 1px 0 var(--glas-glanz);
  }

  .menue-knopf span,
  .menue-knopf span::before,
  .menue-knopf span::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--tinte);
    border-radius: 2px;
    transition: transform var(--zeit) var(--kurve), opacity var(--zeit-schnell) var(--kurve);
  }

  .menue-knopf span::before,
  .menue-knopf span::after {
    content: '';
    position: relative;
  }

  .menue-knopf span::before {
    top: -6px;
  }
  .menue-knopf span::after {
    top: 4px;
  }

  .menue-knopf[aria-expanded='true'] span {
    background: transparent;
  }

  .menue-knopf[aria-expanded='true'] span::before {
    transform: translateY(6px) rotate(45deg);
  }

  .menue-knopf[aria-expanded='true'] span::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobilmenue {
    border-top: 1px solid var(--glas-rand-unten);
    background: var(--glas-flaeche-stark);
    -webkit-backdrop-filter: blur(24px) saturate(var(--glas-saettigung));
    backdrop-filter: blur(24px) saturate(var(--glas-saettigung));
    padding-block: var(--raum-5);
    max-height: calc(100dvh - 8rem);
    overflow-y: auto;
  }

  .mobil-liste {
    list-style: none;
    padding: 0;
    display: grid;
    /*
     * `minmax(0, 1fr)` und nicht die stillschweigende Spur.
     *
     * Eine Rasterspalte ohne Angabe ist `auto`, und `auto` heißt: mindestens
     * so breit wie der breiteste Inhalt. Ein einziger Eintrag, der nicht
     * schmaler kann – ein Eingabefeld, ein langes Wort ohne Trennstelle –
     * zieht damit die ganze Spalte auf und schiebt alle anderen Zeilen mit
     * aus dem Bild. Die Null als Untergrenze nimmt der Spur dieses Recht: Sie
     * ist so breit wie das Menü und keinen Pixel breiter.
     */
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }

  .mobil-liste a {
    display: flex;
    justify-content: space-between;
    padding: var(--raum-3) var(--raum-2);
    font-size: var(--t-lg);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius);
  }

  .mobil-liste a:hover {
    background: var(--flaeche-warm);
  }

  .mobil-liste-klein a {
    font-size: var(--t-sm);
    color: var(--tinte-weich);
  }

  /* Name links, Nummer rechts – das `space-between` von `.mobil-liste a`
     macht das schon. Hier bleibt nur, was die Nummer selbst braucht:
     Ziffern gleicher Breite, damit sie nicht zappelt, und den Ampelpunkt
     dicht davor statt am anderen Zeilenende. */
  .mobil-telefon-nr {
    display: inline-flex;
    align-items: center;
    gap: var(--raum-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .mobil-titel {
    margin-block: var(--raum-5) var(--raum-2);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinte-leise);
  }

  .anzahl {
    color: var(--tinte-leise);
    font-variant-numeric: tabular-nums;
  }

  /*
   * Der schmale Schreibtisch: angedockt trägt die obere Zeile zwei
   * Bedienelemente mehr, als sie Platz hat.
   *
   * Gemessen: Der Inhalt der oberen Zeile braucht auf Deutsch 1166 px, auf
   * Englisch und Französisch 1245 – die Menüpunkte sind dort länger und
   * „Book an appointment" misst 45 px mehr als „Termin buchen". Der
   * Standortwähler (39 px) und die Sprachwahl (118 px) sind neu
   * dazugekommen; sie stehen im angedockten Zustand für die eingeklappte
   * Leiste.
   *
   * Die Obergrenze von 84 rem ist deshalb keine runde Zahl, sondern die
   * gemessene: 1245 px Inhalt plus 96 px Rand ergeben 1341 – darunter passt
   * die französische Fassung nicht mehr. Wer nur auf Deutsch prüft, setzt
   * hier 78 rem und übersieht es; genau das ist beim ersten Versuch
   * passiert, gefunden bei 1249 px auf /fr/.
   *
   * Weichen müssen Telefonnummer und Lupe – und zwar nur hier und nur
   * angedockt. Beide sind keine Navigation: Die Nummer steht in der
   * Fußzeile, auf der Kontaktseite und wieder oben, sobald man
   * hochscrollt; die Suche liegt unter /suche/. Der Standortwähler und die
   * Sprachwahl dagegen haben sonst gar keinen Platz mehr, denn die Leiste
   * darunter ist ja eingeklappt.
   *
   * `display: none` ist hier zulässig, weil es ganze Bedienelemente
   * entfernt und nicht deren Namen – anders als damals beim Berater-Knopf,
   * wo `display: none` den Text wegnahm und die Schaltfläche namenlos
   * zurückließ (siehe `namen-pruefen.mjs`).
   */
  @media (min-width: 74.0625rem) and (max-width: 84rem) {
    .kopf:global(.ist-angedockt) .telefon,
    .kopf:global(.ist-angedockt) .lupe-link {
      display: none;
    }
  }

  /*
   * ── Angedockt trägt zwei Elemente mehr – auch auf großen Telefonen ────
   *
   * Beim Andocken wandern Standortwähler und Sprachwahl nach oben in die
   * Aktionsleiste (siehe `.ist-angedockt .ort-kompakt` weiter oben). Die
   * Leiste braucht dann rund 50 px mehr, bekommt aber dieselbe Breite.
   * Was nicht hineinpasst, schiebt sie in ihr letztes Kind – den
   * Menüknopf, der dadurch aus der Pille ragt.
   *
   * Unter 26 rem ist das über Polster und Lücken gelöst. Darüber fehlte es:
   * gemessen bei 430 px im angedockten Zustand stand der Menüknopf 11,1 px
   * über der Pille. Ein Gerät mit 430 px ist kein Sonderfall – iPhone 15
   * Pro Max und Pixel 8 Pro liegen dort.
   *
   * Die Bedingung ist deshalb nicht „schmal", sondern „angedockt und noch
   * im Telefonsatz": bis 46 rem, dieselbe Grenze, ab der die Telefonnummer
   * aus der Leiste verschwindet.
   */
  @media (max-width: 46rem) {
    .kopf:global(.ist-angedockt) .kopf-inner {
      padding-inline: var(--raum-3);
      gap: var(--raum-3);
    }

    /* Die Liste ist die Fortsetzung der Pille, also fluchten ihre Zeilen mit
       deren Inhalt – dasselbe Polster wie `.kopf-inner`, in derselben
       Bedingung, sonst steht der gemeinsame Körper innen versetzt. */
    .kopf:global(.ist-angedockt) .kopf-aktionen .ort-kompakt :global(.waehler-liste) {
      padding-inline: var(--raum-3);
    }

    .kopf:global(.ist-angedockt) .kopf-aktionen {
      gap: var(--raum-3);
    }

    /*
     * Oben angedockt endet die Pille gerade, nicht rund.
     *
     * Angedockt liegt ihre Oberkante bei y = 0 – gemessen bei 320, 402, 780
     * und 1280 px. Die beiden oberen Ecken sind aber mit 28 px gerundet, und
     * in den zwei Zwickeln, die dadurch links und rechts oben frei bleiben,
     * scrollt die Seite durch. Auf dem Telefon ist das kein Detail: Dort
     * beginnt gleich unter der Statusleiste die Überschrift, und von ihr
     * bleibt in den Zwickeln ein drei Pixel hoher Streifen stehen, der wie
     * eine gestrichelte Linie über dem Kopf aussieht.
     *
     * Eckig oben heißt: Die beiden Seitenlinien laufen gerade nach oben aus
     * dem Bild, und der Kopf sitzt an der Kante des Schirms statt davor.
     * Unten bleibt es rund – dort schwebt die Pille wirklich, und dort
     * setzt auch die ausgeklappte Standortliste an.
     *
     * NUR MOBIL und NUR angedockt. Auf dem Schreibtisch steht der Kopf mit
     * Abstand zum Fensterrand; eine Pille, die dort oben eckig wird, sähe
     * abgeschnitten aus statt angesetzt.
     *
     * `.kopf-glasflaeche` braucht keine eigene Regel: Sie erbt den Radius
     * über `border-radius: inherit`.
     */
    .kopf:global(.ist-angedockt) .kopf-glas {
      border-start-start-radius: 0;
      border-start-end-radius: 0;
    }
  }

  /*
   * Ab wann das waagerechte Menü dem Menüknopf weicht: 74 rem, nicht 68.
   *
   * Der Grund ist Rechnen, nicht Geschmack. Angedockt trägt die obere Zeile
   * jetzt Standortwähler und Sprachwahl zusätzlich – auf Englisch und
   * Französisch zusammen 1245 px. Bei 68 rem stehen 993 px zur Verfügung;
   * selbst ohne Telefonnummer und Lupe fehlten 42.
   *
   * Zwischen 68 und 74 rem übernimmt deshalb der Menüknopf. Verloren geht
   * dabei nichts: Im Mobilmenü stehen dieselben Punkte, alle
   * Behandlungsbereiche einzeln aufklappbar UND die Sprachwahl – es ist
   * dort mehr zu sehen als in der Leiste, nicht weniger.
   */
  @media (max-width: 74rem) {
    .haupt {
      display: none;
    }
    .menue-knopf {
      display: flex;
    }
    .haupt {
      margin-inline-end: 0;
    }
    .kopf-aktionen {
      margin-inline-start: auto;
    }
  }

  @media (max-width: 46rem) {
    /*
     * Die Rufnummer verlässt die Kopfleiste ganz – nicht nur ihre Ziffern.
     *
     * Hier stand vorher `.telefon-nr { display: none }`. Übrig blieb der
     * Verweis mit dem Ampelpunkt darin: 8 px breit, `aria-hidden`, also ein
     * Ziel ohne Namen und weit unter den 24 px, die WCAG 2.5.8 verlangt.
     * Anrufen konnte damit niemand; im Weg stand es trotzdem.
     *
     * Und zwar messbar. Angedockt trägt die Zeile bei 390 px: Wortmarke
     * 99,6 + Wähler 38,4 + Punkt 8 + „Book an appointment" 150 + Menüknopf
     * 44, dazu vier Lücken à 12 – zusammen 388 px in einer Pille, die innen
     * 350 hat. Der Menüknopf, das letzte Kind und nicht schrumpfbar, stand
     * deshalb 19 px außerhalb des Fensters (Englisch) bzw. 17 px
     * (Französisch); auf Deutsch ging es aus, weil „Termin buchen" 36 px
     * kürzer ist. Punkt und Lücke sind 20 px – genau die, die fehlten.
     *
     * Verloren geht nichts: Die Nummer steht jetzt als eigene Zeile im
     * Mobilmenü, mit Namen und voller Zeilenhöhe, dazu in der Fußzeile, auf
     * der Kontaktseite und ab 46 rem wieder hier oben.
     */
    .telefon {
      display: none;
    }

    /*
     * Die Lupe verschwindet aus der Kopfleiste.
     *
     * Gemessen bei 390 px Fensterbreite lief der Kopf 14 Pixel über den Rand
     * – und ein Kopf, der übersteht, macht die ganze Seite seitlich
     * schiebbar. Verloren geht nichts: Im Mobilmenü steht „Suchen" als
     * erster Eintrag, und dort hat es mehr Platz und einen Namen statt eines
     * Symbols.
     */
    .lupe-link {
      display: none;
    }
    .standortleiste-inner {
      font-size: 0.7rem;
    }

    /* Der Pfeil entfällt – bei einem Symbol ohne Text sagt er nichts, was
       das Aufklappen nicht selbst zeigt, und kostet 15 der Pixel, die hier
       fehlen. */
    .ort-kompakt-pfeil {
      display: none;
    }
  }

  /**
   * Schmale Geräte: Der Kopf muss in die Breite passen, sonst lässt sich die
   * ganze Seite seitlich schieben.
   *
   * Gemessen bei 390 px: Der Kopf war 105 px zu breit – Wortmarke,
   * Standortname, Telefonpunkt, Terminknopf und Menüknopf nebeneinander
   * passen dort nicht. Sichtbar wurde es erst am Gerät, weil `flex` nichts
   * umbricht, sondern hinausschiebt.
   *
   * Es entfällt der Standortname neben der Marke. Er ist keine Auslassung:
   * Direkt darunter steht „Sie sehen KU64 Kurfürstendamm · Adresse“ – die
   * Angabe stünde zweimal, und die Zeile darunter ist die genauere.
   *
   * Der Terminknopf bleibt, aber schmaler. Er ist der Grund, warum die
   * meisten Menschen die Seite auf dem Handy öffnen.
   */
  @media (max-width: 26rem) {
    /* Der Ort bleibt auch hier stehen – er ist auf dem Telefon die einzige
       Stelle, an der steht, in welcher Praxis man gerade ist. Früher stand
       er hier auf `display: none`, weil daneben noch die ausgeschriebene
       Fassung in der Leiste stand. Die gibt es auf schmalen Bildschirmen
       nicht mehr. */

    .logo {
      padding-inline-start: 0.5rem;
    }

    .kopf-aktionen .knopf {
      padding-inline: var(--raum-3);
      font-size: var(--t-xs);
    }

    /*
     * ── Erst Platz schaffen, dann schrumpfen ────────────────────────────
     *
     * Vorher stand hier nur die zweite Hälfte: `min-width: 0` plus
     * `overflow: hidden`, damit der Kopf nicht über den Rand läuft. Das
     * verhinderte zwar das seitliche Schieben, aber um den Preis, dass
     * ausgerechnet der Terminknopf nachgab. Gemessen bei 360 px im
     * eingeklappten Kopf: Der Text war 16,6 px BREITER als sein Knopf und
     * lief unter dem Polster hindurch bis an die Pillenkante – genau das,
     * was auf dem Gerät als „zu eng am Rand" auffällt. Bei 393 px waren es
     * 1,4 px, bei 375 px 9,2.
     *
     * Der Knopf war nie das Problem. Der Platz war falsch verteilt:
     *
     *     Glaspille bei 360 px                          320 px
     *     − Innenpolster (2 × 24)                        48 px
     *     − zwei Lücken (2 × 24)                         48 px
     *     = für Logo und Aktionen                       224 px
     *       gebraucht: Logo 98 + Aktionen 148           246 px
     *
     * Die beiden Lücken sind der auffälligste Posten, und eine davon war
     * ganz umsonst: `.haupt` ist auf dem Telefon leer und 0 px breit,
     * erzeugt als Flex-Kind aber trotzdem auf beiden Seiten einen Abstand.
     *
     * Also: Polster und Lücke auf --raum-3, die leere Navigation ganz aus
     * dem Fluss. Das gibt 60 px zurück – mehr als die 22, die fehlten.
     */
    /*
     * Polster und Lücken auf --raum-2.
     *
     * Der eingeklappte Kopf trägt ein Element mehr als der ausgeklappte:
     * Beim Scrollen wandert der Standortwähler nach oben in die
     * Aktionsleiste. Gemessen bei 360 px braucht sie damit 219 px statt
     * 181 – und bekommt 200. Die 19 px Unterschied schob sie in ihr
     * letztes Kind, den Menüknopf, der dadurch 6,3 px über die Pille
     * hinausragte.
     *
     *     Logo 98 + Lücke + [Ort 38 + Lücke + Termin 113 + Lücke + Menü 44]
     *
     * Vier Lücken und zwei Polster à 12 px sind 72 px Zwischenraum auf einem
     * 360-px-Gerät. Auf 8 px zurückgenommen bleiben 48 – und der Kopf hat
     * wieder Luft, statt sie seinen Knöpfen abzunehmen.
     */
    .kopf-inner {
      padding-inline: var(--raum-2);
      gap: var(--raum-2);
    }

    /* Mit `.kopf-inner` mitgezogen, aus demselben Grund wie bei 46 rem. */
    .kopf-aktionen .ort-kompakt :global(.waehler-liste) {
      padding-inline: var(--raum-2);
    }

    .kopf-aktionen {
      gap: var(--raum-2);
    }

    .haupt:empty {
      display: none;
    }

    /*
     * Die Pille rückt näher an den Schirmrand.
     *
     * `--rand` ist `clamp(1.25rem, 5vw, 3rem)` und bleibt bei 360 px auf
     * seinem Mindestwert von 20 px stehen – der Prozentanteil greift dort
     * nicht mehr. Zwei mal 20 px sind auf einem 360-px-Gerät mehr Rahmen,
     * als die Pille verträgt, wenn vier Elemente hineinsollen.
     *
     * 12 px sehen auf einem kleinen Gerät nicht knapp aus, sondern richtig:
     * Der Rahmen wächst sonst mit, während der Inhalt schrumpft.
     */
    .kopf-glas {
      max-width: calc(100vw - 2 * var(--raum-2));
    }

    /*
     * Zielgrößen geben nicht nach.
     *
     * Nachdem der Terminknopf `flex: none` bekommen hatte, gab statt seiner
     * der Menüknopf nach – gemessen bei 360 px auf 32 px Breite und 10,3 px
     * über die Pille hinaus. Damit war die WCAG-Zielgröße von 24 px zwar
     * noch gehalten, die bequemen 44 px aber nicht mehr, und ein Knopf, der
     * aus seiner eigenen Leiste ragt, sieht nach Fehler aus.
     *
     * Ein Flex-Kind ohne `flex: none` ist immer der Kandidat, der zahlt.
     * Hier soll niemand zahlen: Der Platz reicht, seit Rahmen, Polster und
     * Lücken zurückgebaut sind.
     */
    .kopf-aktionen .menue-knopf,
    .kopf-aktionen .ort-kompakt {
      flex: none;
    }

    /*
     * Der Terminknopf gibt nicht mehr nach.
     *
     * Er ist der Grund, warum die meisten Menschen die Seite auf dem Handy
     * öffnen; wenn etwas weichen muss, dann nicht er. Mit dem
     * zurückgewonnenen Platz muss auch nichts mehr weichen – auf Englisch
     * („Book an appointment", sechs Zeichen mehr) ebenso wenig, nachgemessen
     * bei 360 px.
     */
    .kopf-aktionen .knopf-primaer {
      flex: none;
    }

    /*
     * `min-width: 0` bleibt als Netz für den Fall, den niemand vorhergesehen
     * hat – eine dritte Sprache, ein längerer Ortsname. Dann gibt zuerst das
     * Logo nach, nicht der Terminknopf. Eine Seite, die sich seitlich
     * schieben lässt, bleibt der schlechteste Ausgang von allen.
     */
    .kopf-aktionen {
      min-width: 0;
    }

    .logo {
      min-width: 0;
      overflow: hidden;
    }
  }

  /*
   * ── Unter 22 rem gibt der Standortwähler den Platz frei ───────────────
   *
   * Bei 320 px – iPhone SE der ersten Generationen, und was an Android
   * darunter liegt – reicht auch der zurückgebaute Zwischenraum nicht:
   * Logo, Ort, Termin und Menü brauchen 317 px, die Pille hat 304.
   *
   * Von den vieren ist der Ort der einzige, der anderswo vollständig
   * erreichbar ist: Das Mobilmenü führt ihn mit Überschrift und allen vier
   * Praxen („Bitte wählen Sie Ihren Standort für passende Angaben"), und
   * direkt unter dem Kopf steht die Zeile mit dem aktuellen Standort samt
   * Adresse. Das Symbol im Kopf ist eine Abkürzung, kein einziger Zugang.
   *
   * Der Terminknopf dagegen ist der Grund, warum die meisten Menschen die
   * Seite auf dem Telefon öffnen, und der Menüknopf führt zu allem
   * Übrigen. Beide bleiben in voller Zielgröße.
   */
  /*
   * ── Auf dem Telefon steht der Standort im Menü, nicht im Kopf ─────────
   *
   * Der kompakte Wähler war dort ein Fremdkörper. Er stritt mit Termin- und
   * Menüknopf um den Platz – bei 360 px angedockt blieben dem Terminknopf
   * rechnerisch 19 px zu wenig –, und seine Ausklappliste ist auf die
   * Standortleiste gerechnet: oben eckig, oben ohne Rahmen, damit sie
   * nahtlos daran ansetzt. Unter dem kleinen Symbol im Kopf hing damit eine
   * Fläche, die sichtbar zu etwas anderem gehörte.
   *
   * Beides ist mit einer Entscheidung erledigt: Auf dem Telefon steht der
   * Wähler in der Standortleiste unter dem Kopf – und, seit dieser Fassung,
   * zusätzlich im Menü. Damit ist er auch dann erreichbar, wenn die Leiste
   * beim Scrollen einklappt, und der Kopf behält seine zwei Knöpfe.
   *
   * Eine frühere Fassung blendete ihn nur unter 22 rem aus, mit der
   * Begründung, er stehe ja im Menü. Das stimmte damals nicht – im Menü gab
   * es ihn nicht. Deshalb steht er jetzt zuerst dort, und erst dann
   * verschwindet er hier.
   */
  /*
   * ── Der Wähler BLEIBT im angedockten Kopf ─────────────────────────────
   *
   * Ein Zwischenstand hatte ihn auf dem Telefon ganz entfernt, weil er nun
   * auch im Menü steht. `kopf-pruefen.mjs` hat das mit acht Befunden
   * zurückgewiesen, und zu Recht – zwei davon wiegen schwer:
   *
   *     „gescrollt gibt es keinen Standortwähler mehr"
   *     „gescrollt steht nirgends mehr, in welcher Praxis man ist"
   *
   * Der zweite ist der eigentliche: Wer auf `/potsdam/` liest und scrollt,
   * muss sehen, dass er in Potsdam ist. Sonst gelten Öffnungszeiten,
   * Telefonnummer und Terminstrecke für einen Ort, den niemand mehr nennt.
   * Der Wächter merkt an, dass der Umbau daran schon zweimal gescheitert
   * ist – ein Grund mehr, ihn nicht zu übergehen.
   *
   * Der Eintrag im Menü bleibt trotzdem: Er ist der zweite Weg, nicht der
   * Ersatz. Was hier zu lösen war, ist nicht die Erreichbarkeit, sondern
   * das Aussehen des Ausklapps – siehe `Standortliste.astro`.
   */
</style>

<script>
  import { beimSeitenaufbau } from '../lib/seitenaufbau';

  /* ── Was den Seitenwechsel überlebt und was nicht ──────────────────────
   *
   * Die Website tauscht beim Seitenwechsel den Körper aus, führt Module aber
   * nicht erneut aus. Alles, was ein Element aus der Seite greift, muss
   * deshalb nach jedem Aufbau neu gebunden werden – sonst hängt der Zuhörer
   * an einem Knopf, den es nicht mehr gibt. Genau das war der Fall: Das
   * mobile Menü ließ sich nach dem ersten Wechsel nicht mehr öffnen.
   *
   * `document` und `window` überleben den Austausch. Was an ihnen hängt,
   * steht deshalb unten und wird genau einmal registriert – zweimal wäre
   * hier ein Fehler, nicht nur Ballast.
   */

  /*
   * Alles, was sich aufklappt – nicht nur der eine Wähler.
   *
   * Drei Dinge klappen im Kopf auf: der Standortwähler in der Leiste
   * (`.waehler`), der kompakte im Kopf (`.ort-kompakt`) und das große
   * Behandlungsmenü (`.mega`). Hier stand nur der erste – und damit blieben
   * die anderen offen, wenn man daneben klickte, mit Escape schloss oder
   * das Fenster wechselte. Ein Menü, das nur auf seinen eigenen Knopf hört,
   * legt sich über die Seite und bleibt dort liegen.
   *
   * Eine Konstante statt zweier Zeichenketten an sechs Stellen: Der Fehler
   * bestand ja gerade darin, dass eine Stelle den neuen Wähler nicht kannte.
   */
  const WAEHLER = '.waehler[open], .ort-kompakt[open], .mega[open]';

  function waehlerZu() {
    for (const d of document.querySelectorAll<HTMLDetailsElement>(WAEHLER)) {
      d.open = false;
    }
  }

  /** Alles schließen, was den Klick oder den Fokus nicht selbst enthält. */
  function waehlerZuAusser(ziel: Node) {
    for (const d of document.querySelectorAll<HTMLDetailsElement>(WAEHLER)) {
      if (!d.contains(ziel)) d.open = false;
    }
  }

  /*
   * Standortwähler schließen, sobald man woanders hinklickt.
   *
   * Zwei Dinge waren hier falsch. Erstens war der Wähler beim Laden der Seite
   * einmal abgefragt und in einer Variablen festgehalten – wird das Markup
   * später ersetzt, zeigt die Variable auf ein Element, das nicht mehr in der
   * Seite steht, und das Schließen greift ins Leere. Jetzt wird bei jedem
   * Klick neu gesucht.
   *
   * Zweitens zählte nur der Klick als "außerhalb". Wer mit der Tastatur
   * weiterspringt oder das Fenster wechselt, ließ den Wähler offen stehen.
   */
  document.addEventListener('click', (e) => waehlerZuAusser(e.target as Node));

  /* Der Fokus wandert aus dem Wähler heraus – etwa mit der Tabulatortaste. */
  document.addEventListener('focusin', (e) => waehlerZuAusser(e.target as Node));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') waehlerZu();
  });

  /* Beim Scrollen mitgehen zu lassen wäre störend – beim Verlassen der Seite
     oder beim Wechsel in ein anderes Fenster aber nicht. */
  window.addEventListener('blur', waehlerZu);

  // ── Ab hier: alles, was Elemente aus der Seite braucht ────────────────

  beimSeitenaufbau(() => {
    const abbauen: (() => void)[] = [];

    // Mobiles Menü
    const knopf = document.querySelector<HTMLButtonElement>('.menue-knopf');
    const menue = document.getElementById('mobilmenue');

    knopf?.addEventListener('click', () => {
      const offen = knopf.getAttribute('aria-expanded') === 'true';
      knopf.setAttribute('aria-expanded', String(!offen));
      /* Fehlt das Datenattribut, bleibt die vorhandene Beschriftung stehen.
         Ohne Abfrage schreibt setAttribute die Zeichenkette „undefined" in
         aria-label – ein Screenreader liest sie dann vor. */
      const label = offen ? knopf.dataset.labelOeffnen : knopf.dataset.labelSchliessen;
      if (label) knopf.setAttribute('aria-label', label);
      if (menue) menue.hidden = offen;
      /*
       * Der Zustand muss nach außen sichtbar sein.
       *
       * Der Berater-Knopf liegt `position: fixed` unten rechts und wusste
       * nichts vom offenen Menü – er lag als runder Fleck über der
       * Standortliste, genau auf „Berlin-Mitte". Zwei Komponenten, die
       * einander nicht kennen, brauchen einen gemeinsamen Anschlag; ein
       * Attribut am Wurzelelement ist der billigste.
       *
       * `:has(#mobilmenue:not([hidden]))` wäre ohne Skript ausgekommen, hängt
       * aber daran, dass beide im selben Baum stehen und der Wähler
       * unterstützt wird. Ein gesetztes Attribut ist nachlesbar und
       * prüfbar.
       */
      document.documentElement.toggleAttribute('data-menue-offen', !offen);
    });

    /*
     * Angedockt oder nicht.
     *
     * Ein IntersectionObserver auf einem Pixel über dem Kopf statt eines
     * Scroll-Handlers: Der Browser meldet den Wechsel selbst, statt bei jedem
     * Scrollschritt eine Position auszurechnen. Zwei Meldungen pro Seite statt
     * hundert pro Sekunde.
     */
    const marke = document.querySelector('.kopf-marke');
    const kopf = document.querySelector('.kopf');

    if (marke && kopf && 'IntersectionObserver' in window) {
      const beobachter = new IntersectionObserver(
        ([eintrag]) => {
          kopf.classList.toggle('ist-angedockt', !eintrag.isIntersecting);
          /*
           * In BEIDE Richtungen schließen.
           *
           * Hier stand `if (!eintrag.isIntersecting)`, also nur beim
           * Einklappen. Das war richtig, solange es einen Wähler gab: Der
           * in der Leiste hinge sonst unter einer Leiste, die es nicht mehr
           * gibt. Seit der zweite oben im Kopf steht, gilt dasselbe
           * umgekehrt – wer ihn offen lässt und nach oben scrollt, hat ein
           * Menü an einem Knopf, der gerade verschwindet.
           */
          waehlerZu();
        },
        { threshold: 0 },
      );
      beobachter.observe(marke);
      abbauen.push(() => beobachter.disconnect());
    }

    /*
     * Öffnungsstatus im Browser neu berechnen. Die Seite ist statisch, der
     * beim Build ermittelte Status wäre sonst dauerhaft falsch.
     */
    const telefon = document.querySelector<HTMLAnchorElement>('.telefon');
    const punkt = telefon?.querySelector('.punkt');
    const rohdaten = telefon?.dataset.oeffnungszeiten;

    if (punkt && rohdaten) {
      try {
        const zeiten = JSON.parse(rohdaten) as {
          tag: string;
          von: string | null;
          bis: string | null;
        }[];
        const tage = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
        const jetzt = new Date();
        const heute = zeiten.find((z) => z.tag === tage[jetzt.getDay()]);

        let offen = false;
        if (heute?.von && heute.bis) {
          const min = jetzt.getHours() * 60 + jetzt.getMinutes();
          const [vh, vm] = heute.von.split(':').map(Number);
          const [bh, bm] = heute.bis.split(':').map(Number);
          offen = min >= vh * 60 + vm && min < bh * 60 + bm;
        }

        punkt.classList.toggle('offen', offen);
        telefon?.setAttribute(
          'title',
          offen
            ? 'Jetzt geöffnet – rufen Sie uns an'
            : 'Gerade geschlossen – hinterlassen Sie uns eine Nachricht',
        );
      } catch {
        /* Fehlerhafte Daten: Punkt bleibt neutral. */
      }
    }

    /* ── Das große Behandlungsmenü öffnet auch beim Überfahren ─────────
     *
     * Klicken funktioniert überall und ist der Grundzustand – ein `<details>`
     * braucht dafür keine Zeile JavaScript. Am Schreibtisch erwartet man von
     * einem großen Menü aber, dass es beim Hinfahren aufgeht.
     *
     * Nur für Geräte mit echtem Zeiger: Auf einem Touchscreen meldet der
     * Browser den ersten Tipp als `pointerenter` UND als Klick – das Menü
     * ginge auf und sofort wieder zu.
     *
     * Die Verzögerungen sind nicht Geschmack: 120 ms beim Öffnen verhindern,
     * dass das Feld aufspringt, wenn jemand nur über „Leistungen" hinweg zu
     * „Team" fährt. 220 ms beim Schließen überbrücken den Weg vom Menüpunkt
     * ins Feld – dazwischen liegt ein Spalt, und ohne Nachlauf klappte es
     * genau dort zu.
     */
    const mega = document.querySelector<HTMLDetailsElement>('.mega');
    if (mega && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let aufZeit: number | undefined;
      let zuZeit: number | undefined;

      mega.addEventListener('pointerenter', () => {
        window.clearTimeout(zuZeit);
        aufZeit = window.setTimeout(() => {
          mega.open = true;
        }, 120);
      });

      mega.addEventListener('pointerleave', () => {
        window.clearTimeout(aufZeit);
        zuZeit = window.setTimeout(() => {
          mega.open = false;
        }, 220);
      });

      abbauen.push(() => {
        window.clearTimeout(aufZeit);
        window.clearTimeout(zuZeit);
      });
    }

    /* ── Das wandernde Feld im Hauptmenü ────────────────────────────────
     *
     * Es folgt dem Zeiger von Punkt zu Punkt und kehrt beim Verlassen zum
     * aktiven Punkt zurück. Gemessen wird gegen die Liste, nicht gegen das
     * Fenster – so stimmt die Rechnung auch, wenn der Kopf beim Scrollen
     * andockt und sich dabei verschiebt.
     */
    const liste = document.querySelector<HTMLElement>('.haupt-liste');
    const laeufer = liste?.querySelector<HTMLElement>('.haupt-laeufer');
    const links = liste ? [...liste.querySelectorAll<HTMLElement>('.haupt-link')] : [];

    if (liste && laeufer && links.length > 0) {
      let zuletzt: HTMLElement | null = null;

      /*
       * Gemessen gegen den tatsächlichen Bezugskasten, nicht gegen die Liste.
       *
       * Vorher stand hier `liste.getBoundingClientRect()`, weil die Liste
       * `position: relative` trug und damit der Bezug war. Seit sie das
       * nicht mehr tut – das große Menü braucht die Pille als Bezug –, wäre
       * diese Rechnung um den Abstand vom Pillenrand zur Liste daneben.
       *
       * `offsetParent` beantwortet die Frage, statt sie vorauszusetzen: Es
       * IST der Kasten, auf den sich `top` und `left` beziehen. Damit stimmt
       * die Rechnung auch, wenn später wieder jemand eine Ebene dazwischen
       * positioniert.
       */
      const stellen = (ziel: HTMLElement) => {
        const bezug = (laeufer.offsetParent ?? liste).getBoundingClientRect();
        const z = ziel.getBoundingClientRect();
        laeufer.style.setProperty('--x', `${z.left - bezug.left}px`);
        laeufer.style.setProperty('--y', `${z.top - bezug.top}px`);
        laeufer.style.setProperty('--b', `${z.width}px`);
        laeufer.style.setProperty('--h', `${z.height}px`);
      };

      /*
       * Wann das Feld zuletzt verschwunden ist.
       *
       * Es entscheidet, ob das nächste Erscheinen springen darf. Wer den
       * aktiven Punkt überquert und gleich weiterzieht, hat das Feld eine
       * Zehntelsekunde nicht gesehen – ein Sprung an die neue Stelle wirkt
       * dann wie ein Aussetzer. Wer eine Minute später zurückkommt, erwartet
       * keine Bewegung von der alten Stelle her.
       */
      let versteckSeit = 0;

      /**
       * Ausblenden – auf Wunsch erst noch zum Ziel gleiten.
       *
       * Der Kommentar oben verspricht seit jeher, das Feld kehre beim
       * Verlassen zum aktiven Punkt zurück. Der Code tat das nie: Er nahm
       * nur die Deckkraft weg und ließ das Feld stehen, wo es gerade war.
       * Über dem aktiven Punkt sah man es deshalb schlagartig verschwinden,
       * mitten in der Bewegung.
       */
      const verbergen = (ziel?: HTMLElement | null) => {
        if (ziel) stellen(ziel);
        delete laeufer.dataset.sichtbar;
        versteckSeit = performance.now();
        zuletzt = null;
      };

      const zeigen = (ziel: HTMLElement) => {
        /*
         * Über dem aktiven Punkt nicht – dort steht schon seine eigene
         * Fläche. Aber es gleitet dorthin und löst sich dort auf, statt an
         * Ort und Stelle auszugehen.
         */
        if (ziel.classList.contains('ist-aktiv')) {
          verbergen(ziel);
          return;
        }
        /*
         * Beim ersten Erscheinen erst setzen, dann einblenden – sonst gleitet
         * das Feld sichtbar von der linken Kante herbei, weil es vorher bei
         * Null stand. Danach soll es gleiten, das ist ja der Sinn.
         */
        const warVerborgen = !laeufer.hasAttribute('data-sichtbar');
        /* Nur springen, wenn es wirklich weg war – nicht bei einem
           Wimpernschlag über dem aktiven Punkt. */
        const langeWeg = performance.now() - versteckSeit > 420;
        if (warVerborgen && langeWeg) {
          const alterUebergang = laeufer.style.transition;
          laeufer.style.transition = 'none';
          stellen(ziel);
          /* Layout erzwingen, damit die Sprungposition gilt, bevor der
             Übergang zurückkommt. */
          void laeufer.offsetWidth;
          laeufer.style.transition = alterUebergang;
        } else {
          stellen(ziel);
        }
        laeufer.dataset.sichtbar = '';
        zuletzt = ziel;
      };

      for (const link of links) {
        link.addEventListener('pointerenter', () => zeigen(link));
        link.addEventListener('focus', () => zeigen(link));
      }
      /*
       * Beim Verlassen zurück zum aktiven Punkt – oder an Ort und Stelle
       * auflösen, wenn es keinen gibt (etwa auf einer Unterseite ohne
       * eigenen Menüpunkt).
       *
       * Die Klammern sind nicht Zierrat: `verbergen` bekäme als Zuhörer das
       * Ereignis als erstes Argument, und `stellen(PointerEvent)` wirft.
       */
      const aktiverPunkt = () => links.find((l) => l.classList.contains('ist-aktiv')) ?? null;

      liste.addEventListener('pointerleave', () => verbergen(aktiverPunkt()));
      liste.addEventListener('focusout', (e) => {
        if (!liste.contains(e.relatedTarget as Node)) verbergen(aktiverPunkt());
      });

      /* Die Breite der Punkte ändert sich mit der Fenstergröße und mit der
         Sprache. Ohne Beobachter säße das Feld danach neben seinem Punkt. */
      const nachmessen = () => {
        if (zuletzt) stellen(zuletzt);
      };
      const groesse = new ResizeObserver(nachmessen);
      groesse.observe(liste);
      document.fonts?.ready.then(nachmessen);
      abbauen.push(() => groesse.disconnect());
    }

    return () => {
      for (const f of abbauen) f();
    };
  });
</script>
