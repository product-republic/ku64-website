---
import { inhalte } from '../i18n/daten';

const daten = inhalte(Astro);

/**
 * Standortwahl für standortfreie Seiten (/termine/, /anamnese/).
 *
 * Statt willkürlich einen Standort zu wählen oder automatisch weiterzuleiten,
 * fragen wir. Der zuletzt gewählte Standort wird oben angeboten – sichtbar
 * gekennzeichnet, damit niemand versehentlich am falschen Ort landet.
 */

interface Props {
  /** Unterpfad, der an den Standort angehängt wird, z. B. "termine". */
  ziel: string;
  titel?: string;
}

const { ziel, titel = 'Bitte wählen Sie Ihren Standort' } = Astro.props;
---

<div class="wahl">
  <h2>{titel}</h2>
  <p class="hinweis-text">
    Sprechzeiten, Telefonnummern und das Behandlungsangebot unterscheiden sich je Standort –
    deshalb fragen wir lieber, statt zu raten.
  </p>

  <div class="raster" id="wahlRaster">
    {
      daten.standorte.map((s) => (
        <a
          class="karte karte-klickbar ziel"
          href={`/${s.slug}/${ziel}/`}
          style={`--akzent:${s.akzent}`}
          data-slug={s.slug}
        >
          <span class="zuletzt-marke marke marke-erfolg" hidden>zuletzt gewählt</span>
          <h3>KU64 {s.name}</h3>
          <address>{s.strasse}, {s.plz} {s.ort}</address>
          <p class="tel">{s.telefon}</p>
        </a>
      ))
    }
  </div>
</div>

<script>
  import { beimSeitenaufbau } from '../lib/seitenaufbau';

  /* Nach jedem Seitenaufbau: Die Karten sind beim Seitenwechsel neue
     Elemente, das Modul läuft aber nicht noch einmal. Ohne das blieb die
     Markierung „zuletzt gewählt" beim zweiten Aufruf der Standortübersicht
     aus. */
  beimSeitenaufbau(() => {
    // Zuletzt gewählten Standort markieren und nach vorn sortieren.
    try {
      const slug = localStorage.getItem('ku64:standort');
      if (slug) {
        const karte = document.querySelector<HTMLElement>(`.ziel[data-slug="${slug}"]`);
        const marke = karte?.querySelector<HTMLElement>('.zuletzt-marke');
        if (karte && marke) {
          marke.hidden = false;
          karte.parentElement?.prepend(karte);
        }
      }
    } catch {
      /* kein Speicher verfügbar */
    }
  });
</script>

<style>
  .wahl { padding-block: var(--raum-6); }
  h2 { font-size: var(--t-xl); margin-block-end: var(--raum-3); }
  .hinweis-text { max-width: var(--breite-text); margin-block-end: var(--raum-6); color: var(--tinte-weich); }
  .ziel { text-decoration: none; overflow: hidden; }
  /* Das gelbe Band über jeder Karte ist entfallen. Vier Karten nebeneinander
     ergaben vier gelbe Balken – eine Auszeichnung, die alles auszeichnet,
     zeichnet nichts aus. Die Karten unterscheiden sich jetzt durch das, was
     auf ihnen steht. */
  .zuletzt-marke { align-self: flex-start; margin-block-end: var(--raum-2); }
  .ziel h3 { font-size: var(--t-lg); }
  address { font-style: normal; margin-block: var(--raum-2); font-size: var(--t-sm); color: var(--tinte-leise); }
  .tel { margin-block-start: auto; font-size: var(--t-sm); font-weight: 600; color: var(--akzent-schrift); }
</style>
