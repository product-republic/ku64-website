---
/**
 * Ein Inhalt eines Drittanbieters – gesperrt, bis jemand ihn freigibt.
 *
 * ── Was das löst ────────────────────────────────────────────────────────
 *
 * Die übliche Sperre ist ein grauer Kasten mit „Dieser Inhalt wurde
 * blockiert". Der sagt nur, was NICHT da ist, und man klickt ihn frei, ohne
 * zu wissen, was kommt. Hier steht stattdessen eine verschwommene Vorschau:
 * Man sieht, dass dort eine Karte, ein Rundgang, ein Video liegt – und
 * entscheidet in Kenntnis der Sache.
 *
 * ── Die entscheidende Eigenschaft ───────────────────────────────────────
 *
 * Die Vorschau kommt aus EIGENEN Dateien. Kein Bild, kein Vorschaubild, kein
 * Aufwärm-Abruf geht vor der Freigabe an den Drittanbieter – auch nicht als
 * `preconnect`. Genau daran scheitern die meisten „Zwei-Klick-Lösungen":
 * Sie zeigen als Platzhalter das Vorschaubild von YouTube und haben damit
 * die Verbindung schon aufgebaut, gegen die sie schützen sollen.
 *
 * Der `iframe` wird erst im Moment der Freigabe erzeugt und in den DOM
 * gehängt. Vorher existiert er nicht – kein `src`, kein `data-src`, kein
 * `hidden`. Ein verstecktes `iframe` mit gesetztem `src` lädt.
 *
 * ── Warum die Freigabe hier auch die Einwilligung setzt ─────────────────
 *
 * Wer auf „Karte laden" klickt, hat entschieden. Ihn danach noch durch den
 * Auswahldialog zu schicken wäre eine zweite Frage auf dieselbe Antwort.
 * Der Klick erteilt die Einwilligung für die Kategorie des Dienstes und
 * merkt sie – dieselbe Speicherung wie im Dialog, damit beides nicht
 * auseinanderläuft.
 *
 * `nurEinmal` schaltet das ab: Beim Sprachberater soll jedes Gespräch
 * einzeln zugestimmt werden, weil dort die Stimme übertragen wird.
 *
 * ── Barrierefreiheit ────────────────────────────────────────────────────
 *
 * Die verschwommene Fläche ist `aria-hidden` – eine Vorlesehilfe kann mit
 * einem unscharfen Bild nichts anfangen. Was dort liegt, steht im
 * zugänglichen Namen der Schaltfläche, und der ist vollständig: nicht
 * „Laden", sondern „Karte von Google Maps laden – dabei werden Daten an
 * Google übertragen". Ein Knopf, der nur „Laden" heißt, ist in einer
 * Liste aller Bedienelemente nicht unterscheidbar.
 */
import { DIENSTE } from '../data/dienste';
import { texte } from '../i18n/katalog';
import { spracheAusParameter } from '../i18n/sprachen';

interface Props {
  /** Slug aus `dienste.ts`. Ein Dienst ohne Eintrag ist ein Baufehler. */
  dienst: string;
  /** Die Adresse, die nach der Freigabe in den `iframe` kommt. */
  adresse: string;
  /** Was dort zu sehen sein wird – für Schaltfläche und Vorlesehilfe. */
  titel: string;
  /** Seitenverhältnis der Fläche, damit nichts springt. */
  verhaeltnis?: string;
  /** Höhe statt Verhältnis, wo eine Karte eine feste Höhe braucht. */
  hoehe?: string;
  /** Einwilligung merken (Standard) oder nur für diesen Aufruf gelten lassen. */
  nurEinmal?: boolean;
  /** Erlaubnisse für den `iframe`, z. B. 'fullscreen; xr-spatial-tracking'. */
  erlauben?: string;
}

const {
  dienst: slug,
  adresse,
  titel,
  verhaeltnis = '16 / 9',
  hoehe,
  nurEinmal = false,
  erlauben,
} = Astro.props;

/* Sprache aus der Adresse – wie im Auswahldialog, aus demselben Grund. */
const t = texte(spracheAusParameter(Astro.params.sprache as string | undefined));

const d = DIENSTE.find((x) => x.slug === slug);

/*
 * Ein Dienst, der nicht im Verzeichnis steht, wird nicht eingebettet –
 * und zwar mit Abbruch beim Bauen, nicht mit einer leeren Fläche.
 *
 * Das ist der Grund, warum es diese Datei gibt: Sonst bindet in einem halben
 * Jahr jemand ein Fenster ein, das in keiner Datenschutzerklärung steht.
 */
if (!d) {
  throw new Error(
    `[Drittinhalt] „${slug}" steht nicht in src/data/dienste.ts.\n` +
      'Kein eingebetteter Drittanbieter ohne Eintrag im Verzeichnis – sonst fehlt er in ' +
      'der Datenschutzerklärung, in /cookies/ und im Auswahldialog.',
  );
}

if (d.stand !== 'aktiv') {
  throw new Error(
    `[Drittinhalt] „${slug}" steht als „${d.stand}" im Verzeichnis und darf nicht eingebettet ` +
      'werden. Erst den Eintrag auf „aktiv" setzen und VERZEICHNIS_FASSUNG hochzählen.',
  );
}

/* Der Name der Schaltfläche nennt Dienst und Folge – siehe Kopfkommentar. */
const knopfName = t('dritt.ladenName', { titel, anbieter: d.anbieter.split(',')[0] });

/* Ohne bestätigten AV-Vertrag wird nicht geladen, auch nicht auf Klick.
   Eine Einwilligung ersetzt keinen Vertrag. */
const gesperrt = !d.avVertrag;
---

<figure
  class="dritt"
  data-dienst={slug}
  data-adresse={adresse}
  data-kategorie={d.kategorie}
  data-nur-einmal={nurEinmal ? '1' : null}
  data-erlauben={erlauben}
  data-titel={titel}
  style={hoehe ? `--dritt-hoehe:${hoehe}` : `--dritt-verhaeltnis:${verhaeltnis}`}
>
  <div class="dritt-flaeche">
    {/* Die verschwommene Vorschau. `aria-hidden`, weil unscharf keine
        Information ist – sie steht im Namen der Schaltfläche. */}
    <div class="dritt-vorschau" aria-hidden="true">
      <slot name="vorschau" />
    </div>

    <div class="dritt-frage" data-rolle="frage">
      <p class="dritt-titel">{titel}</p>
      {
        gesperrt ? (
          <p class="dritt-text">
            {t('dritt.nochNichtFrei', { dienst: d.name, anbieter: d.anbieter.split(',')[0] })}
          </p>
        ) : (
          <>
            <p class="dritt-text">{t('dritt.wirdGeladen')}</p>
            <button type="button" class="knopf knopf-primaer" data-rolle="freigeben" aria-label={knopfName}>
              {t('dritt.laden')}
            </button>
            <p class="dritt-fein">
              {t('dritt.uebertragung', {
                daten: d.daten.slice(0, 2).join(' und '),
                anbieter: d.anbieter.split(',')[0],
              })}{' '}
              <a href="/cookies/#verzeichnis">{t('dritt.wasUebertragen')}</a>
            </p>
          </>
        )
      }
    </div>
  </div>

  <figcaption class="dritt-fuss">
    <slot name="fuss" />
  </figcaption>
</figure>

<script>
  import { beimSeitenaufbau } from '../lib/seitenaufbau';

  /*
   * Nach jedem Seitenaufbau neu binden.
   *
   * Der ClientRouter tauscht den Körper aus, ohne Module erneut auszuwerten –
   * ohne diesen Umweg funktioniert die Freigabe nur auf der zuerst geladenen
   * Seite. Genau dieser Fehler hat in diesem Projekt schon den
   * Sprachumschalter und die Standortwahl gekostet.
   */
  beimSeitenaufbau(() => {
    const SCHLUESSEL = 'ku64:einwilligung';
    const TAGE = 182;

    function fassung() {
      const el = document.querySelector('script[data-fassung]');
      return el ? Number((el as HTMLElement).dataset.fassung) : 1;
    }

    function gespeichert() {
      try {
        const roh = localStorage.getItem(SCHLUESSEL);
        if (!roh) return null;
        const e = JSON.parse(roh);
        if (!e || !Array.isArray(e.kategorien) || e.fassung !== fassung()) return null;
        const alter = (Date.now() - Date.parse(e.am)) / 86400000;
        return isFinite(alter) && alter <= TAGE ? e : null;
      } catch {
        return null;
      }
    }

    function merken(kategorie: string) {
      const vorher = gespeichert();
      const kategorien = new Set<string>(vorher ? vorher.kategorien : []);
      kategorien.add(kategorie);
      const e = { kategorien: [...kategorien], am: new Date().toISOString(), fassung: fassung() };
      try {
        localStorage.setItem(SCHLUESSEL, JSON.stringify(e));
      } catch {
        /* Privater Modus: Die Freigabe gilt dann nur für diese Seite. */
      }
      document.dispatchEvent(new CustomEvent('ku64:einwilligung', { detail: e }));
    }

    function einsetzen(figur: HTMLElement) {
      if (figur.dataset.geladen === '1') return;
      figur.dataset.geladen = '1';

      const flaeche = figur.querySelector('.dritt-flaeche');
      const frage = figur.querySelector('[data-rolle="frage"]');
      if (!flaeche) return;

      const rahmen = document.createElement('iframe');
      rahmen.src = figur.dataset.adresse || '';
      rahmen.title = figur.dataset.titel || '';
      rahmen.loading = 'lazy';
      /* `referrerpolicy`: Der Drittanbieter braucht nicht zu wissen, auf
         welcher Unterseite jemand war – die Domain genügt ihm. */
      rahmen.referrerPolicy = 'strict-origin-when-cross-origin';
      if (figur.dataset.erlauben) rahmen.setAttribute('allow', figur.dataset.erlauben);
      rahmen.className = 'dritt-rahmen';

      frage?.remove();
      figur.querySelector('.dritt-vorschau')?.remove();
      flaeche.appendChild(rahmen);
    }

    /* Schon freigegebene Kategorien: sofort einsetzen, ohne zweite Frage. */
    function nachziehen() {
      const e = gespeichert();
      for (const figur of document.querySelectorAll<HTMLElement>('.dritt')) {
        if (figur.dataset.nurEinmal === '1') continue;
        const k = figur.dataset.kategorie || '';
        if (e && e.kategorien.includes(k)) einsetzen(figur);
      }
    }

    for (const figur of document.querySelectorAll<HTMLElement>('.dritt')) {
      figur.querySelector('[data-rolle="freigeben"]')?.addEventListener('click', () => {
        if (figur.dataset.nurEinmal !== '1') merken(figur.dataset.kategorie || '');
        einsetzen(figur);
      });
    }

    nachziehen();

    /* Wer im Dialog nachträglich zustimmt, soll die Karte sehen, ohne die
       Seite neu zu laden. */
    const hoerer = () => nachziehen();
    document.addEventListener('ku64:einwilligung', hoerer);
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('ku64:einwilligung', hoerer);
    }, { once: true });
  });
</script>

<style>
  .dritt {
    margin: 1.6rem 0;
  }

  /*
   * ── Das Seitenverhältnis ist eine MINDESThöhe, keine feste ───────────
   *
   * Vorher stand hier `aspect-ratio` direkt auf der Fläche, und die Frage
   * lag mit `position: absolute` darin. Eine absolut liegende Frage trägt
   * nichts zur Höhe bei – sie wurde abgeschnitten, sobald sie mehr Platz
   * brauchte, als 16:9 hergibt.
   *
   * Auf dem Telefon ist das der Normalfall, nicht die Ausnahme: Bei 362 px
   * Breite sind 16:9 genau 204 px, und darin sollen Titel, der Satz „Wird
   * erst auf Ihren Klick geladen …", die Schaltfläche mit dem vollen
   * Videotitel und die Zeile zum Verzeichnis stehen. Gemessen lief die
   * Schaltfläche links und rechts aus dem Kasten, vom Titel blieb die
   * untere Hälfte. Übrig blieb eine dunkle Fläche – als sei das Video
   * kaputt.
   *
   * Jetzt liegen alle Kinder in derselben Rasterzelle. Das `::before` hält
   * das Verhältnis als Untergrenze – der Platz steht also weiterhin von
   * Anfang an, es gibt keinen Layout-Sprung –, und die Zeile wächst, wenn
   * die Frage mehr braucht. Nach der Zustimmung fällt die Frage weg, und
   * der Rahmen sitzt wieder exakt im Verhältnis.
   */
  .dritt-flaeche {
    position: relative;
    display: grid;
    /*
     * `minmax(0, 1fr)`, nicht das voreingestellte `auto`.
     *
     * Eine auto-Spalte nimmt die max-content-Breite ihrer Kinder. Die kommt
     * hier aus `.dritt-text { max-width: 34rem }` – gemessen 558 px – und
     * überlief den 356 px breiten Kasten, statt sich ihm zu fügen. Die
     * Null als Untergrenze ist der entscheidende Teil: Ohne sie greift
     * `min-width: auto` und die Spalte schrumpft nicht unter ihren Inhalt.
     */
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--linie);
    background: var(--flaeche-dunkel);
  }

  .dritt-flaeche::before {
    content: '';
    grid-area: 1 / 1;
    aspect-ratio: var(--dritt-verhaeltnis, 16 / 9);
  }

  .dritt-flaeche > * {
    grid-area: 1 / 1;
  }

  /*
   * ── Der Rahmen entsteht erst im Browser, deshalb `:global` ───────────
   *
   * Astro schreibt sein Bereichsmerkmal (`data-astro-cid-…`) beim BAUEN in
   * die Auszeichnung und hängt dasselbe Merkmal an jeden Selektor dieses
   * Stilblocks. Der `iframe` hier entsteht aber erst im Moment der Freigabe
   * per `document.createElement` – vorher darf er nicht existieren, das ist
   * der Kern dieses Bauteils. Er kann das Merkmal also nie tragen.
   *
   * Aus `.dritt-rahmen { … }` wurde damit `.dritt-rahmen[data-astro-cid-…]`
   * und aus `.dritt-flaeche > *` wurde `.dritt-flaeche[…] > [data-astro-cid-…]`.
   * Beide gingen am Rahmen vorbei. Gemessen mit der alten Fassung, auf
   * /berlin-charlottenburg/ bei 402 px: Der Rahmen fiel auf die
   * Browservorgabe 304x154 px zurück (300x150 plus 2 px eingelassener
   * Standardrand) und landete mangels `grid-area` nicht in Zelle 1/1,
   * sondern öffnete eine zweite Rasterzeile. Der Kasten WUCHS dadurch von
   * 225 auf 375,2 px, die erste Zeile blieb leer, und 66 % der Fläche waren
   * blanker dunkler Grund – auf dem Schreibtisch 94,6 %. Das sah aus wie
   * ein kaputtes Video, war aber unser eigener Kasten.
   *
   * `:global` steht hier nicht aus Bequemlichkeit, sondern weil das Ziel zur
   * Bauzeit nicht existiert. Eingegrenzt bleibt es trotzdem: Der Elternteil
   * `.dritt-flaeche` behält sein Merkmal, die Regel wirkt also nur in diesem
   * Bauteil.
   *
   * ACHTUNG für später: Jede weitere Regel, die den Rahmen betrifft, muss
   * denselben Weg nehmen. Eine Regel für `.dritt-rahmen` ohne `:global`
   * greift stillschweigend nicht – man sieht es erst am fertigen Bild.
   */
  .dritt-flaeche > :global(.dritt-rahmen) {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Wo eine Höhe angegeben ist, gilt sie statt des Verhältnisses. */
  .dritt[style*='--dritt-hoehe'] .dritt-flaeche::before {
    aspect-ratio: auto;
    min-height: var(--dritt-hoehe);
  }

  /*
   * ── Die Vorschau beschneidet sich selbst ─────────────────────────────
   *
   * `overflow` gehört hierher, nicht nur an den Kasten. Die Vorschau ist
   * absichtlich größer als ihr Platz: `scale: 1.08` gegen die helle Kante
   * des Weichzeichners (siehe unten), und ein Foto kommt als
   * `<figure><img>` herein und bringt seine eigene Höhe mit – auf
   * /berlinmitte/ ein quadratisches Bild in einem 16:10-Kasten.
   *
   * Solange dieser Überstand nur vom Kasten beschnitten wurde, war er dort
   * trotzdem vorhanden: `.dritt-flaeche` wurde damit zu einem eigenen
   * Rollbereich. Gemessen `scrollHeight - clientHeight`: 10 bis 16 px auf
   * den meisten Seiten, 134 px auf /berlinmitte/ bei 402 px, 395 px auf dem
   * Schreibtisch. Sichtbar war das nicht – aber ein `scrollIntoView`
   * irgendwo tiefer im Baum konnte die Frage um genau diesen Betrag nach
   * oben schieben, und dann stand der Titel über der Kastenkante.
   *
   * `overflow: clip` statt `hidden`: `hidden` beschneidet zwar auch, macht
   * das Element aber zu einem rollbaren Behälter – genau das soll weg.
   *
   * Ein `overflow: hidden` als Rückfall davor bringt nichts: esbuild fasst
   * zwei Werte derselben Eigenschaft beim Verkleinern zu einem zusammen,
   * im gebauten Stilblatt stand danach nur noch `overflow:clip`. Nötig ist
   * er auch nicht – Browser ohne `clip` verwerfen die Zeile und beschneiden
   * die Vorschau weiterhin über `.dritt-flaeche`; ihnen fehlt nur die
   * Rollsperre. Und wer `color-mix` versteht, das eine Regel weiter unten
   * den Schleier mischt, versteht auch `clip`: dieselbe Baureihe.
   */
  .dritt-vorschau {
    position: absolute;
    inset: 0;
    overflow: clip;
  }

  /*
   * Ein Bild kommt nicht nackt herein, sondern in seiner eigenen Hülle
   * (`Bild.astro` liefert `<figure class="bild">`). Ohne diese Regel ist die
   * Hülle so hoch wie das Bild und nicht so hoch wie der Kasten – dann
   * greift das `object-fit: cover` darunter ins Leere, weil es keine Höhe
   * gibt, auf die es zuschneiden könnte. `:global`, weil die Hülle aus einem
   * anderen Bauteil stammt und dessen Merkmal trägt, nicht unseres.
   */
  .dritt-vorschau > :global(*:not(img):not(svg)) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    margin: 0;
    /* Die Ecken rundet der Kasten. Eine zweite Rundung darin zeigt an vier
       Stellen den dunklen Grund. */
    border-radius: 0;
  }

  .dritt-vorschau :global(img),
  .dritt-vorschau :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /*
     * `min-height` zusätzlich zu `height`, und das ist kein Gürtel zum
     * Hosenträger: `Bild.astro` setzt `.bild img { height: auto }` mit einer
     * höheren Gewichtung (zwei Klassen plus Bereichsmerkmal) und gewinnt
     * damit gegen das `height: 100%` von hier. Gemessen war das Bild auf
     * /berlinmitte/ dadurch quadratisch statt zugeschnitten und stand
     * 134 px über den Kasten hinaus. `min-height` ist dort nicht gesetzt,
     * greift also – und ergibt zusammen mit `object-fit: cover` genau den
     * Zuschnitt, der hier gemeint war.
     */
    min-height: 100%;
  }

  /*
   * Die Unschärfe.
   *
   * `scale`, weil `blur` sonst eine helle Kante nach innen zieht – dieselbe
   * Maßnahme wie beim Kopfvideo. Zusätzlich abgedunkelt, damit die Schrift
   * darüber die 4,5:1 erreicht: Über einem unscharfen Bild lässt sich der
   * Kontrast nicht berechnen, deshalb liegt zusätzlich ein Schleier darauf
   * (siehe `.dritt-frage::before`).
   */
  .dritt-vorschau :global(img),
  .dritt-vorschau :global(svg) {
    filter: blur(10px) brightness(0.75) saturate(0.9);
    scale: 1.08;
  }

  /*
   * Die Frage liegt jetzt IM Raster, nicht darüber – nur so bestimmt sie
   * die Höhe mit. `min-width: 0` gehört dazu: Ohne das schiebt die
   * Schaltfläche, deren Name den vollen Videotitel trägt, die Zelle
   * auseinander, statt umzubrechen.
   */
  .dritt-frage {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.2rem;
    text-align: center;
    /* Deckender Schleier: Der Untergrund ist ein unscharfes Bild, dessen
       Helligkeit niemand kennt. Ohne ihn wäre der Kontrast Glückssache. */
    background: color-mix(in oklab, var(--flaeche-dunkel) 62%, transparent);
    color: #fff;
  }

  .dritt-titel {
    margin: 0;
    font-weight: 650;
    font-size: 1.02rem;
    /* Der Videotitel ist redaktionell und kann lang sein. */
    text-wrap: balance;
  }

  /*
   * Die Schaltfläche trägt den vollen Videotitel („Video laden: Dr. Ziegler
   * erklärt, was Berlins größte Zahnarztpraxis einzigartig macht"). Das ist
   * Absicht – ein Knopf, der nur „Laden" heißt, sagt einer Vorlesehilfe
   * nicht, WAS geladen wird, und `namen-pruefen.mjs` besteht darauf.
   *
   * Ein Knopf erbt aber `white-space: nowrap`; gemessen lief er dadurch auf
   * dem Telefon beidseitig aus dem Kasten. Er darf umbrechen.
   */
  .dritt-frage .knopf {
    max-width: 100%;
    white-space: normal;
    text-wrap: balance;
    line-height: 1.35;
  }

  .dritt-text {
    margin: 0;
    max-width: 34rem;
    font-size: 0.88rem;
    line-height: 1.5;
    /* Reines Weiß auf dem Schleier – gemessen über 7:1. */
    color: #fff;
  }

  .dritt-fein {
    margin: 0;
    font-size: 0.8rem;
  }

  .dritt-fein a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .dritt-fuss {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--tinte-leise);
  }

  .dritt-fuss:empty {
    display: none;
  }
</style>
