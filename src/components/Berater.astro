---
/**
 * Digitaler Berater – schwebendes Chatfenster.
 *
 * Bewusst ohne Framework: reines HTML plus ein kleines Skript. Das Widget lädt
 * erst beim Öffnen Daten und kostet auf jeder Seite nur wenige Kilobyte.
 *
 * ── Die Offenlegung steht ganz oben, nicht in der Fußzeile ───────────────
 *
 * Artikel 50 Absatz 1 der KI-Verordnung verlangt die Information „klar und
 * unterscheidbar, spätestens zum Zeitpunkt der ersten Interaktion". Vorher
 * stand hier eine freundliche Begrüßung und weit darunter, klein, der Hinweis
 * „KI-generierte Auskunft". Das ist beides zu spät und zu leise: Wer die
 * Begrüßung liest und antwortet, hat interagiert, ohne es gelesen zu haben.
 *
 * Der Hinweis steht deshalb als eigener Block über dem Gesprächsverlauf –
 * abgesetzt, damit er nicht wie eine Chatnachricht der Maschine aussieht, und
 * mit dem Weg zu einem Menschen direkt daneben. Der Wortlaut kommt aus
 * `src/data/ki-systeme.ts`, damit Chat, Sprachberater und Transparenzseite
 * dasselbe sagen.
 */
import type { Standort } from '../data/standorte';
import { inhalte } from '../i18n/daten';
import { texte, wegZumMenschenIn } from '../i18n/katalog';

const daten = inhalte(Astro);
const t = texte(daten.sprache);


interface Props {
  standort: Standort | null;
  /** Vorschlagsfragen passend zur aktuellen Seite. */
  vorschlaege?: string[];
}

const { standort, vorschlaege = [] } = Astro.props;
/* Der Telefonverweis als fertiger Baustein.

   Er steht mitten in vier Sätzen. Die Sätze gehören als Ganzes in den
   Katalog – zerlegt in „Text davor", „Verweis", „Text danach" ließen sie
   sich nicht übersetzen, weil die Nummer im Englischen an anderer Stelle
   steht. Die Auszeichnung baut deshalb hier die Vorlage und reicht sie als
   Platzhalter hinein; im Katalog steht nur {telefon}. */
const telefonVerweis = standort
  ? `<a href="tel:${standort.telefonRaw.replace(/\s/g, '')}">${standort.telefon}</a>`
  : '';

/* Vorschlagsfragen aus dem Katalog.

   Sie standen hier als deutsche Zeichenketten – auf jeder Seite dieser
   Website, also auch auf jeder englischen und französischen. Der
   Sprachwächter zählte sie nicht, weil sie nie im Katalog standen; die
   Restdeutsch-Prüfung zählte sie sehr wohl, aber verteilt über tausend
   Seiten und damit ohne erkennbare Ursache. */
const standardVorschlaege = standort
  ? [
      t('berater.vorschlagLeistungenOrt', { name: standort.name }),
      t('berater.vorschlagZahnreinigung'),
      t('berater.vorschlagAngst'),
      t('berater.vorschlagAnfahrt'),
    ]
  : [
      t('berater.vorschlagWelcherStandort'),
      t('berater.vorschlagImplantate'),
      t('berater.vorschlagZahnreinigung'),
    ];

const fragen = vorschlaege.length > 0 ? vorschlaege : standardVorschlaege;

/* Offenlegung und Weg zum Menschen in der Sprache dieser Seite – der
   Wortlaut kommt weiter aus `src/data/ki-systeme.ts`, jetzt aber durch den
   Katalog. Vorher stand hier auf jeder englischen Seite ein deutscher Satz,
   und zwar genau der, der nach Artikel 50 „klar" sein muss. */
const system = daten.kiSystem('berater')!;
const wegZumMenschen = wegZumMenschenIn(daten.sprache);
---

<div class="berater nicht-drucken">
  <button class="ruf" type="button" aria-expanded="false" aria-controls="berater-fenster">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path
        d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.5 9.5 0 0 1-2.8-.4L4 21l1.4-4a8.2 8.2 0 0 1-1.4-4.6 8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 8 7.5Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"
      />
    </svg>
    <span class="ruf-text">{t('berater.oeffnen')}</span>
  </button>

  <div class="fenster" id="berater-fenster" role="dialog" aria-labelledby="berater-titel" hidden>
    <header class="f-kopf">
      <div>
        <p class="f-titel" id="berater-titel">{t('start.digitalerBerater')}</p>
        <p class="f-unter">
          {standort ? `KU64 ${standort.name}` : t('berater.standortWaehlen')}
        </p>
      </div>
      <button class="f-zu" type="button" aria-label={t('berater.schliessen')}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </header>

    <p class="f-offenlegung">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M10 9v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        <circle cx="10" cy="6.2" r="1" fill="currentColor" />
      </svg>
      <span>
        <strong>{system.offenlegung}</strong>
        {' '}
        {
          standort ? (
            <span set:html={t('berater.menschUnter', { telefon: telefonVerweis })} />
          ) : (
            wegZumMenschen
          )
        }
        {' '}
        <a href="/ki-transparenz/">{t('berater.wieDasFunktioniert')}</a>
      </span>
    </p>

    <div class="f-verlauf" id="verlauf" role="log" aria-live="polite" aria-atomic="false">
      <div class="blase blase-bot">
        <p>
          {
            standort
              ? t('berater.begruessungOrt', { ort: standort.name })
              : t('berater.begruessung')
          }
        </p>
        <p
          class="klein"
          set:html={
            standort
              ? t('berater.keineDiagnosenOrt', { telefon: telefonVerweis })
              : t('berater.keineDiagnosen')
          }
        />
      </div>
    </div>

    <div class="f-vorschlaege" id="vorschlaege">
      {fragen.map((f) => <button type="button" class="chip">{f}</button>)}
    </div>

    <form class="f-eingabe" id="chatform">
      <label for="frage" class="nur-screenreader">{t('berater.ihreFrage')}</label>
      <textarea
        id="frage"
        name="frage"
        rows="1"
        placeholder={t('berater.eingabeHinweis')}
        maxlength="2000"
        autocomplete="off"
      ></textarea>
      <button type="submit" class="senden" aria-label={t('berater.frageSenden')}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path
            d="M2 10 18 3l-5 15-3-6-8-2Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </form>

    {/* Die Offenlegung steht oben. Hier stehen nur noch die Grenzen – sie
        gehören ans Eingabefeld, weil man sie genau dann braucht, wenn man
        gerade tippt. */}
    <p
      class="f-fuss"
      set:html={t('berater.grenzen', {
        verweis: `<a href="/datenschutz/#berater">${t('berater.datenschutz')}</a>`,
      })}
    />
  </div>
</div>

<style>
  /*
   * Bei offenem Mobilmenü tritt der Berater ab.
   *
   * Er liegt `position: fixed` unten rechts und weiß von sich aus nichts vom
   * Menü. Geöffnet lag der runde Knopf mitten auf der Standortliste – genau
   * über „Berlin-Mitte", also über einem Ziel, das man antippen will.
   *
   * `display: none` und nicht nur durchsichtig: Ein unsichtbarer Knopf
   * fängt weiterhin Berührungen ab, und dann trifft der Finger den Standort
   * darunter nicht. Genau das war der Fehler.
   *
   * Das Attribut setzt der Menüknopf in `Navigation.astro`.
   */
  :global(html[data-menue-offen]) .berater {
    display: none;
  }

  /*
   * Dasselbe, solange ein Wähler aufgeklappt ist.
   *
   * Der Standortwähler im Kopf spannt seine Liste über fast den ganzen
   * Schirm; der Knopf lag darin auf „Berlin-Mitte". Es ist derselbe Fehler
   * wie beim Menü, nur ein anderer Auslöser – deshalb hier gleich
   * mitbehandelt statt beim nächsten Screenshot noch einmal.
   *
   * `:has()` statt eines zweiten Attributs: Die Wähler sind `<details>` und
   * tragen ihren Zustand selbst. Ein Skript, das ihn zusätzlich nach außen
   * spiegelt, ist eine zweite Wahrheit, die auseinanderlaufen kann.
   */
  :global(body:has(.ort-kompakt[open], .waehler[open])) .berater {
    display: none;
  }

  .berater {
    position: fixed;
    /*
     * Über dem Einwilligungsband, nicht darunter.
     *
     * Beide sitzen unten rechts. `--ew-hoehe` setzt der Einwilligungsdialog
     * selbst, gemessen an seinem eigenen Kasten – und er ändert sich, sobald
     * jemand die Auswahl aufklappt. Ein geschätzter Zuschlag wäre entweder
     * zu klein (dann liegt das Band auf dem Knopf) oder zu groß (dann
     * schwebt der Knopf grundlos in der Mitte). Ist kein Band da, ist die
     * Ersatzangabe 0 und es bleibt beim gewohnten Abstand.
     *
     * Gedeckelt bei 30 vh: Klappt jemand die Auswahl auf, wächst das Band
     * auf drei Viertel des Bildschirms – ohne Deckel stünde der Knopf dann
     * in der Bildmitte. Wer gerade einzeln auswählt, braucht den Berater
     * nicht; das Band darf ihn in diesem einen Fall verdecken.
     */
    inset-block-end: calc(var(--raum-5) + min(var(--ew-hoehe, 0px), 30vh));
    inset-inline-end: var(--raum-5);
    z-index: var(--z-dialog);
    transition: inset-block-end var(--zeit) var(--kurve);
    /*
     * Die Hülle nimmt keine Klicks – nur das, was man sieht.
     *
     * Sie ist unsichtbar und hat keinen Hintergrund, war aber trotzdem ein
     * Ziel. Unter 32 rem setzt die Regel weiter unten `inset-inline` auf
     * BEIDE Seiten, damit das Chatfenster die Breite bekommt; damit ist die
     * Hülle im eingeklappten Zustand ein 370 × 56 px großer, vollkommen
     * durchsichtiger Streifen quer über den unteren Bildrand – bei 402 px
     * Gerätebreite 92 Prozent des Bildschirms. Der Knopf darin ist rund
     * 56 px breit und sitzt rechts; die übrigen rund 314 px waren totes
     * Land, das Berührungen verschluckte.
     *
     * Gemessen an der Zustimmen-Schaltfläche der Einbettungen: bis zu
     * 99 Prozent Überdeckung, und `document.elementFromPoint` auf die
     * Knopfmitte lieferte `DIV.berater` statt des Knopfes. Sichtbar war
     * nichts – der Klick ging einfach ins Leere, was schlimmer ist als eine
     * sichtbare Sperre, weil niemand darauf kommt, weiterzuscrollen.
     *
     * `pointer-events: none` an der Hülle, `auto` an ihren Kindern: Der
     * Knopf und das Fenster bleiben bedienbar, der leere Rest ist keine
     * Fläche mehr. Das gilt in jeder Breite, nicht nur unter 32 rem – auch
     * am Schreibtisch ist die Hülle ein paar Pixel größer als ihr Inhalt.
     */
    pointer-events: none;
  }

  .berater > * {
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .berater {
      transition: none;
    }
  }

  .ruf {
    display: inline-flex;
    align-items: center;
    gap: var(--raum-3);
    padding: 0.85rem 1.35rem;
    min-height: 2.75rem;
    border-radius: var(--radius-voll);
    /*
     * Glas, nicht Schwarz und nicht Gelb.
     *
     * Gelb ist für die Terminbuchung reserviert – zwei gelbe Flächen auf
     * einem Bildschirm heben sich gegenseitig auf. Schwarz war der falsche
     * Ausweg: eine deckende dunkle Fläche wirkt in einer Oberfläche aus
     * durchscheinenden Ebenen wie ein Fremdkörper. Glas ordnet sich ein und
     * bleibt trotzdem lesbar, weil die Schrift in Tinte steht.
     */
    background: var(--glas-flaeche-stark);
    -webkit-backdrop-filter: blur(var(--glas-unschaerfe)) saturate(var(--glas-saettigung));
    backdrop-filter: blur(var(--glas-unschaerfe)) saturate(var(--glas-saettigung));
    border: 1px solid var(--glas-rand);
    color: var(--tinte);
    font-weight: 600;
    font-size: var(--t-sm);
    box-shadow:
      inset 0 1px 0 var(--glas-glanz),
      inset 0 -1px 0 var(--glas-rand-unten),
      0 8px 28px -10px rgb(29 29 27 / 0.34),
      var(--schatten-lg);
    transition: transform var(--zeit) var(--kurve);
  }

  .ruf:hover {
    transform: translateY(-2px);
  }

  .ruf[aria-expanded='true'] {
    display: none;
  }

  .fenster {
    display: flex;
    flex-direction: column;
    width: min(24rem, calc(100vw - 2rem));
    height: min(34rem, calc(100dvh - 6rem));
    /* Schwebt über der Seite – hier ist echtes Glas richtig. */
    background: var(--glas-flaeche-stark);
    -webkit-backdrop-filter: blur(30px) saturate(var(--glas-saettigung));
    backdrop-filter: blur(30px) saturate(var(--glas-saettigung));
    border: 1px solid var(--glas-rand);
    border-radius: var(--radius-xl);
    box-shadow: inset 0 1px 0 var(--glas-glanz), var(--schatten-lg);
    overflow: hidden;
  }

  .f-kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--raum-3);
    padding: var(--raum-4) var(--raum-5);
    /* Ruhiger Kopf statt gelber Fläche: Das Fenster liegt über der Seite und
       war vorher das lauteste Element darauf. */
    background: var(--knopf-flaeche);
    color: var(--knopf-schrift);
    box-shadow: inset 0 -1px 0 rgb(255 255 255 / 0.08);
  }

  .f-titel {
    font-family: var(--schrift-titel);
    font-weight: 600;
    font-size: var(--t-md);
  }

  .f-unter {
    font-size: var(--t-xs);
    opacity: 0.85;
  }

  .f-zu {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: inherit;
    transition: background-color var(--zeit-schnell) var(--kurve);
  }

  .f-zu:hover {
    background: rgb(255 255 255 / 0.18);
  }

  /* Abgesetzt vom Verlauf, damit der Hinweis nicht wie eine Nachricht der
     Maschine aussieht – eine Maschine, die versichert, eine Maschine zu sein,
     ist genau die Konstruktion, der niemand glauben soll. Der Rahmen unten
     trennt ihn vom Gespräch. */
  .f-offenlegung {
    display: flex;
    gap: var(--raum-2);
    align-items: flex-start;
    margin: 0;
    padding: var(--raum-3) var(--raum-4);
    border-block-end: 1px solid var(--linie);
    background: var(--flaeche-warm);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--tinte-weich);
  }
  .f-offenlegung svg {
    flex-shrink: 0;
    margin-block-start: 1px;
    color: var(--akzent-schrift);
  }
  .f-offenlegung strong {
    color: var(--tinte);
    font-weight: 600;
  }

  .f-verlauf {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--raum-4);
    display: flex;
    flex-direction: column;
    gap: var(--raum-3);
    scrollbar-width: thin;
  }

  .blase {
    max-width: 88%;
    padding: var(--raum-3) var(--raum-4);
    border-radius: var(--radius-lg);
    font-size: var(--t-sm);
    line-height: var(--zeile-normal);
  }

  .blase > * + * {
    margin-block-start: var(--raum-2);
  }

  .blase-bot {
    align-self: flex-start;
    background: var(--scheibe-flaeche);
    border: 1px solid var(--scheibe-rand);
    box-shadow: inset 0 1px 0 var(--glas-glanz);
    border-end-start-radius: var(--radius-sm);
  }

  /* Eigene Nachrichten dunkel, Antworten hell – wie in jedem Messenger.
     Gelb trug hier zusätzlich das Problem, dass die Schrift darauf schwarz
     sein musste und die Blase damit wie eine Warnung aussah. */
  .blase-ich {
    align-self: flex-end;
    background: var(--knopf-flaeche);
    color: var(--knopf-schrift);
    border-end-end-radius: var(--radius-sm);
  }

  .blase :global(a) {
    color: inherit;
    font-weight: 600;
  }

  .blase-bot :global(a) {
    color: var(--akzent-schrift);
  }

  .blase-bot :global(ul) {
    padding-inline-start: var(--raum-5);
  }

  .klein {
    font-size: var(--t-xs);
    color: var(--tinte-leise);
  }

  /* Tippanzeige */
  .tippt span {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-inline-end: 3px;
    border-radius: 50%;
    background: var(--tinte-leise);
    animation: huepf 1.2s infinite;
  }
  .tippt span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .tippt span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes huepf {
    0%, 60%, 100% {
      transform: none;
      opacity: 0.4;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  .f-vorschlaege {
    display: flex;
    gap: var(--raum-2);
    padding: 0 var(--raum-4) var(--raum-3);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .f-vorschlaege::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex-shrink: 0;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-voll);
    background: var(--scheibe-flaeche);
    box-shadow: inset 0 1px 0 var(--glas-glanz);
    border: 1px solid var(--scheibe-rand);
    font-size: var(--t-xs);
    color: var(--tinte-weich);
    white-space: nowrap;
    transition: all var(--zeit-schnell) var(--kurve);
  }

  .chip:hover {
    border-color: var(--akzent-schrift);
    color: var(--akzent-schrift);
  }

  .f-eingabe {
    display: flex;
    align-items: flex-end;
    gap: var(--raum-2);
    padding: var(--raum-3) var(--raum-4);
    border-top: 1px solid var(--linie);
  }

  .f-eingabe textarea {
    flex: 1;
    min-width: 0;
    max-height: 7rem;
    padding: var(--raum-3);
    border: 1px solid var(--linie-stark);
    border-radius: var(--radius);
    background: var(--flaeche);
    font-size: var(--t-sm);
    line-height: var(--zeile-normal);
    resize: none;
    outline: none;
  }

  /*
   * Auf Fingergeräten 16 px, sonst zoomt iOS beim Fokus die ganze Seite
   * heran (Begründung ausführlich in `global.css`).
   *
   * Die Regel steht ZUSÄTZLICH hier, obwohl sie global schon existiert:
   * `.f-eingabe textarea` ist spezifischer als das globale `textarea`, und
   * Astro hängt an beide noch seinen Bereichsselektor. Die globale Regel
   * verlor deshalb – gemessen blieb das Feld bei 14,2 px. Eine Regel, die
   * man nicht nachmisst, ist eine Vermutung.
   */
  @media (pointer: coarse) {
    .f-eingabe textarea {
      font-size: 1rem;
    }
  }

  .f-eingabe textarea:focus {
    border-color: var(--akzent-schrift);
  }

  .senden {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: var(--radius);
    background: var(--knopf-flaeche);
    color: var(--knopf-schrift);
    transition: opacity var(--zeit-schnell) var(--kurve);
  }

  .senden:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .f-fuss {
    padding: 0 var(--raum-4) var(--raum-3);
    font-size: 0.68rem;
    line-height: 1.4;
    color: var(--tinte-leise);
  }

  @media (max-width: 32rem) {
    .berater {
      inset-inline: var(--raum-4);
      inset-block-end: calc(var(--raum-4) + min(var(--ew-hoehe, 0px), 30vh));
    }
    /*
     * `display: none` hätte den Knopf namenlos gemacht.
     *
     * Der einzige Text des Knopfes steht in diesem `span`. Ihn auf schmalen
     * Bildschirmen mit `display: none` zu entfernen, nimmt ihn auch dem
     * Screenreader – ab dann heißt das Bedienelement nur noch
     * „Schaltfläche". Gefunden hat es Lighthouse (button-name, WCAG 4.1.2
     * Stufe A) in ALLEN fünf mobilen Läufen; am Schreibtisch war es
     * fehlerfrei, deshalb fiel es nie auf.
     *
     * `.nur-screenreader` versteckt denselben Text nur visuell. Der Knopf
     * behält seinen Namen, und es braucht kein zweites `aria-label`, das
     * beim nächsten Textwechsel vergessen würde.
     */
    .ruf-text {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
    .ruf {
      padding: 1rem;
    }
    .fenster {
      width: 100%;
      height: min(32rem, calc(100dvh - 4rem));
    }
  }
</style>

<script>
  import { beimSeitenaufbau } from '../lib/seitenaufbau';

  /*
   * Der Berater wird nach jedem Seitenaufbau neu gebunden.
   *
   * Ohne das öffnete er sich genau einmal: Beim Seitenwechsel tauscht die
   * Website den Körper aus, führt Module aber nicht erneut aus – der
   * Zuhörer am Rufknopf hing danach an einem Knopf, den es nicht mehr gab.
   * Gemeldet wurde das als „Fragen? Berater öffnen funktioniert nicht", und
   * es stimmte: auf jeder Seite außer der zuerst geladenen.
   *
   * Die Zuhörer an `document` und `window` hängen an einem Signal, das vor
   * dem nächsten Austausch abgebrochen wird. Sonst lägen nach zehn
   * Seitenwechseln zehn Escape-Zuhörer übereinander, von denen neun auf
   * Fenster zeigen, die es nicht mehr gibt.
   */
  beimSeitenaufbau(() => {
    const steuerung = new AbortController();
    const signal = steuerung.signal;
    const wurzel = document.querySelector<HTMLElement>('.berater');
    if (wurzel) {
      const ruf = wurzel.querySelector<HTMLButtonElement>('.ruf')!;
      const fenster = wurzel.querySelector<HTMLElement>('.fenster')!;
      const zu = wurzel.querySelector<HTMLButtonElement>('.f-zu')!;
      const verlaufEl = wurzel.querySelector<HTMLElement>('.f-verlauf')!;
      const form = wurzel.querySelector<HTMLFormElement>('#chatform')!;
      const feld = wurzel.querySelector<HTMLTextAreaElement>('#frage')!;
      const sendeKnopf = form.querySelector<HTMLButtonElement>('.senden')!;
      const chipBox = wurzel.querySelector<HTMLElement>('#vorschlaege')!;

      const standort =
        document.querySelector<HTMLMetaElement>('meta[name="ku64:standort"]')?.content ?? null;

      const verlauf: { role: 'user' | 'assistant'; content: string }[] = [];
      let laeuft = false;

      /* ── Öffnen und Schließen ── */

      const oeffnen = () => {
        fenster.hidden = false;
        ruf.setAttribute('aria-expanded', 'true');
        feld.focus();
      };

      const schliessen = () => {
        fenster.hidden = true;
        ruf.setAttribute('aria-expanded', 'false');
        ruf.focus();
      };

      ruf.addEventListener('click', oeffnen);
      zu.addEventListener('click', schliessen);

      document.addEventListener(
        'keydown',
        (e) => {
          if (e.key === 'Escape' && !fenster.hidden) schliessen();
        },
        { signal },
      );

      // Andere Stellen der Seite können den Berater öffnen.
      document.querySelectorAll('.chat-oeffner').forEach((el) =>
        el.addEventListener('click', (e) => {
          e.preventDefault();
          oeffnen();
        }),
      );

      /*
       * Und andere Stellen können eine Frage mitgeben.
       *
       * Die Suche tut das: Wer dort etwas eintippt, das erkennbar eine Frage
       * ist, bekommt einen Knopf, der genau diese Frage hierher weiterreicht.
       * Über ein Ereignis am Fenster und nicht über einen direkten Aufruf –
       * so muss die Suche nichts über den Berater wissen und er nichts über
       * sie. Wer den Berater eines Tages austauscht, tauscht eine Datei.
       *
       * Die Frage wird eingetragen und abgeschickt, nicht nur eingetragen:
       * Wer den Knopf „Frage an den Berater" drückt, hat die Frage schon
       * gestellt. Ein zweites Mal auf Senden zu drücken wäre eine Hürde ohne
       * Zweck.
       */
      addEventListener(
        'ku64:berater-fragen',
        (e) => {
          const frage = (e as CustomEvent<{ frage?: string }>).detail?.frage?.trim();
          oeffnen();
          if (frage) void fragen(frage);
        },
        { signal },
      );

      /* ── Darstellung ── */

      /** Escapen und danach nur ausgewähltes Markdown zulassen – nie innerHTML
       *  mit ungeprüfter Modellausgabe füllen. */
      function alsHtml(text: string): string {
        const sicher = text
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');

        return sicher
          // Nur interne Pfade als Link zulassen, keine fremden Domains.
          .replace(
            /\[([^\]]+)\]\((\/[a-z0-9\-/#]*)\)/gi,
            '<a href="$2">$1</a>',
          )
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\n{2,}/g, '</p><p>')
          .replace(/\n/g, '<br>');
      }

      function blaseAnlegen(rolle: 'ich' | 'bot'): HTMLElement {
        const el = document.createElement('div');
        el.className = `blase blase-${rolle}`;
        verlaufEl.append(el);
        return el;
      }

      function nachUnten() {
        verlaufEl.scrollTop = verlaufEl.scrollHeight;
      }

      /* ── Senden ── */

      async function fragen(text: string) {
        if (!text.trim() || laeuft) return;

        laeuft = true;
        sendeKnopf.disabled = true;
        chipBox.hidden = true;

        const meine = blaseAnlegen('ich');
        meine.textContent = text;
        verlauf.push({ role: 'user', content: text });
        nachUnten();

        const antwortEl = blaseAnlegen('bot');
        antwortEl.innerHTML = '<span class="tippt"><span></span><span></span><span></span></span>';
        nachUnten();

        let gesammelt = '';

        try {
          // Schrägstrich am Ende ist Pflicht: Die Seite läuft mit
          // trailingSlash 'always', ohne ihn antwortet der Server mit 301 –
          // und eine Weiterleitung macht aus dem POST ein GET ohne Rumpf.
          const res = await fetch('/api/chat/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nachrichten: verlauf, standort }),
          });

          if (!res.ok || !res.body) {
            const daten = await res.json().catch(() => null);
            throw new Error(daten?.fehler || 'Der Berater antwortet gerade nicht.');
          }

          const leser = res.body.getReader();
          const decoder = new TextDecoder();
          let puffer = '';

          while (true) {
            const { done, value } = await leser.read();
            if (done) break;

            puffer += decoder.decode(value, { stream: true });
            const bloecke = puffer.split('\n\n');
            puffer = bloecke.pop() ?? '';

            for (const block of bloecke) {
              const typ = block.match(/^event: (.+)$/m)?.[1];
              const rohdaten = block.match(/^data: (.*)$/m)?.[1];
              if (!typ || rohdaten === undefined) continue;

              if (typ === 'text') {
                gesammelt += JSON.parse(rohdaten);
                antwortEl.innerHTML = `<p>${alsHtml(gesammelt)}</p>`;
                nachUnten();
              } else if (typ === 'fehler') {
                throw new Error(JSON.parse(rohdaten));
              }
            }
          }

          if (gesammelt) verlauf.push({ role: 'assistant', content: gesammelt });
        } catch (e) {
          antwortEl.innerHTML = `<p>${
            e instanceof Error ? e.message : 'Es ist ein Fehler aufgetreten.'
          }</p>`;
          // Fehlgeschlagene Runde nicht im Verlauf lassen – sonst verwirrt sie
          // das Modell bei der nächsten Frage.
          if (verlauf[verlauf.length - 1]?.role === 'user') verlauf.pop();
        } finally {
          laeuft = false;
          sendeKnopf.disabled = false;
          nachUnten();
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = feld.value;
        feld.value = '';
        feld.style.height = 'auto';
        fragen(text);
      });

      // Enter sendet, Shift+Enter macht einen Zeilenumbruch.
      feld.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          form.requestSubmit();
        }
      });

      // Eingabefeld mitwachsen lassen.
      feld.addEventListener('input', () => {
        feld.style.height = 'auto';
        feld.style.height = `${Math.min(feld.scrollHeight, 112)}px`;
      });

      chipBox.querySelectorAll('.chip').forEach((chip) =>
        chip.addEventListener('click', () => fragen(chip.textContent ?? '')),
      );
    }
    return () => steuerung.abort();
  });
</script>