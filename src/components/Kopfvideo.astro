---
/**
 * Kopfvideo eines Standorts.
 *
 * Zeigt die Aufnahme DIESES Standorts – oder gar nichts. Die alte Website
 * spielte überall den Kurfürstendamm aus; wer danach nach Potsdam kam, fand
 * andere Räume vor als im Video.
 *
 * Drei Entscheidungen, die für die Ladezeit zählen:
 *
 * `preload="none"` – das Video wird erst geladen, wenn es abgespielt wird.
 * Ohne das lädt der Browser Sekunden an Videodaten, bevor die Überschrift
 * steht, und der größte Inhaltsblock verschiebt sich nach hinten.
 *
 * Das Standbild ist ein gewöhnliches Bild und liegt im Layout. Es trägt den
 * Kopfbereich, solange kein Video läuft – auf langsamen Verbindungen also
 * dauerhaft. Ein Video ohne Standbild hinterlässt dort eine graue Fläche.
 *
 * Feste Seitenverhältnisse: Der Platz steht, bevor die Datei da ist. Sonst
 * springt beim Eintreffen der gesamte Inhalt nach unten – die
 * Layoutverschiebung, die Lighthouse misst.
 *
 * Und es startet nur, wenn niemand widersprochen hat: Bei
 * `prefers-reduced-motion` bleibt das Standbild stehen. Bewegtbild im
 * Hintergrund ist für manche Menschen nicht Dekoration, sondern ein Auslöser.
 */
import { kopfvideoFuer } from '../data/medien';

interface Props {
  standortSlug: string;
  /** Überschreibt die Beschreibung, falls die Seite eine genauere hat. */
  beschreibung?: string;
}

const { standortSlug, beschreibung } = Astro.props;
const video = kopfvideoFuer(standortSlug);
---

{
  video && (
    <figure class="kopfvideo">
      <video
        class="kopfvideo-quelle"
        poster={video.poster}
        preload="none"
        muted
        loop
        playsinline
        aria-label={beschreibung ?? video.beschreibung}
      >
        <source src={video.datei} type="video/mp4" />
      </video>
      <figcaption class="nur-screenreader">{beschreibung ?? video.beschreibung}</figcaption>
    </figure>
  )
}

{
  video && (
    <script is:inline>
      {`
      (() => {
        const v = document.querySelector('.kopfvideo-quelle');
        if (!v) return;

        /* Wer Bewegung abbestellt hat, bekommt das Standbild. Die Abfrage
           steht hier und nicht in CSS, weil sie das Laden verhindern soll,
           nicht nur das Anzeigen. */
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        /* Erst laden, wenn der Kopf wirklich sichtbar ist. Wer direkt zu
           einem Anker weiter unten springt, lädt das Video nie. */
        const beobachter = new IntersectionObserver((eintraege) => {
          for (const e of eintraege) {
            if (!e.isIntersecting) { v.pause(); continue; }
            v.play().catch(() => {
              /* Automatisches Abspielen abgelehnt – das Standbild bleibt,
                 und das ist ein vollständig brauchbarer Zustand. */
            });
          }
        }, { threshold: 0.25 });

        beobachter.observe(v);
      })();
      `}
    </script>
  )
}

<style>
  .kopfvideo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    /* Der Platz steht, bevor die Datei da ist. */
    aspect-ratio: 16 / 9;
    background: var(--flaeche-warm);
    box-shadow: var(--schatten-lg);
  }

  .kopfvideo-quelle {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Eine leichte Abdunklung nach unten, damit darüberliegende Schrift auch
     auf hellen Bildstellen lesbar bleibt. */
  .kopfvideo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgb(29 29 27 / 0.28), transparent 45%);
  }

  @media (max-width: 40rem) {
    .kopfvideo {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-lg);
    }
  }
</style>
