---
/**
 * Basislayout für jede Seite.
 *
 * Der wichtigste Aspekt: `standort` legt den Standortkontext fest. Ist er
 * gesetzt, bleibt die gesamte Navigation innerhalb dieses Standorts. Es gibt
 * keinen automatischen Wechsel – ein Standortwechsel passiert ausschließlich
 * durch bewusstes Klicken im Standortwähler.
 */
import '../styles/global.css';
/*
 * Die Schriftdatei wird als Modul geladen, damit hier ihre endgültige,
 * versionierte Adresse steht. Ein fest getippter Pfad wäre nach jedem
 * Schriftupdate still falsch – der Preload liefe ins Leere und niemand
 * bemerkte es, weil die Seite trotzdem funktioniert, nur langsamer.
 */
import schriftInter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import Fusszeile from '../components/Fusszeile.astro';
import Brotkrumen from '../components/Brotkrumen.astro';
import Berater from '../components/Berater.astro';
import Sprachhinweis from '../components/Sprachhinweis.astro';
import { type Standort } from '../data/standorte';
import { titelBauen, descriptionKuerzen, kanonisch, SITE_NAME } from '../lib/seo';
import {
  pfadInSprache,
  spracheAusParameter,
  sprachdefinition,
  sprachfassungen,
  QUELLSPRACHE,
} from '../i18n/sprachen';
import { texte } from '../i18n/katalog';

interface Props {
  titel: string;
  description: string;
  /** Aktiver Standort. `null` nur auf standortübergreifenden Seiten. */
  standort?: Standort | null;
  /** Pfad ohne Domain, für Canonical und Breadcrumbs. */
  pfad: string;
  brotkrumen?: { name: string; pfad: string }[];
  /** Beliebig viele JSON-LD-Objekte. */
  schema?: Record<string, unknown>[];
  /** OG-Bild relativ zur Domain. Wird sonst aus Standort und Leistung abgeleitet. */
  bild?: string;
  /** Leistungs-Slug, damit das Vorschaubild die konkrete Leistung zeigt. */
  ogLeistung?: string;
  /** Seiten, die nicht in den Index sollen (z. B. Danke-Seiten). */
  noindex?: boolean;
  /**
   * Canonical auf eine ANDERE Seite – für Fassungen, die dieselbe Aussage
   * treffen wie eine Hauptseite.
   *
   * Der Fall, für den es das gibt: Eine Leistung hat eine ausführliche Seite
   * unter `/leistungen/<slug>/` und je Standort eine Fassung darunter. Solange
   * die Standortfassung nichts erzählt, was nur dort gilt, sind das zwei
   * Seiten mit demselben Inhalt. Gemessen lagen die Standortfassungen
   * untereinander bei bis zu 77,8 Prozent Textgleichheit – und jede verwies
   * per Canonical auf sich selbst, meldete Google also: „Ich bin ein
   * Original.“ Vier Originale derselben Aussage schwächen sich gegenseitig.
   *
   * Hier zeigt die Fassung stattdessen auf die Hauptseite. Für Besucher ändert
   * sich nichts: Die Seite bleibt erreichbar, verlinkt und im Menü.
   *
   * Ausdrücklich KEIN zusätzliches `noindex`. Beides zusammen ist ein
   * Widerspruch – `noindex` sagt „vergiss diese Seite“, Canonical sagt „zähle
   * sie zu jener“. Google folgt dann keinem von beiden verlässlich.
   *
   * Sobald eine Standortfassung eigene Substanz hat – wer dort behandelt,
   * welche Geräte dort stehen, wie der Ablauf dort aussieht –, entfällt die
   * Angabe und die Seite steht wieder für sich.
   */
  kanonischStatt?: string;
  /**
   * Wohin der Sprachwähler zeigt, wenn es die Seite unter diesem Pfad gar
   * nicht gibt.
   *
   * Genau ein Fall: die Fehlerseite. Sie wird als `404.html` gebaut und vom
   * Server für jede unbekannte Adresse ausgeliefert – eine Route `/404/`
   * existiert nicht. Der Sprachwähler zeigte deshalb auf `/en/404/` und
   * `/fr/404/`, also auf nichts. Dass man dort trotzdem landet, ist Zufall:
   * Der Server antwortet auf beides mit derselben Fehlerseite.
   *
   * Von einer Seite, die es nicht gibt, ist die Startseite der Sprache das
   * ehrlichere Ziel. Der Canonical bleibt davon unberührt.
   */
  sprachwahlPfad?: string;
}

const {
  titel,
  description,
  standort = null,
  pfad,
  brotkrumen = [],
  schema = [],
  bild,
  ogLeistung,
  noindex = false,
  kanonischStatt,
  sprachwahlPfad,
} = Astro.props;

/*
 * Die Sprache kommt aus der Route, nicht aus einer Eigenschaft.
 *
 * Damit kann keine Seite vergessen, sie weiterzureichen – und es kann auch
 * keine Seite behaupten, sie sei englisch, während sie unter einer deutschen
 * Adresse liegt. Die Adresse entscheidet.
 */
const sprache = spracheAusParameter(Astro.params.sprache as string | undefined);
const sprachinfo = sprachdefinition(sprache);
const t = texte(sprache);

/*
 * Vorschaubild ableiten. Die Dateien werden von scripts/og-bilder.mjs aus
 * denselben Daten erzeugt wie die Seiten – sie zeigen ausschließlich echte
 * Angaben (Standort, Adresse, Telefon, Behandlung) auf einem echten Foto
 * des jeweiligen Standorts.
 *
 * JPEG, nicht PNG: Seit die Karten ein Foto tragen, wäre PNG ein halbes
 * Megabyte je Karte.
 */
const ogPfad =
  bild ??
  (standort && ogLeistung
    ? `/og/${standort.slug}--${ogLeistung}.jpg`
    : standort
      ? `/og/standort-${standort.slug}.jpg`
      : ogLeistung
        ? `/og/leistung-${ogLeistung}.jpg`
        : '/og/ku64-standard.jpg');

const seitentitel = titelBauen(titel, standort ? `KU64 ${standort.name}` : 'KU64');
const beschreibung = descriptionKuerzen(description);
const canonical = kanonisch(pfadInSprache(kanonischStatt ?? pfad, sprache));
const ogBild = new URL(ogPfad, Astro.site ?? 'https://ku64.de').href;

/*
 * hreflang-Angaben, absolut ausgegeben.
 *
 * Absolut aus zwei Gründen: Google verlangt es, und die Middleware, die alle
 * internen Links auf die Sprache der Seite umbiegt, erkennt absolute Adressen
 * und lässt sie in Ruhe. Ein relatives hreflang würde sie umschreiben – und
 * dann zeigte der Verweis auf die deutsche Fassung ebenfalls nach /en/.
 *
 * `x-default` zeigt auf Deutsch. Das ist die Fassung, die für jemanden ohne
 * passende Sprache am ehesten weiterhilft: Sie ist vollständig, und in einer
 * Berliner Praxis wird deutsch gesprochen.
 */
const sprachziel = sprachwahlPfad ?? pfad;

const alternates = sprachfassungen(sprachziel).map((f) => ({
  hreflang: f.sprache.bcp47,
  href: kanonisch(f.pfad),
}));
const xDefault = kanonisch(pfadInSprache(pfad, QUELLSPRACHE));

/* Sprachen im Aufbau gehören nicht in den Index. Eine halb übersetzte Seite
   in den Suchergebnissen ist schlechter als keine. */
const nichtIndexieren = noindex || !sprachinfo.freigegeben;
---

<!doctype html>
<html
  lang={sprachinfo.bcp47}
  data-sprache={sprache}
  data-sprachpraefix={sprachinfo.praefix}
  style={standort ? `--akzent: ${standort.akzent}` : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Ganz oben, noch vor Titel und Stylesheet: Ohne Preload findet der Browser
      die Schrift erst, nachdem er das Stylesheet geladen UND ausgewertet hat –
      zwei Schritte, die nacheinander laufen. Der Hinweis hier startet den
      Abruf sofort. `crossorigin` ist bei Schriften Pflicht, auch bei Dateien
      von der eigenen Domain; ohne das Attribut lädt der Browser sie ein
      zweites Mal.
    */}
    <link rel="preload" href={schriftInter} as="font" type="font/woff2" crossorigin />

    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={canonical} />
    {nichtIndexieren && <meta name="robots" content="noindex, follow" />}

    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${titel} – KU64`} />
    <meta property="og:locale" content={sprachinfo.ogLocale} />
    {
      sprachfassungen(sprachziel)
        .filter((f) => f.sprache.code !== sprache)
        .map((f) => <meta property="og:locale:alternate" content={f.sprache.ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#e8532e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16120f" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {/* Standortbezug maschinenlesbar – auch für den Chatbot auf der Seite. */}
    {standort && <meta name="ku64:standort" content={standort.slug} />}

    {
      schema.map((s) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(s)}
        />
      ))
    }

    {/*
      Weiche Übergänge zwischen Seiten.

      Ein Wechsel der Sprache oder des Standorts ist inhaltlich ein kleiner
      Schritt – dieselbe Seite, andere Fassung. Als harter Neuaufbau der
      ganzen Seite sieht er aber aus wie ein Sprung an einen anderen Ort.
      Der Übergang blendet stattdessen über, und was gleich bleibt (Kopf,
      Fußzeile), bleibt auch stehen.

      Das ist keine Bibliothek: `ClientRouter` benutzt die
      View-Transitions-Schnittstelle des Browsers. Wo es sie nicht gibt,
      wird ganz normal navigiert – der Übergang ist eine Zugabe, keine
      Voraussetzung.

      Bei `prefers-reduced-motion` unterbleibt er; die Regel dazu steht in
      global.css, weil sie dort neben den übrigen Bewegungsregeln gehört.
    */}
    <ClientRouter />
  </head>

  <body>
    <a class="sprunglink" href="#inhalt">{t('geruest.zumInhalt')}</a>

    {
      /*
       * Der Aufbauhinweis.
       *
       * Er stand hier ohne jeden Stil – roher Text über der Kopfleiste, wie
       * ein Versehen. Jetzt ist er ein schmaler Streifen in der warmen
       * Flächenfarbe, der zum Kopf gehört statt darüber zu liegen.
       *
       * Er verschwindet von selbst: Sobald eine Sprachfassung freigegeben
       * ist, greift die Bedingung nicht mehr. Er ist die Folge eines
       * Zustands, nicht ein Element, das jemand entfernen muss.
       */
      !sprachinfo.freigegeben && (
        <p class="sprache-aufbau">
          <span class="huelle sprache-aufbau-inhalt">{t('sprache.unvollstaendig')}</span>
        </p>
      )
    }

    <Navigation standort={standort} pfad={sprachziel} />

    {/* Genau einmal je Seite – der Wähler im Kopf und der im mobilen Menü
        sind zwei, der Hinweis ist einer. */}
    <Sprachhinweis pfad={sprachziel} />

    {brotkrumen.length > 0 && <Brotkrumen punkte={brotkrumen} />}

    <main id="inhalt">
      <slot />
    </main>

    {/*
      Der Terminaufruf steht NEBEN dem Inhalt, nicht darin.

      Er ist auf 243 Seiten derselbe: Adresse, Telefonnummer, „Online-Termin
      wählen“, „Anamnese vorab ausfüllen“. Als <section> im Hauptinhalt zählte
      dieser Block als Seiteninhalt – auf der Kontaktseite eines Standorts mit
      rund 160 Wörtern waren das fünfzehn Prozent der Seite, und zwar
      dieselben fünfzehn Prozent wie auf den drei anderen.

      <aside> außerhalb von <main> ist hier nicht der Trick, sondern die
      richtige Auszeichnung: ergänzender, seitenübergreifend wiederkehrender
      Inhalt. Sichtbar ändert sich nichts, er steht weiterhin am Seitenende.
    */}
    <slot name="abschluss" />

    <Fusszeile standort={standort} />

    <Berater standort={standort} />

    {/* Standortgedächtnis: merkt sich ausschließlich den zuletzt bewusst
        gewählten Standort, um auf standortfreien Seiten passend zu verlinken.
        Es findet keine automatische Weiterleitung statt. */}
    <script>
      import { beimSeitenaufbau } from '../lib/seitenaufbau';

      /* Nach jedem Seitenaufbau – sonst merkt sich die Website nur den
         Standort der zuerst geladenen Seite, und wer über das Menü nach
         Potsdam wechselt, bekommt beim nächsten Besuch wieder den alten
         vorgeschlagen. */
      beimSeitenaufbau(() => {
        const el = document.querySelector('meta[name="ku64:standort"]');
        if (el) {
          try {
            localStorage.setItem('ku64:standort', el.getAttribute('content') || '');
          } catch {
            /* Privater Modus o. Ä. – dann eben ohne Gedächtnis. */
          }
        }
      });
    </script>
  </body>
</html>

<style>
  /*
   * Ein Streifen, kein Banner.
   *
   * Er steht über dem Kopf und ist die erste Zeile, die eine englische
   * Besucherin sieht. Ungestaltet las er sich wie ein Versehen: schwarzer
   * Text am linken Rand, ohne Fläche, ohne Bezug zur Seite darunter.
   *
   * Jetzt trägt er die warme Flächenfarbe des Hauses, richtet sich am
   * selben Raster aus wie alles andere und tritt in Größe und Farbe zurück.
   * Er informiert, er warnt nicht – deshalb kein Gelb und kein Rot.
   */
  .sprache-aufbau {
    padding-block: 0.5rem;
    background: var(--flaeche-warm);
    border-block-end: 1px solid var(--linie);
    font-size: var(--t-xs);
    line-height: var(--zeile-normal);
    color: var(--tinte-leise);
  }

  .sprache-aufbau-inhalt {
    display: block;
  }
</style>
